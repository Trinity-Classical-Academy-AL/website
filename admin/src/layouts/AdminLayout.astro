---
interface Props {
	title: string;
	current: string;
	counts?: { requests?: number; interest?: number; questions?: number };
}
const { title, current, counts = {} } = Astro.props;
const content = await Astro.slots.render('default');
const mobileContent = (content ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
const on = (href: string) => (current === href ? 'on' : undefined);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<link rel="stylesheet" href="/css/app.css" />
		<link rel="stylesheet" href="/css/admin.css" />
		<link rel="stylesheet" href="/css/responsive.css" />
	</head>
	<body>
		<div class="shell-d">
			<div class="root">
				<div class="app">
					<aside class="side">
						<div class="brand"><img src="/assets/img/emblem-cream.svg" alt="" /><div><p class="brand-t">TCA Admin</p><p class="brand-s">Trinity Classical Academy</p></div></div>
						<nav class="nav" aria-label="Admin">
							<a href="/home" class={on('/home')} aria-current={current === '/home' ? 'page' : undefined}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>Home</a>
							<p class="nav-g">Website</p>
							<a href="/website/banner" class={on('/website/banner')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4h3l6 4V6L7 10z"/><path d="M16.5 9a4 4 0 0 1 0 6M19 6.5a8 8 0 0 1 0 11"/></svg>Announcement banner</a>
							<a href="/website/tours" class={on('/website/tours')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>Tour dates</a>
							<a href="/website/tours#requests" class={on('/website/tours')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l3-8h12l3 8v6H3z"/><path d="M3 13h5l1 3h6l1-3h5"/></svg>Tour requests{counts.requests ? <span class="n" aria-label={`${counts.requests} new`}>{counts.requests}</span> : null}</a>
							<a href="/website/tours#interest" class={on('/website/tours')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>Interest{counts.interest ? <span class="n">{counts.interest}</span> : null}</a>
							<p class="nav-g">Family Portal</p>
							<a href="/portal/families" class={on('/portal/families')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/></svg>Families</a>
							<a href="/portal/bookings" class={on('/portal/bookings')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Tour bookings</a>
							<a href="/portal/questions" class={on('/portal/questions')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z"/></svg>Questions{counts.questions ? <span class="n">{counts.questions}</span> : null}</a>
							<a href="/portal/rsvps" class={on('/portal/rsvps')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg>RSVPs</a>
							<a href="/portal/events" class={on('/portal/events')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>Events</a>
							<p class="nav-g">Admissions</p>
							<span class="dis" aria-disabled="true"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg>Applications<span class="later">Later</span></span>
						</nav>
						<div class="side-foot">
							<a class="side-link" href="https://trinityclassical.academy" target="_blank" rel="noopener">View website</a>
							<a class="side-link" href="https://app.trinityclassical.academy" target="_blank" rel="noopener">View family portal</a>
							<div class="me"><span class="av" aria-hidden="true"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><div><p class="me-n">Staff</p><p class="me-e">Shared login</p></div></div>
							<form method="post" action="/sign-out" style="margin:0"><button class="side-link" style="background:none;border:0;width:100%;cursor:pointer;font:inherit;color:inherit">Sign out</button></form>
						</div>
					</aside>
					<main class="main"><div class="awrap" set:html={content} /></main>
				</div>
			</div>
		</div>
		<div class="shell-m">
			<div class="root m">
				<div class="mapp">
					<header class="mtop"><button type="button" class="menu" id="open-menu" aria-label="Open menu"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button><img src="/assets/img/emblem-green.svg" alt="" /><span class="mtop-t">TCA Admin</span></header>
					<main class="mwrap" style="padding:0"><div class="awrap" set:html={mobileContent} /></main>
				</div>
				<div class="menu-panel" id="menu">
					<div class="side" style="width:100%;min-height:100%">
						<div class="brand"><img src="/assets/img/emblem-cream.svg" alt="" /><div><p class="brand-t">TCA Admin</p></div></div>
						<nav class="nav">
							<a href="/home">Home</a>
							<p class="nav-g">Website</p>
							<a href="/website/banner">Announcement banner</a>
							<a href="/website/tours">Tour dates</a>
							<p class="nav-g">Family Portal</p>
							<a href="/portal/families">Families</a>
							<a href="/portal/bookings">Tour bookings</a>
							<a href="/portal/questions">Questions</a>
							<a href="/portal/rsvps">RSVPs</a>
							<a href="/portal/events">Events</a>
							<span class="dis">Applications<span class="later">Later</span></span>
						</nav>
						<form method="post" action="/sign-out"><button class="side-link" style="background:none;border:0;color:inherit">Sign out</button></form>
					</div>
				</div>
			</div>
		</div>
		<script is:inline>
			document.getElementById('open-menu')?.addEventListener('click', () => document.getElementById('menu')?.classList.toggle('open'));
		</script>
	</body>
</html>
