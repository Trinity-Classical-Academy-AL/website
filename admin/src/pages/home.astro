---
import AdminLayout from '../layouts/AdminLayout.astro';
import { dashboardCounts, formatChicago, getBannerDocument, recentActivity } from '@tca/school';
import { isBannerActive } from '../../../src/lib/admissions/banner.ts';

export const prerender = false;

const counts = await dashboardCounts();
const activity = await recentActivity(12);
const banner = await getBannerDocument();
const current = banner?.current as { enabled?: boolean; text?: string; startsOn?: string; endsOn?: string } | undefined;
const active = current ? isBannerActive({ enabled: Boolean(current.enabled), text: String(current.text ?? ''), startsOn: String(current.startsOn ?? ''), endsOn: String(current.endsOn ?? ''), clickAction: 'flyer', url: '', flyer: null, modal: { title: '', date: '', time: '', location: '', description: '', rsvpUrl: '', rsvpLabel: '', secondaryUrl: '', secondaryLabel: '' }, updatedAt: '' }) : false;
const cards = [
	['New tour requests', counts.newRequests, '/website/tours'],
	['New interest notes', counts.newInterest, '/website/tours'],
	['Families', counts.families, '/portal/families'],
	['Open questions', counts.openQuestions, '/portal/questions'],
	['Tour bookings', counts.bookings, '/portal/bookings'],
	['RSVPs', counts.rsvps, '/portal/rsvps'],
];
---
<AdminLayout title="Home">
	<h1 class="font-display text-4xl italic">Today</h1>
	<p class="mt-2 max-w-xl text-sm text-ink-soft">Website content and the family portal, in one place.</p>
	<section class="mt-6 rounded-card border border-ink/10 bg-white p-5">
		<p class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Announcement banner</p>
		<p class="mt-2 font-display text-2xl italic">{active ? 'On' : current?.enabled ? 'Scheduled off' : 'Off'}</p>
		<p class="mt-1 text-sm text-ink-soft">{current?.text || 'No banner text yet.'}</p>
		<a href="/website/banner" class="mt-3 inline-block font-mono text-[10px] uppercase tracking-eyebrow text-forest">Edit banner</a>
	</section>
	<ul class="mt-4 grid gap-3 sm:grid-cols-3">
		{cards.map(([label, count, href]) => (
			<li>
				<a href={String(href)} class="block rounded-card border border-ink/10 bg-white p-4 hover:border-forest">
					<p class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">{label}</p>
					<p class="mt-2 font-display text-3xl italic">{count}</p>
				</a>
			</li>
		))}
	</ul>
	<section class="mt-6 rounded-card border border-ink/10 bg-white p-5">
		<h2 class="font-display text-2xl italic">Activity</h2>
		{activity.length === 0 ? (
			<p class="mt-3 text-sm text-ink-soft">Nothing has been recorded yet.</p>
		) : (
			<ul class="mt-3 divide-y divide-ink/10">
				{activity.map((item) => (
					<li class="py-3">
						<p class="text-sm">{item.summary}</p>
						<p class="mt-1 font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">{formatChicago(item.createdAt)} · {item.kind.replaceAll('_', ' ')}</p>
					</li>
				))}
			</ul>
		)}
	</section>
</AdminLayout>
