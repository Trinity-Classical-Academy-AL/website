---
import { issueStaffSession, STAFF_COOKIE, STAFF_SESSION_DAYS, tokensMatch, staffSecret } from '@tca/school';
import { text } from '../lib/list.ts';

export const prerender = false;

let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const expected = staffSecret();
	if (!expected) {
		error = 'Set TCA_ADMIN_TOKEN on this admin site, then redeploy.';
	} else if (!tokensMatch(text(form, 'token'), expected)) {
		error = "That key isn't valid. Check for a typo, or ask for a new one.";
	} else {
		Astro.cookies.set(STAFF_COOKIE, issueStaffSession(), {
			httpOnly: true,
			path: '/',
			sameSite: 'lax',
			secure: Astro.url.protocol === 'https:',
			maxAge: STAFF_SESSION_DAYS * 24 * 60 * 60,
		});
		return Astro.redirect('/home');
	}
}
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Staff sign-in — Trinity Classical Academy</title>
		<link rel="stylesheet" href="/src/styles.css" />
	</head>
	<body class="min-h-screen bg-cream/50 font-sans text-ink antialiased">
		<main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-10">
			<form method="post" class="w-full rounded-card border border-ink/10 bg-white p-8 shadow-sm">
				<p class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest">Trinity Classical Academy</p>
				<h1 class="mt-3 font-display text-4xl italic">Staff admin</h1>
				<p class="mt-3 text-sm leading-relaxed text-ink-soft">One key for the website, the family portal, and applications. It stays on this browser for 14 days.</p>
				<label for="token" class="mt-6 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Staff key</label>
				<input id="token" name="token" type="password" autocomplete="current-password" class="mt-1.5 w-full rounded-card border border-ink/15 px-3 py-2.5 text-sm outline-none focus:border-forest" />
				{error && <p role="alert" class="mt-3 rounded-card border border-[#e7b2a8] bg-[#fdecea] px-3 py-2 text-sm text-[#9f2d2d]">{error}</p>}
				<button type="submit" class="mt-5 w-full rounded-pill bg-forest px-5 py-3 font-mono text-[11px] uppercase tracking-eyebrow text-white">Continue</button>
			</form>
		</main>
	</body>
</html>
