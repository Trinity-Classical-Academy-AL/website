---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { searchQuery, text, wantsCsv } from '../../lib/list.ts';
import { chicagoInputToIso, csvResponse, deleteEvent, formatChicago, isoToChicagoInput, listEvents, saveEvent, toCsv } from '@tca/school';

export const prerender = false;
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = text(form, 'action');
	if (action === 'delete') {
		await deleteEvent(text(form, 'id'));
		return Astro.redirect('/portal/events');
	}
	const title = text(form, 'title');
	const starts = chicagoInputToIso(text(form, 'startsAt'));
	if (!title || !starts) error = 'An event needs a title and a date.';
	else {
		await saveEvent({
			id: text(form, 'id') || undefined,
			title,
			description: text(form, 'description'),
			startsAt: starts,
			location: text(form, 'location'),
		});
		return Astro.redirect('/portal/events');
	}
}
const q = searchQuery(Astro.url);
const events = (await listEvents()).filter((event) => {
	if (!q) return true;
	const haystack = `${event.title} ${event.location} ${event.description}`.toLowerCase();
	return haystack.includes(q.toLowerCase());
});
if (wantsCsv(Astro.url)) {
	return csvResponse('trinity-events.csv', toCsv(events, [
		{ key: 'title', label: 'Title' },
		{ key: 'startsAt', label: 'Starts' },
		{ key: 'location', label: 'Location' },
		{ key: 'description', label: 'Description' },
	]));
}
const editing = events.find((event) => event.id === Astro.url.searchParams.get('id'));
---
<AdminLayout title="Events — TCA Admin" current="/portal/events">
	<header class="ahead"><div><p class="crumb">Family portal</p><h1>Events</h1></div></header>
	<form class="tools" method="get"><div class="srch"><input name="q" class="inp" value={q} placeholder="Search events" /></div><a class="btn btn-s btn-sm" href={q ? `?q=${encodeURIComponent(q)}&format=csv` : '?format=csv'}>Export CSV</a></form>
	<section class="card">
		<h2 class="h2">{editing ? 'Edit event' : 'New event'}</h2>
		<form method="post" class="form" style="margin-top:16px">
			{editing && <input type="hidden" name="id" value={editing.id} />}
			<div class="field"><label class="lbl" for="title">Title</label><input id="title" name="title" required value={editing?.title ?? ''} class="inp" /></div>
			<div class="field"><label class="lbl" for="starts">When</label><input id="starts" name="startsAt" type="datetime-local" required value={editing ? isoToChicagoInput(editing.startsAt) : ''} class="inp" /></div>
			<div class="field"><label class="lbl" for="location">Location</label><input id="location" name="location" value={editing?.location ?? ''} class="inp" /></div>
			<div class="field"><label class="lbl" for="description">Description</label><textarea id="description" name="description" rows="3" class="inp">{editing?.description ?? ''}</textarea></div>
			{error && <p class="alert alert-err" role="alert">{error}</p>}
			<button class="btn btn-p">{editing ? 'Save event' : 'Create event'}</button>
		</form>
	</section>
	<div class="stack g12" style="margin-top:16px">
		{events.map((event) => (
			<article class="card between">
				<div><p class="h3">{event.title}</p><p class="mute">{formatChicago(event.startsAt)}{event.location ? ` · ${event.location}` : ''}</p></div>
				<div class="rowx"><a class="btn btn-s btn-sm" href={`?id=${event.id}`}>Edit</a><form method="post"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={event.id} /><button class="btn btn-g btn-sm">Delete</button></form></div>
			</article>
		))}
		{events.length === 0 && <p class="soft">No events yet.</p>}
	</div>
</AdminLayout>
