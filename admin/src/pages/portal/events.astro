---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { searchQuery, text, wantsCsv } from '../../lib/list.ts';
import SearchBar from '../../components/SearchBar.astro';
import { chicagoInputToIso, csvResponse, deleteEvent, formatChicago, isoToChicagoInput, listEvents, saveEvent, toCsv } from '@tca/school';

export const prerender = false;
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = text(form, 'action');
	if (action === 'delete') {
		await deleteEvent(text(form, 'id'));
		return Astro.redirect('/portal/events');
	}
	const title = text(form, 'title');
	const starts = chicagoInputToIso(text(form, 'startsAt'));
	if (!title || !starts) error = 'An event needs a title and a date.';
	else {
		await saveEvent({
			id: text(form, 'id') || undefined,
			title,
			description: text(form, 'description'),
			startsAt: starts,
			location: text(form, 'location'),
		});
		return Astro.redirect('/portal/events');
	}
}
const q = searchQuery(Astro.url);
const events = (await listEvents()).filter((event) => {
	if (!q) return true;
	const haystack = `${event.title} ${event.location} ${event.description}`.toLowerCase();
	return haystack.includes(q.toLowerCase());
});
if (wantsCsv(Astro.url)) {
	return csvResponse('trinity-events.csv', toCsv(events, [
		{ key: 'title', label: 'Title' },
		{ key: 'startsAt', label: 'Starts' },
		{ key: 'location', label: 'Location' },
		{ key: 'description', label: 'Description' },
	]));
}
const editing = events.find((event) => event.id === Astro.url.searchParams.get('id'));
const input = 'mt-1.5 w-full rounded-card border border-ink/15 px-3 py-2.5 text-sm outline-none focus:border-forest';
---
<AdminLayout title="Events">
	<div class="flex flex-wrap items-end justify-between gap-3">
		<h1 class="font-display text-4xl italic">Events</h1>
		<SearchBar q={q} />
	</div>
	<p class="mt-2 text-sm text-ink-soft">Families see upcoming events and RSVP with a head count. Times are Central.</p>
	<form method="post" class="mt-6 rounded-card border border-ink/10 bg-white p-5">
		<h2 class="font-display text-2xl italic">{editing ? 'Edit event' : 'New event'}</h2>
		{editing && <input type="hidden" name="id" value={editing.id} />}
		<label class="mt-4 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Title<input name="title" required value={editing?.title ?? ''} class={input} /></label>
		<label class="mt-4 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">When<input name="startsAt" type="datetime-local" required value={editing ? isoToChicagoInput(editing.startsAt) : ''} class={input} /></label>
		<label class="mt-4 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Location<input name="location" value={editing?.location ?? ''} class={input} /></label>
		<label class="mt-4 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Description<textarea name="description" rows="3" class={input}>{editing?.description ?? ''}</textarea></label>
		{error && <p role="alert" class="mt-3 text-sm text-[#9f2d2d]">{error}</p>}
		<button class="mt-4 rounded-pill bg-forest px-5 py-3 font-mono text-[11px] uppercase tracking-eyebrow text-white">{editing ? 'Save event' : 'Create event'}</button>
	</form>
	<ul class="mt-6 space-y-3">
		{events.map((event) => (
			<li class="flex flex-wrap items-start justify-between gap-3 rounded-card border border-ink/10 bg-white p-5">
				<div>
					<p class="font-display text-2xl italic">{event.title}</p>
					<p class="mt-1 text-sm">{formatChicago(event.startsAt)}</p>
					{event.location && <p class="text-sm text-ink-soft">{event.location}</p>}
					{event.description && <p class="mt-2 max-w-xl text-sm text-ink-soft">{event.description}</p>}
				</div>
				<div class="flex gap-3">
					<a href={`?id=${event.id}`} class="font-mono text-[10px] uppercase tracking-eyebrow text-forest">Edit</a>
					<form method="post"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={event.id} /><button class="font-mono text-[10px] uppercase tracking-eyebrow text-[#9f2d2d]">Delete</button></form>
				</div>
			</li>
		))}
	</ul>
	{events.length === 0 && <p class="mt-6 text-sm text-ink-soft">No events yet.</p>}
</AdminLayout>
