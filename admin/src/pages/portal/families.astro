---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { searchQuery, wantsCsv } from '../../lib/list.ts';
import { csvResponse, formatChicago, listFamilies, toCsv } from '@tca/school';
export const prerender = false;
const q = searchQuery(Astro.url);
const families = await listFamilies(q);
if (wantsCsv(Astro.url)) {
	return csvResponse('trinity-families.csv', toCsv(families.map((family) => ({ ...family, verified: family.emailVerifiedAt ? 'yes' : 'no' })), [
		{ key: 'createdAt', label: 'Joined' }, { key: 'name', label: 'Name' }, { key: 'email', label: 'Email' }, { key: 'phone', label: 'Phone' }, { key: 'verified', label: 'Email verified' },
	]));
}
const csv = q ? `?q=${encodeURIComponent(q)}&format=csv` : '?format=csv';
---
<AdminLayout title="Families — TCA Admin" current="/portal/families">
	<header class="ahead"><div><p class="crumb">Family portal</p><h1>Families</h1></div></header>
	<form class="tools" method="get">
		<div class="srch"><label for="q" style="position:absolute;left:-9999px">Search</label><input id="q" name="q" class="inp" value={q} placeholder="Search name or email" /></div>
		<a class="btn btn-s btn-sm" href={csv}>Export CSV</a>
	</form>
	<div class="tbox">
		<table class="t">
			<thead><tr><th>Joined</th><th>Family</th><th>Phone</th><th>Verified</th></tr></thead>
			<tbody>
				{families.slice(0, 200).map((family) => (
					<tr><td>{formatChicago(family.createdAt, false)}</td><td><strong>{family.name}</strong><div class="sub">{family.email}</div></td><td>{family.phone}</td><td>{family.emailVerifiedAt ? 'Yes' : 'No'}</td></tr>
				))}
			</tbody>
		</table>
		{families.length === 0 && (
			<div class="empty" style="margin:16px">
				<p class="h3">{q ? `No families match “${q}”` : 'No families yet'}</p>
				<p class="soft">{q ? 'Try a different name or email.' : 'Accounts from the family portal show up here.'}</p>
				{q && <a class="btn btn-s btn-sm" href="/portal/families">Clear search</a>}
			</div>
		)}
	</div>
</AdminLayout>
