---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import { searchQuery, wantsCsv } from '../../lib/list.ts';
import { csvResponse, formatChicago, listFamilies, toCsv } from '@tca/school';

export const prerender = false;
const q = searchQuery(Astro.url);
const families = await listFamilies(q);
if (wantsCsv(Astro.url)) {
	return csvResponse('trinity-families.csv', toCsv(families.map((family) => ({ ...family, verified: family.emailVerifiedAt ? 'yes' : 'no' })), [
		{ key: 'createdAt', label: 'Joined' },
		{ key: 'name', label: 'Name' },
		{ key: 'email', label: 'Email' },
		{ key: 'phone', label: 'Phone' },
		{ key: 'verified', label: 'Email verified' },
	]));
}
---
<AdminLayout title="Families">
	<div class="flex flex-wrap items-end justify-between gap-3">
		<h1 class="font-display text-4xl italic">Families</h1>
		<SearchBar q={q} />
	</div>
	<p class="mt-2 text-sm text-ink-soft">One login per family. No children are stored here.</p>
	<div class="mt-6 overflow-x-auto rounded-card border border-ink/10 bg-white p-5">
		<table class="w-full min-w-[640px] text-left text-sm">
			<thead class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute"><tr><th class="py-2 pr-3">Joined</th><th class="py-2 pr-3">Name</th><th class="py-2 pr-3">Email</th><th class="py-2 pr-3">Phone</th><th class="py-2">Verified</th></tr></thead>
			<tbody>
				{families.slice(0, 200).map((family) => (
					<tr class="border-t border-ink/10">
						<td class="py-2 pr-3">{formatChicago(family.createdAt)}</td>
						<td class="py-2 pr-3">{family.name}</td>
						<td class="py-2 pr-3">{family.email}</td>
						<td class="py-2 pr-3">{family.phone}</td>
						<td class="py-2">{family.emailVerifiedAt ? 'Yes' : 'No'}</td>
					</tr>
				))}
			</tbody>
		</table>
		{families.length === 0 && <p class="mt-3 text-sm text-ink-soft">No families yet.</p>}
	</div>
</AdminLayout>
