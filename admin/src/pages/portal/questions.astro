---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { searchQuery, text, wantsCsv } from '../../lib/list.ts';
import { csvResponse, formatChicago, listQuestions, markQuestionReplied, toCsv } from '@tca/school';
export const prerender = false;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (text(form, 'action') === 'replied') await markQuestionReplied(text(form, 'id'));
	return Astro.redirect(`/portal/questions${Astro.url.search}`);
}
const q = searchQuery(Astro.url);
const questions = await listQuestions(q);
if (wantsCsv(Astro.url)) {
	return csvResponse('trinity-questions.csv', toCsv(questions, [
		{ key: 'createdAt', label: 'Asked' }, { key: 'status', label: 'Status' }, { key: 'familyName', label: 'Family' }, { key: 'email', label: 'Email' }, { key: 'body', label: 'Question' },
	]));
}
const csv = q ? `?q=${encodeURIComponent(q)}&format=csv` : '?format=csv';
---
<AdminLayout title="Questions — TCA Admin" current="/portal/questions">
	<header class="ahead"><div><p class="crumb">Family portal</p><h1>Questions</h1></div></header>
	<form class="tools" method="get"><div class="srch"><input name="q" class="inp" value={q} placeholder="Search" /></div><a class="btn btn-s btn-sm" href={csv}>Export CSV</a></form>
	<div class="stack g12">
		{questions.slice(0, 200).map((question) => (
			<article class="card">
				<div class="between"><strong>{question.familyName}</strong><span class:list={['badge', question.status === 'replied' ? 'b-green' : 'b-gray']}>{question.status === 'replied' ? 'Replied' : 'New'}</span></div>
				<p class="mute">{question.email} · {formatChicago(question.createdAt)}</p>
				<p style="margin-top:8px">{question.body}</p>
				{question.status === 'new' && <form method="post" style="margin-top:12px"><input type="hidden" name="action" value="replied" /><input type="hidden" name="id" value={question.id} /><button class="btn btn-s btn-sm">Mark replied</button></form>}
			</article>
		))}
		{questions.length === 0 && (
			<section class="card">
				<div class="empty">
					<span class="card-ic"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z"/></svg></span>
					<p class="h3">{q ? `No questions match “${q}”` : 'No questions'}</p>
					<p class="mute" style="max-width:420px">{q ? 'Try a different name or topic.' : 'Questions from the family portal show here.'}</p>
					{q && <a class="btn btn-s btn-sm" href="/portal/questions">Clear search</a>}
				</div>
			</section>
		)}
	</div>
</AdminLayout>
