---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import { searchQuery, text, wantsCsv } from '../../lib/list.ts';
import { csvResponse, formatChicago, listQuestions, markQuestionReplied, toCsv } from '@tca/school';

export const prerender = false;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (text(form, 'action') === 'replied') await markQuestionReplied(text(form, 'id'));
	return Astro.redirect(`/portal/questions${Astro.url.search}`);
}
const q = searchQuery(Astro.url);
const questions = await listQuestions(q);
if (wantsCsv(Astro.url)) {
	return csvResponse('trinity-questions.csv', toCsv(questions, [
		{ key: 'createdAt', label: 'Asked' },
		{ key: 'status', label: 'Status' },
		{ key: 'familyName', label: 'Family' },
		{ key: 'email', label: 'Email' },
		{ key: 'body', label: 'Question' },
	]));
}
---
<AdminLayout title="Questions">
	<div class="flex flex-wrap items-end justify-between gap-3">
		<h1 class="font-display text-4xl italic">Questions</h1>
		<SearchBar q={q} />
	</div>
	<ul class="mt-6 space-y-3">
		{questions.slice(0, 200).map((question) => (
			<li class="rounded-card border border-ink/10 bg-white p-5">
				<div class="flex flex-wrap items-baseline justify-between gap-2">
					<p class="font-medium">{question.familyName}</p>
					<p class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">{formatChicago(question.createdAt)} · {question.status}</p>
				</div>
				<p class="mt-1 text-sm text-ink-soft">{question.email}</p>
				<p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed">{question.body}</p>
				{question.status === 'new' && (
					<form method="post" class="mt-3"><input type="hidden" name="action" value="replied" /><input type="hidden" name="id" value={question.id} /><button class="font-mono text-[10px] uppercase tracking-eyebrow text-forest">Mark replied</button></form>
				)}
			</li>
		))}
	</ul>
	{questions.length === 0 && <p class="mt-6 text-sm text-ink-soft">No questions yet.</p>}
</AdminLayout>
