---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import { searchQuery, wantsCsv } from '../../lib/list.ts';
import { csvResponse, formatChicago, listRsvps, toCsv } from '@tca/school';

export const prerender = false;
const q = searchQuery(Astro.url);
const rsvps = await listRsvps(q);
if (wantsCsv(Astro.url)) {
	return csvResponse('trinity-rsvps.csv', toCsv(rsvps, [
		{ key: 'createdAt', label: 'RSVP' },
		{ key: 'eventTitle', label: 'Event' },
		{ key: 'familyName', label: 'Family' },
		{ key: 'email', label: 'Email' },
		{ key: 'headCount', label: 'Head count' },
	]));
}
---
<AdminLayout title="RSVPs">
	<div class="flex flex-wrap items-end justify-between gap-3">
		<h1 class="font-display text-4xl italic">RSVPs</h1>
		<SearchBar q={q} />
	</div>
	<div class="mt-6 overflow-x-auto rounded-card border border-ink/10 bg-white p-5">
		<table class="w-full min-w-[640px] text-left text-sm">
			<thead class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute"><tr><th class="py-2 pr-3">When</th><th class="py-2 pr-3">Event</th><th class="py-2 pr-3">Family</th><th class="py-2">Head count</th></tr></thead>
			<tbody>
				{rsvps.slice(0, 200).map((rsvp) => (
					<tr class="border-t border-ink/10">
						<td class="py-2 pr-3">{formatChicago(rsvp.createdAt)}</td>
						<td class="py-2 pr-3">{rsvp.eventTitle}</td>
						<td class="py-2 pr-3">{rsvp.familyName}<br /><span class="text-ink-mute">{rsvp.email}</span></td>
						<td class="py-2">{rsvp.headCount}</td>
					</tr>
				))}
			</tbody>
		</table>
		{rsvps.length === 0 && <p class="mt-3 text-sm text-ink-soft">No RSVPs yet.</p>}
	</div>
</AdminLayout>
