---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { text } from '../../lib/list.ts';
import { getBannerDocument, saveBanner, saveFlyerBytes } from '@tca/school';
import { emptyBanner, sniffFlyer, type Banner } from '../../../../src/lib/admissions/banner.ts';
import { validateBanner } from '../../../../src/lib/admissions/validation.ts';
import { TOUR_DEFAULTS } from '../../../../src/lib/admissions/defaults.ts';

export const prerender = false;

const load = async () => ((await getBannerDocument())?.current as Banner | undefined) ?? emptyBanner();
let banner = await load();
let history = ((await getBannerDocument())?.history ?? []) as Banner[];
let error = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const reuse = form.get('reuse');
	if (reuse != null) {
		const past = history[Number(reuse)];
		if (past) {
			await saveBanner({ ...past, startsOn: '', endsOn: '', updatedAt: '' });
			return Astro.redirect('/website/banner');
		}
	}
	let flyer = banner.flyer;
	if (form.get('removeFlyer') === 'yes') flyer = null;
	const file = form.get('flyer');
	if (file instanceof File && file.size > 0) {
		if (file.size > TOUR_DEFAULTS.flyerMaxBytes) error = 'Files must be 10 MB or smaller.';
		else {
			const bytes = new Uint8Array(await file.arrayBuffer());
			const contentType = sniffFlyer(bytes, file.type);
			if (!contentType) error = 'Use a PNG, JPEG, WebP, or PDF flyer.';
			else {
				const saved = await saveFlyerBytes(bytes, { name: file.name.replace(/[^\w.\- ]+/g, '').slice(0, 180) || 'flyer', contentType });
				flyer = { ...saved, contentType };
			}
		}
	}
	if (!error) {
		const validation = validateBanner({
			enabled: form.get('enabled') === 'on',
			text: text(form, 'text'),
			startsOn: text(form, 'startsOn'),
			endsOn: text(form, 'endsOn'),
			clickAction: text(form, 'clickAction'),
			url: text(form, 'url'),
			modal: {
				title: text(form, 'title'),
				date: text(form, 'date'),
				time: text(form, 'time'),
				location: text(form, 'location'),
				description: text(form, 'description'),
				rsvpUrl: text(form, 'rsvpUrl'),
				rsvpLabel: text(form, 'rsvpLabel'),
				secondaryUrl: text(form, 'secondaryUrl'),
				secondaryLabel: text(form, 'secondaryLabel'),
			},
		});
		if (!validation.value) error = Object.values(validation.errors)[0] || 'Check the banner fields.';
		else {
			await saveBanner({ ...validation.value, flyer, updatedAt: '' });
			return Astro.redirect('/website/banner');
		}
	}
	banner = { ...banner, text: text(form, 'text') };
}

const input = 'inp';
const label = 'lbl';
---
<AdminLayout title="Announcement banner — TCA Admin" current="/website/banner">
	<header class="ahead"><div><p class="crumb">Website</p><h1>Announcement banner</h1><p class="soft" style="margin-top:6px">Shown on the public website. 120 characters. Dates are Central Time. The flyer stays in Netlify Blobs.</p></div></header>
	<div class="two">
		<form method="post" enctype="multipart/form-data" class="card form">
			<label class="chk"><input type="checkbox" name="enabled" checked={banner.enabled} /><span>Banner is on</span></label>
			<div class="field"><label class={label} for="text">Banner text</label><input id="text" name="text" maxlength="120" value={banner.text} class={input} /><p class="cnt-ch">{banner.text.length} / 120</p></div>
			<fieldset class="field" style="border:0;padding:0;margin:0">
				<legend class={label}>When visitors click the banner</legend>
				<div class="chips">
					<label class:list={['chip', banner.clickAction === 'url' && 'on']}><input type="radio" name="clickAction" value="url" checked={banner.clickAction === 'url'} /> Go to a URL</label>
					<label class:list={['chip', banner.clickAction !== 'url' && 'on']}><input type="radio" name="clickAction" value="flyer" checked={banner.clickAction !== 'url'} /> Open a flyer</label>
				</div>
			</fieldset>
			<div class="field"><label class={label} for="url">Link</label><input id="url" name="url" value={banner.url} placeholder="https:// or /visit" class={input} /></div>
			<div class="field">
				<label class={label} for="flyer">Flyer</label>
				{banner.flyer ? (
					<div class="file">
						<div class="stack g4" style="flex:1;min-width:0"><span class="h3">{banner.flyer.name}</span><span class="mute">{Math.max(1, Math.round(banner.flyer.size / 1024))} KB</span></div>
						<label class="btn btn-g btn-sm"><input type="checkbox" name="removeFlyer" value="yes" /> Remove</label>
					</div>
				) : (
					<label class="drop" for="flyer">Choose a PNG, JPEG, WebP, or PDF. Up to 10 MB.</label>
				)}
				<input id="flyer" name="flyer" type="file" accept="image/png,image/jpeg,image/webp,application/pdf" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)" />
			</div>
			<div class="field"><label class={label} for="title">Title</label><input id="title" name="title" value={banner.modal.title} class={input} /></div>
			<div class="rowx">
				<div class="field" style="flex:1"><label class={label} for="date">Date</label><input id="date" name="date" type="date" value={banner.modal.date} class={input} /></div>
				<div class="field" style="flex:1"><label class={label} for="time">Time</label><input id="time" name="time" type="time" value={banner.modal.time} class={input} /></div>
			</div>
			<div class="field"><label class={label} for="location">Location</label><input id="location" name="location" value={banner.modal.location} class={input} /></div>
			<div class="field"><label class={label} for="description">Description</label><textarea id="description" name="description" rows="3" class={input}>{banner.modal.description}</textarea></div>
			<div class="rowx">
				<div class="field" style="flex:1"><label class={label} for="rsvp">RSVP link</label><input id="rsvp" name="rsvpUrl" value={banner.modal.rsvpUrl} class={input} /></div>
				<div class="field" style="flex:1"><label class={label} for="rsvpLabel">Button label</label><input id="rsvpLabel" name="rsvpLabel" value={banner.modal.rsvpLabel} class={input} /></div>
			</div>
			<div class="rowx">
				<div class="field" style="flex:1"><label class={label} for="secondary">Second link</label><input id="secondary" name="secondaryUrl" value={banner.modal.secondaryUrl} class={input} /></div>
				<div class="field" style="flex:1"><label class={label} for="secondaryLabel">Second label</label><input id="secondaryLabel" name="secondaryLabel" value={banner.modal.secondaryLabel} class={input} /></div>
			</div>
			<div class="rowx">
				<div class="field" style="flex:1"><label class={label} for="starts">Show from</label><input id="starts" name="startsOn" type="date" value={banner.startsOn} class={input} /></div>
				<div class="field" style="flex:1"><label class={label} for="ends">Show until</label><input id="ends" name="endsOn" type="date" value={banner.endsOn} class={input} /></div>
			</div>
			{error && <p class="alert alert-err" role="alert">{error}</p>}
			<div class="acts stackm">
				<button type="submit" class="btn btn-p">Save</button>
				<a class="btn btn-g" href="/website/banner">Discard changes</a>
			</div>
		</form>
		<section class="card">
			<div class="card-h"><h2 class="h2">Live preview</h2><span class:list={['badge', banner.enabled ? 'b-green' : 'b-gray']}>{banner.enabled ? 'Live now' : 'Off'}</span></div>
			<div class:list={['pv', !banner.enabled && 'off']}>
				<div class="pv-bar"><span class="tx">{banner.text || 'Banner text'}</span><span class="fl">View flyer</span></div>
				<div class="pv-body"><p class="h3">{banner.modal.title || 'Event title'}</p><p class="soft">{banner.modal.location}</p><p class="mute">{banner.modal.description}</p></div>
			</div>
		</section>
	</div>
	{history.length > 0 && (
		<section class="card" style="margin-top:24px">
			<h2 class="h2" style="margin-bottom:12px">Past banners</h2>
			<div class="rows">
				{history.map((past, index) => (
					<div class="r">
						<span class="h3">{past.text || 'Untitled'}</span>
						<form method="post"><input type="hidden" name="reuse" value={String(index)} /><button class="btn btn-s btn-sm">Reuse</button></form>
					</div>
				))}
			</div>
		</section>
	)}
</AdminLayout>
