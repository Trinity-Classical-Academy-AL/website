---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { searchQuery, text, wantsCsv } from '../../lib/list.ts';
import { csvResponse, formatChicago, listInterest, listTourDates, listTourRequests, saveTourDates, setInterestStatus, setTourRequestStatus, toCsv, tourDatesConfigured } from '@tca/school';
import { defaultTourDates } from '../../../../src/lib/admissions/dates.ts';

export const prerender = false;

const q = searchQuery(Astro.url);
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = text(form, 'action');
	if (action === 'request-status') {
		const status = text(form, 'status');
		if (status === 'new' || status === 'contacted' || status === 'cancelled') await setTourRequestStatus(text(form, 'id'), status);
	} else if (action === 'interest-status') {
		const status = text(form, 'status');
		if (status === 'new' || status === 'contacted') await setInterestStatus(text(form, 'id'), status);
	} else if (action === 'season') {
		const suggested = defaultTourDates();
		await saveTourDates(suggested.map((date) => ({ date: date.date, startTime: date.startTime, endTime: date.endTime, capacity: date.capacity, enabled: date.enabled })));
	} else if (action === 'dates') {
		const count = Number(form.get('count') || 0);
		const dates = [];
		for (let index = 0; index < count; index += 1) {
			const date = text(form, `date-${index}`);
			if (!date) continue;
			dates.push({
				date,
				startTime: text(form, `start-${index}`) || '09:00',
				endTime: text(form, `end-${index}`) || '10:00',
				capacity: Number(form.get(`capacity-${index}`) || 12),
				enabled: form.get(`enabled-${index}`) === 'on',
			});
		}
		await saveTourDates(dates);
	}
	return Astro.redirect('/website/tours');
}

const requests = await listTourRequests(q);
const interest = await listInterest(q);
if (wantsCsv(Astro.url)) {
	const kind = Astro.url.searchParams.get('list');
	if (kind === 'interest') {
		return csvResponse('trinity-interest.csv', toCsv(interest, [
			{ key: 'createdAt', label: 'Submitted' },
			{ key: 'status', label: 'Status' },
			{ key: 'name', label: 'Name' },
			{ key: 'email', label: 'Email' },
			{ key: 'phone', label: 'Phone' },
			{ key: 'pagePath', label: 'Page' },
			{ key: 'message', label: 'Note' },
		]));
	}
	return csvResponse('trinity-tour-requests.csv', toCsv(requests, [
		{ key: 'createdAt', label: 'Submitted' },
		{ key: 'status', label: 'Status' },
		{ key: 'tourDate', label: 'Tour' },
		{ key: 'parentName', label: 'Name' },
		{ key: 'email', label: 'Email' },
		{ key: 'phone', label: 'Phone' },
		{ key: 'children', label: 'Children' },
		{ key: 'grades', label: 'Grades' },
		{ key: 'hearAbout', label: 'Heard about us' },
		{ key: 'message', label: 'Message' },
	].map((column) => column)));
}

const stored = await listTourDates();
const configured = await tourDatesConfigured();
const add = Math.min(5, Number(Astro.url.searchParams.get('add') || 0));
const blanks = Array.from({ length: add }, () => ({ date: '', startTime: '09:00', endTime: '10:00', capacity: 12, enabled: true }));
const dates = (configured ? stored : stored.length ? stored : []).concat(blanks);
const input = 'inp';
const csvRequests = q ? `?q=${encodeURIComponent(q)}&list=requests&format=csv` : '?list=requests&format=csv';
const csvInterest = q ? `?q=${encodeURIComponent(q)}&list=interest&format=csv` : '?list=interest&format=csv';
---
<AdminLayout title="Tours and interest — TCA Admin" current="/website/tours">
	<header class="ahead"><div><p class="crumb">Website</p><h1>Tour dates</h1><p class="soft" style="margin-top:6px">Default capacity is 12. Times are 9:00–10:00 AM Central.</p></div></header>

	<section class="card" id="dates">
		<div class="between"><h2 class="h2">Dates</h2><form method="post"><input type="hidden" name="action" value="season" /><button class="btn btn-s btn-sm">Use this season's Wednesdays</button></form></div>
		{!configured && <p class="soft" style="margin:12px 0">No dates have been saved yet. The public site is using this season's second Wednesdays until you save a list.</p>}
		<form method="post" style="margin-top:16px">
			<input type="hidden" name="action" value="dates" />
			<input type="hidden" name="count" value={String(dates.length)} />
			<div class="tbox"><table class="t">
				<thead><tr><th>Date</th><th>Start</th><th>End</th><th>Capacity</th><th>On the site</th></tr></thead>
				<tbody>
					{dates.map((date, index) => (
						<tr>
							<td><input type="date" name={`date-${index}`} value={date.date} class={input} /></td>
							<td><input type="time" name={`start-${index}`} value={date.startTime} class={input} /></td>
							<td><input type="time" name={`end-${index}`} value={date.endTime} class={input} /></td>
							<td><input type="number" min="0" max="200" name={`capacity-${index}`} value={date.capacity} class={input} style="width:88px" /></td>
							<td><input type="checkbox" name={`enabled-${index}`} checked={date.enabled} /></td>
						</tr>
					))}
				</tbody>
			</table></div>
			<div class="acts" style="margin-top:16px">
				<a class="btn btn-g" href={`?add=${add + 1}`}>Add a date</a>
				<button class="btn btn-p">Save tour dates</button>
			</div>
		</form>
	</section>

	<section class="card" id="requests" style="margin-top:24px">
		<div class="between"><h2 class="h2">Tour requests</h2><a class="btn btn-s btn-sm" href={csvRequests}>Export CSV</a></div>
		<form class="tools" method="get"><div class="srch"><input name="q" class="inp" value={q} placeholder="Search name or email" /></div></form>
		<div class="tbox"><table class="t">
			<thead><tr><th>Received</th><th>Family</th><th>Tour</th><th>Message</th><th>Status</th></tr></thead>
			<tbody>
				{requests.slice(0, 200).map((request) => (
					<tr>
						<td>{formatChicago(request.createdAt)}</td>
						<td><strong>{request.parentName}</strong><div class="sub">{request.email}<br />{request.phone}</div></td>
						<td>{request.tourDate}</td>
						<td>{request.message || '—'}</td>
						<td>
							<form method="post">
								<input type="hidden" name="action" value="request-status" />
								<input type="hidden" name="id" value={request.id} />
								<select name="status" class="inp" style="height:38px;font-size:15px;width:150px" onchange="this.form.submit()">
									<option value="new" selected={request.status === 'new'}>New</option>
									<option value="contacted" selected={request.status === 'contacted'}>Contacted</option>
									<option value="cancelled" selected={request.status === 'cancelled'}>Cancelled</option>
								</select>
							</form>
						</td>
					</tr>
				))}
			</tbody>
		</table></div>
		{requests.length === 0 && <p class="soft" style="margin-top:12px">Nothing here yet.</p>}
	</section>

	<section class="card" id="interest" style="margin-top:24px">
		<div class="between"><h2 class="h2">Interest</h2><a class="btn btn-s btn-sm" href={csvInterest}>Export CSV</a></div>
		<div class="tbox"><table class="t">
			<thead><tr><th>Received</th><th>Name</th><th>Email</th><th>Note</th><th>Status</th></tr></thead>
			<tbody>
				{interest.slice(0, 200).map((note) => (
					<tr>
						<td>{formatChicago(note.createdAt)}</td>
						<td><strong>{note.name}</strong><div class="sub">{note.pagePath}</div></td>
						<td>{note.email}</td>
						<td>{note.message || '—'}</td>
						<td>
							<form method="post">
								<input type="hidden" name="action" value="interest-status" />
								<input type="hidden" name="id" value={note.id} />
								<select name="status" class="inp" style="height:38px;font-size:15px;width:150px" onchange="this.form.submit()">
									<option value="new" selected={note.status === 'new'}>New</option>
									<option value="contacted" selected={note.status === 'contacted'}>Contacted</option>
								</select>
							</form>
						</td>
					</tr>
				))}
			</tbody>
		</table></div>
		{interest.length === 0 && <p class="soft" style="margin-top:12px">Nothing here yet.</p>}
	</section>
</AdminLayout>
