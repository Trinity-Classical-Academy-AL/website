---
import Icon from './ui/Icon.astro';
interface Props { name: string; email: string; initials: string; csrf: string; showAdmin: boolean; adminHint: boolean }
const { name, email, initials, csrf, showAdmin, adminHint } = Astro.props;
---
<div class="account-control">
  <button type="button" class="acct-btn" aria-label="Account menu" aria-haspopup="menu" aria-expanded="false" aria-controls="desktop-account" popovertarget="desktop-account">
    <span class="av" aria-hidden="true">{initials}</span>
    <span class="acct-t"><span class="me-n">{name || email}</span><span class="me-e">{email}</span></span>
<Icon name="chevron-up" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
  </button>
  <div id="desktop-account" popover="auto" class="acct-pop desktop-account" role="menu" aria-label="Account" tabindex="-1" autofocus data-account-popover>
    <div class="ap-h"><span class="av">{initials}</span><div class="ap-who"><p class="ap-n">{name || 'Account'}</p><p class="ap-e">{email}</p></div>{showAdmin && <span class="badge b-green">Admin</span>}</div>
    {adminHint && <p class="ap-note">Admin opens when you sign in with your school email.</p>}
    <div class="ap-l">
      {!Astro.locals.access?.studentId && <a role="menuitem" href="/account" data-astro-prefetch="tap"><Icon name="settings" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Settings</a>}
      <a role="menuitem" href="https://trinityclassical.academy" target="_blank" rel="noopener"><Icon name="external" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />School website</a>
    </div>
    <div class="ap-l ap-out">
      <form method="post" action="/sign-out">
        <input type="hidden" name="csrf" value={csrf} />
        <button role="menuitem" type="submit"><Icon name="sign-out" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Sign out</button>
      </form>
    </div>
  </div>
</div>
