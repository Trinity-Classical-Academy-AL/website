---
import { cssHref, cssVersion } from '../lib/assets';
import { ClientRouter } from 'astro:transitions';
// These sign-in screens have no bold body copy or mono labels above the fold.
const lightFonts = ['/', '/signup', '/password', '/forgot', '/reset-expired', '/google-unavailable', '/interested'].includes(Astro.url.pathname);
---
<link rel="preload" href="/assets/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin transition:persist="font-geist-400" />
<link rel="preload" href="/assets/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin transition:persist="font-geist-500" />
<link rel="preload" href="/assets/fonts/geist-600.woff2" as="font" type="font/woff2" crossorigin transition:persist="font-geist-600" />
{!lightFonts && <link rel="preload" href="/assets/fonts/geist-700.woff2" as="font" type="font/woff2" crossorigin transition:persist="font-geist-700" />}
<link rel="preload" href="/assets/fonts/martina-plantijn-light.woff2" as="font" type="font/woff2" crossorigin transition:persist="font-martina" />
{!lightFonts && <link rel="preload" href="/assets/fonts/ibm-plex-mono-500.woff2" as="font" type="font/woff2" crossorigin transition:persist="font-plex" />}
<link rel="stylesheet" href={cssHref('fonts.css')} transition:persist={`portal-fonts-${cssVersion}`} />
<ClientRouter fallback="swap" />
