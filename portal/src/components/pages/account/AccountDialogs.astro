---
import Field from '../../ui/Field.astro';
import ConfirmDialog from '../../ui/ConfirmDialog.astro';

import { ArkDialog } from '../../ArkDialog.tsx';

import type { AccountView } from '../../../lib/pages/account.ts';
interface Props { view: AccountView }
const { notifyCategory, emailOwner, routes, verified, adminChoices, csrf, back, dialog, verifyAddress, error, notice, focus, fresh, myName, householdName, removing } = Astro.props.view;
const lastName = (fresh?.lastName || myName.split(' ').slice(1).join(' ')).trim();
---
{dialog === 'notify' && routes[notifyCategory as 'tours'] && (() => {
		const category = notifyCategory as 'announcements' | 'tours' | 'admin';
		const route = routes[category];
		const titles = { announcements: 'School announcements', tours: 'Tours and events', admin: 'Admin alerts' };
		const choices = (category === 'admin' ? adminChoices : verified).map((item) => item.email);
		return <ArkDialog client:load label={titles[category]} closeHref="/account">
			<h2 class="h2">{titles[category]}</h2>
			<p class="soft">Who gets these emails.</p>
			{error && <p class="alert alert-err" role="alert">{error}</p>}
			<form class="form notify-form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="notify" /><input type="hidden" name="category" value={category} />
				<label class="optc"><input type="radio" name="mode" value="default" checked={!route.custom} /><span class="stack g4"><span class="t">{category === 'admin' ? 'Every email (default)' : 'Every guardian (default)'}</span><span class="mute">{route.defaults.join(', ') || 'No verified email yet'}. New guardians are included automatically.</span></span></label>
				<label class="optc"><input type="radio" name="mode" value="custom" checked={route.custom} /><span class="stack g4"><span class="t">Only these emails</span>
					<span class="notify-picks">{choices.map((email) => <label class="check-row"><input type="checkbox" name="emails" value={email} checked={route.emails.includes(email)} /><span>{emailOwner.get(email) ? <><strong>{emailOwner.get(email)}</strong> <span class="mute">{email}</span></> : email}</span></label>)}</span>
				</span></label>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Save</button></div>
			</form>
		</ArkDialog>;
	})()}
	{dialog === 'family-name' && (
		<ArkDialog client:load label="Family name" closeHref="/account">
			<h2 class="h2">Family name</h2>
			<p class="soft">How your household appears to the school, like “The Brooks family”. Any guardian can change it.</p>
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="family-name" />
				<Field label="Family name" labelFor={"family-name"} input={{ "id": "family-name", "name": "name", "class": "inp", "value": householdName, "placeholder": lastName ? `The ${lastName} family` : 'The Smith family', "maxlength": "120" }}></Field>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Save</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'add-guardian' && (
		<ArkDialog client:load label="Add a guardian" closeHref="/account">
			<h2 class="h2">Add a guardian</h2>
			<p class="soft">A parent or guardian in your household. They’ll sign in with their own email and see the same tours, forms and children.</p>
			{error && <p class="alert alert-err" role="alert">{error}</p>}
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="add-guardian" />
				<Field label="Their name" labelFor={"g-name"} input={{ "id": "g-name", "name": "name", "class": "inp", "required": true, "autocomplete": "off" }}></Field>
				<Field label="Their email" labelFor={"g-email"} hint="We’ll email them a link to set a password." input={{ "id": "g-email", "name": "email", "class": "inp", "type": "email", "required": true, "autocomplete": "off" }}></Field>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Add guardian</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'remove-guardian' && removing && (
		<ArkDialog client:load label="Remove guardian" closeHref="/account">
			<h2 class="h2">Remove {removing.name || removing.emails[0]?.email}?</h2>
			<p class="soft">They’ll no longer be able to sign in to your family’s account with {removing.emails.map((item) => item.email).join(', ')}. Their name and emails are removed from the family.</p>
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="remove-guardian" /><input type="hidden" name="id" value={removing.id} />
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-danger">Remove guardian</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'join' && (
		<ArkDialog client:load label="Join another family" closeHref="/account">
			<h2 class="h2">Join another family</h2>
			{error && <p class="alert alert-err" role="alert">{error}</p>}
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="join" />
				<Field label="Their email" labelFor={"join-email"}><input id="join-email" name="email" class="inp" type="email" required /><p class="mute">The email they use for the portal. If it has an account, we’ll ask them to approve. Once they do, your emails, children and tour requests join their family.</p></Field>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Send request</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'add' && (
		<ArkDialog client:load label="Add one of your emails" closeHref="/account">
			<h2 class="h2">Add one of your emails</h2>
			<p class="soft">Another address you use, like a work email. For a spouse or another parent, use <a href="/account?dialog=add-guardian">Add a guardian</a>.</p>
			{error && <p class="alert alert-err" role="alert">{error}</p>}
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="add" />
				<Field label="Email" labelFor={"add-email"}><input id="add-email" name="email" class="inp" type="email" required /><p class="mute">We’ll send a 6-digit code to confirm it’s yours.</p></Field>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Send code</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'verify' && (
		<ArkDialog client:load label="Check your email" closeHref="/account">
			<h2 class="h2">Check your email</h2>
			<p class="soft">We sent a code to {verifyAddress}. It expires in 10 minutes.</p>
			{error && <p class="errm" role="alert">{error}</p>}
			{notice && <p class="mute">{notice}</p>}
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="verify" /><input type="hidden" name="email" value={verifyAddress} />
				<Field label="6-digit code" labelFor={"code"} input={{ "id": "code", "name": "code", "class": "inp code", "inputmode": "numeric", "autocomplete": "one-time-code", "required": true }}></Field>
				<p class="small"><button class="btn btn-g btn-sm" formaction="/account" formmethod="post" name="action" value="resend">Resend code</button> · <a href={back({ dialog: 'add' })}>Use a different email</a></p>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Later</a><button class="btn btn-p">Verify</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'remove' && focus && (
		<ConfirmDialog overlay={{ class: 'ov' }} dialog={{ class: 'dlg', role: 'dialog', 'aria-modal': 'true', 'aria-label': 'Remove email' }} openUrl={back({ dialog: 'remove', id: focus.id })} closeUrl="/account">
			<h2 class="h2">Remove {focus.email}?</h2>
			<p class="soft">You won’t be able to sign in with it. Anything sent to it moves to your primary email.</p>
			<form class="form" method="post" data-enhance data-optimistic="remove|close-sheet" data-optimistic-target={focus.id}>
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="remove" /><input type="hidden" name="id" value={focus.id} /><input type="hidden" name="confirm" value="yes" />
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account" autofocus>Cancel</a><button class="btn btn-p">Remove email</button></div>
			</form>
		</ConfirmDialog>
	)}
	{dialog === 'unlink-blocked' && focus && (
		<ArkDialog client:load label="Turn on password first" closeHref="/account">
			<h2 class="h2">Turn on password first</h2>
			<p class="soft">Google is the only way to sign in with {focus.email}. Turn on password sign-in for it, then unlink Google.</p>
			<a class="btn btn-s" href="/account">Close</a>
		</ArkDialog>
	)}
	{dialog === 'unlink' && focus && (
		<ArkDialog client:load label="Unlink Google" closeHref="/account">
			{error && !focus.password ? (
				<>
					<h2 class="h2">Turn on password first</h2>
					<p class="soft">{error}</p>
					<a class="btn btn-s" href="/account">Close</a>
				</>
			) : (
				<>
					<h2 class="h2">Unlink Google from {focus.email}?</h2>
					<p class="soft">You can still sign in with this email and your password.</p>
					<form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="unlink" /><input type="hidden" name="id" value={focus.id} />
						<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Unlink</button></div>
					</form>
				</>
			)}
		</ArkDialog>
	)}
	{dialog === 'password-on' && focus && (
		<ArkDialog client:load label="Turn on password" closeHref="/account">
			<h2 class="h2">Turn on password for {focus.email}</h2>
			{error && <p class="errm" role="alert">{error}</p>}
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="password-on" /><input type="hidden" name="id" value={focus.id} />
				<Field label="New password" labelFor={"new-pw"} hint="At least 10 characters" input={{ "id": "new-pw", "name": "password", "class": "inp", "type": "password", "autocomplete": "new-password", "required": true }}></Field>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Save password</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'password' && (
		<ArkDialog client:load label="Change password" closeHref="/account">
			<h2 class="h2">Change password</h2>
			{error && <p class="errm" role="alert">{error}</p>}
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="password" />
				<Field label="Current password" labelFor={"current"} input={{ "id": "current", "name": "current", "class": "inp", "type": "password", "autocomplete": "current-password", "required": true }}></Field>
				<Field label="New password" labelFor={"next"} hint="At least 10 characters" input={{ "id": "next", "name": "password", "class": "inp", "type": "password", "autocomplete": "new-password", "required": true }}></Field>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Save password</button></div>
			</form>
		</ArkDialog>
	)}
	{dialog === 'name' && (
		<ArkDialog client:load label="Your name" closeHref="/account">
			<h2 class="h2">Your name</h2>
			<p class="soft">Your own name, as the school sees it. To rename the family, use Rename on the Family section.</p>
			{error && <p class="errm" role="alert">{error}</p>}
			<form class="form" method="post" data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="name" />
				<Field label="Your name" labelFor={"name"} input={{ "id": "name", "name": "name", "class": "inp", "value": myName || '', "required": true, "autocomplete": "name" }}></Field>
				<div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/account">Cancel</a><button class="btn btn-p">Save</button></div>
			</form>
		</ArkDialog>
	)}
