---
import Badge from '../../ui/Badge.astro';
import Icon from '../../ui/Icon.astro';


import type { AccountView } from '../../../lib/pages/account.ts';
interface Props { view: AccountView }
const { emailOwner, csrf, back, emails, guardians, you, myName, familyName, routes, incoming, outgoing, verified, adminChoices, showAdminRoute, changed } = Astro.props.view;
const initials = (name: string, email: string) => (name || email).split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
const NOTIFY = [
	{ key: 'announcements', title: 'School announcements', hint: 'Messages from the office' },
	{ key: 'tours', title: 'Tours and events', hint: 'Confirmations and reminders' },
	{ key: 'admin', title: 'Admin alerts', hint: 'New prospects, time requests, staff invites' },
] as const;
const who = (name: string, email: string) => name ? `${name} (${email})` : email;
---
<div class="acct">
		<section class="panel" id="family">
			<div class="panel-h">
				<div class="panel-tt"><span class="panel-k">Family</span><h2 class="h2">{familyName || 'Name your family'}</h2></div>
				<a class="btn btn-s btn-sm" href={back({ dialog: 'family-name' })}>{familyName ? 'Rename' : 'Add name'}</a>
			</div>
			<ul class="plist guardians">
				{guardians.map((person) => {
					const mine = person.id === you?.id;
					const invited = person.emails.every((item) => !item.verified);
					return <li data-row={person.id}>
						<span class="av">{initials(person.name, person.emails[0]?.email || '')}</span>
						<span class="g-t"><span class="g-n"><strong>{person.name || person.emails[0]?.email}</strong>{mine && <span class="badge b-green">You</span>}{invited && <span class="badge b-gold">Invited</span>}</span><span class="mute">{person.emails.map((item) => item.email).join(', ')}</span></span>
						{!mine && <a class="btn btn-g btn-sm" href={back({ dialog: 'remove-guardian', id: person.id })}>Remove</a>}
					</li>;
				})}
				{incoming.map((request) => (
					<li class="g-req" data-row={request.id}>
						<span class="g-t">{request.initiatedBy === 'from'
							? <><strong>{request.fromName || request.fromEmail}</strong> <span class="mute">({request.fromEmail})</span> asked to join your family.</>
							: <><strong>{request.toName || request.toEmail}</strong> <span class="mute">({request.toEmail})</span> invited you to join their family. Your emails, children and tour requests would move into it.</>}</span>
						<form method="post" data-enhance><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="join-answer" /><input type="hidden" name="id" value={request.id} /><input type="hidden" name="answer" value="approve" /><button class="btn btn-p btn-sm" data-busy="Combining…">{request.initiatedBy === 'from' ? 'Approve' : 'Accept'}</button></form>
						<form method="post" data-enhance data-optimistic="remove" data-optimistic-target={request.id}><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="join-answer" /><input type="hidden" name="id" value={request.id} /><input type="hidden" name="answer" value="decline" /><button class="btn btn-g btn-sm">Decline</button></form>
					</li>
				))}
				{outgoing.map((request) => (
					<li class="g-req" data-row={request.id}>
						<span class="g-t mute">{request.initiatedBy === 'from' ? <>Waiting for <strong>{request.targetEmail}</strong> to approve your request to join their family.</> : <>Waiting for <strong>{request.targetEmail}</strong> to accept your invitation.</>}</span>
						<form method="post" data-enhance data-optimistic="remove" data-optimistic-target={request.id}><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="join-cancel" /><input type="hidden" name="id" value={request.id} /><button class="btn btn-g btn-sm">Cancel</button></form>
					</li>
				))}
			</ul>
			<div class="panel-f">
				<a class="btn btn-s btn-sm" href={back({ dialog: 'add-guardian' })}><Icon name="plus" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />Add a guardian</a>
				<span class="grow"></span>
				<a class="panel-f-link" href={back({ dialog: 'join' })}>Join another family</a>
			</div>
		</section>
		<section class="panel">
			<div class="panel-h">
				<div class="panel-tt"><span class="panel-k">You</span><h2 class="h2">{myName || 'Your name'}</h2></div>
				<a class="btn btn-s btn-sm" href={back({ dialog: 'name' })}>Edit your name</a>
			</div>
			<div class="sub-h"><span><strong>Your emails</strong><span class="mute">Sign in with any verified one. The primary email is the family’s main contact.</span></span><a class="btn btn-s btn-sm" href={back({ dialog: 'add' })}><Icon name="plus" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />Add email</a></div>
			<div class="em-list">
			{emails.map((item) => (
				<div class="em-row" data-row={item.id}>
					<div class="em-top">
						<div class="stack g4">
							<span class="h3 em-a">{item.email}</span>
							<div class="rowx" style="gap:6px">
								{item.primary && <Badge class="badge b-green">Primary</Badge>}
								{item.verified ? <Badge class="badge b-gray">Verified</Badge> : <Badge class="badge b-gold">Unverified</Badge>}
								{item.school && <Badge class="badge b-gray">School</Badge>}
							</div>
						</div>
						{!item.primary && (
							<div class="acts">
								{item.verified && <form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="primary" /><input type="hidden" name="id" value={item.id} /><button class="btn btn-s btn-sm">Make primary</button></form>}
								{item.verified ? <a class="btn btn-g btn-sm" href={back({ dialog: 'remove', id: item.id })}>Remove</a> : (
									<>
										<a class="btn btn-p btn-sm" href={back({ dialog: 'verify', email: item.email })}>Enter code</a>
										<form method="post" data-enhance data-optimistic="remove|close-sheet" data-optimistic-target={item.id}><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="remove" /><input type="hidden" name="confirm" value="yes" /><input type="hidden" name="id" value={item.id} /><button class="btn btn-g btn-sm">Remove</button></form>
									</>
								)}
							</div>
						)}
					</div>
					{item.verified ? (
						<div class="em-m">
							<p class="mth-k">Sign in with</p>
							<div class="mth">
								<span class="mth-n"><Icon name="lock" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Password</span>
								{item.password ? <Badge class="badge b-gray">On</Badge> : <span class="mute">Off</span>}
								<span class="grow"></span>
								{item.password ? (
									<form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="password-off" /><input type="hidden" name="id" value={item.id} /><button class="btn btn-g btn-sm">Turn off</button></form>
								) : (
									<a class="btn btn-s btn-sm" href={back({ dialog: 'password-on', id: item.id })}>Turn on</a>
								)}
							</div>
							<div class="mth">
								<span class="mth-n"><Icon name="google" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" />Google</span>
								{item.google ? <Badge class="badge b-green">Linked</Badge> : <span class="mute">Not linked</span>}
								<span class="grow"></span>
								{item.google ? <a class="btn btn-g btn-sm" href={back({ dialog: item.password ? 'unlink' : 'unlink-blocked', id: item.id })}>Unlink</a> : <a class="btn btn-s btn-sm" href={`/auth/google?link=${item.id}`} data-astro-reload>Link Google</a>}
							</div>
						</div>
					) : <p class="mute">Verify this email to sign in with it or get notifications.</p>}
				</div>
			))}
			</div>
			<div class="sub-h sub-h-row"><span><strong>Password</strong><span class="mute">Works with any of your emails that has password sign-in on.{changed && ` Last changed ${changed}.`}</span></span><a class="btn btn-s btn-sm" href={back({ dialog: 'password' })}>Change</a></div>
		</section>
		<section class="panel">
			<div class="panel-h"><div class="panel-tt"><h2 class="h2">Notifications</h2></div></div>
			<ul class="plist notify">
				{NOTIFY.filter((item) => item.key !== 'admin' || showAdminRoute).map((item) => {
					const route = routes[item.key];
					return <li>
						<span class="g-t"><strong>{item.title}</strong><span class="mute">{item.hint}</span></span>
						<span class="n-to">
							{route.custom ? <span class="n-who">{route.emails.map((email) => emailOwner.get(email) || email).join(', ')}</span> : <span class="n-who">{item.key === 'admin' ? 'Your emails' : 'Every guardian'} <span class="badge b-gray">Default</span></span>}
							<span class="mute n-emails" title={route.emails.join(', ')}>{route.emails.join(', ') || 'No verified email yet'}</span>
						</span>
						<a class="btn btn-s btn-sm" href={back({ dialog: 'notify', category: item.key })}>{route.custom ? 'Edit' : 'Edit default'}</a>
					</li>;
				})}
			</ul>
			<p class="panel-b mute panel-note n-foot">Security alerts, like a new sign-in or password change, always go to every verified email.</p>
		</section>
</div>
