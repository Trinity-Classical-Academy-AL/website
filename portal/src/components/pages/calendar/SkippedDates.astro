---
import { eventDate } from '@tca/school';

/** A repeating item's upcoming skipped dates: a quiet list, each with Restore (puts the date back). */
interface Props { csrf: string; seriesId: string; itemKey: string; dates: string[] }
const { csrf, seriesId, itemKey, dates } = Astro.props;
const short = (date: string) => eventDate(`${date}T17:00:00Z`, false).replace(/^(\w{3})\w*,/, '$1,');
---
{dates.length > 0 && <div class="skips">
	<h3 class="sh-k">Skipped {dates.length === 1 ? 'date' : `dates · ${dates.length}`}</h3>
	<ul class="skips-list">{dates.map((date) => (
		<li data-skipped-date={date}>
			<span class="skips-d">{short(date)}</span>
			<form method="post" data-enhance><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="restore-date" /><input type="hidden" name="seriesId" value={seriesId} /><input type="hidden" name="date" value={date} /><input type="hidden" name="item" value={itemKey} /><button class="skips-r" data-busy="Restoring…">Restore</button></form>
		</li>
	))}</ul>
</div>}
