---
import SheetFooter from '../../ui/SheetFooter.astro';
import SheetBody from '../../ui/SheetBody.astro';
import FileDrop from '../../ui/FileDrop.astro';
import SheetHeader from '../../ui/SheetHeader.astro';
import Sheet from '../../ui/Sheet.astro';
import ConfirmDialog from '../../ui/ConfirmDialog.astro';
import ChipGroup from '../../ui/ChipGroup.astro';
import Field from '../../ui/Field.astro';
import Check from '../../ui/Check.astro';

import type { DocumentsView } from '../../../lib/pages/documents.ts';
interface Props { view: DocumentsView }
const { csrf, error, families, editing, sheet, categories, grades } = Astro.props.view;
---
{(sheet === 'upload' || editing) && (
		<div><Sheet overlay={{ "class": "ov ov-side", "hidden": false }} dialog={{ "class": "ssheet", "role": "dialog", "aria-modal": "true", "aria-label": editing ? 'Edit document' : 'Upload document' }} openUrl={editing ? `/admin/documents?doc=${editing.id}` : '/admin/documents?sheet=upload'} closeUrl={"/admin/documents"}><form method="post" enctype="multipart/form-data" data-enhance data-optimistic="publish|close-sheet" data-optimistic-target={editing?.id}><SheetHeader closeHref="/admin/documents"><div class="sh-tt"><h2 class="h2">{editing ? 'Edit document' : 'Upload document'}</h2></div></SheetHeader><SheetBody>{error && <div class="alert alert-err" role="alert"><p class="at">{error}</p></div>}<input type="hidden" name="csrf" value={csrf} />{editing && <input type="hidden" name="id" value={editing.id} />}<Field label="File" hint="PDF, Word, JPG or PNG, up to 25 MB."><FileDrop id="file" name="file" accept="application/pdf,image/png,image/jpeg,.doc,.docx" current={editing?.fileName} /></Field><Field label="Title" labelFor={"title"} input={{ "id": "title", "name": "title", "class": "inp", "value": editing?.title ?? '' }}></Field><Field label="Category" labelFor={"category"}><select id="category" name="category" class="inp">{categories.map((category) => <option value={category} selected={editing?.category === category}>{category}</option>)}</select></Field><ChipGroup style="border:0;padding:0" legend="Audience" chips><Fragment slot="chips"><label class="chip"><input type="radio" name="audience" value="everyone" checked={!editing || editing.audience === 'everyone'} />Everyone</label><label class="chip"><input type="radio" name="audience" value="grade" checked={editing?.audience === 'grade'} />A grade</label><label class="chip"><input type="radio" name="audience" value="family" checked={editing?.audience === 'family'} />A family</label></Fragment></ChipGroup><Field label="Grade" labelFor={"grade"}><select id="grade" name="grade" class="inp"><option value="">Choose one</option>{grades.map((grade) => <option value={grade} selected={editing?.grade === grade}>{grade === 'K' ? 'Kindergarten' : `${grade}`}</option>)}</select></Field><Field label="Family" labelFor={"familyId"}><select id="familyId" name="familyId" class="inp"><option value="">Choose one</option>{families.slice(0, 200).map((row) => <option value={row.id}>{row.name || row.email}</option>)}</select></Field><Check><input type="checkbox" name="email" /><span>Email guardians that it’s available<span class="d">Otherwise it just shows as New in their Documents.</span></span></Check></SheetBody><SheetFooter>{editing && <a class="btn btn-gd" href={`/admin/documents?doc=${editing.id}&confirm=1`}>Delete</a>}<span class="grow"></span><a class="btn btn-s" href="/admin/documents">Cancel</a><button class="btn btn-s" name="publish" value="no">Save draft</button><button class="btn btn-p" name="publish" value="yes" data-busy="Saving…">Publish</button></SheetFooter></form><Fragment slot="after">{editing && <ConfirmDialog overlay={{ "class": "ov ov-top", "hidden": Astro.url.searchParams.get('confirm') !== '1' }} dialog={{ "class": "dlg", "role": "alertdialog" }} openUrl={`/admin/documents?doc=${editing.id}&confirm=1`} closeUrl={`/admin/documents?doc=${editing.id}`}><h2 class="h2">Delete this document?</h2><p class="soft">Families will no longer be able to download it.</p><form method="post" data-enhance data-optimistic="remove|close-sheet" data-optimistic-target={editing.id}><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="delete-doc" /><input type="hidden" name="id" value={editing.id} /><div class="acts"><a class="btn btn-s" href={`/admin/documents?doc=${editing.id}`}>Cancel</a><button class="btn btn-d">Delete</button></div></form></ConfirmDialog>}</Fragment></Sheet></div>
	)}
