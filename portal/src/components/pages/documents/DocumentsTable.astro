---
import TBox from '../../ui/TBox.astro';
import RowLink from '../../ui/RowLink.astro';
import GoCell from '../../ui/GoCell.astro';
import EmptyState from '../../ui/EmptyState.astro';
import Badge from '../../ui/Badge.astro';

import type { DocumentsView } from '../../../lib/pages/documents.ts';
interface Props { view: DocumentsView }
const { tab, docs } = Astro.props.view;
---
{tab === 'documents' && (docs.length === 0 ? <section class="card"><EmptyState><p class="h3">No documents yet</p><p class="mute">Upload handbooks, calendars and supply lists for everyone, or report cards and letters for one family.</p><a class="btn btn-p btn-sm" href="/admin/documents?sheet=upload">Upload document</a></EmptyState></section> : (
		<TBox><table class="t t-click"><thead><tr><th>Document</th><th>Audience</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>
			{docs.map((doc) => <RowLink data-row={doc.id} class:list={['rowlink', doc.id === Astro.url.searchParams.get('saved') && 'hl']}><td><strong>{doc.title}</strong><div class="sub">{doc.category}</div></td><td>{doc.audience === 'everyone' ? 'Everyone' : doc.audience === 'grade' ? doc.grade : 'A family'}</td><td>{doc.status === 'published' ? <Badge data-status class="badge b-green">Published</Badge> : <Badge data-status class="badge b-gray">Draft</Badge>}</td><td>{doc.updatedAt.slice(0, 10)}</td><GoCell link={{ "href": `/admin/documents?doc=${doc.id}`, "aria-label": "Edit" }}>Edit</GoCell></RowLink>)}
		</tbody></table></TBox>
	))}
