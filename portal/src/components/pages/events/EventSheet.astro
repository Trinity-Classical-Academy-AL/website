---
import SheetFooter from '../../ui/SheetFooter.astro';
import SheetBody from '../../ui/SheetBody.astro';
import SheetHeader from '../../ui/SheetHeader.astro';
import Sheet from '../../ui/Sheet.astro';
import ConfirmDialog from '../../ui/ConfirmDialog.astro';
import Field from '../../ui/Field.astro';
import Check from '../../ui/Check.astro';

import { isoToChicagoInput, formatChicago } from '@tca/school';
import type { EventsView } from '../../../lib/pages/events.ts';
interface Props { view: EventsView }
const { csrf, error, fields, editing, guests, adding } = Astro.props.view;
---
{(adding || editing) && (
		<div><Sheet overlay={{ "class": "ov ov-side", "hidden": false }} dialog={{ "class": "ssheet", "role": "dialog", "aria-modal": "true", "aria-label": editing ? 'Edit event' : 'New event' }} openUrl={editing ? `/admin/events?event=${editing.id}` : '/admin/events?sheet=new'} closeUrl={"/admin/events"}><form method="post" enctype="multipart/form-data" data-enhance data-optimistic="close-sheet"><SheetHeader closeHref="/admin/events"><div class="sh-tt"><h2 class="h2">{editing ? 'Edit event' : 'New event'}</h2></div></SheetHeader><SheetBody>{error && <div class="alert alert-err" role="alert"><p class="at">{error}</p></div>}<input type="hidden" name="csrf" value={csrf} />{editing && <input type="hidden" name="id" value={editing.id} />}<Field label="Title" labelFor={"title"} input={{ "id": "title", "name": "title", "class:list": ['inp', fields.title && 'bad'], "value": editing?.title ?? '' }} error={fields.title}></Field><div class="f2"><Field label="Date" labelFor={"date"} input={{ "id": "date", "name": "date", "class:list": ['inp', fields.date && 'bad'], "placeholder": "MM/DD/YYYY", "value": editing ? isoToChicagoInput(editing.startsAt).slice(0, 10) : '' }}></Field><Field label="Start" labelFor={"start"} input={{ "id": "start", "name": "start", "class": "inp", "placeholder": "7:00 PM", "value": editing ? isoToChicagoInput(editing.startsAt).slice(11) : '' }}></Field><Field label="End" labelFor={"end"} input={{ "id": "end", "name": "end", "class:list": ['inp', fields.end && 'bad'], "placeholder": "8:30 PM", "value": editing?.endsAt ? isoToChicagoInput(editing.endsAt).slice(11) : '' }} error={fields.end}></Field></div><Field label="Location" labelFor={"location"} input={{ "id": "location", "name": "location", "class": "inp", "value": editing?.location ?? '' }}></Field><Field label="Description" labelFor={"description"}><textarea id="description" name="description" class="inp" rows="3">{editing?.description ?? ''}</textarea></Field><Field label="Image or flyer (optional)" hint="JPG, PNG, WebP or PDF, up to 10 MB." input={{ "name": "flyer", "type": "file", "accept": "image/png,image/jpeg,image/webp,application/pdf" }}></Field><Check><input type="checkbox" name="website" checked={editing?.showOnWebsite} /><span>Show on website<span class="d">Listed on trinityclassical.academy events.</span></span></Check><Check><input type="checkbox" name="popup" checked={editing?.featurePopup} /><span>Feature as website popup<span class="d">Shows in the banner flyer popup. Replaces the current one.</span></span></Check><Check><input type="checkbox" name="rsvp" checked={editing?.collectRsvp} /><span>Collect RSVPs<span class="d">Adds an RSVP button.</span></span></Check><Field label="RSVP link" labelFor={"rsvpUrl"} hint="Leave blank to use the public portal RSVP form. Or enter another form link." input={{ "id": "rsvpUrl", "name": "rsvpUrl", "class:list": ['inp', fields.rsvp && 'bad'], "value": editing?.rsvpUrl ?? '' }} error={fields.rsvp}></Field>{editing && <section class="card"><h3 class="h3">RSVPs</h3><p class="small">Totals include account and guest (legacy) responses.</p><a class="btn btn-s btn-sm" href={`/admin/event-guests-export?id=${editing.id}`}>Export RSVP CSV</a>{guests.length ? <ul>{guests.map((guest) => <li><strong>{guest.name}</strong> · {guest.email} · {guest.type}<p>{guest.headCount} attending · {formatChicago(new Date(guest.updatedAt).toISOString())}</p>{guest.note && <p>{guest.note}</p>}</li>)}</ul> : <p class="soft">No responses yet.</p>}</section>}</SheetBody><SheetFooter>{editing && <a class="btn btn-gd" href={`/admin/events?event=${editing.id}&confirm=1`}>Delete event</a>}<span class="grow"></span><a class="btn btn-s" href="/admin/events">Cancel</a><button class="btn btn-p" data-busy="Saving…">Save</button></SheetFooter></form><Fragment slot="after">{editing && <ConfirmDialog overlay={{ "class": "ov ov-top", "hidden": Astro.url.searchParams.get('confirm') !== '1' }} dialog={{ "class": "dlg", "role": "alertdialog", "aria-label": "Delete event" }} openUrl={`/admin/events?event=${editing.id}&confirm=1`} closeUrl={`/admin/events?event=${editing.id}`}><h2 class="h2">Delete {editing.title}?</h2><p class="soft">It comes off the website and the popup, and the banner goes back to text only. Families who RSVP’d get a cancellation email.</p><form method="post" data-enhance data-optimistic="remove|close-sheet" data-optimistic-target={editing.id}><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={editing.id} /><div class="acts"><a class="btn btn-s" href={`/admin/events?event=${editing.id}`}>Cancel</a><button class="btn btn-d">Delete event</button></div></form></ConfirmDialog>}</Fragment></Sheet></div>
	)}
