---
import DataTable from '../../ui/DataTable.astro';
import Row from '../../ui/Row.astro';
import EmptyState from '../../ui/EmptyState.astro';

import { formatChicago } from '@tca/school';
import type { EventsView } from '../../../lib/pages/events.ts';
interface Props { view: EventsView }
const { totals, events, saved } = Astro.props.view;
---
{events.length === 0 ? <section class="card"><EmptyState><p class="h3">No upcoming events</p><p class="mute">Add open houses, info nights and school events. Choose which show on the website.</p><a class="btn btn-p btn-sm" href="/admin/events?sheet=new">New event</a></EmptyState></section> : (
		<DataTable columns={['Event', 'Date', 'Location', 'Shown', 'RSVPs']}>
			{events.map((event) => <Row href={`/admin/events?event=${event.id}`} data-row={event.id} class:list={[event.id === saved?.id && 'hl']}><td class="trunc"><strong>{event.title}</strong></td><td>{formatChicago(event.startsAt)}</td><td class="trunc">{event.location || '—'}</td><td>{event.showOnWebsite ? 'On website' : 'Families only'}{event.featurePopup ? ' · Website popup' : ''}</td><td>{totals.find((row) => row.id === event.id)?.heads || 0} people · {totals.find((row) => row.id === event.id)?.responses || 0} responses</td></Row>)}
		</DataTable>
	)}
