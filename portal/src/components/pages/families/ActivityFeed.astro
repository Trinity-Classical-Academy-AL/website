---
import { incomingDate } from '@tca/school';
import type { FeedItem } from '../../../lib/pages/families.ts';
/**
 * One notes-and-activity log for a family: staff notes, contact history from every
 * inquiry, merges and join requests. New notes append in place (append-note).
 * `familyId` writes family notes; without it, notes go on the inquiry `inquiryId`.
 */
interface Props { items: FeedItem[]; csrf: string; by: string; familyId?: string; inquiryId?: string }
const { items, csrf, by, familyId, inquiryId } = Astro.props;
---
<ul class="feed" data-note-feed>{items.map((item) => <li><p class="feed-h"><strong>{item.label}</strong><span class="mute">{item.by ? `${item.by} · ` : ''}{incomingDate(item.at)}</span></p>{item.note && <p>{item.note}</p>}</li>)}</ul>
{items.length === 0 && <p class="mute" data-note-empty>No notes yet.</p>}
{(familyId || inquiryId) && <form class="sh-note-f" method="post" data-enhance data-optimistic="append-note" data-note-by={by} data-success="Note added.">
	<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="note" />
	{familyId ? <input type="hidden" name="family" value={familyId} /> : <input type="hidden" name="id" value={inquiryId} />}
	<textarea class="inp" name="note" rows="3" maxlength="2000" required aria-label="Add a note" placeholder="Add a note"></textarea>
	<button class="btn btn-s btn-sm">Add note</button>
</form>}
