---
import TBox from '../../ui/TBox.astro';
import RowLink from '../../ui/RowLink.astro';
import GoCell from '../../ui/GoCell.astro';
import EmptyState from '../../ui/EmptyState.astro';
import Icon from '../../ui/Icon.astro';

import type { FamiliesView } from '../../../lib/pages/families.ts';
interface Props { view: FamiliesView }
const { visible } = Astro.props.view;
---
{visible.length === 0 ? <EmptyState><p class="h3">No enrolled families yet</p></EmptyState> : (
		<TBox><table class="t t-click"><thead><tr><th>Family</th><th>Students</th><th>Enrolled</th><th></th></tr></thead><tbody>
			{visible.map((row) => <RowLink data-search-row={`${row.name} ${row.email} ${row.students}`}><td><strong>{row.name}</strong><div class="sub"><a href={`mailto:${row.email}`}>{row.email}</a></div><a class="btn btn-s btn-sm" href={`mailto:${row.email}`}>Email</a></td><td>{row.students}</td><td>{row.enrolled}</td><GoCell link={{ "href": `/admin/families/${row.id}`, "aria-label": "Open" }} chevron></GoCell></RowLink>)}
		</tbody></table></TBox>
	)}
