---
import SheetFooter from '../../ui/SheetFooter.astro';
import SheetBody from '../../ui/SheetBody.astro';
import SheetHeader from '../../ui/SheetHeader.astro';
import Sheet from '../../ui/Sheet.astro';
import Field from '../../ui/Field.astro';

import type { FamilyView } from '../../../lib/pages/family.ts';
interface Props { view: FamilyView }
const { subject, csrf, error, sheet, emails } = Astro.props.view;
---
{sheet === 'guardian' && (
		<div><Sheet overlay={{ "class": "ov ov-side", "hidden": false }} dialog={{ "class": "ssheet", "role": "dialog", "aria-modal": "true", "aria-label": "Add guardian" }} openUrl={`/admin/families/${subject.id}?sheet=guardian`} closeUrl={`/admin/families/${subject.id}`}><form method="post" data-enhance data-optimistic="close-sheet"><SheetHeader closeHref={`/admin/families/${subject.id}`}><div class="sh-tt"><h2 class="h2">Add guardian</h2></div></SheetHeader><SheetBody>{error && <p class="alert alert-err">{error}</p>}{emails.map(row=><p><a href={`mailto:${row.email}`}>{row.email}</a> <a class="btn btn-s btn-sm" href={`mailto:${row.email}`}>Email</a></p>)}<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="guardian" /><Field label="Name" labelFor={"label"} input={{ "id": "label", "name": "label", "class": "inp" }}></Field><Field label="Email" labelFor={"gemail"} input={{ "id": "gemail", "name": "email", "class": "inp", "type": "email" }}></Field></SheetBody><SheetFooter><span class="grow"></span><a class="btn btn-s" href={`/admin/families/${subject.id}`}>Cancel</a><button class="btn btn-p">Add guardian</button></SheetFooter></form></Sheet></div>
	)}
