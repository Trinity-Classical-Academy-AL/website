---
import SheetFooter from '../../ui/SheetFooter.astro';
import SheetBody from '../../ui/SheetBody.astro';
import SheetHeader from '../../ui/SheetHeader.astro';
import Sheet from '../../ui/Sheet.astro';
import Field from '../../ui/Field.astro';

import type { FamilyView } from '../../../lib/pages/family.ts';
interface Props { view: FamilyView }
const { subject, csrf, error, grades, sheet, editing, editFirst, editRest } = Astro.props.view;
---
{(sheet === 'student' || editing || (error && sheet !== 'guardian')) && (
		<div><Sheet overlay={{ "class": "ov ov-side", "hidden": false }} dialog={{ "class": "ssheet", "role": "dialog", "aria-modal": "true", "aria-label": editing ? 'Edit student' : 'Add student' }} openUrl={editing ? `/admin/families/${subject.id}?student=${editing.id}` : `/admin/families/${subject.id}?sheet=student`} closeUrl={`/admin/families/${subject.id}`}><form method="post" data-enhance data-optimistic="close-sheet"><SheetHeader closeHref={`/admin/families/${subject.id}`}><div class="sh-tt"><h2 class="h2">{editing ? 'Edit student' : 'Add student'}</h2><p class="mute">{subject.name}</p></div></SheetHeader><SheetBody>{error && <p class="alert alert-err" role="alert">{error}</p>}<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="student" />{editing && <input type="hidden" name="id" value={editing.id} />}<div class="f2"><Field label="First name" labelFor={"first"} input={{ "id": "first", "name": "first", "class": "inp", "value": editFirst || '' }}></Field><Field label="Last name" labelFor={"last"} input={{ "id": "last", "name": "last", "class": "inp", "value": editRest.join(' ') }}></Field></div><Field label="Grade" labelFor={"grade"}><select id="grade" name="grade" class="inp"><option value="">Choose one</option>{grades.map((grade) => <option value={grade} selected={editing?.grade === grade}>{grade === 'K' ? 'Kindergarten' : `${grade}`}</option>)}</select></Field><Field label="Teacher (optional)" labelFor={"teacher"} input={{ "id": "teacher", "name": "teacher", "class": "inp", "value": editing?.teacher ?? '' }}></Field></SheetBody><SheetFooter>{editing && <button class="btn btn-gd" form="remove-student" data-submit-action="remove-student" type="submit">Remove</button>}<span class="grow"></span><a class="btn btn-s" href={`/admin/families/${subject.id}`}>Cancel</a><button class="btn btn-p" data-busy="Saving…">Save</button></SheetFooter></form>{editing && <form data-action-form="remove-student" id="remove-student" method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="remove-student" /><input type="hidden" name="id" value={editing.id} /></form>}</Sheet></div>
	)}
