---
import EmptyState from '../../ui/EmptyState.astro';
import type { Message, Thread } from '@tca/school';

/**
 * Conversations about students: the list on the left, the open conversation on
 * the right with a reply box. Families and students pick which teacher a
 * message is for; teachers can also write to a whole class.
 */
interface Props {
	base: string; csrf: string; threads: Thread[]; me: string; mode: 'family' | 'staff' | 'student';
	open: { childId: string; childName: string; messages: Message[]; teachers: { email: string; name: string; role: string }[] } | null;
	startable: { id: string; name: string }[];
	classes?: { id: string; name: string }[];
}
const { base, csrf, threads, open, startable, me, mode, classes = [] } = Astro.props;
const familySide = mode !== 'staff';
const when = (iso: string) => {
	const date = new Date(iso);
	const sameDay = date.toDateString() === new Date().toDateString();
	return new Intl.DateTimeFormat('en-US', sameDay ? { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' } : { month: 'short', day: 'numeric', timeZone: 'America/Chicago' }).format(date);
};
const mine = (msg: Message) => mode === 'staff' ? msg.authorEmail === me : mode === 'student' ? msg.fromStudent : msg.fromFamily;
const note = (msg: Message) => msg.toClass ? `To all ${msg.toClass} families` : msg.toName ? `To ${msg.toName}` : '';
---
<div class="inbox">
	<aside class="inbox-list">
		{mode !== 'student' && startable.length > 0 && <form class="inbox-new" method="get" action={base}><select class="inp" name="child" aria-label="Start a conversation about">{startable.map((kid) => <option value={kid.id}>{kid.name}</option>)}</select><button class="btn btn-s btn-sm">New</button></form>}
		{classes.length > 0 && <a class="inbox-class" href={`${base}?compose=class`}>Write to a whole class</a>}
		{threads.length === 0 ? <p class="mute inbox-empty">No messages yet.</p> : <ul>{threads.map((thread) => (
			<li><a class:list={['inbox-row', open?.childId === thread.childId && 'on', thread.unread && 'unread']} href={`${base}?child=${thread.childId}`}>
				<span class="inbox-top"><strong>{thread.childName}</strong><span class="mute">{when(thread.lastAt)}</span></span>
				{mode === 'staff' && <span class="mute inbox-fam">{thread.familyName}</span>}
				<span class="inbox-prev">{thread.lastBody}</span>
			</a></li>
		))}</ul>}
	</aside>
	<section class="inbox-main">
		{Astro.url.searchParams.get('compose') === 'class' && classes.length > 0 ? (
			<form method="post" data-enhance class="inbox-compose">
				<header class="inbox-head"><strong>Write to a whole class</strong></header>
				<div class="inbox-compose-b">
					<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="class" />
					<label class="field"><span class="lbl">Class</span><select class="inp" name="classId">{classes.map((row) => <option value={row.id}>{row.name}</option>)}</select></label>
					<label class="field"><span class="lbl">Message</span><textarea class="inp" name="body" rows="8" required placeholder="Please send a coat tomorrow; we’re walking to the library."></textarea></label>
					<p class="mute small">Each family gets it by email and in their student’s conversation, so replies come back to you privately.</p>
				</div>
				<div class="inbox-reply"><span class="grow"></span><a class="btn btn-s btn-sm" href={base}>Cancel</a><button class="btn btn-p btn-sm" data-busy="Sending…">Send to the class</button></div>
			</form>
		) : !open ? <EmptyState><p class="h3">{familySide ? 'Write to your child’s teacher' : 'Pick a conversation'}</p><p class="mute">{familySide ? 'Replies come back here and by email.' : 'Messages from families arrive here and by email.'}</p></EmptyState> : (
			<>
				<header class="inbox-head"><strong>{open.childName}</strong><span class="mute">{mode === 'staff' ? 'With the family' : 'With the school'}</span></header>
				<div class="inbox-msgs">{open.messages.length === 0 ? <p class="mute inbox-empty">Start the conversation below.</p> : open.messages.map((msg) => (
					<article class:list={['msg', mine(msg) && 'mine']}>
						<span class="msg-who"><strong>{msg.authorName}</strong>{note(msg) && <span class="mute">{note(msg)}</span>}<span class="mute">{when(msg.createdAt)}</span></span>
						<p class="msg-body">{msg.body}</p>
					</article>
				))}</div>
				<form method="post" data-enhance class="inbox-reply">
					<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="post" /><input type="hidden" name="childId" value={open.childId} />
					<div class="inbox-write">
						{familySide && open.teachers.length > 1 && <label class="inbox-to"><span class="mute small">To</span><select class="inp" name="to">{open.teachers.map((teacher) => <option value={teacher.email}>{teacher.name}{teacher.role ? ` · ${teacher.role}` : ''}</option>)}</select></label>}
						<textarea class="inp" name="body" rows="3" required placeholder="Write a message…" aria-label="Message"></textarea>
					</div>
					<button class="btn btn-p btn-sm" data-busy="Sending…">Send</button>
				</form>
			</>
		)}
	</section>
</div>
