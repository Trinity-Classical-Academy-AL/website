---
import ContactEmail from './ContactEmail.astro';
import Sheet from '../../ui/Sheet.astro';
import SheetHeader from '../../ui/SheetHeader.astro';
import SheetBody from '../../ui/SheetBody.astro';
import SheetFooter from '../../ui/SheetFooter.astro';
import Field from '../../ui/Field.astro';
import {incomingDate,incomingDetailsText,inquiryDetailsText} from '@tca/school';
import type {IncomingView} from '../../../lib/pages/prospects.ts';
interface Props {view:IncomingView}
const {selected:row,csrf,activity,error,closeUrl,href,contactedLabel}=Astro.props.view;
const source=row?.externalSource==='formaloo'?'Formaloo':row?.externalSource==='netlify-forms'?'Website':row?.source;
const details=row?.externalSource ? incomingDetailsText(row.details) : row ? inquiryDetailsText(row.details as any) : '';
---
{row&&<Sheet openUrl={href({contact:row.id})} closeUrl={closeUrl} dialog={{role:'dialog','aria-modal':'true','aria-label':'Contact details'}}>
 <SheetHeader closeHref={closeUrl}><h2 class="h2">{row.name || row.email}</h2></SheetHeader>
 <SheetBody>
  {error&&<p class="alert alert-err" role="alert">{error}</p>}
  <p><ContactEmail id={row.id} email={row.email} csrf={csrf} label={contactedLabel}/><br />{row.phone}</p>
  <p class="soft">{row.contactType} · {incomingDate(row.createdAt)} · <span class="badge b-gray">{row.status}</span></p>
  <p>{row.externalSource==='formaloo'?<a href="https://trinity-classicalalabama.formaloo.me/tqo8fo" target="_blank" rel="noopener noreferrer">Formaloo</a>:source}</p>
  {row.priorYear&&<span class="badge b-gray">Prior year</span>}{row.alreadyFamily&&<span class="badge b-gray">Already a family</span>}
  {row.message&&<p>{row.message}</p>}<pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit">{details}</pre>
  <h3 class="h3">Activity</h3>
  {activity.length ? <ul>{activity.map(item=><li><span class="soft">{incomingDate(item.at)} · {item.by} · {item.kind}</span><p>{item.note}</p></li>)}</ul> : <p class="mute">No activity yet.</p>}
  <form method="post" data-enhance data-optimistic="close-sheet" data-success="Note added.">
   <input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="action" value="note"/><input type="hidden" name="id" value={row.id}/>
   <label class="field"><span class="lbl">Note</span><textarea class="inp" name="note" rows="3" maxlength="2000" required></textarea></label><button class="btn btn-s btn-sm">Add note</button>
  </form>
 </SheetBody>
 <SheetFooter>
  <form method="post" data-enhance data-optimistic="status:contacted|contacted|close-sheet" data-optimistic-target={row.id} data-contacted-label={contactedLabel} data-success="Marked contacted.">
   <input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="action" value="contacted"/><input type="hidden" name="id" value={row.id}/><button class="btn btn-p btn-sm">Mark contacted</button>
  </form>
  <ContactEmail id={row.id} email={row.email} csrf={csrf} label={contactedLabel} pill/>
 </SheetFooter>
</Sheet>}
