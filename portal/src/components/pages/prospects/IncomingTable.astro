---
import ContactEmail from './ContactEmail.astro';
import TBox from '../../ui/TBox.astro';
import RowLink from '../../ui/RowLink.astro';
import GoCell from '../../ui/GoCell.astro';
import EmptyState from '../../ui/EmptyState.astro';
import { CONTACT_TYPES,incomingDate } from '@tca/school';
import type {IncomingView} from '../../../lib/pages/prospects.ts';
interface Props {view:IncomingView}
const {visible,filter,type,prior,href,csrf,contactedLabel}=Astro.props.view;
---
<form class="chips" method="get" data-incoming-filters aria-label="Filter incoming contacts">
 <input type="hidden" name="q" value={Astro.url.searchParams.get('q') || ''}/><input type="hidden" name="type" value=""/>
 <label class="chip"><input type="radio" name="filter" value="" checked={!filter&&!type}/>All active</label>
 <label class="chip"><input type="radio" name="filter" value="new" checked={filter==='new'}/>New</label>
 <label class="chip"><input type="radio" name="filter" value="overdue" checked={filter==='overdue'}/>Not contacted 14+ days</label>
 {CONTACT_TYPES.map(value=><label class="chip"><input type="radio" name="filter" value={value} checked={type===value}/>{value[0].toUpperCase()+value.slice(1)}</label>)}
 <label class="chip"><input type="checkbox" name="prior" value="1" checked={prior}/>Show prior year</label>
</form>
{visible.length===0 ? <EmptyState><p class="h3">No incoming contacts</p><p class="mute">New contacts from the website and Formaloo show here.</p></EmptyState> : <TBox><table class="t t-click"><thead><tr><th>Name</th><th>Type</th><th>Received</th><th>Status</th><th>Contacted</th><th></th></tr></thead><tbody>
 {visible.map(row=><RowLink data-row={row.id} data-search-row={`${row.name} ${row.email}`}>
  <td><strong>{row.name || row.email || '—'}</strong><div class="sub"><ContactEmail id={row.id} email={row.email} csrf={csrf} label={contactedLabel}/></div><ContactEmail id={row.id} email={row.email} csrf={csrf} label={contactedLabel} pill/>{row.alreadyFamily&&<span class="badge b-gray">Already a family</span>}{row.priorYear&&<span class="badge b-gray">Prior year</span>}</td>
  <td><span class="badge b-gray">{row.contactType}</span></td><td>{incomingDate(row.createdAt)}</td>
  <td><span class:list={['badge',row.status==='contacted'?'b-green':'b-gray']} data-status>{row.status}</span></td>
  <td data-contacted>{row.contactedAt ? `${row.contactedBy || 'Staff'} · ${incomingDate(row.contactedAt)}` : 'Not yet'}</td>
  <GoCell link={{href:href({contact:row.id}),'aria-label':'Open'}} chevron />
 </RowLink>)}
</tbody></table></TBox>}

<script>
 document.addEventListener('change',event=>{
  if(event.target instanceof HTMLInputElement && event.target.closest('form[data-incoming-filters]'))event.target.form?.requestSubmit();
 });
</script>
