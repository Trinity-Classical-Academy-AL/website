---
import EmptyState from '../../ui/EmptyState.astro';
import DataTable from '../../ui/DataTable.astro';
import Row from '../../ui/Row.astro';
import type { StaffView } from '../../../lib/pages/staff.ts';
interface Props { view: StaffView }
const { family, staff, seen } = Astro.props.view;
---
{staff.length === 0 ? <EmptyState><p class="h3">No staff yet</p></EmptyState> : <DataTable columns={['Name', 'Email', 'Last sign-in', '']}>
				{staff.map((person) => (
					<Row>
						<td><strong>{person.name || person.email}</strong></td>
						<td><a href={`mailto:${person.email}`}>{person.email}</a></td>
						<td>{seen(person.lastSignInAt)}</td>
						<td class="end">{person.id !== family.id && <a class="btn btn-g btn-sm" href={`/admin/staff?remove=${person.id}`}>Remove access</a>}</td>
					</Row>
				))}
	</DataTable>}
