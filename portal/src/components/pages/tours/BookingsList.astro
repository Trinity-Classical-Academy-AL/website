---
import DataTable from '../../ui/DataTable.astro';
import Row from '../../ui/Row.astro';
import EmptyState from '../../ui/EmptyState.astro';

import { shortDate } from '../../../lib/fields.ts';
import { chicagoToday, formatChicago, slotTypeLabel } from '@tca/school';
import type { ToursView } from '../../../lib/pages/tours.ts';
interface Props { view: ToursView }
const { tab, slots, query, whenFilter, groups } = Astro.props.view;
---
{tab === 'bookings' && (
		<>
			<form class="tools" method="get" data-local-search={!query ? true : undefined}>
				<input type="hidden" name="tab" value="bookings" />
				<select class="inp inp-auto" name="when" aria-label="Time" onchange="this.form.requestSubmit()">
					<option value="">All upcoming</option>
					{slots.filter(slot => slot.date >= chicagoToday()).map((slot) => <option value={slot.id} selected={whenFilter === slot.id}>{shortDate(slot.date)}</option>)}
				</select>
				<input class="inp" name="q" value={query} placeholder="Search family or note" aria-label="Search" />
			</form>
			{groups.size === 0 ? <EmptyState><p class="h3">No bookings</p><p class="mute">Confirmed visits show here, grouped by time.</p></EmptyState> : [...groups.entries()].map(([key, group]) => {
				const slot = slots.find((item) => item.id === key);
				const people = group.reduce((sum, row) => sum + row.headCount, 0);
				return (
					<section data-search-group class="stack g8" style="margin-bottom:20px">
						<h2 class="h3">{slot ? `${slotTypeLabel(slot.type)} · ${shortDate(slot.date)}` : group[0].when} <span class="mute">{slot?.capacityUnit === 'families' ? `${group.length} of ${slot.capacity} ${slot.capacity === 1 ? 'family' : 'families'}` : `${people} of ${slot?.capacity ?? people} people`}</span></h2>
						<DataTable pageKey={`page-${key}`} columns={['Family', 'Email', 'People', 'Note', 'Booked']}>
							{group.map((row) => (
								<Row data-search-row={`${row.familyName} ${row.email} ${row.note}`}>
									<td><strong>{row.familyName || '—'}</strong></td>
									<td><a href={`mailto:${row.email}`}>{row.email}</a></td>
									<td>{row.headCount}</td>
									<td class="trunc" title={row.note || undefined}>{row.note || 'None'}</td>
									<td>{formatChicago(row.createdAt, false)}</td>
								</Row>
							))}
						</DataTable>
					</section>
				);
			})}
			<EmptyState data-search-empty hidden><p class="h3">No bookings match your search</p></EmptyState>
		</>
	)}
