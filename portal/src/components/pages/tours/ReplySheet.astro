---
import SheetFooter from '../../ui/SheetFooter.astro';
import SheetBody from '../../ui/SheetBody.astro';
import SheetHeader from '../../ui/SheetHeader.astro';
import Sheet from '../../ui/Sheet.astro';
import ChipGroup from '../../ui/ChipGroup.astro';
import Field from '../../ui/Field.astro';
import Icon from '../../ui/Icon.astro';

import { TOUR_STATUSES, formatChicago } from '@tca/school';
import type { ToursView } from '../../../lib/pages/tours.ts';
interface Props { view: ToursView }
const { csrf, error, fields, draft, replying } = Astro.props.view;
---
{replying && (
		<div>
			<Sheet overlay={{ "class": "ov ov-side", "hidden": false }} dialog={{ "class": "ssheet", "role": "dialog", "aria-modal": "true", "aria-label": "Reply to request" }} openUrl={`/admin/tours?tab=requests&reply=${replying.id}`} closeUrl={"/admin/tours?tab=requests"}>
				
					<SheetHeader closeHref="/admin/tours?tab=requests"><div class="sh-tt"><h2 class="h2">Reply to request</h2><p class="mute">{replying.familyName} · {replying.email} · Requested {formatChicago(replying.createdAt, false)}</p></div></SheetHeader>
					<form method="post" data-enhance data-optimistic="close-sheet">
						<SheetBody>
							{error && <div class="alert alert-err" role="alert"><p class="at">{error}</p></div>}
							<p class="soft">{replying.familyName} asked for {replying.otherTime || 'another time'}. {replying.headCount} {replying.headCount === 1 ? 'person' : 'people'}.{replying.note ? ` “${replying.note}”` : ''}</p>
							<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="reply" /><input type="hidden" name="tab" value="requests" /><input type="hidden" name="id" value={replying.id} />
							<Field label="Date" labelFor={"rdate"} input={{ "id": "rdate", "name": "date", "class:list": ['inp', fields.date && 'bad'], "placeholder": "MM/DD/YYYY", "value": draft.date }} error={fields.date}></Field>
							<Field label="Time" labelFor={"rtime"}><input id="rtime" name="start" class="inp" placeholder="9:00 AM" value={draft.start} /><input name="end" class:list={['inp', fields.end && 'bad']} placeholder="10:00 AM" value={draft.end} aria-label="End" />{fields.end && <p class="errm"><span>{fields.end}</span></p>}</Field>
							<ChipGroup class="field field-reset" legend="Send as" chips><Fragment slot="chips"><label class="chip"><input type="radio" name="mode" value={TOUR_STATUSES.CONFIRMED} checked={draft.mode !== TOUR_STATUSES.PROPOSED} />Confirmed visit</label><label class="chip"><input type="radio" name="mode" value={TOUR_STATUSES.PROPOSED} checked={draft.mode === TOUR_STATUSES.PROPOSED} />Proposed time (family accepts)</label></Fragment></ChipGroup>
							<Field label="Message to family (optional)" labelFor={"message"}><textarea id="message" name="message" class="inp" rows="3">{draft.message}</textarea></Field>
						</SheetBody>
						<SheetFooter>
							<button class="btn btn-gd" form="decline-form" data-submit-action="decline-form" type="submit">Decline</button>
							<span class="grow"></span>
							<a class="btn btn-s" href="/admin/tours?tab=requests">Cancel</a>
							<button class="btn btn-p" data-busy="Sending…">Send</button>
						</SheetFooter>
					</form>
					<form data-action-form="decline-form" id="decline-form" method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="decline" /><input type="hidden" name="id" value={replying.id} /></form>
				</Sheet>
		</div>
	)}
