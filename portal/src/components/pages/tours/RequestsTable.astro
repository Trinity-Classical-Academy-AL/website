---
import DataTable from '../../ui/DataTable.astro';
import Row from '../../ui/Row.astro';
import EmptyState from '../../ui/EmptyState.astro';

import { formatChicago } from '@tca/school';
import type { ToursView } from '../../../lib/pages/tours.ts';
interface Props { view: ToursView }
const { tab, requests } = Astro.props.view;
---
{tab === 'requests' && (requests.length === 0 ? <EmptyState><p class="h3">No time requests</p><p class="mute">Requests for times outside the published schedule show here.</p></EmptyState> : (
		<DataTable columns={['Family', 'Email', 'Requested', 'Preferred', 'People', 'Note']}>
			{requests.map((row) => (
				<Row href={`/admin/tours?tab=requests&reply=${row.id}`}>
					<td><strong>{row.familyName || '—'}</strong></td>
					<td>{row.email}</td>
					<td>{formatChicago(row.createdAt, false)}</td>
					<td class="trunc" title={row.otherTime || undefined}>{row.otherTime || '—'}</td>
					<td>{row.headCount} {row.headCount === 1 ? 'person' : 'people'}</td>
					<td class="trunc" title={row.note || undefined}>{row.note || 'None'}</td>
				</Row>
			))}
		</DataTable>
	))}
