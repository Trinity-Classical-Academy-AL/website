---
import TBox from '../../ui/TBox.astro';
import RowLink from '../../ui/RowLink.astro';
import GoCell from '../../ui/GoCell.astro';
import EmptyState from '../../ui/EmptyState.astro';
import Icon from '../../ui/Icon.astro';

import { formatChicago } from '@tca/school';
import type { ToursView } from '../../../lib/pages/tours.ts';
interface Props { view: ToursView }
const { tab, requests } = Astro.props.view;
---
{tab === 'requests' && (requests.length === 0 ? <EmptyState><p class="h3">No time requests</p><p class="mute">Requests for times outside the published schedule show here.</p></EmptyState> : (
		<TBox><table class="t t-click"><thead><tr><th scope="col">Family</th><th scope="col">Requested</th><th scope="col">Preferred</th><th scope="col">People</th><th scope="col">Note</th><th scope="col" aria-label="Open"></th></tr></thead><tbody>
			{requests.map((row) => (
				<RowLink>
					<td><strong>{row.familyName || '—'}</strong><div class="sub">{row.email}</div></td>
					<td>{formatChicago(row.createdAt, false)}</td>
					<td>{row.otherTime || '—'}</td>
					<td>{row.headCount} {row.headCount === 1 ? 'person' : 'people'}</td>
					<td>{row.note || 'None'}</td>
					<GoCell link={{ "href": `/admin/tours?tab=requests&reply=${row.id}`, "aria-label": "Reply" }} chevron></GoCell>
				</RowLink>
			))}
		</tbody></table></TBox>
	))}
