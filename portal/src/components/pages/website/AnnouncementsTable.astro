---
import DataTable from '../../ui/DataTable.astro';
import Row from '../../ui/Row.astro';
import EmptyState from '../../ui/EmptyState.astro';
import Badge from '../../ui/Badge.astro';

import { audienceText } from '@tca/school';

import type { WebsiteView } from '../../../lib/pages/website.ts';
interface Props { view: WebsiteView }
const { tab, announcements } = Astro.props.view;
---
{tab === 'announcements' && (announcements.length === 0 ? (
		<section class="card"><EmptyState><p class="h3">No announcements yet</p><p class="mute">Published notes show in the family portal and can be emailed.</p></EmptyState></section>
	) : (
		<DataTable columns={['Title', 'Audience', 'Sent', 'Status']}>
			{announcements.map((row) => (
				<Row href={`/admin/website?tab=announcements&edit=${row.id}`} data-row={row.id} class:list={[row.id === Astro.url.searchParams.get('saved') && 'hl']}>
					<td class="trunc"><strong>{row.title}</strong></td>
					<td>{audienceText(row.audience)}</td>
					<td>{row.sentAt ? row.sentAt.slice(0, 10) : 'Not sent'}</td>
					<td>{row.status === 'draft' ? <Badge data-status class="badge b-gray">Draft</Badge> : <Badge data-status class="badge b-green">Sent</Badge>}</td>
				</Row>
			))}
		</DataTable>
	))}
