---
import Field from '../../ui/Field.astro';
import Badge from '../../ui/Badge.astro';

import { formatUsDate } from '../../../lib/fields.ts';

import { type Banner } from '../../../../../src/lib/admissions/banner.ts';

import type { WebsiteView } from '../../../lib/pages/website.ts';
interface Props { view: WebsiteView }
const { csrf, tab, banner, errors, errorSummary, flyerError, live, previewBadge, featured } = Astro.props.view;
import Icon from '../../ui/Icon.astro';
import { eventWhen } from '@tca/school';
const ic = { 'aria-hidden': 'true', width: '16', height: '16', viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.75', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
// The saved flyer, from an admin-only route (works while the banner is off). ?v busts the cache after a replace.
const flyerPdf = banner.flyer?.contentType === 'application/pdf';
const flyerImage = banner.flyer && !flyerPdf ? `/admin/website/flyer?v=${encodeURIComponent(banner.flyer.key)}` : undefined;
const err = (key: string) => (errors as Record<string, string>)[key] ?? '';
const hhmm = (value: string) => /^\d{2}:\d{2}$/.test(value) ? value : '';
const iso = (value: string) => /^\d{4}-\d{2}-\d{2}$/.test(value) ? value : '';
---
{tab === 'banner' && (
	<>
		{featured && <div class="wb-notice"><Icon name="calendar" {...ic} /><span><strong>{featured.title}</strong> is in the banner right now, from the calendar ({eventWhen(featured.startsAt)}). This banner shows again after it ends.</span><a class="btn btn-s btn-sm" href={`/admin/calendar/event-${featured.id}`}>Open event</a><form method="post" data-enhance><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="unfeature" /><input type="hidden" name="id" value={featured.id} /><button class="btn btn-p btn-sm" data-confirm={`Take ${featured.title} out of the website banner? This banner shows instead.`} data-confirm-yes="Take it out">Take it out of the banner</button></form></div>}
		<div class="two bn wb">
			<form class="card wb-form" method="post" enctype="multipart/form-data" id="banner-form" data-banner-node="banner-form" data-banner-form data-enhance data-optimistic="close-sheet">
				<input type="hidden" name="csrf" value={csrf} />
				{errorSummary && <div class="alert alert-err wb-alert" role="alert"><p class="at">{errorSummary}</p></div>}
				<section class="wb-sec">
					<div class="wb-head"><h2 class="wb-h">Banner</h2><label class="wb-switch"><span>Show on the website</span><input class="sw" type="checkbox" name="enabled" role="switch" aria-label="Show banner on the website" checked={banner.enabled} /></label></div>
					<label class="field"><span class="lbl">Text</span>
						<span class="wb-count-wrap"><input id="text" data-banner-node="text" name="text" class:list={['inp', errors.text && 'bad']} value={banner.text} maxlength="160" placeholder="Join us for our Spring Open House" aria-invalid={errors.text ? 'true' : undefined} aria-describedby="text-count" /><span id="text-count" data-banner-node="text-count" class:list={['cnt-ch', 'wb-count', (errors.text || banner.text.length > 120) && 'bad']}>{banner.text.length} / 120</span></span>
						{errors.text && <p class="errm"><span>{errors.text}</span></p>}
					</label>
					<div class="f2">
						<label class="field"><span class="lbl">Show from</span><input id="startsOn" data-banner-node="startsOn" name="startsOn" type="date" class:list={['inp', errors.startsOn && 'bad']} value={iso(banner.startsOn)} />{errors.startsOn && <p class="errm"><span>{errors.startsOn}</span></p>}</label>
						<label class="field"><span class="lbl">Until</span><input id="endsOn" data-banner-node="endsOn" name="endsOn" type="date" class:list={['inp', errors.endsOn && 'bad']} value={iso(banner.endsOn)} aria-invalid={errors.endsOn ? 'true' : undefined} />{errors.endsOn && <p class="errm"><span>{errors.endsOn}</span></p>}</label>
					</div>
				</section>
				<section class="wb-sec">
					<h2 class="wb-h">When clicked</h2>
					<div class="type-pick type-pick-2" role="radiogroup" aria-label="When someone clicks the banner">
						<label class="type-opt"><input type="radio" name="clickAction" value="flyer" checked={banner.clickAction !== 'url'} /><Icon name="document" {...ic} />Open the flyer popup</label>
						<label class="type-opt"><input type="radio" name="clickAction" value="url" checked={banner.clickAction === 'url'} /><Icon name="external" {...ic} />Go to a link</label>
					</div>
					<label class="field" data-banner-link hidden={banner.clickAction !== 'url'}><span class="lbl">Link</span><input id="url" data-banner-node="url" name="url" class:list={['inp', errors.url && 'bad']} value={banner.url} placeholder="https://" />{errors.url && <p class="errm"><span>{errors.url}</span></p>}</label>
				</section>
				<section class="wb-sec" data-banner-popup hidden={banner.clickAction === 'url'}>
					<h2 class="wb-h">Popup</h2>
					<div class="field"><span class="lbl">Flyer</span>
						{/* One flyer box: empty (drop or choose), a file (thumbnail, Preview, Replace, Remove), or removed (Undo until Save). */}
						<div class="wb-fly" data-fly data-state={banner.flyer ? 'file' : 'empty'}>
							<button type="button" class="wb-fly-drop" data-fly-pick>
								<span class="wb-fly-drop-ic"><Icon name="plus" {...ic} /></span>
								<span class="wb-fly-drop-t"><strong>Drop a flyer here, or choose a file</strong><span class="mute">JPG, PNG, WebP or PDF · up to 10 MB</span></span>
							</button>
							<div class="wb-fly-card">
								<span class="wb-fly-thumb">
									<img data-fly-img alt="" src={flyerImage} hidden={!flyerImage} />
									<span class="wb-fly-pdf" data-fly-pdf hidden={!flyerPdf}><Icon name="document" {...ic} />PDF</span>
								</span>
								<div class="wb-fly-meta">
									<strong data-fly-name>{banner.flyer?.name ?? ''}</strong>
									<span class="mute" data-fly-size>{banner.flyer ? `${Math.max(1, Math.round(banner.flyer.size / 1024))} KB` : ''}</span>
									<span class="wb-fly-acts">
										<button type="button" class="btn btn-s btn-sm" data-fly-pick>Replace</button>
										<button type="button" class="btn btn-g btn-sm" data-fly-remove>Remove</button>
									</span>
								</div>
							</div>
							<p class="wb-fly-undo"><span>The flyer is removed when you save.</span><button type="button" class="btn btn-g btn-sm" data-fly-restore>Undo</button></p>
						</div>
						<input data-banner-node="flyer" name="flyer" type="file" accept="image/png,image/jpeg,image/webp,application/pdf" hidden />
						<input type="checkbox" name="removeFlyer" value="yes" data-banner-node="removeFlyer" hidden />
						<p class="errm" data-banner-node="flyer-error" hidden><span></span></p>
						{flyerError && <p class="errm"><span>{flyerError}</span></p>}
					</div>
					<label class="field"><span class="lbl">Title</span><input id="title" data-banner-node="title" name="title" class="inp" value={banner.modal.title} placeholder="Spring Open House" /></label>
					<div class="f2">
						<label class="field"><span class="lbl">Date</span><input id="date" data-banner-node="date" name="date" type="date" class:list={['inp', err('modal.date') && 'bad']} value={iso(banner.modal.date)} />{err('modal.date') && <p class="errm"><span>{err('modal.date')}</span></p>}</label>
						<label class="field"><span class="lbl">Time</span><input id="time" data-banner-node="time" name="time" type="time" class:list={['inp', err('modal.time') && 'bad']} value={hhmm(banner.modal.time)} />{err('modal.time') && <p class="errm"><span>{err('modal.time')}</span></p>}</label>
					</div>
					<label class="field"><span class="lbl">Where</span><input id="location" data-banner-node="location" name="location" class="inp" value={banner.modal.location} placeholder="Trinity campus" /></label>
					<label class="field"><span class="lbl">Description</span><textarea id="description" data-banner-node="description" name="description" class="inp" rows="3">{banner.modal.description}</textarea></label>
					<div class="wb-btns">
						<span class="lbl">Buttons</span>
						<div class="wb-btn-row"><input id="rsvpLabel" data-banner-node="rsvpLabel" name="rsvpLabel" class="inp" value={banner.modal.rsvpLabel || 'RSVP'} aria-label="Primary button" /><input id="rsvpUrl" data-banner-node="rsvpUrl" name="rsvpUrl" class="inp" value={banner.modal.rsvpUrl} placeholder="Link" aria-label="Primary button link" /></div>
						<div class="wb-btn-row"><input id="secondaryLabel" data-banner-node="secondaryLabel" name="secondaryLabel" class="inp" value={banner.modal.secondaryLabel} placeholder="Second button (optional)" aria-label="Secondary button" /><input id="secondaryUrl" data-banner-node="secondaryUrl" name="secondaryUrl" class="inp" value={banner.modal.secondaryUrl} placeholder="Link" aria-label="Secondary button link" /></div>
						{['modal.rsvpUrl', 'modal.secondaryUrl'].map((key) => err(key) && <p class="errm"><span>{err(key)}</span></p>)}
					</div>
				</section>
				<div class="wb-bar">
					<a class="btn btn-g btn-sm" href="/admin/website">Discard changes</a>
					<button class="btn btn-p btn-sm" id="banner-save" data-banner-node="banner-save" data-busy="Saving…">Save</button>
				</div>
			</form>
			<section class="wb-pv pv-col">
				<div class="wb-pv-h"><h2 class="wb-h">Preview</h2><Badge id="pv-badge" data-banner-node="pv-badge" class:list={['badge', previewBadge === 'Live' ? 'b-green' : 'b-gray']}>{previewBadge}</Badge></div>
				<div class="wb-site">
					<div id="pv" data-banner-node="pv" class:list={['pv', !live && 'off']}>
						<div class="pv-bar" data-fly-open role="button" tabindex="0" title="Click to open the popup, as visitors see it"><span class="tx" id="pv-text" data-banner-node="pv-text">{banner.text || 'Your banner text appears here'}</span><span class="fl" id="pv-cue" data-banner-node="pv-cue">{banner.clickAction === 'url' ? 'Learn more' : 'View details'}</span></div>
					</div>
					<div class="wb-site-body" aria-hidden="true"><span></span><span></span><span></span></div>
				</div>
				<p class="mute wb-pv-note" id="pv-note" data-banner-node="pv-note">{banner.clickAction === 'url' ? 'Clicking goes to the link.' : 'Click the banner to open the popup.'}</p>
				<div class="pmock sm" id="popup-preview" data-banner-node="popup-preview" data-banner-popup hidden={banner.clickAction === 'url'}>
					<div class="pm-top"><div class="pm-fly" data-fly-pv><img alt="" src={flyerImage} hidden={!flyerImage} /><span class="wb-fly-pdf" hidden={!flyerPdf}><Icon name="document" {...ic} />PDF</span><div class="fthumb" aria-hidden="true" hidden={!!banner.flyer}><span class="ft-t">Flyer</span></div></div><div class="pm-h"><p class="pm-k">Upcoming event</p><p class="pm-t" id="pv-title" data-banner-node="pv-title">{banner.modal.title || 'Event title'}</p></div></div>
					<p class="mute" id="pv-where" data-banner-node="pv-where">{banner.modal.location}</p>
					<p class="pm-d" id="pv-desc" data-banner-node="pv-desc">{banner.modal.description}</p>
					<div class="pm-a"><span class="pm-btn p" id="pv-rsvp" data-banner-node="pv-rsvp">{banner.modal.rsvpLabel || 'RSVP'}</span>{banner.modal.secondaryLabel && <span class="pm-btn s" id="pv-second" data-banner-node="pv-second">{banner.modal.secondaryLabel}</span>}</div>
				</div>
				{/* Full-size popup as visitors see it: the flyer (image, or the PDF itself) beside the details. */}
				<dialog class="fly-dlg" data-fly-dlg aria-label="Popup preview">
					<button type="button" class="fly-dlg-x" data-fly-close aria-label="Close preview"><Icon name="close" {...ic} /></button>
					<div class="fly-dlg-b">
						<div class="fly-dlg-media" data-fly-media></div>
						<div class="fly-dlg-t">
							<p class="pm-k">Upcoming event</p>
							<h2 class="fly-dlg-h" data-fly-dtitle></h2>
							<p class="mute" data-fly-dwhen></p>
							<p class="fly-dlg-d" data-fly-ddesc></p>
							<div class="pm-a" data-fly-dbtns></div>
						</div>
					</div>
				</dialog>
			</section>
		</div>
	</>
)}
