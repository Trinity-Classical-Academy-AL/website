---
import { htmlAttributes } from './attributes';
import type { HTMLAttributes } from 'astro/types';
import { dialogAttributes } from '../../lib/dialogs';
interface Props {
 overlay?: HTMLAttributes<'div'>;
 dialog?: HTMLAttributes<'div'>;
 openUrl: string;
 closeUrl: string;
}
const { overlay = {}, dialog = {}, openUrl, closeUrl } = Astro.props;
const { class: overlayClass = 'ov ov-top', hidden, ...overlayAttributes } = overlay;
const { class: dialogClass = 'dlg', ...dialogProps } = dialog;
const state = dialogAttributes(Astro.url, { openUrl, closeUrl, hidden: hidden === undefined ? undefined : Boolean(hidden) });
---
<div class={overlayClass} {...htmlAttributes(overlayAttributes)} {...state}><div class={dialogClass} {...htmlAttributes(dialogProps)}><slot /></div></div>
