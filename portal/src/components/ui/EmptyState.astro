---
import { htmlAttributes } from './attributes';
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'div'> & { as?: 'div' | 'p' };
const { as: Tag = 'div', class: className = 'empty', ...attributes } = Astro.props;
---
<Tag class={className} {...htmlAttributes(attributes)}><slot /></Tag>
