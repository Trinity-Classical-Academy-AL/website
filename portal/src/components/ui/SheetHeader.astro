---
import Icon from './Icon.astro';
interface Props { closeHref: string; closeIcon?: boolean }
const { closeHref, closeIcon = false } = Astro.props;
---
<div class="sh-h"><slot /><a class="sh-ic" href={closeHref} aria-label="Close">{closeIcon ? <Icon name="close" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" /> : '×'}</a></div>
