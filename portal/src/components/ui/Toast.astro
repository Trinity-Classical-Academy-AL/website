---
import { htmlAttributes } from './attributes';
import type { HTMLAttributes } from 'astro/types';
/**
 * Confirmation after a page action. Pass just the message. On load the script
 * moves it into the one toast stack (top right), shared with instant toasts from
 * scripts/interactions.ts, and dismisses it after a few seconds.
 */
type Props = HTMLAttributes<'div'> & { tone?: 'ok' | 'err' };
const { tone = 'ok', class: className, ...attributes } = Astro.props;
---
<div class:list={['toast', `t-${tone}`, className]} data-toast role={tone === 'err' ? 'alert' : 'status'} {...htmlAttributes(attributes)}><span class="toast-msg"><slot /></span></div>
