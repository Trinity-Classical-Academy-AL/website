---
import { cssHref } from '../lib/assets';
import FontHead from '../components/FontHead.astro';
interface Props { title: string }
const { title } = Astro.props;
const content = await Astro.slots.render('default');
const mobileContent = (content ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<FontHead />
		<link rel="stylesheet" href={cssHref('app.css')} />
		<link rel="stylesheet" href={cssHref('responsive.css')} />
	</head>
	<body>
		<div class="shell-d">
			<div class="root">
				<div class="auth">
					<aside class="auth-brand">
						<img src="/assets/img/emblem-cream.svg" alt="" />
						<p class="k">Trinity Classical Academy</p>
						<h2>Family Portal</h2>
						<p>Book a tour, RSVP for events and ask us questions.</p>
						<a href="https://trinityclassical.academy" target="_blank" rel="noopener">Back to trinityclassical.academy</a>
					</aside>
					<main class="auth-main"><div set:html={content} /></main>
				</div>
			</div>
		</div>
		<div class="shell-m">
			<div class="root m">
				<div class="mauth">
					<header class="mauth-top"><img src="/assets/img/emblem-green.svg" alt="" /><span class="h3" style="flex:1">Trinity Classical Academy</span><a class="small" href="https://trinityclassical.academy" target="_blank" rel="noopener">Main site</a></header>
					<div class="mauth-main" set:html={mobileContent} />
				</div>
			</div>
		</div>
		<div class="interaction-toasts" data-interaction-toasts aria-live="polite" aria-atomic="true"></div>
		<script>import '../scripts/interactions';</script>
	</body>
</html>
