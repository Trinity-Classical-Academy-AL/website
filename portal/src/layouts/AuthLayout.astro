---
interface Props { title: string; heading: string; lede: string }
const { title, heading, lede } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
		<link rel="stylesheet" href="/src/styles.css" />
	</head>
	<body class="min-h-screen bg-cream/50 font-sans text-ink antialiased">
		<main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-10">
			<div class="w-full rounded-card border border-ink/10 bg-white p-8 shadow-sm">
				<p class="font-mono text-[10px] uppercase tracking-eyebrow text-forest">Trinity Classical Academy</p>
				<h1 class="mt-3 font-display text-4xl italic">{heading}</h1>
				<p class="mt-3 text-sm leading-relaxed text-ink-soft">{lede}</p>
				<div class="mt-6"><slot /></div>
			</div>
		</main>
	</body>
</html>
