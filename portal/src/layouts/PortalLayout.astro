---
import Icon from '../components/ui/Icon.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import { cssHref } from '../lib/assets';
import { emailOpensAdmin, type PortalRole } from '@tca/school';
import { csrfToken } from '../lib/security.ts';
import FontHead from '../components/FontHead.astro';
import AccountMenu from '../components/AccountMenu.astro';
import MobileMenu from '../components/MobileMenu.astro';

interface Props {
	title: string;
	current: string;
	roles: PortalRole[];
	name: string;
	email: string;
}
const { title, current, roles, name, email } = Astro.props;
const content = await Astro.slots.render('default');
const overlay = await Astro.slots.render('overlay');
const mobileContent = (content ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
const mobileOverlay = (overlay ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
const on = (href: string) => (current === href ? 'on' : undefined);
const initials = name.split(' ').filter(Boolean).map((part) => part[0]).join('').slice(0, 2).toUpperCase() || 'TCA';
// The page's roles come from middleware: the household's stage (prospect or
// guardian) plus this person's access (staff, admin, developer).
const live = (Astro.locals.roles?.length ? Astro.locals.roles : roles) as string[];
const guardian = live.includes('guardian');
// A 7th or 8th grader signed in with their own sign-in: just their page.
const student = live.includes('student');
const sessionEmail = Astro.locals.sessionEmail || email;
const admin = live.includes('admin');
const staff = live.includes('staff');
const developer = live.includes('developer');
const showAdmin = admin && emailOpensAdmin(sessionEmail);
const adminHint = admin && !showAdmin;
const applying = Astro.locals.access?.applying ?? false;
type NavItem = { href: string; label: string; icon: string };
// Sidebar: Family for everyone (its pages follow the household's stage), then Staff and Admin as the person has them.
const sections: { key: string; label: string; items: NavItem[] }[] = [
	{ key: 'family', label: 'Family', items: student ? [{ href: '/s', label: 'My classes', icon: 'student' }] : guardian ? [
		{ href: '/g', label: 'Home', icon: 'home' }, { href: '/g/students', label: 'Students', icon: 'student' }, { href: '/g/calendar', label: 'Calendar', icon: 'calendar' },
		{ href: '/g/announcements', label: 'Announcements', icon: 'announcement' }, { href: '/g/messages', label: 'Messages', icon: 'message' }, { href: '/g/documents', label: 'Documents', icon: 'document-lines' }, { href: '/g/forms', label: 'To do', icon: 'edit' },
		...(applying ? [{ href: '/applications', label: 'Apply', icon: 'application' }] : []),
	] : [
		{ href: '/home', label: 'Home', icon: 'home' }, { href: '/tour', label: 'Request a tour', icon: 'map-pin' }, { href: '/events', label: 'Events', icon: 'star' }, { href: '/applications', label: 'Apply', icon: 'application' },
	] },
	...(staff ? [{ key: 'staff', label: 'Staff', items: [{ href: '/staff', label: 'Students', icon: 'families' }, { href: '/staff/attendance', label: 'Attendance', icon: 'check' }, { href: '/staff/classes', label: 'Classes', icon: 'document-lines' }, { href: '/staff/report-cards', label: 'Report cards', icon: 'document' }, { href: '/staff/messages', label: 'Messages', icon: 'message' }] }] : []),
	...(showAdmin ? [{ key: 'admin', label: 'Admin', items: [
		{ href: '/admin', label: 'Overview', icon: 'overview' }, { href: '/admin/families', label: 'Families', icon: 'families' }, { href: '/admin/applications', label: 'Applications', icon: 'application' },
		{ href: '/admin/reenrollment', label: 'Re-enrollment', icon: 'student' }, { href: '/admin/classes', label: 'Classes', icon: 'document-lines' }, ...(staff ? [] : [{ href: '/staff/report-cards', label: 'Report cards', icon: 'document' }, { href: '/staff/messages', label: 'Messages', icon: 'message' }]), { href: '/admin/calendar', label: 'Calendar', icon: 'calendar' }, { href: '/admin/announcements', label: 'Announcements', icon: 'announcement' }, { href: '/admin/website', label: 'Website', icon: 'globe' },
		{ href: '/admin/documents', label: 'Documents & forms', icon: 'document' }, { href: '/admin/staff', label: 'Staff & access', icon: 'lock' },
	] }] : []),
];
const headings = sections.length > 1;
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
// Sidebar collapsed to icons, remembered per browser (set by portal-shell.ts).
const sideCollapsed = Astro.cookies.get('side')?.value === 'collapsed';
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<title>{title}</title>
		<FontHead />
		<link rel="stylesheet" href={cssHref('portal.css')} />
		<link rel="stylesheet" href={cssHref('responsive.css')} />
	</head>
	<body>
		<div class:list={['portal-shell', sideCollapsed && 'side-collapsed']} data-portal-current={current}>
		<div class="shell-d">
			<div class="root">
				<div class="app">
					<aside class="side" transition:persist={`portal-sidebar-${sessionEmail}-${name}-${csrf}-${roles.join('-')}-${cssHref('portal.css')}`} data-portal-sidebar>
						<div class="brand"><img src="/assets/img/emblem-green.svg" alt="" /><div class="brand-x"><p class="brand-t">TCA Portal</p><p class="brand-s">Trinity Classical Academy</p></div></div>
						<nav class="nav" aria-label="Main">
							{sections.map((section) => <>
								{headings && <p class="nav-g">{section.label}</p>}
								{section.items.map((item) => <a data-astro-prefetch="tap" href={item.href} class={on(item.href)} aria-current={current === item.href ? 'page' : undefined} title={item.label}><Icon name={item.icon as any} aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />{item.label}</a>)}
							</>)}
						</nav>
						{adminHint && <p class="side-note">To use Admin, sign in with your school email.</p>}
						{developer && <a class:list={['side-dev', current.startsWith('/developer') && 'on']} href="/developer" data-astro-prefetch="tap" title="Developer console"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m7 8-4 4 4 4" /><path d="m17 8 4 4-4 4" /><path d="m14 4-4 16" /></svg><span>Developer console</span></a>}
						<div class="side-collapse"><button type="button" class="side-toggle" data-side-toggle aria-label="Collapse sidebar" title="Collapse sidebar"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path d="m15 10-2 2 2 2" class="side-toggle-a"/></svg><span class="side-toggle-l">Collapse sidebar</span></button></div>
						<div class="side-foot">
							<AccountMenu name={name || sessionEmail} email={sessionEmail} initials={initials} csrf={csrf} showAdmin={showAdmin} adminHint={adminHint} />
						</div>
					</aside>
					<main class="main portal-main"><div class="awrap" set:html={content} /></main>
					<Fragment set:html={overlay} />
				</div>
			</div>
		</div>
		<div class="shell-m" id="shell-m">
			<div class="root m">
				<div class="mapp">
					<MobileMenu initials={initials} name={name || sessionEmail} email={sessionEmail} csrf={csrf} showAdmin={showAdmin}>
					<nav class="nav mmenu" id="mmenu" aria-label="Main">
						{sections.map((section) => <>
							{headings && <p class="nav-g">{section.label}</p>}
							{section.items.map((item) => <a data-astro-prefetch="tap" href={item.href}>{item.label}</a>)}
						</>)}
						{developer && <a data-astro-prefetch="tap" href="/developer">Developer console</a>}
						{adminHint && <p class="side-note">To use Admin, sign in with your school email.</p>}
						<div class="nav-sep"></div>
						{!student && <a data-astro-prefetch="tap" href="/account"><Icon name="settings" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Settings</a>}
						<a href="https://trinityclassical.academy" target="_blank" rel="noopener">trinityclassical.academy</a>
						<form method="post" action="/sign-out"><input type="hidden" name="csrf" value={csrf} /><button class="nav-btn" type="submit"><Icon name="sign-out" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Sign out</button></form>
						{showAdmin && <p class="mute" style="padding:16px 12px 0"><span class="badge b-green">Admin</span></p>}
					</nav>
					</MobileMenu>
					<main class="mwrap"><div class="awrap" set:html={mobileContent} /></main>
					<Fragment set:html={mobileOverlay} />
				</div>
			</div>
		</div>
		</div>
		<template data-page-skeleton><Skeleton /></template>
		<template data-sheet-skeleton><div class="ov ov-side" data-loading-sheet><div class="ssheet" aria-busy="true"><div class="sh-h"><span class="skeleton-shape" style="width:180px;height:24px"></span></div><div class="sh-b"><Skeleton kind="sheet" /></div></div></div></template>
		<div class="interaction-toasts" data-interaction-toasts aria-live="polite" aria-atomic="true"></div>
		<script>
			import '../scripts/portal-shell.ts';
			import '../scripts/interactions';
		</script>
	</body>
</html>
