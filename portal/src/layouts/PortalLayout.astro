---
import Icon from '../components/ui/Icon.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import { cssHref } from '../lib/assets';
import { emailOpensAdmin, type PortalRole } from '@tca/school';
import { csrfToken } from '../lib/security.ts';
import FontHead from '../components/FontHead.astro';
import AccountMenu from '../components/AccountMenu.astro';
import MobileMenu from '../components/MobileMenu.astro';

interface Props {
	title: string;
	current: string;
	roles: PortalRole[];
	name: string;
	email: string;
}
const { title, current, roles, name, email } = Astro.props;
const content = await Astro.slots.render('default');
const overlay = await Astro.slots.render('overlay');
const mobileContent = (content ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
const mobileOverlay = (overlay ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
const on = (href: string) => (current === href ? 'on' : undefined);
const initials = name.split(' ').filter(Boolean).map((part) => part[0]).join('').slice(0, 2).toUpperCase() || 'TCA';
const prospect = roles.includes('prospect') && !roles.includes('guardian');
const guardian = roles.includes('guardian');
const sessionEmail = Astro.locals.sessionEmail || email;
const admin = roles.includes('admin');
const showAdmin = admin && emailOpensAdmin(sessionEmail);
const adminHint = admin && !showAdmin;
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
// Sidebar collapsed to icons, remembered per browser (set by portal-shell.ts).
const sideCollapsed = Astro.cookies.get('side')?.value === 'collapsed';
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<title>{title}</title>
		<FontHead />
		<link rel="stylesheet" href={cssHref('portal.css')} />
		<link rel="stylesheet" href={cssHref('responsive.css')} />
	</head>
	<body>
		<div class:list={['portal-shell', sideCollapsed && 'side-collapsed']} data-portal-current={current}>
		<div class="shell-d">
			<div class="root">
				<div class="app">
					<aside class="side" transition:persist={`portal-sidebar-${sessionEmail}-${name}-${csrf}-${roles.join('-')}`} data-portal-sidebar>
						<div class="brand"><img src="/assets/img/emblem-green.svg" alt="" /><div class="brand-x"><p class="brand-t">TCA Portal</p><p class="brand-s">Trinity Classical Academy</p></div></div>
						<nav class="nav" aria-label="Main">
							{prospect && (
								<>
									<a data-astro-prefetch="tap" href="/home" class={on('/home')} aria-current={current === '/home' ? 'page' : undefined} title="Home"><Icon name="home" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Home</a>
									<a data-astro-prefetch="tap" href="/tour" class={on('/tour')} title="Request a tour"><Icon name="map-pin" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Request a tour</a>
									<a data-astro-prefetch="tap" href="/events" class={on('/events')} title="Events"><Icon name="star" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Events</a>
								</>
							)}
							{guardian && showAdmin && <p class="nav-g">Family</p>}
							{guardian && (
								<>
									<a data-astro-prefetch="tap" href="/g" class={on('/g')} title="Home"><Icon name="home" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Home</a>
									<a data-astro-prefetch="tap" href="/g/students" class={on('/g/students')} title="Students"><Icon name="student" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Students</a>
									<a data-astro-prefetch="tap" href="/g/calendar" class={on('/g/calendar')} title="Calendar"><Icon name="calendar" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Calendar</a>
									<a data-astro-prefetch="tap" href="/g/announcements" class={on('/g/announcements')} title="Announcements"><Icon name="announcement" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Announcements</a>
									<a data-astro-prefetch="tap" href="/g/documents" class={on('/g/documents')} title="Documents"><Icon name="document-lines" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Documents</a>
									<a data-astro-prefetch="tap" href="/g/forms" class={on('/g/forms')} title="Forms"><Icon name="edit" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Forms</a>
								</>
							)}
							{showAdmin && <p class="nav-g">Admin</p>}
							{showAdmin && (
								<>
									<a data-astro-prefetch="tap" href="/admin" class={on('/admin')} title="Overview"><Icon name="overview" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Overview</a>
									<a data-astro-prefetch="tap" href="/admin/families" class={on('/admin/families')} title="Families"><Icon name="families" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Families</a>
									<a data-astro-prefetch="tap" href="/admin/applications" class={on('/admin/applications')} title="Applications"><Icon name="edit" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Applications</a>
									<a data-astro-prefetch="tap" href="/admin/tours" class={on('/admin/tours')} title="Tours & scheduling"><Icon name="clock" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Tours & scheduling</a>
									<a data-astro-prefetch="tap" href="/admin/events" class={on('/admin/events')} title="Events"><Icon name="calendar" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Events</a>
									<a data-astro-prefetch="tap" href="/admin/website" class={on('/admin/website')} title="Website"><Icon name="globe" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Website</a>
									<a data-astro-prefetch="tap" href="/admin/documents" class={on('/admin/documents')} title="Documents & forms"><Icon name="document" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Documents & forms</a>
									<a data-astro-prefetch="tap" href="/admin/staff" class={on('/admin/staff')} title="Staff"><Icon name="lock" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Staff</a>
								</>
							)}
						</nav>
						{adminHint && <p class="side-note">To use Admin, sign in with your school email.</p>}
						<div class="side-collapse"><button type="button" class="side-toggle" data-side-toggle aria-label="Collapse sidebar" title="Collapse sidebar"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path d="m15 10-2 2 2 2" class="side-toggle-a"/></svg><span class="side-toggle-l">Collapse sidebar</span></button></div>
						<div class="side-foot">
							<AccountMenu name={name || sessionEmail} email={sessionEmail} initials={initials} csrf={csrf} showAdmin={showAdmin} adminHint={adminHint} />
						</div>
					</aside>
					<main class="main portal-main"><div class="awrap" set:html={content} /></main>
					<Fragment set:html={overlay} />
				</div>
			</div>
		</div>
		<div class="shell-m" id="shell-m">
			<div class="root m">
				<div class="mapp">
					<MobileMenu initials={initials} name={name || sessionEmail} email={sessionEmail} csrf={csrf} showAdmin={showAdmin}>
					<nav class="nav mmenu" id="mmenu" aria-label="Main">
						{prospect && <a data-astro-prefetch="tap" href="/home"><Icon name="home" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Home</a>}
						{prospect && <a data-astro-prefetch="tap" href="/tour"><Icon name="map-pin" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Request a tour</a>}
						{prospect && <a data-astro-prefetch="tap" href="/events">Events</a>}
						{guardian && showAdmin && <p class="nav-g">Family</p>}
						{guardian && <a data-astro-prefetch="tap" href="/g">Home</a>}
						{guardian && <a data-astro-prefetch="tap" href="/g/students">Students</a>}
						{guardian && <a data-astro-prefetch="tap" href="/g/calendar">Calendar</a>}
						{guardian && <a data-astro-prefetch="tap" href="/g/announcements">Announcements</a>}
						{guardian && <a data-astro-prefetch="tap" href="/g/documents">Documents</a>}
						{guardian && <a data-astro-prefetch="tap" href="/g/forms">Forms</a>}
						{showAdmin && <p class="nav-g">Admin</p>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin">Overview</a>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin/families">Families</a>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin/applications">Applications</a>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin/tours">Tours & scheduling</a>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin/events">Events</a>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin/website">Website</a>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin/documents">Documents & forms</a>}
						{showAdmin && <a data-astro-prefetch="tap" href="/admin/staff">Staff</a>}
						{adminHint && <p class="side-note">To use Admin, sign in with your school email.</p>}
						<div class="nav-sep"></div>
						<a data-astro-prefetch="tap" href="/account"><Icon name="settings" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Settings</a>
						<a href="https://trinityclassical.academy" target="_blank" rel="noopener">trinityclassical.academy</a>
						<form method="post" action="/sign-out"><input type="hidden" name="csrf" value={csrf} /><button class="nav-btn" type="submit"><Icon name="sign-out" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Sign out</button></form>
						{showAdmin && <p class="mute" style="padding:16px 12px 0"><span class="badge b-green">Admin</span></p>}
					</nav>
					</MobileMenu>
					<main class="mwrap"><div class="awrap" set:html={mobileContent} /></main>
					<Fragment set:html={mobileOverlay} />
				</div>
			</div>
		</div>
		</div>
		<template data-page-skeleton><Skeleton /></template>
		<template data-sheet-skeleton><div class="ov ov-side" data-loading-sheet><div class="ssheet" aria-busy="true"><div class="sh-h"><span class="skeleton-shape" style="width:180px;height:24px"></span></div><div class="sh-b"><Skeleton kind="sheet" /></div></div></div></template>
		<div class="interaction-toasts" data-interaction-toasts aria-live="polite" aria-atomic="true"></div>
		<script>
			import '../scripts/portal-shell.ts';
			import '../scripts/interactions';
		</script>
	</body>
</html>
