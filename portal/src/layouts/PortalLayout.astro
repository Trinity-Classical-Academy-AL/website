---
import Icon from '../components/ui/Icon.astro';
import Skeleton from '../components/ui/Skeleton.astro';
import { cssHref } from '../lib/assets';
import type { PortalRole } from '@tca/school';
import { csrfToken } from '../lib/security.ts';
import FontHead from '../components/FontHead.astro';
import AccountMenu from '../components/AccountMenu.astro';
import MobileMenu from '../components/MobileMenu.astro';

interface Props {
	title: string;
	current: string;
	roles: PortalRole[];
	name: string;
	email: string;
}
const { title, current, roles, name, email } = Astro.props;
const content = await Astro.slots.render('default');
const overlay = await Astro.slots.render('overlay');
// The phone copy gets its own ids. A button's form="…" must follow, or it would submit
// (and confirm in) the hidden desktop copy's form.
const mobileIds = (html: string) => html.replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"').replace(/(\s)form="([^"]+)"/g, '$1form="$2-m"');
const mobileContent = mobileIds(content ?? '');
const mobileOverlay = mobileIds(overlay ?? '');
const initials = name.split(' ').filter(Boolean).map((part) => part[0]).join('').slice(0, 2).toUpperCase() || 'TCA';
// The page's roles come from middleware: the household's stage (prospect or
// guardian) plus this person's access (staff, admin, developer).
const live = (Astro.locals.roles?.length ? Astro.locals.roles : roles) as string[];
const guardian = live.includes('guardian');
// A 7th or 8th grader signed in with their own sign-in: just their page.
const student = live.includes('student');
const sessionEmail = Astro.locals.sessionEmail || email;
const admin = live.includes('admin');
const staff = live.includes('staff');
const developer = live.includes('developer');
const finance = live.includes('finance');
const superAdmin = live.includes('super_admin');
const showAdmin = admin;
const applying = Astro.locals.access?.applying ?? false;
// A teaching application in progress: Teaching in the Family section until they're hired.
const teachingApp = !staff && (Astro.locals.access?.teaching ?? false);
const teachItem = teachingApp ? [{ href: '/teaching', label: 'Teaching', icon: 'application' }] : [];
type NavItem = { href: string; label: string; icon: string; match?: string[] };
// Sidebar: Family for everyone (its pages follow the household's stage), then Staff and Admin as the person has them.
const sections: { key: string; label: string; items: NavItem[] }[] = [
	{ key: 'family', label: 'Family', items: student ? [{ href: '/s', label: 'My classes', icon: 'student' }, { href: '/s/messages', label: 'Messages', icon: 'message' }] : guardian ? [
		{ href: '/g', label: 'Home', icon: 'home' }, { href: '/g/students', label: 'Students', icon: 'student' }, { href: '/g/calendar', label: 'Calendar', icon: 'calendar' },
		{ href: '/g/announcements', label: 'Announcements', icon: 'announcement' }, { href: '/g/messages', label: 'Messages', icon: 'message' }, { href: '/g/documents', label: 'Documents', icon: 'document-lines' }, { href: '/g/forms', label: 'To do', icon: 'edit' }, { href: '/billing', label: 'Billing', icon: 'document' },
		...(applying ? [{ href: '/applications', label: 'Apply', icon: 'application' }] : []), ...teachItem,
	] : [
		{ href: '/home', label: 'Home', icon: 'home' }, { href: '/tour', label: 'Request a tour', icon: 'map-pin' }, { href: '/events', label: 'Events', icon: 'star' }, { href: '/applications', label: 'Apply', icon: 'application' }, ...teachItem,
	] },
	...(staff ? [{ key: 'staff', label: 'Teacher', items: [{ href: '/staff', label: 'Students', icon: 'families' }, { href: '/staff/attendance', label: 'Attendance', icon: 'check' }, { href: '/staff/classes', label: 'Classes', icon: 'document-lines' }, { href: '/staff/report-cards', label: 'Report cards', icon: 'document' }, { href: '/staff/messages', label: 'Messages', icon: 'message' }] }] : []),
	...(showAdmin ? [{ key: 'admin', label: 'Admin', items: [
		{ href: '/admin', label: 'Overview', icon: 'overview' }, { href: '/admin/families', label: 'Families', icon: 'families' }, { href: '/admin/applications', label: 'Applications', icon: 'application' },
		{ href: '/admin/reenrollment', label: 'Re-enrollment', icon: 'student' }, { href: '/admin/classes', label: 'Classes', icon: 'document-lines' }, ...(staff ? [] : [{ href: '/staff/messages', label: 'Messages', icon: 'message' }]), { href: '/admin/calendar', label: 'Calendar', icon: 'calendar' }, { href: '/admin/announcements', label: 'Announcements', icon: 'announcement' }, { href: '/admin/website', label: 'Website', icon: 'globe' },
		{ href: '/admin/documents', label: 'Documents & forms', icon: 'document' }, { href: '/admin/classreach', label: 'ClassReach', icon: 'families' },
		...(superAdmin ? [{ href: '/admin/hiring', label: 'Hiring', icon: 'student' }, { href: '/admin/people', label: 'People', icon: 'lock' }] : []),
	] }] : []),
	// Finance: its own role, like Developer. Admin alone doesn't see it.
	...(finance ? [{ key: 'finance', label: 'Finance', items: [
		{ href: '/finance', label: 'Budget', icon: 'overview' }, { href: '/finance/families', label: 'Family accounts', icon: 'families' }, { href: '/finance/plans', label: 'Tuition plans', icon: 'document-lines' },
		{ href: '/finance/payments', label: 'Payments', icon: 'check' }, { href: '/finance/settings', label: 'Finance settings', icon: 'settings' },
	] }] : []),
	...(developer ? [{ key: 'developer', label: 'Developer', items: [{ href: '/developer', label: 'Email previews', icon: 'message' }] }] : []),
];
// One area at a time (Family, Staff, Admin, Finance, Developer): the switcher picks it, and the page's path decides it.
// Teacher tabs live only in the Teacher section. Admins without Teacher still get Messages (families write to the school) in Admin.
const areaKey = (() => {
	const pick = current.startsWith('/admin') ? 'admin' : current.startsWith('/finance') ? 'finance' : current.startsWith('/developer') ? 'developer'
		: current === '/staff' || current.startsWith('/staff/') ? (staff ? 'staff' : 'admin') : 'family';
	return sections.some((section) => section.key === pick) ? pick : sections[0].key;
})();
const area = sections.find((section) => section.key === areaKey) ?? sections[0];
const inItem = (item: NavItem, path: string) => item.href === path || !!item.match?.includes(path);
const on = (item: NavItem) => (inItem(item, current) ? 'on' : undefined);
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
// Sidebar collapsed to icons, remembered per browser (set by portal-shell.ts).
const sideCollapsed = Astro.cookies.get('side')?.value === 'collapsed';
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<title>{title}</title>
		<FontHead />
		<link rel="stylesheet" href={cssHref('portal.css')} />
		<link rel="stylesheet" href={cssHref('responsive.css')} />
	</head>
	<body>
		<div class:list={['portal-shell', sideCollapsed && 'side-collapsed']} data-portal-current={current}>
		<div class="shell-d">
			<div class="root">
				<div class="app">
					<aside class="side" transition:persist={`portal-sidebar-${sessionEmail}-${name}-${csrf}-${roles.join('-')}-${areaKey}-${cssHref('portal.css')}`} data-portal-sidebar>
						<div class="brand"><img src="/assets/img/emblem-green.svg" alt="" /><div class="brand-x"><p class="brand-t">TCA Portal</p><p class="brand-s">Trinity Classical Academy</p></div></div>
						{sections.length > 1 && <details class="area-pick" data-area-pick>
							<summary title={`${area.label}: switch area`}><span class="area-t"><strong>{area.label}</strong></span><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg></summary>
							<div class="area-list">{sections.map((section) => <a href={section.items[0].href} data-astro-prefetch="tap" class={section.key === areaKey ? 'on' : undefined} aria-current={section.key === areaKey ? 'true' : undefined}>{section.label}</a>)}</div>
						</details>}
						<nav class="nav" aria-label="Main">
							{area.items.map((item) => <a data-astro-prefetch="hover" href={item.href} class={on(item)} aria-current={inItem(item, current) ? 'page' : undefined} title={item.label} data-match={item.match?.join(' ')} data-badge={item.href.endsWith('/messages') || item.href === '/g/announcements' ? item.href : undefined}><Icon name={item.icon as any} aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />{item.label}</a>)}
						</nav>
						<div class="side-collapse"><button type="button" class="side-toggle" data-side-toggle aria-label="Collapse sidebar" title="Collapse sidebar"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path d="m15 10-2 2 2 2" class="side-toggle-a"/></svg><span class="side-toggle-l">Collapse sidebar</span></button></div>
						<div class="side-foot">
							<AccountMenu name={name || sessionEmail} email={sessionEmail} initials={initials} csrf={csrf} showAdmin={showAdmin} applyToTeach={!staff && !teachingApp && !student} />
						</div>
					</aside>
					<main class="main portal-main"><div class="awrap" set:html={content} /></main>
					<Fragment set:html={overlay} />
				</div>
			</div>
		</div>
		<div class="shell-m" id="shell-m">
			<div class="root m">
				<div class="mapp">
					<MobileMenu initials={initials} name={name || sessionEmail} email={sessionEmail} csrf={csrf} showAdmin={showAdmin}>
					<nav class="nav mmenu" id="mmenu" aria-label="Main">
						{sections.map((section) => <>
							{sections.length > 1 && <p class="nav-g">{section.label}</p>}
							{section.items.map((item) => <a data-astro-prefetch="tap" href={item.href} data-badge={item.href.endsWith('/messages') || item.href === '/g/announcements' ? item.href : undefined}>{item.label}</a>)}
						</>)}
						<div class="nav-sep"></div>
						{!student && <a data-astro-prefetch="tap" href="/account"><Icon name="settings" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Settings</a>}
						<a href="https://trinityclassical.academy" target="_blank" rel="noopener">trinityclassical.academy</a>
						<form method="post" action="/sign-out"><input type="hidden" name="csrf" value={csrf} /><button class="nav-btn" type="submit"><Icon name="sign-out" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />Sign out</button></form>
						{showAdmin && <p class="mute" style="padding:16px 12px 0"><span class="badge b-green">Admin</span></p>}
					</nav>
					</MobileMenu>
					<main class="mwrap"><div class="awrap" set:html={mobileContent} /></main>
					<Fragment set:html={mobileOverlay} />
				</div>
			</div>
		</div>
		</div>
		<template data-page-skeleton><Skeleton /></template>
		<template data-sheet-skeleton><div class="ov ov-side" data-loading-sheet><div class="ssheet" aria-busy="true"><div class="sh-h"><span class="skeleton-shape" style="width:180px;height:24px"></span></div><div class="sh-b"><Skeleton kind="sheet" /></div></div></div></template>
		<div class="interaction-toasts" data-interaction-toasts aria-live="polite" aria-atomic="true"></div>
		<script>
			import '../scripts/portal-shell.ts';
			import '../scripts/interactions';
		</script>
	</body>
</html>
