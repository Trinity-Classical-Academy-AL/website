---
import { emailOpensAdmin, type PortalRole } from '@tca/school';
import { csrfToken } from '../lib/security.ts';
import FontHead from '../components/FontHead.astro';
import { AccountMenu } from '../components/AccountMenu.tsx';
import { MobileMenu } from '../components/MobileMenu.tsx';

interface Props {
	title: string;
	current: string;
	roles: PortalRole[];
	name: string;
	email: string;
}
const { title, current, roles, name, email } = Astro.props;
const content = await Astro.slots.render('default');
const overlay = await Astro.slots.render('overlay');
const mobileContent = (content ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
const mobileOverlay = (overlay ?? '').replace(/\b(id|for)="([^"]+)"/g, '$1="$2-m"');
const on = (href: string) => (current === href ? 'on' : undefined);
const initials = name.split(' ').filter(Boolean).map((part) => part[0]).join('').slice(0, 2).toUpperCase() || 'TCA';
const prospect = roles.includes('prospect') && !roles.includes('guardian');
const guardian = roles.includes('guardian');
const sessionEmail = Astro.locals.sessionEmail || email;
const admin = roles.includes('admin');
const showAdmin = admin && emailOpensAdmin(sessionEmail);
const adminHint = admin && !showAdmin;
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<title>{title}</title>
		<FontHead />
		<link rel="stylesheet" href="/css/portal.css" />
		<link rel="stylesheet" href="/css/responsive.css" />
	</head>
	<body>
		<div class="shell-d">
			<div class="root">
				<div class="app">
					<aside class="side">
						<div class="brand"><img src="/assets/img/emblem-green.svg" alt="" /><div><p class="brand-t">TCA Portal</p><p class="brand-s">Trinity Classical Academy</p></div></div>
						<nav class="nav" aria-label="Main">
							{prospect && (
								<>
									<a href="/home" class={on('/home')} aria-current={current === '/home' ? 'page' : undefined}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>Home</a>
									<a href="/tour" class={on('/tour')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Request a tour</a>
									<a href="/events" class={on('/events')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>Events</a>
									<a href="/your-family" class={on('/your-family')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.2a6.5 6.5 0 0 1 3.5 5.8"/></svg>Your family</a>
								</>
							)}
							{guardian && showAdmin && <p class="nav-g">Family</p>}
							{guardian && (
								<>
									<a href="/g" class={on('/g')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>Home</a>
									<a href="/g/students" class={on('/g/students')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="3"/><path d="M7 21v-6l-2-3 4-2h6l4 2-2 3v6"/></svg>Students</a>
									<a href="/g/calendar" class={on('/g/calendar')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>Calendar</a>
									<a href="/g/announcements" class={on('/g/announcements')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4h3l6 4V6L7 10z"/><path d="M16.5 9a4 4 0 0 1 0 6M19 6.5a8 8 0 0 1 0 11"/></svg>Announcements</a>
									<a href="/g/documents" class={on('/g/documents')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg>Documents</a>
									<a href="/g/forms" class={on('/g/forms')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13.5 6.5 4 4"/></svg>Forms</a>
								</>
							)}
							{showAdmin && <p class="nav-g">Admin</p>}
							{showAdmin && (
								<>
									<a href="/admin" class={on('/admin')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Overview</a>
									<a href="/admin/prospects" class={on('/admin/prospects')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>Prospects</a>
									<a href="/admin/tours" class={on('/admin/tours')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Tours & scheduling</a>
									<a href="/admin/events" class={on('/admin/events')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>Events</a>
									<a href="/admin/website" class={on('/admin/website')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>Website</a>
									<a href="/admin/families" class={on('/admin/families')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.2a6.5 6.5 0 0 1 3.5 5.8"/></svg>Families</a>
									<a href="/admin/documents" class={on('/admin/documents')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg>Documents & forms</a>
									<a href="/admin/staff" class={on('/admin/staff')}><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Staff</a>
								</>
							)}
						</nav>
						{adminHint && <p class="side-note">To use Admin, sign in with your school email.</p>}
						<div class="side-foot">
							<a class="side-link" href="https://trinityclassical.academy" target="_blank" rel="noopener"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>trinityclassical.academy</a>
							<AccountMenu client:load name={name || sessionEmail} email={sessionEmail} initials={initials} csrf={csrf} showAdmin={showAdmin} adminHint={adminHint} />
						</div>
					</aside>
					<main class="main"><div class="awrap" set:html={content} /></main>
					<Fragment set:html={overlay} />
				</div>
			</div>
		</div>
		<div class="shell-m" id="shell-m">
			<div class="root m">
				<div class="mapp">
					<MobileMenu client:load initials={initials} name={name || sessionEmail} email={sessionEmail} csrf={csrf} showAdmin={showAdmin}>
					<nav class="nav mmenu" id="mmenu" aria-label="Main">
						{prospect && <a href="/home"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg>Home</a>}
						{prospect && <a href="/tour"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Request a tour</a>}
						{prospect && <a href="/events">Events</a>}
						{prospect && <a href="/your-family">Your family</a>}
						{guardian && showAdmin && <p class="nav-g">Family</p>}
						{guardian && <a href="/g">Home</a>}
						{guardian && <a href="/g/students">Students</a>}
						{guardian && <a href="/g/calendar">Calendar</a>}
						{guardian && <a href="/g/announcements">Announcements</a>}
						{guardian && <a href="/g/documents">Documents</a>}
						{guardian && <a href="/g/forms">Forms</a>}
						{showAdmin && <p class="nav-g">Admin</p>}
						{showAdmin && <a href="/admin">Overview</a>}
						{showAdmin && <a href="/admin/prospects">Prospects</a>}
						{showAdmin && <a href="/admin/tours">Tours & scheduling</a>}
						{showAdmin && <a href="/admin/events">Events</a>}
						{showAdmin && <a href="/admin/website">Website</a>}
						{showAdmin && <a href="/admin/families">Families</a>}
						{showAdmin && <a href="/admin/documents">Documents & forms</a>}
						{showAdmin && <a href="/admin/staff">Staff</a>}
						{adminHint && <p class="side-note">To use Admin, sign in with your school email.</p>}
						<div class="nav-sep"></div>
						<a href="/account"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/></svg>Settings</a>
						<a href="https://trinityclassical.academy" target="_blank" rel="noopener">trinityclassical.academy</a>
						<form method="post" action="/sign-out"><input type="hidden" name="csrf" value={csrf} /><button class="nav-btn" type="submit"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 17l-5-5 5-5M5 12h11"/></svg>Sign out</button></form>
						{showAdmin && <p class="mute" style="padding:16px 12px 0"><span class="badge b-green">Admin</span></p>}
					</nav>
					</MobileMenu>
					<main class="mwrap"><div class="awrap" set:html={mobileContent} /></main>
					<Fragment set:html={mobileOverlay} />
				</div>
			</div>
		</div>
		<script is:inline>
			document.addEventListener('submit', (event) => {
				const form = event.target;
				if (!(form instanceof HTMLFormElement)) return;
				const button = form.querySelector('button.btn-p');
				if (!(button instanceof HTMLButtonElement) || button.disabled) return;
				const label = button.dataset.busy || '';
				button.disabled = true;
				button.classList.add('busy');
				if (label) button.innerHTML = '<span class="spin" aria-hidden="true"></span>' + label;
			});
		</script>
	</body>
</html>
