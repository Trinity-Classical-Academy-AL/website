---
import PageHeader from '../components/ui/PageHeader.astro';
import AccountSettings from '../components/pages/account/AccountSettings.astro';
import AccountDialogs from '../components/pages/account/AccountDialogs.astro';
import PortalLayout from '../layouts/PortalLayout.astro';

import { loadAccount } from '../lib/pages/account.ts';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const page = await loadAccount(Astro, family);
if (page instanceof Response) return page;
const { dialog, error, notice, fresh } = page;
---
<PortalLayout title="Settings — TCA Portal" current="/account" roles={family.roles} name={fresh?.name || family.name} email={family.email}>
	<PageHeader><div><h1>Settings</h1><p class="soft">Your name, sign-in emails and notifications.</p></div></PageHeader>
	{notice && <p class="alert alert-ok" role="status">{notice}</p>}
	{error && !dialog && <p class="alert alert-err" role="alert">{error}</p>}
	<AccountSettings view={page} />
	<AccountDialogs view={page} />
</PortalLayout>
