---
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import Sheet from '../../components/ui/Sheet.astro';
import SheetHeader from '../../components/ui/SheetHeader.astro';
import SheetBody from '../../components/ui/SheetBody.astro';
import SheetFooter from '../../components/ui/SheetFooter.astro';
import Toast from '../../components/ui/Toast.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { RouteTabs } from '../../components/RouteTabs.tsx';
import { FilterSelect } from '../../components/FilterSelect.tsx';
import { AUDIENCES, CALENDAR_TYPES, eventDate } from '@tca/school';
import { loadCalendar } from '../../lib/pages/calendar.ts';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const page = await loadCalendar(Astro);
if (page instanceof Response) return page;
const { csrf, error, today, month, byDay, shown, link, typeFilter, audienceFilter, sheetOpen, newDate, editing, sheetType, form, toast } = page;

const [year, monthIndex] = [Number(month.slice(0, 4)), Number(month.slice(5, 7)) - 1];
const iso = (date: Date) => date.toISOString().slice(0, 10);
const first = new Date(Date.UTC(year, monthIndex, 1));
const start = new Date(first); start.setUTCDate(1 - first.getUTCDay());
const last = new Date(Date.UTC(year, monthIndex + 1, 0));
const end = new Date(last); end.setUTCDate(last.getUTCDate() + (6 - last.getUTCDay()));
const days: { date: string; day: number; inMonth: boolean }[] = [];
for (const cursor = new Date(start); cursor <= end; cursor.setUTCDate(cursor.getUTCDate() + 1)) days.push({ date: iso(cursor), day: cursor.getUTCDate(), inMonth: cursor.getUTCMonth() === monthIndex });
const shift = (by: number) => iso(new Date(Date.UTC(year, monthIndex + by, 1))).slice(0, 7);
const monthLabel = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(first);
const clock = (time: string) => time ? new Date(`2000-01-01T${time}:00Z`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' }).replace(':00', '').toLowerCase() : '';
const typeIcon = { gathering: 'star', tour: 'map-pin', school_day: 'calendar' } as Record<string, string>;
const audienceText = (values: string[]) => values.includes('staff') && values.length === 1 ? 'Staff only' : values.includes('public') ? 'Public' : values.map((value) => AUDIENCES.find((item) => item.value === value)?.label ?? value).join(', ');
const itemHref = (item: (typeof shown)[number]) => item.source === 'tour' ? (item.seriesId ? `/admin/tours?rule=${item.seriesId}` : `/admin/tours?slot=${item.id}`) : link({ item: item.key });
const monthItems = shown.filter((item) => item.date.startsWith(month));
const closeUrl = link({});
const weekday = (day: string) => new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: 'UTC' }).format(new Date(`${day}T00:00:00Z`));
---
<PortalLayout title="Calendar — TCA Portal" current="/admin/calendar" roles={family.roles} name={family.name} email={family.email}>
	<PageHeader>
		<h1>Calendar</h1>
		<RouteTabs slot="tabs" client:load label="Calendar" tabs={[
			{ href: '/admin/calendar', label: 'Calendar', current: true },
			{ href: '/admin/tours', label: 'Tour schedules', current: false },
			{ href: '/admin/tours?tab=bookings', label: 'Bookings', current: false },
			{ href: '/admin/tours?tab=requests', label: 'Time requests', current: false },
		]} />
		<Fragment slot="actions"><a class="btn btn-p btn-sm" href={link({ new: month === today.slice(0, 7) ? today : `${month}-01` })}><Icon name="plus" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />New</a></Fragment>
	</PageHeader>
	{toast && <Toast>{toast}</Toast>}
	<div class="cal-bar">
		<div class="cal-nav">
			<a class="cal-step" href={link({ m: shift(-1) })} aria-label="Previous month"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg></a>
			<a class="cal-step" href={link({ m: shift(1) })} aria-label="Next month"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg></a>
			<h2 class="cal-title">{monthLabel}</h2>
			{month !== today.slice(0, 7) && <a class="btn btn-s btn-sm cal-today" href={link({ m: '' })}>Today</a>}
		</div>
		<div class="filters">
			<FilterSelect client:load param="type" label="Type" value={typeFilter} options={[{ value: '', label: 'All' }, ...CALENDAR_TYPES]} />
			<FilterSelect client:load param="audience" label="For" value={audienceFilter} options={[{ value: '', label: 'Everyone' }, ...AUDIENCES.map((item) => ({ value: item.value, label: item.label }))]} />
		</div>
	</div>
	<div class="cal cal-admin" role="grid" aria-label={monthLabel}>
		<div class="cal-head" role="row">{['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((name) => <span role="columnheader">{name}</span>)}</div>
		<div class="cal-grid">
			{days.map((cell) => {
				const onDay = byDay.get(cell.date) ?? [];
				return <div role="gridcell" class:list={['cal-day', !cell.inMonth && 'out', cell.date === today && 'today']} data-new-href={link({ new: cell.date, type: '' })}>
					<span class="cal-n">{cell.day}</span>
					<a class="cal-add" href={link({ new: cell.date, type: '' })} aria-label={`Add on ${cell.date}`}><Icon name="plus" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></a>
					<div class="cal-evs">
						{onDay.slice(0, 4).map((item) => (
							<a class:list={['cal-ev', `ev-${item.type}`, item.audience.length === 1 && item.audience[0] === 'staff' && 'ev-staff']} href={itemHref(item)} title={`${item.title}${item.allDay ? '' : ` · ${clock(item.start)}`} · ${audienceText(item.audience)}`}>
								{!item.allDay && <span class="cal-t">{clock(item.start)}</span>} {item.title}
							</a>
						))}
						{onDay.length > 4 && <a class="cal-more" href="#month-list">+{onDay.length - 4} more</a>}
					</div>
					{onDay.length > 0 && <span class="cal-dots" aria-hidden="true">{onDay.slice(0, 3).map((item) => <i class={`dot-${item.type}`} />)}</span>}
				</div>;
			})}
		</div>
	</div>
	<div class="cal-legend">{CALENDAR_TYPES.map((item) => <span><i class={`dot-${item.value}`} />{item.label}</span>)}<span><i class="dot-staff" />Staff only</span></div>
	<section class="cal-month-list" id="month-list">
		<h2 class="ev-h">This month</h2>
		{monthItems.length === 0 ? <p class="mute">Nothing on the calendar in {monthLabel}. Click a day to add something.</p> : (
			<ul class="ev-list">{monthItems.map((item) => (
				<li><a href={itemHref(item)}><span class="ev-date"><span>{weekday(item.date)}</span><strong>{Number(item.date.slice(8))}</strong></span>
					<span class="ev-t"><strong><Icon name={typeIcon[item.type]} aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /> {item.title}</strong>
						<span class="mute">{[item.allDay ? 'All day' : `${clock(item.start)}${item.end ? `–${clock(item.end)}` : ''}`, audienceText(item.audience), item.signup === 'booking' ? `${item.taken}/${item.capacity} booked` : item.signup === 'rsvp' ? `${item.taken} coming${item.capacity ? ` of ${item.capacity}` : ''}` : '', item.location].filter(Boolean).join(' · ')}</span></span></a></li>
			))}</ul>
		)}
	</section>

	{sheetOpen && <Sheet slot="overlay" openUrl={link(editing ? { item: editing.key } : { new: newDate })} closeUrl={closeUrl} dialog={{ role: 'dialog', 'aria-modal': 'true', 'aria-label': editing ? 'Edit' : 'Add to the calendar' }}>
		<form method="post" data-enhance class="cal-form">
			<SheetHeader closeHref={closeUrl}><div class="sh-tt"><h2 class="h2">{editing ? `Edit ${editing.title}` : `Add on ${eventDate(`${form.date || newDate}T17:00:00Z`)}`}</h2></div></SheetHeader>
			<SheetBody>
				{error && <p class="alert alert-err" role="alert">{error}</p>}
				<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value={sheetType === 'tour' ? 'save-tour' : 'save-event'} />
				{editing && <input type="hidden" name="id" value={editing.id} />}
				<div class="type-pick" role="group" aria-label="Type">
					{CALENDAR_TYPES.filter((item) => !editing || item.value !== 'tour').map((item) => editing
						? <label class:list={['type-opt', sheetType === item.value && 'on']}><input type="radio" name="type" value={item.value} checked={sheetType === item.value} /><Icon name={typeIcon[item.value]} aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />{item.label}</label>
						: <a class:list={['type-opt', sheetType === item.value && 'on']} href={link({ new: form.date || newDate, type: item.value })}><Icon name={typeIcon[item.value]} aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />{item.label}</a>)}
					{!editing && <input type="hidden" name="type" value={sheetType} />}
				</div>
				{sheetType !== 'tour' && <label class="field"><span class="lbl">Title</span><input class="inp" name="title" value={form.title} required placeholder={sheetType === 'school_day' ? 'No school, Early dismissal, First day…' : 'Open house, Chapel, Parent night…'} /></label>}
				<div class="f2">
					<label class="field"><span class="lbl">Date</span><input class="inp" type="date" name="date" value={form.date} required /></label>
					{sheetType === 'gathering' && <label class="field check-field"><span class="lbl">&nbsp;</span><span class="check-row"><input type="checkbox" name="allDay" checked={form.allDay} data-all-day />All day</span></label>}
				</div>
				{sheetType !== 'school_day' && <div class="f2" data-times>
					<label class="field"><span class="lbl">Starts</span><input class="inp" type="time" name="start" value={form.start} /></label>
					<label class="field"><span class="lbl">Ends</span><input class="inp" type="time" name="end" value={form.end} /></label>
				</div>}
				{sheetType === 'tour' ? (
					<>
						<div class="f2">
							<label class="field"><span class="lbl">Places</span><input class="inp" type="number" min="1" max="500" name="capacity" value={form.capacity} required /></label>
							<label class="field"><span class="lbl">Counted as</span><select class="inp" name="unit"><option value="families">Families</option><option value="people">People</option></select></label>
						</div>
						<label class="check-row"><input type="checkbox" name="published" checked />Published (families can book it)</label>
						<p class="hint">For tours every week, set up a <a href="/admin/tours?sheet=add">tour schedule</a> instead.</p>
					</>
				) : (
					<>
						{sheetType === 'gathering' && <label class="field"><span class="lbl">Location</span><input class="inp" name="location" value={form.location} placeholder="Trinity campus" /></label>}
						<fieldset class="field field-reset"><legend class="lbl">Who it’s for</legend>
							<div class="aud-picks">{AUDIENCES.map((item) => <label class="aud"><input type="checkbox" name="audience" value={item.value} checked={(form.audience as string[]).includes(item.value)} /><span class="aud-t"><strong>{({ public: 'Public', prospective: 'Prospects', enrolled: 'Families', staff: 'Staff' } as Record<string, string>)[item.value]}</strong><span>{({ public: 'Website and portal', prospective: 'Applying or visiting', enrolled: 'Enrolled', staff: 'Only staff see it' } as Record<string, string>)[item.value]}</span></span><span class="aud-check" aria-hidden="true"><Icon name="check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></span></label>)}</div>
						</fieldset>
						{sheetType === 'gathering' && <div class="f2">
							<label class="field check-field"><span class="lbl">Sign-up</span><span class="check-row"><input type="checkbox" name="rsvp" checked={form.rsvp} />Collect RSVPs</span></label>
							<label class="field"><span class="lbl">Limit (optional)</span><input class="inp" type="number" min="1" name="capacity" value={form.capacity} placeholder="No limit" /></label>
						</div>}
						<label class="field"><span class="lbl">{sheetType === 'school_day' ? 'Note (optional)' : 'Details (optional)'}</span><textarea class="inp" name="description" rows="3">{form.description}</textarea></label>
						{sheetType === 'gathering' && <label class="check-row"><input type="checkbox" name="popup" checked={form.popup} />Feature on the website (needs Public)</label>}
					</>
				)}
			</SheetBody>
			<SheetFooter>
				{editing && <button class="btn btn-gd btn-sm" form="delete-item" type="submit">Delete</button>}
				<span class="grow"></span>
				<a class="btn btn-s btn-sm" href={closeUrl}>Cancel</a>
				<button class="btn btn-p btn-sm" data-busy="Saving…">{editing ? 'Save' : 'Add'}</button>
			</SheetFooter>
		</form>
		{editing && <form id="delete-item" method="post" data-enhance hidden><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="delete-event" /><input type="hidden" name="id" value={editing.id} /><input type="hidden" name="date" value={editing.date} /></form>}
		{editing && <p class="cal-more-opts mute"><a href={`/admin/events?event=${editing.id}`}>RSVP list and flyer</a></p>}
	</Sheet>}
</PortalLayout>

<script>
	// A click on a day's empty space adds something on that day.
	document.addEventListener('click', (event) => {
		const target = event.target as Element;
		const cell = target.closest<HTMLElement>('.cal-admin .cal-day[data-new-href]');
		if (!cell || target.closest('a, button')) return;
		const link = cell.querySelector<HTMLAnchorElement>('.cal-add');
		link?.click();
	});
	// All-day hides the time fields.
	const sync = () => document.querySelectorAll<HTMLInputElement>('[data-all-day]').forEach((box) => box.closest('form')?.querySelectorAll<HTMLElement>('[data-times]').forEach((row) => { row.hidden = box.checked; }));
	document.addEventListener('change', (event) => { if ((event.target as Element).matches?.('[data-all-day]')) sync(); });
	document.addEventListener('astro:page-load', sync);
	sync();
</script>
