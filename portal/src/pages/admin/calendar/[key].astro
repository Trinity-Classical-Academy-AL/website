---
import PageHeader from '../../../components/ui/PageHeader.astro';
import Toast from '../../../components/ui/Toast.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import ItemFields from '../../../components/pages/calendar/ItemFields.astro';
import DeleteItem from '../../../components/pages/calendar/DeleteItem.astro';
import People from '../../../components/pages/calendar/People.astro';
import SkippedDates from '../../../components/pages/calendar/SkippedDates.astro';
import { CALENDAR_TYPES, eventDate } from '@tca/school';
import { loadCalendarItem } from '../../../lib/pages/calendar.ts';

/** One calendar item with room to work: its details and everyone who signed up. */
export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const page = await loadCalendarItem(Astro);
if (page instanceof Response) return page;
const clock = (time: string) => time ? new Date(`2000-01-01T${time}:00Z`).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' }).replace(':00', '').toLowerCase() : '';
const item = page?.item;
const back = `/admin/calendar?m=${(item?.date ?? '').slice(0, 7)}`;
---
<PortalLayout title={`${item?.title ?? 'Not found'} — Calendar — TCA Portal`} current="/admin/calendar" roles={family.roles} name={family.name} email={family.email}>
	{!page || !item ? (
		<>
			<PageHeader><div><a class="back" href="/admin/calendar">Calendar</a><h1>Not on the calendar</h1></div></PageHeader>
			<EmptyState><p class="h3">This item was removed or has passed</p><p class="mute"><a href="/admin/calendar">Back to the calendar</a></p></EmptyState>
		</>
	) : (
		<>
			<PageHeader>
				<div><a class="back" href={back}>Calendar</a><h1>{item.title}</h1><span class:list={['badge', item.type === 'gathering' ? 'b-green' : item.type === 'tour' ? 'b-gold' : 'b-gray']}>{CALENDAR_TYPES.find((type) => type.value === item.type)?.label}</span></div>
				<Fragment slot="actions"><DeleteItem csrf={page.csrf} item={item} part="button" down /></Fragment>
			</PageHeader>
			{page.toast && <Toast>{page.toast}</Toast>}
			<p class="item-when">{eventDate(`${item.date}T17:00:00Z`)}{item.allDay ? ' · All day' : ` · ${clock(item.start)}${item.end ? `–${clock(item.end)}` : ''}`}{item.location ? ` · ${item.location}` : ''}{item.type === 'gathering' && <> · <a href={`/admin/events?event=${item.id}`}>Flyer</a></>}</p>
			<div class:list={['item-grid', item.signup === 'none' && 'solo']}>
				<form method="post" enctype="multipart/form-data" data-enhance class="panel cal-form item-form">
					<div class="panel-b">
						<ItemFields csrf={page.csrf} type={item.type} form={page.form} editing={item} error={page.error} />
						<div class="item-save"><button class="btn btn-p btn-sm" data-busy="Saving…">Save</button></div>
					</div>
				</form>
				{item.signup !== 'none' && <div class="panel item-people"><div class="panel-b"><People item={item} people={page.people} />{item.seriesId && <SkippedDates csrf={page.csrf} seriesId={item.seriesId} itemKey={item.key} dates={page.skipped} />}</div></div>}
			</div>
			<DeleteItem csrf={page.csrf} item={item} part="form" />
		</>
	)}
</PortalLayout>
