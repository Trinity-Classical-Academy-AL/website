---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { RouteTabs } from '../../components/RouteTabs.tsx';
import { csrfOk, csrfToken } from '../../lib/security.ts';
import { parseUsDate } from '../../lib/fields.ts';
import { deleteSchoolDocument, getFamily, listAdminDocuments, listAdminForms, listFamilies, saveSchoolDocument, saveSchoolForm } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
const tab = Astro.url.searchParams.get('tab') === 'forms' ? 'forms' : 'documents';
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (String(form.get('action') ?? '') === 'delete-doc') {
		await deleteSchoolDocument(String(form.get('id') ?? ''));
		return Astro.redirect('/admin/documents?removed=1');
	} else if (String(form.get('action') ?? '') === 'form') {
		const labels = form.getAll('qlabel').map(String);
		const types = form.getAll('qtype').map(String);
		const required = new Set(form.getAll('qreq').map(String));
		const result = await saveSchoolForm({
			id: String(form.get('id') ?? '') || undefined,
			title: String(form.get('title') ?? ''),
			instructions: String(form.get('instructions') ?? ''),
			audience: String(form.get('audience') ?? 'everyone'),
			grade: String(form.get('grade') ?? ''),
			dueOn: parseUsDate(String(form.get('due') ?? '')),
			questions: labels.map((label, index) => ({ id: '', label, type: types[index] || 'short', required: required.has(String(index)) })),
			publish: String(form.get('publish') ?? '') === 'yes',
		});
		if (!result.ok) error = result.error;
		else return Astro.redirect(`/admin/documents?tab=forms&saved=${result.id}`);
	} else {
		const file = form.get('file');
		const upload = file instanceof File && file.size ? { bytes: new Uint8Array(await file.arrayBuffer()), name: file.name, contentType: file.type || 'application/pdf' } : undefined;
		const audience = String(form.get('audience') ?? 'everyone');
		const result = await saveSchoolDocument({
			id: String(form.get('id') ?? '') || undefined,
			title: String(form.get('title') ?? ''),
			category: String(form.get('category') ?? 'Letters'),
			audience: audience === 'grade' || audience === 'family' ? audience : 'everyone',
			grade: String(form.get('grade') ?? ''),
			familyId: String(form.get('familyId') ?? ''),
			publish: String(form.get('publish') ?? '') === 'yes',
			email: form.get('email') === 'on',
			file: upload,
		});
		if (!result.ok) error = result.error;
		else return Astro.redirect(`/admin/documents?saved=${result.id}`);
	}
}
const docs = await listAdminDocuments();
const forms = tab === 'forms' || Astro.url.searchParams.get('sheet') === 'form' ? await listAdminForms() : [];
const families = await listFamilies('');
const editing = docs.find((doc) => doc.id === Astro.url.searchParams.get('doc'));
const sheet = Astro.url.searchParams.get('sheet');
const categories = ['Handbooks and policies', 'Calendars', 'Supply lists', 'Report cards', 'Letters', 'Forms and info'];
const grades = ['K', '1', '2', '3', '4', '5', '6', '7', '8'];
---
<PortalLayout title="Documents & forms — TCA Portal" current="/admin/documents" roles={family.roles} name={family.name} email={family.email}>
	{Astro.url.searchParams.get('saved') && <div class="toast t-ok" role="status"><span style="flex:1">{tab === 'forms' ? 'Form saved.' : 'Document published.'}</span></div>}
	<header class="ahead"><div><h1>Documents & forms</h1></div><div class="acts">{tab === 'documents' ? <a class="btn btn-p btn-sm" href="/admin/documents?sheet=upload">Upload document</a> : <a class="btn btn-p btn-sm" href="/admin/documents?tab=forms&sheet=form">New form</a>}</div></header>
	<RouteTabs client:load label="Sections" tabs={[{ href: '/admin/documents', label: 'Documents', current: tab === 'documents' }, { href: '/admin/documents?tab=forms', label: 'Forms', current: tab === 'forms' }]} />
	{tab === 'documents' && (docs.length === 0 ? <section class="card"><div class="empty"><p class="h3">No documents yet</p><p class="mute">Upload handbooks, calendars and supply lists for everyone, or report cards and letters for one family.</p><a class="btn btn-p btn-sm" href="/admin/documents?sheet=upload">Upload document</a></div></section> : (
		<div class="tbox"><table class="t t-click"><thead><tr><th>Document</th><th>Audience</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>
			{docs.map((doc) => <tr class:list={['rowlink', doc.id === Astro.url.searchParams.get('saved') && 'hl']}><td><strong>{doc.title}</strong><div class="sub">{doc.category}</div></td><td>{doc.audience === 'everyone' ? 'Everyone' : doc.audience === 'grade' ? doc.grade : 'A family'}</td><td>{doc.status === 'published' ? <span class="badge b-green">Published</span> : <span class="badge b-gray">Draft</span>}</td><td>{doc.updatedAt.slice(0, 10)}</td><td class="go"><a href={`/admin/documents?doc=${doc.id}`} aria-label="Edit">Edit</a></td></tr>)}
		</tbody></table></div>
	))}
	{tab === 'forms' && (forms.length === 0 ? <section class="card"><div class="empty"><p class="h3">No forms yet</p><a class="btn btn-p btn-sm" href="/admin/documents?tab=forms&sheet=form">New form</a></div></section> : (
		<div class="tbox"><table class="t t-click"><thead><tr><th>Form</th><th>Audience</th><th>Due</th><th>Submitted</th><th>Status</th></tr></thead><tbody>
			{forms.map((form) => <tr class="rowlink"><td><a href={`/admin/forms/${form.id}`}>{form.title}</a></td><td>{form.audience === 'grade' ? form.grade : 'Everyone'}</td><td>{form.dueOn || '—'}</td><td>{form.submitted} / {form.total}</td><td>{form.status === 'open' ? <span class="badge b-green">Open</span> : <span class="badge b-gray">Draft</span>}</td></tr>)}
		</tbody></table></div>
	))}
	{(sheet === 'upload' || editing) && (
		<div slot="overlay"><div class="ov ov-side"><aside class="ssheet" role="dialog" aria-modal="true" aria-label={editing ? 'Edit document' : 'Upload document'}><form method="post" enctype="multipart/form-data" data-astro-reload><div class="sh-h"><div class="sh-tt"><h2 class="h2">{editing ? 'Edit document' : 'Upload document'}</h2></div><a class="sh-ic" href="/admin/documents" aria-label="Close">×</a></div><div class="sh-b">{error && <div class="alert alert-err" role="alert"><p class="at">{error}</p></div>}<input type="hidden" name="csrf" value={csrf} />{editing && <input type="hidden" name="id" value={editing.id} />}<div class="field"><label class="lbl">File</label><p class="hint">PDF, Word, JPG or PNG, up to 25 MB.</p><label class="drop" for="file">Drag a file here or <span class="btn btn-s btn-sm">Choose file</span></label><input id="file" name="file" type="file" accept="application/pdf,image/png,image/jpeg,.doc,.docx" /></div><div class="field"><label class="lbl" for="title">Title</label><input id="title" name="title" class="inp" value={editing?.title ?? ''} /></div><div class="field"><label class="lbl" for="category">Category</label><select id="category" name="category" class="inp">{categories.map((category) => <option value={category} selected={editing?.category === category}>{category}</option>)}</select></div><fieldset class="field" style="border:0;padding:0"><legend class="lbl">Audience</legend><div class="chips"><label class="chip"><input type="radio" name="audience" value="everyone" checked={!editing || editing.audience === 'everyone'} />Everyone</label><label class="chip"><input type="radio" name="audience" value="grade" checked={editing?.audience === 'grade'} />A grade</label><label class="chip"><input type="radio" name="audience" value="family" checked={editing?.audience === 'family'} />A family</label></div></fieldset><div class="field"><label class="lbl" for="grade">Grade</label><select id="grade" name="grade" class="inp"><option value="">Choose one</option>{grades.map((grade) => <option value={grade} selected={editing?.grade === grade}>{grade === 'K' ? 'Kindergarten' : `${grade}`}</option>)}</select></div><div class="field"><label class="lbl" for="familyId">Family</label><select id="familyId" name="familyId" class="inp"><option value="">Choose one</option>{families.slice(0, 200).map((row) => <option value={row.id}>{row.name || row.email}</option>)}</select></div><label class="chk"><input type="checkbox" name="email" /><span>Email guardians that it’s available<span class="d">Otherwise it just shows as New in their Documents.</span></span></label></div><div class="sh-f">{editing && <a class="btn btn-gd" href={`/admin/documents?doc=${editing.id}&confirm=1`}>Delete</a>}<span class="grow"></span><a class="btn btn-s" href="/admin/documents">Cancel</a><button class="btn btn-s" name="publish" value="no">Save draft</button><button class="btn btn-p" name="publish" value="yes" data-busy="Saving…">Publish</button></div></form></aside>{Astro.url.searchParams.get('confirm') === '1' && editing && <div class="ov ov-top"><div class="dlg" role="alertdialog"><h2 class="h2">Delete this document?</h2><p class="soft">Families will no longer be able to download it.</p><form method="post" data-astro-reload><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="delete-doc" /><input type="hidden" name="id" value={editing.id} /><div class="acts"><a class="btn btn-s" href={`/admin/documents?doc=${editing.id}`}>Cancel</a><button class="btn btn-d">Delete</button></div></form></div></div>}</div></div>
	)}
	{sheet === 'form' && (
		<div slot="overlay"><div class="ov ov-side"><aside class="ssheet" role="dialog" aria-modal="true" aria-label="New form"><form method="post" data-astro-reload><div class="sh-h"><div class="sh-tt"><h2 class="h2">New form</h2></div><a class="sh-ic" href="/admin/documents?tab=forms" aria-label="Close">×</a></div><div class="sh-b">{error && <div class="alert alert-err"><p class="at">{error}</p></div>}<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="form" /><div class="field"><label class="lbl" for="ftitle">Title</label><input id="ftitle" name="title" class="inp" /></div><div class="field"><label class="lbl" for="instructions">Instructions (optional)</label><textarea id="instructions" name="instructions" class="inp" rows="2"></textarea></div><div class="field"><label class="lbl" for="due">Due</label><input id="due" name="due" class="inp" placeholder="MM/DD/YYYY" /></div><div class="field"><span class="lbl">Questions</span><div class="fb"><div class="fb-row"><span class="fb-h" aria-hidden="true">⋮⋮</span><input class="inp" name="qlabel" placeholder="Question" aria-label="Question" /><select name="qtype" class="inp" aria-label="Field type"><option value="short">Short text</option><option value="long">Long text</option><option value="yesno">Yes / No</option><option value="choice">Choice</option><option value="date">Date</option><option value="phone">Phone</option></select><label class="chk fb-req"><input type="checkbox" name="qreq" value="0" checked /><span>Required</span></label></div></div></div><fieldset class="field" style="border:0;padding:0"><legend class="lbl">Audience</legend><div class="chips"><label class="chip"><input type="radio" name="audience" value="everyone" checked />Everyone</label><label class="chip"><input type="radio" name="audience" value="grade" />A grade</label></div></fieldset></div><div class="sh-f"><span class="grow"></span><a class="btn btn-s" href="/admin/documents?tab=forms">Cancel</a><button class="btn btn-s" name="publish" value="no">Save draft</button><button class="btn btn-p" name="publish" value="yes" data-busy="Saving…">Publish</button></div></form></aside></div></div>
	)}
</PortalLayout>
