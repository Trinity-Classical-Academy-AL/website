---
import PageHeader from '../../components/ui/PageHeader.astro';
import Toast from '../../components/ui/Toast.astro';
import DocumentsTable from '../../components/pages/documents/DocumentsTable.astro';
import FormsTable from '../../components/pages/documents/FormsTable.astro';
import DocumentSheet from '../../components/pages/documents/DocumentSheet.astro';
import FormSheet from '../../components/pages/documents/FormSheet.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { RouteTabs } from '../../components/RouteTabs.tsx';

import { loadDocuments } from '../../lib/pages/documents.ts';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const page = await loadDocuments(Astro, family);
if (page instanceof Response) return page;
const { tab, toast } = page;
---
<PortalLayout title="Documents & forms — TCA Portal" current="/admin/documents" roles={family.roles} name={family.name} email={family.email}>
	{toast && <Toast>{toast}</Toast>}
	<PageHeader actions={{ "class": "acts" }}><div><h1>Documents & forms</h1></div><RouteTabs slot="tabs" client:load label="Sections" tabs={[{ href: '/admin/documents', label: 'Documents', current: tab === 'documents' }, { href: '/admin/documents?tab=forms', label: 'Forms', current: tab === 'forms' }]} /><Fragment slot="actions">{tab === 'documents' ? <a class="btn btn-p btn-sm" href="/admin/documents?sheet=upload">Upload document</a> : <a class="btn btn-p btn-sm" href="/admin/documents?tab=forms&sheet=form">New form</a>}</Fragment></PageHeader>
	<DocumentsTable view={page} />
	<FormsTable view={page} />
	<DocumentSheet slot="overlay" view={page} />
	<FormSheet slot="overlay" view={page} />
</PortalLayout>
