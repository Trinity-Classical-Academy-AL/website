---
import PageHeader from '../../components/ui/PageHeader.astro';
import Toast from '../../components/ui/Toast.astro';
import EventsTable from '../../components/pages/events/EventsTable.astro';
import EventSheet from '../../components/pages/events/EventSheet.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { RouteTabs } from '../../components/RouteTabs.tsx';

import { loadEvents } from '../../lib/pages/events.ts';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const page = await loadEvents(Astro, family);
if (page instanceof Response) return page;
const { past, toast } = page;
---
<PortalLayout title="Events — TCA Portal" current="/admin/events" roles={family.roles} name={family.name} email={family.email}>
	{toast && <Toast role="status"><span style="flex:1">{toast}</span></Toast>}
	<PageHeader actions={{ "class": "acts" }}><div><h1>Events</h1><p class="soft">Shown to families in the portal; choose which also go on the website.</p></div><Fragment slot="actions"><a class="btn btn-p btn-sm" href="/admin/events?sheet=new">New event</a></Fragment></PageHeader>
	<RouteTabs client:load label="Events" tabs={[{ href: '/admin/events', label: 'Upcoming', current: !past }, { href: '/admin/events?tab=past', label: 'Past', current: past }]} />
	<EventsTable view={page} />
	<EventSheet slot="overlay" view={page} />
</PortalLayout>
