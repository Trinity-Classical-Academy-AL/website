---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { formatChicago, getFamily, listFamilies } from '@tca/school';
export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const families = await listFamilies('');
---
<PortalLayout title="Families — TCA Portal" current="/admin/families" roles={family.roles} name={family.name} email={family.email}>
	<header class="ahead"><div><h1>Families</h1><p class="soft">Enrolled families and other portal accounts.</p></div></header>
	{families.length === 0 ? <div class="empty"><p class="h3">No families yet</p></div> : (
		<div class="tbox"><table class="t"><thead><tr><th scope="col">Family</th><th scope="col">Phone</th><th scope="col">Joined</th></tr></thead><tbody>
			{families.slice(0, 200).map((row) => <tr><td><strong>{row.name || '—'}</strong><div class="sub">{row.email}</div></td><td>{row.phone || '—'}</td><td>{formatChicago(row.createdAt, false)}</td></tr>)}
		</tbody></table></div>
	)}
</PortalLayout>
