---
import PageHeader from '../../components/ui/PageHeader.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import FamiliesTable from '../../components/pages/families/FamiliesTable.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';

import { loadFamilies } from '../../lib/pages/families.ts';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const page = await loadFamilies(Astro, family);
if (page instanceof Response) return page;
const { q } = page;
---
<PortalLayout title="Families — TCA Portal" current="/admin/families" roles={family.roles} name={family.name} email={family.email}>
	<PageHeader><div><h1>Families</h1><p class="soft">Enrolled families. Guardians see the Family section.</p></div></PageHeader>
	<form class="tools" method="get" data-local-search={!q ? true : undefined}><input class="inp" name="q" value={q} placeholder="Search family" aria-label="Search family" /></form>
	<FamiliesTable view={page} />
	<EmptyState data-search-empty hidden><p class="h3">No families match your search</p></EmptyState>
</PortalLayout>
