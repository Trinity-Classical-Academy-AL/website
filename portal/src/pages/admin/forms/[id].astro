---
import SheetFooter from '../../../components/ui/SheetFooter.astro';
import SheetBody from '../../../components/ui/SheetBody.astro';
import SheetHeader from '../../../components/ui/SheetHeader.astro';
import Sheet from '../../../components/ui/Sheet.astro';
import ConfirmDialog from '../../../components/ui/ConfirmDialog.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import TBox from '../../../components/ui/TBox.astro';
import RowLink from '../../../components/ui/RowLink.astro';
import Toast from '../../../components/ui/Toast.astro';
import { runActions, toastFrom } from '../../../lib/actions.ts';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { csrfToken } from '../../../lib/security.ts';
import { formTracker, remindForm, trackerCsv } from '@tca/school';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
if (Astro.url.searchParams.get('export') === '1') {
	const tracker = await formTracker(Astro.params.id || '');
	if (!tracker) return Astro.redirect('/admin/documents?tab=forms');
	return trackerCsv(tracker);
}
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
const actionResult = await runActions(Astro, {
	remind: async () => {
		const count = await remindForm(Astro.params.id || '');
		return { redirect: count < 0 ? `/admin/forms/${Astro.params.id}?limited=1` : `/admin/forms/${Astro.params.id}?reminded=${count}` };
	},
});
if ('redirect' in actionResult) return Astro.redirect(actionResult.redirect, actionResult.status);
const tracker = await formTracker(Astro.params.id || '');
if (!tracker) return Astro.redirect('/admin/documents?tab=forms');
const filter = Astro.url.searchParams.get('status') || 'all';
const rows = tracker.rows.filter((row) => filter === 'missing' ? row.status !== 'submitted' : filter === 'submitted' ? row.status === 'submitted' : true);
const submitted = tracker.rows.filter((row) => row.status === 'submitted').length;
const missing = tracker.rows.filter((row) => row.status === 'missing').length;
const drafts = tracker.rows.filter((row) => row.status === 'draft').length;
const openRow = tracker.rows.find((row) => row.id === Astro.url.searchParams.get('submission'));
const toast = toastFrom(Astro.url, { reminded: count => `Reminder sent to ${count} families.` });

---
<PortalLayout title={`${tracker.title} — TCA Portal`} current="/admin/documents" roles={family.roles} name={family.name} email={family.email}>
	{toast && <Toast role="status"><span style="flex:1">{toast}</span></Toast>}
	{Astro.url.searchParams.get('limited') && <div class="alert alert-err" role="alert"><p class="at">Too many reminders. Wait 15 minutes.</p></div>}
	<a class="back" href="/admin/documents?tab=forms">Forms</a>
	<PageHeader actions={{ "class": "acts" }}><div><h1>{tracker.title}</h1><p class="soft">{tracker.audience === 'grade' ? tracker.grade : 'Everyone'} · one per student{tracker.dueOn ? ` · due ${tracker.dueOn}` : ''} · e-signature required</p></div>
		<Fragment slot="actions"><a class="btn btn-s btn-sm" href={`/admin/forms/${tracker.id}?export=1`}>Export CSV</a><a class="btn btn-s btn-sm" href={`/admin/documents?tab=forms&sheet=form`}>Edit form</a><a class="btn btn-p btn-sm" href={`/admin/forms/${tracker.id}?remind=1`}>Send reminder</a></Fragment>
	</PageHeader>
	<p class="soft">Submitted {submitted} / {tracker.rows.length || 0}. Missing {missing}. Draft started {drafts}.</p>
	<div class="acts"><a href={`/admin/forms/${tracker.id}`}>All · {tracker.rows.length}</a><a href={`/admin/forms/${tracker.id}?status=missing`}>Missing · {missing + drafts}</a><a href={`/admin/forms/${tracker.id}?status=submitted`}>Submitted · {submitted}</a></div>
	{rows.length === 0 ? <EmptyState><p class="h3">No students in this view</p></EmptyState> : <TBox><table class="t t-click"><thead><tr><th>Student</th><th>Grade</th><th>Status</th><th>Submitted</th></tr></thead><tbody>
		{rows.map((row) => <RowLink><td><strong>{row.student}</strong><div class="sub">{row.family}</div></td><td>{row.grade}</td><td>{row.status === 'submitted' ? 'Submitted' : row.status === 'draft' ? 'Draft started' : 'Missing'}</td><td>{row.status === 'submitted' ? <a href={`/admin/forms/${tracker.id}?submission=${row.id}`}>{row.submittedAt.slice(0, 10)} · {row.signature || 'View'}</a> : 'None'}</td></RowLink>)}
	</tbody></table></TBox>}
	{(
		<div slot="overlay"><ConfirmDialog overlay={{ "class": "ov", "hidden": Astro.url.searchParams.get('remind') !== '1' }} dialog={{ "class": "dlg", "role": "alertdialog", "aria-label": "Send reminder" }} openUrl={`/admin/forms/${tracker.id}?remind=1`} closeUrl={`/admin/forms/${tracker.id}`}><h2 class="h2">Send a reminder?</h2><p class="soft">Families who have not submitted get an email. Last reminder is recorded on each assignment.</p><form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="remind" /><div class="acts"><a class="btn btn-s" href={`/admin/forms/${tracker.id}`}>Cancel</a><button class="btn btn-p">Send reminder</button></div></form></ConfirmDialog></div>
	)}
	{openRow && (
		<div slot="overlay"><Sheet overlay={{ "class": "ov ov-side", "hidden": false }} dialog={{ "class": "ssheet", "role": "dialog", "aria-modal": "true", "aria-label": "Submission" }} openUrl={`/admin/forms/${tracker.id}?submission=${openRow.id}`} closeUrl={`/admin/forms/${tracker.id}`}><SheetHeader closeHref={`/admin/forms/${tracker.id}`}><div class="sh-tt"><h2 class="h2">{openRow.student}</h2><p class="mute">Submitted {openRow.submittedAt.slice(0, 16).replace('T', ' ')} by {openRow.signature}</p></div></SheetHeader><SheetBody>{Object.entries(openRow.answers).map(([key, value]) => <p><strong>{key.slice(0, 8)}</strong> {value}</p>)}<p>Signature {openRow.signature}</p><p class="mute">Signed electronically</p></SheetBody><SheetFooter><a class="btn btn-s" href={`/admin/forms/${tracker.id}`}>Close</a></SheetFooter></Sheet></div>
	)}
</PortalLayout>
