---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { csrfOk, csrfToken } from '../../lib/security.ts';
import { formatChicago, getFamily, listInquiries, setInquiryStatus } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (csrfOk(Astro.cookies, form)) {
		const status = String(form.get('status') ?? '');
		if (status === 'new' || status === 'contacted' || status === 'confirmed' || status === 'cancelled') {
			await setInquiryStatus(String(form.get('id') ?? ''), status);
		}
	}
	return Astro.redirect('/admin/inquiries');
}
const rows = await listInquiries();
const statuses = ['new', 'contacted', 'confirmed', 'cancelled'] as const;
---
<PortalLayout title="Inquiries — TCA Portal" current="/admin/inquiries" roles={family.roles} name={family.name} email={family.email}>
	<header class="ahead">
		<div><h1>Inquiries</h1><p class="soft">People who wrote in without booking a time, including “just send me updates.”</p></div>
		<div class="acts"><a class="btn btn-s btn-sm" href="/admin/inquiries-export">Export CSV</a></div>
	</header>
	{rows.length === 0 ? <div class="empty"><p class="h3">No inquiries</p><p class="mute">The public interest form shows up here.</p></div> : (
		<div class="tbox"><table class="t"><thead><tr><th scope="col">Received</th><th scope="col">Name</th><th scope="col">Contact</th><th scope="col">Message</th><th scope="col">Status</th></tr></thead><tbody>
			{rows.map((row) => (
				<tr>
					<td>{formatChicago(row.createdAt)}<div class="sub">{row.source}</div></td>
					<td><strong>{row.name || '—'}</strong></td>
					<td>{row.email}{row.phone ? <div class="sub">{row.phone}</div> : null}</td>
					<td>{row.message || '—'}{row.grades ? <div class="sub">{row.grades}</div> : null}</td>
					<td>
						<form method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="id" value={row.id} />
							<select name="status" class="inp" aria-label="Status" onchange="this.form.submit()">
								{statuses.map((status) => <option value={status} selected={row.status === status}>{status}</option>)}
							</select>
						</form>
					</td>
				</tr>
			))}
		</tbody></table></div>
	)}
</PortalLayout>
