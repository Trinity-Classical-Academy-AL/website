---
import SheetFooter from '../../components/ui/SheetFooter.astro';
import SheetBody from '../../components/ui/SheetBody.astro';
import SheetHeader from '../../components/ui/SheetHeader.astro';
import Sheet from '../../components/ui/Sheet.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import DataTable from '../../components/ui/DataTable.astro';
import Row from '../../components/ui/Row.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Check from '../../components/ui/Check.astro';
import { runActions } from '../../lib/actions.ts';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { FieldSelect } from '../../components/FieldSelect.tsx';
import { csrfToken } from '../../lib/security.ts';
import { TOUR_STATUSES, inquiryAutoReply, inquiryAutoReplyEnabled, inquiryDetailsText, incomingDetailsText, nextInquiryEvent, portalOrigin, writeSetting, formatChicago, listInquiries, setInquiryStatus } from '@tca/school';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const statuses = Object.values(TOUR_STATUSES).filter(status => status !== TOUR_STATUSES.PROPOSED);
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
const actionResult = await runActions(Astro, {
	autoreply: async (form) => {
		await writeSetting('inquiry_autoreply_enabled', form.get('enabled') === 'on');
		return { redirect: '/admin/inquiries' };
	},
}, {
	fallback: async (form) => {
		const status = statuses.find(status => status === form.get('status'));
		if (status) {
			await setInquiryStatus(String(form.get('id') ?? ''), status);
		}
		return { redirect: '/admin/inquiries' };
	},
});

if ('redirect' in actionResult) return Astro.redirect(actionResult.redirect, actionResult.status);
error = actionResult.error;
const rows = await listInquiries();
const enabled = await inquiryAutoReplyEnabled();
const preview = inquiryAutoReply({ firstName: 'Alex', event: await nextInquiryEvent(), portalOrigin: portalOrigin() });
const selected = rows.find((row) => row.id === Astro.url.searchParams.get('inquiry'));
---
<PortalLayout title="Inquiries — TCA Portal" current="/admin/inquiries" roles={family.roles} name={family.name} email={family.email}>
	<PageHeader actions={{ "class": "acts" }}>
		<div><h1>Inquiries</h1></div>
		<Fragment slot="actions"><a class="btn btn-s btn-sm" href="/admin/inquiries-export">Export CSV</a></Fragment>
	</PageHeader>
	{error && <p class="alert alert-err" role="alert">{error}</p>}
	<section class="card" style="margin-bottom:24px">
		<form method="post" data-astro-reload>
			<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="autoreply" />
			<Check><input type="checkbox" name="enabled" checked={enabled} /><span>Send an automatic reply to new inquiries<span class="d">Applies to new interview and interest form submissions. Off by default.</span></span></Check>
			{process.env.INQUIRY_AUTOREPLY === 'off' && <p class="small">Automatic replies are disabled by the environment kill switch.</p>}
			<button class="btn btn-s btn-sm">Save automatic reply setting</button>
		</form>
		<details><summary class="lbl">Preview automatic reply</summary><p><strong>Subject: {preview.subject}</strong></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit">{preview.text}</pre></details>
	</section>
	{rows.length === 0 ? <EmptyState><p class="h3">No inquiries</p><p class="mute">The public interest form shows up here.</p></EmptyState> : (
		<DataTable columns={['Received', 'Source', 'Name', 'Email', 'Phone', 'Message', 'Status']}>
			{rows.map((row) => (
				<Row href={`/admin/inquiries?inquiry=${row.id}`} data-row={row.id}>
					<td>{formatChicago(row.createdAt)}</td>
					<td>{row.source === 'interview' ? 'Interview request' : row.source}</td>
					<td><strong>{row.name || '—'}</strong></td>
					<td><a href={`mailto:${row.email}`}>{row.email}</a></td>
					<td>{row.phone || '—'}</td>
					<td class="trunc" title={row.message || undefined}>{row.message || '—'}{row.grades ? ` · ${row.grades}` : ''}</td>
					<td>
						<form method="post" data-enhance data-optimistic="status" data-optimistic-target={row.id} data-success="Status saved." data-status-value={row.status}><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="id" value={row.id} />
							<FieldSelect client:idle name="status" label="Status" value={row.status} submit options={statuses.map((status) => ({ value: status, label: status }))} />
						</form>
					</td>
				</Row>
			))}
		</DataTable>
	)}
	{selected && <div slot="overlay"><Sheet overlay={{ "class": "ov ov-side", "hidden": false }} dialog={{ "class": "ssheet", "role": "dialog", "aria-modal": "true", "aria-label": "Inquiry details" }} openUrl={`/admin/inquiries?inquiry=${selected.id}`} closeUrl={"/admin/inquiries"}><SheetHeader closeHref="/admin/inquiries"><h2 class="h2">{selected.name || selected.email}</h2></SheetHeader><SheetBody><p><a href={`mailto:${selected.email}`}>{selected.email}</a><br />{selected.phone}</p><p class="soft">{selected.source} · {selected.status} · {formatChicago(selected.createdAt)}</p><p>{selected.message}</p><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit">{selected.source === 'formaloo_interview' ? incomingDetailsText(selected.details as any) : inquiryDetailsText(selected.details)}</pre></SheetBody><SheetFooter><a class="btn btn-s btn-sm" href={`/admin/families?family=${selected.id}`}>Contact history</a><a class="btn btn-s" href="/admin/inquiries">Close</a></SheetFooter></Sheet></div>}
</PortalLayout>
