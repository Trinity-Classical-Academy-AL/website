---
import { runActions } from '../../lib/actions.ts';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { FieldSelect } from '../../components/FieldSelect.tsx';
import { csrfToken } from '../../lib/security.ts';
import { inquiryAutoReply, inquiryAutoReplyEnabled, inquiryDetailsText, nextInquiryEvent, portalOrigin, writeSetting, formatChicago, listInquiries, setInquiryStatus } from '@tca/school';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
const actionResult = await runActions(Astro, {
	autoreply: async (form) => {
		await writeSetting('inquiry_autoreply_enabled', form.get('enabled') === 'on');
		return { redirect: '/admin/inquiries' };
	},
}, {
	fallback: async (form) => {
		const status = String(form.get('status') ?? '');
		if (status === 'new' || status === 'contacted' || status === 'confirmed' || status === 'cancelled') {
			await setInquiryStatus(String(form.get('id') ?? ''), status);
		}
		return { redirect: '/admin/inquiries' };
	},
});

if ('redirect' in actionResult) return Astro.redirect(actionResult.redirect, actionResult.status);
error = actionResult.error;
const rows = await listInquiries();
const enabled = await inquiryAutoReplyEnabled();
const preview = inquiryAutoReply({ firstName: 'Alex', event: await nextInquiryEvent(), portalOrigin: portalOrigin() });
const selected = rows.find((row) => row.id === Astro.url.searchParams.get('inquiry'));
const statuses = ['new', 'contacted', 'confirmed', 'cancelled'] as const;
---
<PortalLayout title="Inquiries — TCA Portal" current="/admin/inquiries" roles={family.roles} name={family.name} email={family.email}>
	{error && <p class="alert alert-err" role="alert">{error}</p>}
	<header class="ahead">
		<div><h1>Inquiries</h1><p class="soft">People who wrote in without booking a time, including “just send me updates.”</p></div>
		<div class="acts"><a class="btn btn-s btn-sm" href="/admin/inquiries-export">Export CSV</a></div>
	</header>
	<section class="card" style="margin-bottom:24px">
		<form method="post" data-astro-reload>
			<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="autoreply" />
			<label class="chk"><input type="checkbox" name="enabled" checked={enabled} /><span>Send an automatic reply to new inquiries<span class="d">Applies to new interview and interest form submissions. Off by default.</span></span></label>
			{process.env.INQUIRY_AUTOREPLY === 'off' && <p class="small">Automatic replies are disabled by the environment kill switch.</p>}
			<button class="btn btn-s btn-sm">Save automatic reply setting</button>
		</form>
		<details><summary class="lbl">Preview automatic reply</summary><p><strong>Subject: {preview.subject}</strong></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit">{preview.text}</pre></details>
	</section>
	{rows.length === 0 ? <div class="empty"><p class="h3">No inquiries</p><p class="mute">The public interest form shows up here.</p></div> : (
		<div class="tbox"><table class="t"><thead><tr><th scope="col">Received</th><th scope="col">Name</th><th scope="col">Contact</th><th scope="col">Message</th><th scope="col">Status</th></tr></thead><tbody>
			{rows.map((row) => (
				<tr data-row={row.id}>
					<td>{formatChicago(row.createdAt)}<div class="sub">{row.source}</div></td>
					<td><a href={`/admin/inquiries?inquiry=${row.id}`}><strong>{row.name || '—'}</strong></a>{row.source === 'interview' && <div class="sub">Interview request</div>}</td>
					<td>{row.email}{row.phone ? <div class="sub">{row.phone}</div> : null}</td>
					<td>{row.message || '—'}{row.grades ? <div class="sub">{row.grades}</div> : null}</td>
					<td>
						<form method="post" data-enhance data-optimistic="status" data-success="Status saved." data-status-value={row.status}><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="id" value={row.id} />
							<FieldSelect client:load name="status" label="Status" value={row.status} submit options={statuses.map((status) => ({ value: status, label: status }))} />
						</form>
					</td>
				</tr>
			))}
		</tbody></table></div>
	)}
	{selected && <div slot="overlay"><div class="ov ov-side"><aside class="ssheet" role="dialog" aria-modal="true" aria-label="Inquiry details"><div class="sh-h"><h2 class="h2">{selected.name || selected.email}</h2><a class="sh-ic" href="/admin/inquiries" aria-label="Close">×</a></div><div class="sh-b"><p>{selected.email}<br />{selected.phone}</p><p class="soft">{selected.source} · {selected.status} · {formatChicago(selected.createdAt)}</p><p>{selected.message}</p><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit">{inquiryDetailsText(selected.details)}</pre></div><div class="sh-f"><a class="btn btn-s" href="/admin/inquiries">Close</a></div></aside></div></div>}
</PortalLayout>
