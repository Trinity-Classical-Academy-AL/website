---
/**
 * Prospects is now the Prospects tab of Families. Old links (bookmarks, digest
 * emails) keep working: tabs and filters map across, ?contact=<id> opens that family.
 */
export const prerender = false;
const from = Astro.url.searchParams;
const to = new URL('/admin/families?tab=prospects', Astro.url);
if (from.get('tab') === 'updates') to.searchParams.set('stage', 'updates');
const filter = from.get('filter');
if (filter && ['new', 'overdue', 'contacted', 'confirmed', 'cancelled'].includes(filter)) to.searchParams.set('filter', filter);
const received = from.get('prior') === '1' ? 'all' : from.get('received');
if (received) to.searchParams.set('activity', received);
for (const key of ['q', 'contacted']) if (from.get(key)) to.searchParams.set(key, from.get(key)!);
if (from.get('contact')) to.searchParams.set('family', from.get('contact')!);
return Astro.redirect(to.pathname + to.search, 301);
---
