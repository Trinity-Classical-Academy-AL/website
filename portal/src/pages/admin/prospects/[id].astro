---
/** Prospect and enrolled families share one page now: /admin/families/:id. */
export const prerender = false;
const to = new URL(`/admin/families/${Astro.params.id}`, Astro.url);
if (Astro.url.searchParams.get('enroll') === '1') to.searchParams.set('enroll', '1');
return Astro.redirect(to.pathname + to.search, 301);
---
