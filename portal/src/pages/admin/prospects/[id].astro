---
import ContactEmail from '../../../components/pages/prospects/ContactEmail.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import ConfirmDialog from '../../../components/ui/ConfirmDialog.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Toast from '../../../components/ui/Toast.astro';
import Badge from '../../../components/ui/Badge.astro';
import { runActions, toastFrom } from '../../../lib/actions.ts';
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { csrfToken } from '../../../lib/security.ts';
import { familyTourView, incomingDate, formatChicago, getFamily, grantRoles, listProspectChildren, readStaffNote, saveStaffNote } from '@tca/school';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const prospect = await getFamily(Astro.params.id || '');
if (!prospect) return Astro.redirect('/admin/prospects');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
const actionResult = await runActions(Astro, {
	enroll: async () => {
		const roles = Array.from(new Set([...prospect.roles.filter((role) => role !== 'prospect'), 'guardian' as const]));
		await grantRoles(prospect.id, roles);
		return { redirect: `/admin/prospects/${prospect.id}?enrolled=1` };
	},
}, {
	fallback: async (form) => {
		await saveStaffNote(prospect.id, String(form.get('note') ?? ''));
		return { redirect: `/admin/prospects/${prospect.id}?noted=1` };
	},
});

if ('redirect' in actionResult) return Astro.redirect(actionResult.redirect, actionResult.status);
error = actionResult.error;
const [kids, tour, note] = await Promise.all([listProspectChildren(prospect.id), familyTourView(prospect.id), readStaffNote(prospect.id)]);
const enrolled = Astro.url.searchParams.get('enrolled') === '1';
const confirming = Astro.url.searchParams.get('enroll') === '1';
const enrolledToast = enrolled ? toastFrom(Astro.url, { enrolled: () => `${prospect.name || 'This prospect'} is enrolled. Add students from Families.` }) : '';
const notedToast = toastFrom(Astro.url, { noted: 'Note saved.' });

---
<PortalLayout title={`${prospect.name || 'Prospect'} — TCA Portal`} current="/admin/prospects" roles={family.roles} name={family.name} email={family.email}>
	{error && <p class="alert alert-err" role="alert">{error}</p>}
	{enrolledToast && <Toast role="status"><span style="flex:1">{enrolledToast}</span></Toast>}
	{notedToast && <Toast role="status"><span style="flex:1">{notedToast}</span></Toast>}
	<a class="back" href="/admin/prospects">Prospects</a>
	<PageHeader actions={{ "class": "acts" }}><div><h1>{prospect.name || prospect.email}</h1><p class="soft">Prospect · joined {formatChicago(prospect.createdAt, false)}</p></div><Fragment slot="actions">{!prospect.roles.includes('guardian') && <a class="btn btn-p btn-sm" href={`/admin/prospects/${prospect.id}?enroll=1`}>Mark enrolled</a>}</Fragment></PageHeader>
	<div class="two">
		<section class="card"><h2 class="h2">Profile</h2><p><strong>Email</strong> <ContactEmail id={prospect.id} email={prospect.email} csrf={csrf} label={`${family.email} · ${incomingDate(new Date().toISOString())}`} account/> <ContactEmail id={prospect.id} email={prospect.email} csrf={csrf} label={`${family.email} · ${incomingDate(new Date().toISOString())}`} account pill/></p>{prospect.emailVerifiedAt && <p class="mute">Signed up with a verified email.</p>}</section>
		<section class="card"><h2 class="h2">Family</h2>{kids.children.length === 0 ? <EmptyState as="p" class="mute">No children yet.</EmptyState> : kids.children.map((child) => <p><strong>{child.firstName}</strong> <span class="mute">{child.grade}{child.schoolYear ? ` · ${child.schoolYear}` : ''}</span></p>)}{kids.note && <p class="soft">Note: {kids.note}</p>}</section>
	</div>
	<section class="card" style="margin-top:16px"><h2 class="h2">Tours</h2>{tour.holds.length === 0 ? <EmptyState as="p" class="mute">No tour yet.</EmptyState> : tour.holds.map((hold) => <p>{hold.when || hold.otherTime || hold.proposedWhen} · {hold.headCount} people <Badge class="badge b-gray">{hold.status}</Badge></p>)}</section>
	<section class="card" style="margin-top:16px">
		<h2 class="h2">Staff notes</h2>
		<form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><textarea name="note" class="inp" rows="4">{note}</textarea><button class="btn btn-p" style="margin-top:12px">Save note</button></form>
	</section>
	{(
		<div slot="overlay"><ConfirmDialog overlay={{ "class": "ov", "hidden": !confirming }} dialog={{ "class": "dlg", "role": "alertdialog", "aria-modal": "true", "aria-label": "Mark enrolled" }} openUrl={`/admin/prospects/${prospect.id}?enroll=1`} closeUrl={`/admin/prospects/${prospect.id}`}><h2 class="h2">Mark {prospect.name || 'this prospect'} as enrolled?</h2><p class="soft">They’ll see the Family section. Add students from Families.</p><div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href={`/admin/prospects/${prospect.id}`}>Cancel</a><form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="enroll" /><button class="btn btn-p">Mark enrolled</button></form></div></ConfirmDialog></div>
	)}
</PortalLayout>
