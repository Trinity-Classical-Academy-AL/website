---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { csrfOk, csrfToken } from '../../lib/security.ts';
import { getFamily, inviteStaff, listFamilies } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let notice = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') ?? '').trim();
	if (csrfOk(Astro.cookies, form) && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
		const result = await inviteStaff(email);
		notice = result === 'granted' ? 'That account can now open Admin.' : 'They’ll have Admin when they finish creating the account.';
	}
}
const staff = [];
for (const row of await listFamilies('')) {
	const full = await getFamily(row.id);
	if (full?.roles.includes('admin')) staff.push(full);
}
---
<PortalLayout title="Staff — TCA Portal" current="/admin/staff" roles={family.roles} name={family.name} email={family.email}>
	<header class="ahead">
		<div><h1>Staff</h1><p class="soft">People with Admin access. They sign in with a school email.</p></div>
		<div class="acts"><a class="btn btn-p btn-sm" href="#invite">Invite staff</a></div>
	</header>
	{notice && <p class="alert alert-ok" role="status">{notice}</p>}
	<div class="tbox">
		<table class="t">
			<thead><tr><th scope="col">Name</th></tr></thead>
			<tbody>
				{staff.map((person) => (
					<tr><td><strong>{person.name || person.email}</strong><div class="sub">{person.email}</div></td></tr>
				))}
			</tbody>
		</table>
	</div>
	<section class="card narrow" id="invite" style="margin-top:16px">
		<div class="card-h"><h2 class="h2">Invite staff</h2></div>
		<form class="form" method="post">
			<input type="hidden" name="csrf" value={csrf} />
			<div class="field"><label class="lbl" for="email">Email</label><input id="email" name="email" class="inp" type="email" placeholder="name@example.com" required /></div>
			<button class="btn btn-p">Invite</button>
		</form>
	</section>
</PortalLayout>
