---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { csrfOk, csrfToken } from '../../lib/security.ts';
import { addTourSlot, formatChicago, getFamily, listAdminTours, listTourSlotSummary, setTourHoldStatus } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (String(form.get('action') ?? '') === 'slot') {
		const result = await addTourSlot({
			date: String(form.get('date') ?? ''),
			start: String(form.get('start') ?? ''),
			end: String(form.get('end') ?? ''),
			capacity: Number(form.get('capacity') || 1),
		});
		if (!result.ok) error = result.error;
	} else if (String(form.get('action') ?? '') === 'status') {
		const status = String(form.get('status') ?? '');
		if (status === 'new' || status === 'contacted' || status === 'confirmed' || status === 'cancelled') {
			await setTourHoldStatus(String(form.get('id') ?? ''), status);
		}
	}
	if (!error) return Astro.redirect('/admin/tours');
}
const rows = await listAdminTours();
const slots = await listTourSlotSummary();
const statuses = ['new', 'contacted', 'confirmed', 'cancelled'] as const;
---
<PortalLayout title="Tours — TCA Portal" current="/admin/tours" roles={family.roles} name={family.name} email={family.email}>
	<header class="phead">
		<div><h1 class="h1">Tours</h1><p class="lead">One family per seeded Wednesday morning. Add another slot when you need a second time.</p></div>
		<a class="btn btn-s" href="/admin/tours-export">Download CSV</a>
	</header>
	<section class="card">
		<h2 class="h2">Add a slot</h2>
		{error && <p class="alert alert-err" role="alert">{error}</p>}
		<form class="form" method="post">
			<input type="hidden" name="csrf" value={csrf} />
			<input type="hidden" name="action" value="slot" />
			<div class="f2">
				<div class="field"><label class="lbl" for="date">Date</label><input id="date" name="date" class="inp" type="date" required /></div>
				<div class="field"><label class="lbl" for="capacity">Families</label><input id="capacity" name="capacity" class="inp" type="number" min="1" max="20" value="1" /></div>
				<div class="field"><label class="lbl" for="start">Start</label><input id="start" name="start" class="inp" type="time" value="08:00" required /></div>
				<div class="field"><label class="lbl" for="end">End</label><input id="end" name="end" class="inp" type="time" value="09:00" required /></div>
			</div>
			<button class="btn btn-p">Add slot</button>
		</form>
	</section>
	<section class="card" style="margin-top:16px">
		<h2 class="h2">Slots</h2>
		{slots.map((slot) => <p class="r"><span>{slot.when}</span><span class="mute">{slot.taken >= slot.capacity ? 'Full' : 'Open'} · {slot.capacity} {slot.capacity === 1 ? 'family' : 'families'}</span></p>)}
	</section>
	<section class="card" style="margin-top:16px">
		<h2 class="h2">Bookings and other times</h2>
		{rows.length === 0 ? <p class="soft">No requests yet. The January, February, and March 2027 Wednesday mornings are ready.</p> : (
			<div class="tbox"><table class="t"><thead><tr><th>When</th><th>Family</th><th>Contact</th><th>Grades</th><th>Note</th><th>Status</th></tr></thead><tbody>
				{rows.map((row) => (
					<tr>
						<td>{row.kind === 'slot' ? row.when : 'Another time'}<div class="mute">{row.kind === 'other' ? row.otherTime : formatChicago(row.createdAt)}</div></td>
						<td>{row.familyName || '—'}</td>
						<td>{row.email}{row.phone ? <div class="mute">{row.phone}</div> : null}</td>
						<td>{row.grades || '—'}</td>
						<td>{row.note || '—'}</td>
						<td>
							<form method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="status" /><input type="hidden" name="id" value={row.id} />
								<select name="status" class="inp" style="width:140px" onchange="this.form.submit()">
									{statuses.map((status) => <option value={status} selected={row.status === status}>{status}</option>)}
								</select>
							</form>
						</td>
					</tr>
				))}
			</tbody></table></div>
		)}
	</section>
</PortalLayout>
