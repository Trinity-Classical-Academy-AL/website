---
/**
 * Tours live on the calendar now: tour times and weekly tours are Tour items,
 * and bookings and time requests are in Calendar → RSVPs. Old links land there.
 */
export const prerender = false;
const params = Astro.url.searchParams;
const tab = params.get('tab');
if (tab === 'requests') return Astro.redirect(`/admin/calendar/rsvps?show=reply${params.get('reply') ? `&reply=${params.get('reply')}` : ''}`);
if (tab === 'bookings') return Astro.redirect('/admin/calendar/rsvps?kind=booking');
if (params.get('slot')) return Astro.redirect(`/admin/calendar?item=tour:${encodeURIComponent(params.get('slot')!)}`);
return Astro.redirect('/admin/calendar?type=tour');
---
