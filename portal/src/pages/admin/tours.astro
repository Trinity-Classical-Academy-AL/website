---
import { TOUR_BOOKING_WINDOWS, tourBookingWindowLabel } from '../../lib/tour-series.ts';
import { runActions, redirectOnSuccess, toastFrom, fieldErrorMessage } from '../../lib/actions.ts';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { RouteTabs } from '../../components/RouteTabs.tsx';
import { csrfToken } from '../../lib/security.ts';
import { formatUsDate, longDate, parseClock, parseUsDate, shortDate } from '../../lib/fields.ts';
import {
	TOUR_STATUSES,
	addTourSlot,
	chicagoToday, deleteTourSeries, listSeries, nextSeriesDates, saveSeries, skipTourSeriesDate, WEEKDAYS,
	declineTourRequest,
	deleteTourSlot,
	formatChicago,
	formatTourClock,
	listAdminTours,
	listTourSlotSummary,
	replyToTourRequest,
	slotTypeLabel,
	updateTourSlot,
} from '@tca/school';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
const requested = Astro.url.searchParams.get('tab');
let tab = requested === 'requests' || requested === 'bookings' ? requested : 'times';
let error = '';
let fields: Record<string, string> = {};
let draft = { type: 'tour', date: '', start: '9:00 AM', end: '10:00 AM', capacity: '1', capacityUnit: 'families', repeats: 'none', weekdays: [] as number[], startsOn: '', endsOn: '', bookingWindowDays: '92', published: true, message: '', mode: String(TOUR_STATUSES.CONFIRMED) };
const actionResult = await runActions(Astro, {
	slot: async (form) => {
		if (draft.repeats === 'weekly') {
			return redirectOnSuccess(await saveSeries({ id: String(form.get('seriesId') || '') || undefined, type: draft.type, weekdays: draft.weekdays,
				startsOn: parseUsDate(draft.startsOn), endsOn: parseUsDate(draft.endsOn), start: parseClock(draft.start), end: parseClock(draft.end),
				capacity: Number(draft.capacity), capacityUnit: draft.capacityUnit === 'people' ? 'people' : 'families', published: draft.published, bookingWindowDays: draft.bookingWindowDays === '' ? null : Number(draft.bookingWindowDays) }), result => `/admin/tours?saved=${result.id}`);
		}
		const date = parseUsDate(draft.date);
		const start = parseClock(draft.start);
		const end = parseClock(draft.end);
		const capacity = Number(draft.capacity);
		const fields: Record<string, string> = {};
		if (!date) fields.date = 'Enter a date.';
		if (!start || !end || start >= end) fields.end = 'End must be after start.';
		if (!Number.isInteger(capacity) || capacity < 1) fields.capacity = 'Capacity must be at least 1.';
		if (Object.keys(fields).length) return { error: fieldErrorMessage(fields), fields };
		const id = String(form.get('id') ?? '');
		const input = { date, start, end, capacity, capacityUnit: draft.capacityUnit === 'people' ? 'people' as const : 'families' as const, type: draft.type, published: draft.published };
		if (id) return redirectOnSuccess(await updateTourSlot({ id, ...input }), `/admin/tours?saved=${id}`);
		return redirectOnSuccess(await addTourSlot(input), result => `/admin/tours?saved=${result.id}`);
	},
	'rule-delete': async (form) => redirectOnSuccess(await deleteTourSeries(String(form.get('id') ?? '')), '/admin/tours?removed=1'),
	skip: changeSeriesDate,
	restore: changeSeriesDate,
	delete: async (form) => redirectOnSuccess(await deleteTourSlot(String(form.get('id') ?? '')), '/admin/tours?removed=1'),
	reply: async (form) => redirectOnSuccess(await replyToTourRequest({
		id: String(form.get('id') ?? ''), date: parseUsDate(draft.date), start: parseClock(draft.start), end: parseClock(draft.end),
		mode: draft.mode === TOUR_STATUSES.PROPOSED ? TOUR_STATUSES.PROPOSED : TOUR_STATUSES.CONFIRMED, message: draft.message,
	}), '/admin/tours?tab=requests&sent=1'),
	decline: async (form) => {
		await declineTourRequest(String(form.get('id') ?? ''));
		return { redirect: '/admin/tours?tab=requests&declined=1' };
	},
}, {
	draftFrom: (form) => {
		const posted = String(form.get('tab') ?? '');
		if (posted === 'requests' || posted === 'bookings' || posted === 'times') tab = posted;
		draft = {
			type: String(form.get('type') ?? 'tour'), date: String(form.get('date') ?? ''), start: String(form.get('start') ?? ''), end: String(form.get('end') ?? ''),
			capacity: String(form.get('capacity') ?? '1'), capacityUnit: String(form.get('capacityUnit') ?? 'families'), repeats: String(form.get('repeats') ?? 'none'),
			weekdays: form.getAll('weekdays').map(Number), startsOn: String(form.get('startsOn') ?? ''), endsOn: String(form.get('endsOn') ?? ''),
			bookingWindowDays: String(form.get('bookingWindowDays') ?? '92'), published: form.get('published') === 'on', message: String(form.get('message') ?? ''), mode: String(form.get('mode') ?? TOUR_STATUSES.CONFIRMED),
		};
		return draft;
	},
});
async function changeSeriesDate(form: FormData, { action }: { action: string }) {
	const id = String(form.get('id') ?? '');
	return redirectOnSuccess(await skipTourSeriesDate(id, String(form.get('skipDate') ?? ''), action === 'restore'), `/admin/tours?rule=${id}`);
}

if ('redirect' in actionResult) return Astro.redirect(actionResult.redirect, actionResult.status);
error = actionResult.error;
fields = actionResult.fields;
const [slots, rows, allSeries] = await Promise.all([listTourSlotSummary(), listAdminTours(), listSeries()]);
const rules = allSeries.filter(series => ['tour', 'open_house', 'info_night'].includes(series.type));
const oneOffs = slots.filter(slot => !slot.seriesId);
const requests = rows.filter((row) => row.kind === 'other' && row.status !== TOUR_STATUSES.CANCELLED && row.status !== TOUR_STATUSES.CONFIRMED);
const bookings = rows.filter((row) => row.kind === 'slot' && row.status !== TOUR_STATUSES.CANCELLED);
const seriesId = Astro.url.searchParams.get('rule') || '';
const editingRule = rules.find(rule => rule.id === seriesId);
const editingId = seriesId || Astro.url.searchParams.get('slot') || '';
const adding = Astro.url.searchParams.get('sheet') === 'add' || (error && tab === 'times' && !editingId);
const editing = editingRule ? { ...editingRule, date: editingRule.startsOn, taken: editingRule.families } : slots.find((slot) => slot.id === editingId);
const editHref = editingRule ? `/admin/tours?rule=${editingId}` : `/admin/tours?slot=${editingId}`;
const skipDate = Astro.url.searchParams.get('skip') || '';
const skipSlot = slots.find(slot => slot.seriesId === seriesId && slot.date === skipDate);
const skipFamilies = skipSlot?.families ?? 0;
const confirmingSkip = Boolean(editingRule && skipDate && Astro.url.searchParams.get('confirm') === skipDate);
const repeats = error ? draft.repeats : editingRule ? 'weekly' : 'none';
const selectedDays = error ? draft.weekdays : editingRule?.weekdays ?? [];
const confirmingDelete = Astro.url.searchParams.get('confirm') === editingId && Boolean(editing);
const replying = requests.find((row) => row.id === (Astro.url.searchParams.get('reply') || ''));
const savedId = Astro.url.searchParams.get('saved') || '';
const toast = toastFrom(Astro.url, { saved: 'Time saved.', removed: 'Time deleted.', sent: 'Reply sent.', declined: 'Request declined.' });
const query = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const whenFilter = Astro.url.searchParams.get('when') || '';
const visibleBookings = bookings.filter((row) => {
	if (whenFilter && row.slotId !== whenFilter) return false;
	if (!query) return true;
	return `${row.familyName} ${row.email} ${row.note}`.toLowerCase().includes(query);
});
const groups = new Map<string, typeof visibleBookings>();
for (const row of visibleBookings) {
	const key = row.slotId || row.when;
	groups.set(key, [...(groups.get(key) ?? []), row]);
}
const clock = (start: string, end: string) => `${formatTourClock(start)} to ${formatTourClock(end)}`;
const openHref = (slotId: string) => `/admin/tours?slot=${slotId}`;
---
<PortalLayout title="Tours & scheduling — TCA Portal" current="/admin/tours" roles={family.roles} name={family.name} email={family.email}>
	{toast && <div class="toast t-ok" role="status"><svg class="lead-ic" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m5 12 5 5L20 7"/></svg><span style="flex:1">{toast}</span><a href={tab === 'times' ? '/admin/tours' : `/admin/tours?tab=${tab}`} aria-label="Dismiss">×</a></div>}
	<header class="ahead">
		<div><h1>Tours & scheduling</h1></div>
		<div class="acts" style="flex-wrap:nowrap">
			{(tab === 'times' || tab === 'bookings') && <a class="btn btn-s btn-sm" href="/admin/tours-export"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>Export CSV</a>}
			{tab === 'times' && <a class="btn btn-p btn-sm" href="/admin/tours?sheet=add"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14"/></svg>Add time</a>}
		</div>
	</header>
	<RouteTabs client:load label="Sections" tabs={[
		{ href: '/admin/tours', label: 'Times', current: tab === 'times' },
		{ href: '/admin/tours?tab=requests', label: 'Time requests', current: tab === 'requests' },
		{ href: '/admin/tours?tab=bookings', label: 'Bookings', current: tab === 'bookings' },
	]} />
	{tab === 'times' && (oneOffs.length === 0 && rules.length === 0 ? (
		<section class="card"><div class="empty"><p class="h3">No times yet</p><p class="mute" style="max-width:520px">Add a campus tour, open house or info night. Published times show on the website and in Request a tour.</p><div style="margin-top:4px"><a class="btn btn-p btn-sm" href="/admin/tours?sheet=add">Add time</a></div></div></section>
	) : (
		<>
			<div class="tbox"><table class="t t-click"><thead><tr><th scope="col">Type</th><th scope="col">When</th><th scope="col">Time</th><th scope="col">Booked</th><th scope="col">Status</th><th scope="col" aria-label="Open"></th></tr></thead><tbody>
				{rules.map(rule => <tr class:list={['rowlink', rule.id === savedId && 'hl']} data-rule-row={rule.id}>
					<td><strong>{slotTypeLabel(rule.type)}</strong><div class="sub">{tourBookingWindowLabel(rule.bookingWindowDays)}</div></td>
					<td>Every {rule.weekdays.map(d => WEEKDAYS[d]).join(' & ')} · {formatUsDate(rule.startsOn)} – {formatUsDate(rule.endsOn)}</td>
					<td>{clock(rule.start, rule.end)}</td>
					<td>{rule.families} upcoming {rule.families === 1 ? 'booking' : 'bookings'}</td>
					<td><span class:list={['badge', rule.published ? 'b-green' : 'b-gray']}>{rule.published ? 'Published' : 'Unpublished'}</span></td>
					<td class="go"><a href={`/admin/tours?rule=${rule.id}`} aria-label="Open"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m9 6 6 6-6 6"/></svg></a></td>
				</tr>)}
				{oneOffs.map((slot) => (
					<tr class:list={['rowlink', slot.id === savedId && 'hl']}>
						<td><strong>{slotTypeLabel(slot.type)}</strong></td>
						<td>{longDate(slot.date)}</td>
						<td>{clock(slot.start, slot.end)}</td>
						<td>{slot.taken} / {slot.capacity} {slot.capacityUnit === 'families' ? (slot.capacity === 1 ? 'family' : 'families') : 'people'}</td>
						<td>{slot.taken >= slot.capacity ? <span class="badge b-gray">Full</span> : slot.published ? <span class="badge b-green">Published</span> : <span class="badge b-gray">Unpublished</span>}</td>
						<td class="go"><a href={openHref(slot.id)} aria-label="Open"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m9 6 6 6-6 6"/></svg></a></td>
					</tr>
				))}
			</tbody></table></div>
			<p class="mute" style="margin-top:10px">Select a row to edit it.</p>
		</>
	))}
	{tab === 'requests' && (requests.length === 0 ? <div class="empty"><p class="h3">No time requests</p><p class="mute">Requests for times outside the published schedule show here.</p></div> : (
		<div class="tbox"><table class="t t-click"><thead><tr><th scope="col">Family</th><th scope="col">Requested</th><th scope="col">Preferred</th><th scope="col">People</th><th scope="col">Note</th><th scope="col" aria-label="Open"></th></tr></thead><tbody>
			{requests.map((row) => (
				<tr class="rowlink">
					<td><strong>{row.familyName || '—'}</strong><div class="sub">{row.email}</div></td>
					<td>{formatChicago(row.createdAt, false)}</td>
					<td>{row.otherTime || '—'}</td>
					<td>{row.headCount} {row.headCount === 1 ? 'person' : 'people'}</td>
					<td>{row.note || 'None'}</td>
					<td class="go"><a href={`/admin/tours?tab=requests&reply=${row.id}`} aria-label="Reply"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m9 6 6 6-6 6"/></svg></a></td>
				</tr>
			))}
		</tbody></table></div>
	))}
	{tab === 'bookings' && (
		<>
			<form class="tools" method="get" data-local-search={!query ? true : undefined}>
				<input type="hidden" name="tab" value="bookings" />
				<select class="inp inp-auto" name="when" aria-label="Time" onchange="this.form.requestSubmit()">
					<option value="">All upcoming</option>
					{slots.filter(slot => slot.date >= chicagoToday()).map((slot) => <option value={slot.id} selected={whenFilter === slot.id}>{shortDate(slot.date)}</option>)}
				</select>
				<input class="inp" name="q" value={query} placeholder="Search family or note" aria-label="Search" />
			</form>
			{groups.size === 0 ? <div class="empty"><p class="h3">No bookings</p><p class="mute">Confirmed visits show here, grouped by time.</p></div> : [...groups.entries()].map(([key, group]) => {
				const slot = slots.find((item) => item.id === key);
				const people = group.reduce((sum, row) => sum + row.headCount, 0);
				return (
					<section data-search-group class="stack g8" style="margin-bottom:20px">
						<h2 class="h3">{slot ? `${slotTypeLabel(slot.type)} · ${shortDate(slot.date)}` : group[0].when} <span class="mute">{slot?.capacityUnit === 'families' ? `${group.length} of ${slot.capacity} ${slot.capacity === 1 ? 'family' : 'families'}` : `${people} of ${slot?.capacity ?? people} people`}</span></h2>
						<div class="tbox"><table class="t"><thead><tr><th scope="col">Family</th><th scope="col">People</th><th scope="col">Note</th><th scope="col">Booked</th></tr></thead><tbody>
							{group.map((row) => (
								<tr data-search-row={`${row.familyName} ${row.email} ${row.note}`}>
									<td><strong>{row.familyName || '—'}</strong><div class="sub">{row.email}</div></td>
									<td>{row.headCount}</td>
									<td>{row.note || 'None'}</td>
									<td>{formatChicago(row.createdAt, false)}</td>
								</tr>
							))}
						</tbody></table></div>
					</section>
				);
			})}
			<div class="empty" data-search-empty hidden><p class="h3">No bookings match your search</p></div>
		</>
	)}
	{(tab === 'times' || adding || editing) && (
		<div slot="overlay">
			<div class="ov ov-side" data-time-sheet hidden={!adding && !editing} data-instant-dialog-url={!editing ? "/admin/tours?sheet=add" : undefined} data-instant-dialog-close="/admin/tours">
				<aside class="ssheet" role="dialog" aria-modal="true" aria-label={editing ? 'Edit time' : 'Add a time'}>
					<div class="sh-h"><div class="sh-tt"><h2 class="h2">{editing ? 'Edit time' : 'Add a time'}</h2>{editing && <p class="mute">{slotTypeLabel(editing.type)} · {editingRule ? `Every ${editingRule.weekdays.map(d => WEEKDAYS[d]).join(' & ')}` : shortDate(editing.date)}</p>}</div><a class="sh-ic" href="/admin/tours" aria-label="Close"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 6l12 12M18 6 6 18"/></svg></a></div>
					<form class="form" method="post" id="slot-form" data-time-form data-enhance data-optimistic="close-sheet">
						<div class="sh-b">
							{error && <div class="alert alert-err" role="alert"><div class="stack g4"><p class="at">{error}</p></div></div>}
							{editing && editing.families > 0 && <div class="sh-note"><span><strong>{editing.families} {editing.families === 1 ? 'family' : 'families'} booked</strong>{editing.capacityUnit === 'people' ? ` · ${editing.taken} people` : ''}</span></div>}
							<input type="hidden" name="csrf" value={csrf} />
							<input type="hidden" name="action" value="slot" />
							<input type="hidden" name="tab" value="times" />
							{editing && <input type="hidden" name={editingRule ? "seriesId" : "id"} value={editing.id} />}
							<fieldset class="field" style="border:0;padding:0;margin:0">
								<legend class="lbl" style="padding:0;margin-bottom:6px">Type</legend>
								<div class="chips">
									{[['tour', 'Campus tour'], ['open_house', 'Open house'], ['info_night', 'Info night']].map(([value, label]) => (
										<label class="chip"><input type="radio" name="type" value={value} checked={(error ? draft.type : editing?.type ?? 'tour') === value} />{label}</label>
									))}
								</div>
							</fieldset>
							<fieldset class="field" style="border:0;padding:0;margin:0"><legend class="lbl">Repeats</legend><div class="chips">
								<label class="chip"><input type="radio" name="repeats" value="none" checked={repeats !== 'weekly'} disabled={Boolean(editingRule)} />Does not repeat</label>
								<label class="chip"><input type="radio" name="repeats" value="weekly" checked={repeats === 'weekly'} disabled={Boolean(editing && !editingRule)} />Weekly</label>
							</div></fieldset>
							<div data-once hidden={repeats === 'weekly'}><div class="field"><label class="lbl" for="date">Date</label><input id="date" name="date" class:list={['inp', fields.date && 'bad']} type="text" placeholder="MM/DD/YYYY" value={error ? draft.date : editing ? formatUsDate(editing.date) : ''} aria-invalid={fields.date ? 'true' : undefined} />{fields.date && <p class="errm"><span>{fields.date}</span></p>}</div></div>
							<div data-weekly hidden={repeats !== 'weekly'} class="stack g16">
								<fieldset class="field" style="border:0;padding:0;margin:0"><legend class="lbl">Weekdays</legend><div class="chips">{[1,2,3,4,5].map(day => <label class="chip"><input type="checkbox" name="weekdays" value={day} checked={selectedDays.includes(day)} />{WEEKDAYS[day]}</label>)}</div>{fields.weekdays && <p class="errm"><span>{fields.weekdays}</span></p>}</fieldset>
								<div class="f2">{([['startsOn','Starts on'], ['endsOn','Ends on']] as const).map(([key,label]) => <div class="field"><label class="lbl" for={key}>{label}</label><input class:list={['inp', fields[key] && 'bad']} id={key} name={key} placeholder="MM/DD/YYYY" value={error ? draft[key] : editingRule ? formatUsDate(editingRule[key]) : ''} aria-invalid={fields[key] ? 'true' : undefined} />{fields[key] && <p class="errm"><span>{fields[key]}</span></p>}</div>)}</div>
								<div class="field"><label class="lbl" for="bookingWindowDays">Bookable up to</label><select id="bookingWindowDays" name="bookingWindowDays" class="inp" aria-describedby="bookingWindowHint">
									{TOUR_BOOKING_WINDOWS.map(([value, label]) => <option value={value} selected={(error ? draft.bookingWindowDays : editingRule ? String(editingRule.bookingWindowDays ?? '') : '92') === value}>{label}</option>)}
								</select><p id="bookingWindowHint" class="hint">How far ahead families can book.</p>{fields.bookingWindowDays && <p class="errm"><span>{fields.bookingWindowDays}</span></p>}</div>
							</div>
							<div class="f2">
								<div class="field"><label class="lbl" for="start">Start</label><input id="start" name="start" class="inp" type="text" value={error ? draft.start : editing ? formatTourClock(editing.start) : '9:00 AM'} /></div>
								<div class="field"><label class="lbl" for="end">End</label><input id="end" name="end" class:list={['inp', fields.end && 'bad']} type="text" value={error ? draft.end : editing ? formatTourClock(editing.end) : '10:00 AM'} aria-invalid={fields.end ? 'true' : undefined} />{fields.end && <p class="errm"><span>{fields.end}</span></p>}</div>
							</div>
							<div class="field"><label class="lbl" for="capacity">Capacity</label><div class="chips">{[['families','Families'], ['people','People']].map(([value,label]) => <label class="chip"><input type="radio" name="capacityUnit" value={value} checked={(error ? draft.capacityUnit : editing?.capacityUnit ?? 'families') === value} />{label}</label>)}</div><p class="hint" data-people-hint hidden={(error ? draft.capacityUnit : editing?.capacityUnit ?? 'families') !== 'people'}>People, including children.</p><input id="capacity" name="capacity" class:list={['inp', fields.capacity && 'bad']} type="number" min="1" value={error ? draft.capacity : editing ? String(editing.capacity) : '1'} aria-invalid={fields.capacity ? 'true' : undefined} />{fields.capacity && <p class="errm"><span>{fields.capacity}</span></p>}</div>
							<label class="chk"><input type="checkbox" name="published" checked={error ? draft.published : editing ? editing.published : true} /><span>Published<span class="d">Shows on the website and in Request a tour.</span></span></label>
							{editingRule && <div class="stack g8"><h3 class="h3">Next dates</h3><div class="tbox"><table class="t" style="min-width:0"><thead><tr><th scope="col">Date</th><th scope="col">Status</th><th scope="col"></th></tr></thead><tbody>{nextSeriesDates(editingRule, editingRule.startsOn).map(date => {
								const skipped = editingRule.skipDates.includes(date);
								const booked = slots.find(slot => slot.seriesId === editingRule.id && slot.date === date)?.families ?? 0;
								return <tr data-rule-date={date}><td>{shortDate(date).replace(/, \d{4}$/, '')}</td><td>{skipped ? <span class="badge b-gray">Skipped</span> : booked ? `${booked} booked` : 'Open'}</td><td>{!skipped && booked ? <a class="btn btn-gd btn-sm" href={`${editHref}&skip=${date}&confirm=${date}`}>Skip</a> : <button class="btn btn-gd btn-sm" type="submit" form={`date-${date}`} data-submit-action={`date-${date}`}>{skipped ? 'Restore' : 'Skip'}</button>}</td></tr>;
							})}</tbody></table></div></div>}
						</div>
						<div class="sh-f">
							{editing && <a class="btn btn-gd" href={`${editHref}&confirm=${editing.id}`}>Delete time</a>}
							<span class="grow"></span>
							<a class="btn btn-s" href="/admin/tours">Cancel</a>
							<button class="btn btn-p" data-busy="Saving…">Save</button>
						</div>
					</form>
					{editingRule && nextSeriesDates(editingRule, editingRule.startsOn).map(date => <form hidden id={`date-${date}`} data-action-form={`date-${date}`} method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value={editingRule.skipDates.includes(date) ? 'restore' : 'skip'} /><input type="hidden" name="id" value={editingRule.id} /><input type="hidden" name="skipDate" value={date} /></form>)}
				</aside>
			</div>
			{editing && (
				<div class="ov ov-top" hidden={!confirmingDelete} data-instant-dialog-url={`${editHref}&confirm=${editing.id}`} data-instant-dialog-close={editHref}><div class="dlg" role="alertdialog" aria-modal="true" aria-label="Delete this time?"><h2 class="h2">Delete this time?</h2><p class="soft">{editing.families} {editing.families === 1 ? 'family' : 'families'}{editing.capacityUnit === 'people' ? ` (${editing.taken} people)` : ''} are booked. They’ll get an email that this tour was cancelled, with a link to pick another time.</p><div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href={editHref}>Cancel</a><form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value={editingRule ? "rule-delete" : "delete"} /><input type="hidden" name="id" value={editing.id} /><button class="btn btn-d">Delete time</button></form></div></div></div>
			)}
			{confirmingSkip && <div class="ov ov-top"><div class="dlg" role="alertdialog" aria-modal="true" aria-label="Delete this time?"><h2 class="h2">Delete this time?</h2><p class="soft">{skipFamilies} {skipFamilies === 1 ? 'family' : 'families'} are booked. They’ll get an email that this tour was cancelled, with a link to pick another time.</p><div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href={editHref}>Cancel</a><form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="skip" /><input type="hidden" name="id" value={seriesId} /><input type="hidden" name="skipDate" value={skipDate} /><button class="btn btn-d">Delete time</button></form></div></div></div>}
		</div>
	)}
	{replying && (
		<div slot="overlay">
			<div class="ov ov-side">
				<aside class="ssheet" role="dialog" aria-modal="true" aria-label="Reply to request">
					<div class="sh-h"><div class="sh-tt"><h2 class="h2">Reply to request</h2><p class="mute">{replying.familyName} · {replying.email} · Requested {formatChicago(replying.createdAt, false)}</p></div><a class="sh-ic" href="/admin/tours?tab=requests" aria-label="Close"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 6l12 12M18 6 6 18"/></svg></a></div>
					<form method="post" data-enhance data-optimistic="close-sheet">
						<div class="sh-b">
							{error && <div class="alert alert-err" role="alert"><p class="at">{error}</p></div>}
							<p class="soft">{replying.familyName} asked for {replying.otherTime || 'another time'}. {replying.headCount} {replying.headCount === 1 ? 'person' : 'people'}.{replying.note ? ` “${replying.note}”` : ''}</p>
							<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="reply" /><input type="hidden" name="tab" value="requests" /><input type="hidden" name="id" value={replying.id} />
							<div class="field"><label class="lbl" for="rdate">Date</label><input id="rdate" name="date" class:list={['inp', fields.date && 'bad']} placeholder="MM/DD/YYYY" value={draft.date} />{fields.date && <p class="errm"><span>{fields.date}</span></p>}</div>
							<div class="field"><label class="lbl" for="rtime">Time</label><input id="rtime" name="start" class="inp" placeholder="9:00 AM" value={draft.start} /><input name="end" class:list={['inp', fields.end && 'bad']} placeholder="10:00 AM" value={draft.end} aria-label="End" />{fields.end && <p class="errm"><span>{fields.end}</span></p>}</div>
							<fieldset class="field" style="border:0;padding:0;margin:0"><legend class="lbl">Send as</legend><div class="chips"><label class="chip"><input type="radio" name="mode" value={TOUR_STATUSES.CONFIRMED} checked={draft.mode !== TOUR_STATUSES.PROPOSED} />Confirmed visit</label><label class="chip"><input type="radio" name="mode" value={TOUR_STATUSES.PROPOSED} checked={draft.mode === TOUR_STATUSES.PROPOSED} />Proposed time (family accepts)</label></div></fieldset>
							<div class="field"><label class="lbl" for="message">Message to family (optional)</label><textarea id="message" name="message" class="inp" rows="3">{draft.message}</textarea></div>
						</div>
						<div class="sh-f">
							<button class="btn btn-gd" form="decline-form" data-submit-action="decline-form" type="submit">Decline</button>
							<span class="grow"></span>
							<a class="btn btn-s" href="/admin/tours?tab=requests">Cancel</a>
							<button class="btn btn-p" data-busy="Sending…">Send</button>
						</div>
					</form>
					<form data-action-form="decline-form" id="decline-form" method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="decline" /><input type="hidden" name="id" value={replying.id} /></form>
				</aside>
			</div>
		</div>
	)}
</PortalLayout>

<script>
	function syncTimeForm() {
		document.querySelectorAll<HTMLFormElement>('[data-time-form]').forEach(form => {
			const sync = () => {
				const weekly = form.querySelector<HTMLInputElement>('[name=repeats]:checked')?.value === 'weekly';
				form.querySelectorAll<HTMLElement>('[data-once]').forEach(el => el.hidden = weekly);
				form.querySelectorAll<HTMLElement>('[data-weekly]').forEach(el => el.hidden = !weekly);
				const people = form.querySelector<HTMLInputElement>('[name=capacityUnit]:checked')?.value === 'people';
				form.querySelectorAll<HTMLElement>('[data-people-hint]').forEach(el => el.hidden = !people);
			};
			form.addEventListener('change', event => {
				const target = event.target as HTMLInputElement;
				if (target.name === 'repeats' || target.name === 'capacityUnit') sync();
				if (target.name === 'type' && !form.querySelector('[name=id], [name=seriesId]')) {
					const tour = target.value === 'tour';
					const capacity = form.querySelector<HTMLInputElement>('[name=capacity]');
					if (capacity) capacity.value = tour ? '1' : '12';
					const unit = form.querySelector<HTMLInputElement>(`[name=capacityUnit][value=${tour ? 'families' : 'people'}]`);
					if (unit) unit.checked = true;
					sync();
				}
			});
			sync();
		});
	}
	document.addEventListener('astro:page-load', syncTimeForm);
</script>
