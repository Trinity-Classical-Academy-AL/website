---
import PageHeader from '../../components/ui/PageHeader.astro';
import Toast from '../../components/ui/Toast.astro';
import BannerEditor from '../../components/pages/website/BannerEditor.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { RouteTabs } from '../../components/RouteTabs.tsx';

import { loadWebsite } from '../../lib/pages/website.ts';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
// Announcements have their own page now.
if (Astro.url.searchParams.get('tab') === 'announcements') return Astro.redirect(Astro.url.searchParams.get('sheet') === 'new' ? '/admin/announcements/new' : '/admin/announcements');
const page = await loadWebsite(Astro, family);
if (page instanceof Response) return page;
const { bannerToast } = page;
---
<PortalLayout title="Website — TCA Portal" current="/admin/website" roles={family.roles} name={family.name} email={family.email}>
	{bannerToast && <Toast>{bannerToast}</Toast>}
	<PageHeader actions={{ "class": "acts" }}>
		<div><h1>Website</h1></div>
		<RouteTabs slot="tabs" client:load label="Sections" tabs={[
		{ href: '/admin/website', label: 'Banner', current: true },
		]} />
		<Fragment slot="actions">
			<a class="btn btn-s btn-sm" href="https://trinityclassical.academy" target="_blank" rel="noopener">View website</a>
		</Fragment>
	</PageHeader>
	<BannerEditor view={page} />
</PortalLayout>
<script>import '../../scripts/banner-preview';</script>
