---
import PageHeader from '../components/ui/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import PortalLayout from '../layouts/PortalLayout.astro';
import { FORMALOO_APPLY_URL, formatChicago, listFamilyApplications, schoolYearOf, shiftSchoolYear } from '@tca/school';

/**
 * A family's applications, newest school year first, with plain-language status
 * and what happens next. Applying still happens on the Formaloo form.
 */
export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const applications = await listFamilyApplications(family.id);
const upcoming = shiftSchoolYear(schoolYearOf(), 1);
const hasUpcoming = applications.some((app) => app.schoolYear === upcoming && app.status !== 'withdrawn');

// Family-facing wording for each status.
const STATUS: Record<string, { label: string; tone: string; next: string }> = {
	submitted: { label: 'Received', tone: 'b-gray', next: 'We received your interview request. The office will reach out about next steps.' },
	reviewing: { label: 'In review', tone: 'b-gray', next: 'The office is reviewing your request, which can include a pastoral reference.' },
	interview: { label: 'Interview', tone: 'b-gold', next: 'You’re invited to interview. The office will contact you to schedule a time.' },
	accepted: { label: 'Accepted', tone: 'b-green', next: 'You’ve been invited to complete Trinity’s full application. Check your email for the link.' },
	enrolled: { label: 'Enrolled', tone: 'b-green', next: 'Your family is enrolled for this year. Welcome to Trinity.' },
	waitlisted: { label: 'Waitlisted', tone: 'b-gold', next: 'You’re on the waitlist. We’ll be in touch if a spot opens.' },
	declined: { label: 'Not accepted', tone: 'b-gray', next: 'We weren’t able to move forward with this request. Contact the office with any questions.' },
	withdrawn: { label: 'Withdrawn', tone: 'b-gray', next: 'This request was withdrawn.' },
};
---
<PortalLayout title="Applications — TCA Portal" current="/applications" roles={family.roles} name={family.name} email={family.email}>
	<PageHeader>
		<h1>Applications</h1>
		{!hasUpcoming && <Fragment slot="actions"><a class="btn btn-p btn-sm" href={FORMALOO_APPLY_URL} target="_blank" rel="noopener">Apply for {upcoming}<Icon name="external" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></a></Fragment>}
	</PageHeader>
	<div class="apps">
		{applications.length === 0 ? (
			<section class="panel apps-empty">
				<div class="panel-b">
					<p class="h3">Applying to Trinity starts with an interview request</p>
					<p class="soft">Tell us about your family and your children. The office reviews each request, invites families to interview, and then sends the full application.</p>
					<a class="btn btn-p btn-sm" href={FORMALOO_APPLY_URL} target="_blank" rel="noopener">Request an interview for {upcoming}<Icon name="external" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></a>
				</div>
			</section>
		) : applications.map((app) => {
			const enrolled = app.status === 'accepted' && (app.answers as { enrollmentStatus?: string }).enrollmentStatus === 'Enrolled';
			const status = enrolled ? STATUS.enrolled : STATUS[app.status] ?? STATUS.submitted;
			return <section class="panel">
				<div class="panel-h">
					<div class="panel-tt"><span class="panel-k">School year</span><h2 class="h2">{app.schoolYear}</h2></div>
					<span class:list={['badge', status.tone]}>{status.label}</span>
				</div>
				<p class="panel-b app-next">{status.next}</p>
				{app.students.length > 0 && <ul class="plist">{app.students.map((student) => <li><strong>{student.name}</strong><span class="mute">{[student.grade && `Grade ${student.grade}`, student.currentSchool].filter(Boolean).join(' · ')}</span></li>)}</ul>}
				<div class="panel-f"><span class="mute">Submitted {formatChicago(app.submittedAt, false)}</span></div>
			</section>;
		})}
		{applications.length > 0 && !hasUpcoming && <p class="mute apps-more">Applying for {upcoming}? <a href={FORMALOO_APPLY_URL} target="_blank" rel="noopener">Request an interview</a>.</p>}
	</div>
</PortalLayout>
