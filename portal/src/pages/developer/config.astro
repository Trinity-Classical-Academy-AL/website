---
import PageHeader from '../../components/ui/PageHeader.astro';
import Toast from '../../components/ui/Toast.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { runActions, toastFrom } from '../../lib/actions.ts';
import { csrfToken } from '../../lib/security.ts';
import { classReachSignupUrl, setClassReachSignupUrl } from '@tca/school';

/** Developer console: school-wide settings that rarely change (the ClassReach sign-up link). */
export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const csrf = csrfToken(Astro.cookies, Astro.url.protocol === 'https:');
const result = await runActions(Astro, {
	classreach: async (form) => {
		const outcome = await setClassReachSignupUrl(String(form.get('url') ?? ''));
		return outcome.ok ? { redirect: '/developer/config?saved=1' } : { error: outcome.error };
	},
});
if ('redirect' in result) return Astro.redirect(result.redirect, result.status);
const classReach = await classReachSignupUrl();
const toast = toastFrom(Astro.url, { saved: () => 'ClassReach link saved.' });
---
<PortalLayout title="Config — Developer console — TCA Portal" current="/developer/config" roles={family.roles} name={family.name} email={family.email}>
	<PageHeader><h1>Config</h1></PageHeader>
	{toast && <Toast>{toast}</Toast>}
	{result.error && <p class="alert alert-err" role="alert">{result.error}</p>}
	<section class="panel cfg">
		<div class="panel-h"><h2 class="h2">ClassReach link</h2></div>
		<form method="post" data-enhance class="panel-b cfg-form">
			<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="classreach" />
			<label class="field"><span class="lbl">Account sign-up link</span><input class="inp" type="url" name="url" value={classReach} placeholder="https://trinityclassicalacademy.classreach.com/…" /></label>
			<p class="mute small">Accepted families get this link by email to create their ClassReach account and finish enrolling there. Applications can’t be accepted until it’s set.</p>
			<div><button class="btn btn-p btn-sm" data-busy="Saving…">Save</button></div>
		</form>
	</section>
</PortalLayout>
