---
import EmptyState from '../components/ui/EmptyState.astro';
import { runActions, redirectOnSuccess } from '../lib/actions.ts';
import PortalLayout from '../layouts/PortalLayout.astro';
import { FieldSelect } from '../components/FieldSelect.tsx';
import { csrfToken } from '../lib/security.ts';
import { cancelRsvp, formatChicago, listRsvps, setRsvp, upcomingEvents } from '@tca/school';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
const respond = async (form: FormData, { action }: { action: string }) => {
	const eventId = String(form.get('eventId') ?? '');
	const events = await upcomingEvents(new Date(), family.roles.includes('guardian') ? 'enrolled' : 'prospective');
	const event = events.find((item) => item.id === eventId);
	if (!event) return { error: 'That event is not open.' };
	if (action === 'cancel') {
		await cancelRsvp(eventId, family.id);
		return { redirect: '/events' };
	}
	return redirectOnSuccess(await setRsvp({ eventId, familyId: family.id, familyName: family.name || family.email, email: family.email, eventTitle: event.title, headCount: Number(form.get('headCount')) }), '/events');
};
const actionResult = await runActions(Astro, { cancel: respond }, { fallback: respond });

if ('redirect' in actionResult) return Astro.redirect(actionResult.redirect, actionResult.status);
error = actionResult.error;
const [events, rsvps] = await Promise.all([upcomingEvents(new Date(), family.roles.includes('guardian') ? 'enrolled' : 'prospective'), listRsvps('')]);
const mine = new Map(rsvps.filter((row) => row.familyId === family.id).map((row) => [row.eventId, row]));
---
<PortalLayout title="Events — TCA Portal" current="/events" roles={family.roles} name={family.name} email={family.email}>
	<header class="ahead"><div><h1>Events</h1></div></header>
	{events.length === 0 ? <EmptyState><p class="h3">No upcoming events</p><p class="mute">We’ll list the next info night or open house here.</p></EmptyState> : (
		<div class="evc-list">
			{events.map((event) => {
				const rsvp = mine.get(event.id);
				const day = (options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-US', { ...options, timeZone: 'America/Chicago' }).format(new Date(event.startsAt));
				const when = event.allDay ? day({ weekday: 'long', month: 'long', day: 'numeric' }) : `${day({ weekday: 'long', month: 'long', day: 'numeric' })} · ${day({ hour: 'numeric', minute: '2-digit' }).replace(':00', '')}`;
				return (
					<article class="evc">
						<div class="evc-media" aria-hidden={event.hasImage ? undefined : 'true'}>
							{event.hasImage ? <img src={`/event-image/${event.id}`} alt="" loading="lazy" /> : <span class="evc-date"><span>{day({ month: 'short' })}</span><strong>{day({ day: 'numeric' })}</strong></span>}
						</div>
						<div class="evc-body">
							<p class="evc-when">{when}</p>
							<h2 class="evc-t">{event.title}</h2>
							{event.location && <p class="evc-loc mute">{event.location}</p>}
							{event.description && <p class="evc-d soft">{event.description}</p>}
							{event.collectRsvp && <form method="post" class="evc-rsvp" data-enhance data-optimistic="close-sheet">
								<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="eventId" value={event.id} />
								{rsvp && <span class="badge b-green">You’re going · {rsvp.headCount ?? 1}</span>}
								<span class="evc-count"><label class="mute small" for={`head-${event.id}`}>People</label><FieldSelect client:load id={`head-${event.id}`} name="headCount" label="How many people?" value={rsvp ? String(rsvp.headCount ?? 1) : '1'} options={Array.from({ length: 20 }, (_, i) => String(i + 1)).map((count) => ({ value: count, label: count }))} /></span>
								<button class="btn btn-p btn-sm" name="action" value="save">{rsvp ? 'Update' : 'RSVP'}</button>
								{rsvp && <button class="btn btn-g btn-sm" name="action" value="cancel">Can’t make it</button>}
							</form>}
						</div>
					</article>
				);
			})}
			{error && <p class="alert alert-err" role="alert">{error}</p>}
		</div>
	)}
</PortalLayout>
