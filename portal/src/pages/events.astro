---
import PortalLayout from '../layouts/PortalLayout.astro';
import { csrfOk, csrfToken } from '../lib/security.ts';
import { cancelRsvp, formatChicago, getFamily, listRsvps, setRsvp, upcomingEvents } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else {
		const eventId = String(form.get('eventId') ?? '');
		const events = await upcomingEvents();
		const event = events.find((item) => item.id === eventId);
		if (!event) error = 'That event is not open.';
		else if (String(form.get('action') ?? '') === 'cancel') await cancelRsvp(eventId, family.id);
		else {
			const result = await setRsvp({ eventId, familyId: family.id, familyName: family.name || family.email, email: family.email, eventTitle: event.title, headCount: Number(form.get('headCount')) });
			if (!result.ok) error = result.error;
		}
		if (!error) return Astro.redirect('/events');
	}
}
const events = await upcomingEvents();
const mine = new Map((await listRsvps('')).filter((row) => row.familyId === family.id).map((row) => [row.eventId, row]));
---
<PortalLayout title="Events — TCA Portal" current="/events" roles={family.roles} name={family.name} email={family.email}>
	<header class="phead"><h1 class="h1">Events</h1></header>
	{events.length === 0 ? <div class="empty"><p class="h3">No upcoming events</p><p class="mute">We’ll list the next info night or open house here.</p></div> : (
		<div class="stack g16">
			{events.map((event) => {
				const rsvp = mine.get(event.id);
				return (
					<section class="card">
						<h2 class="h2">{event.title}</h2>
						<p class="soft">{formatChicago(event.startsAt)}{event.location ? ` · ${event.location}` : ''}</p>
						{event.description && <p class="mute" style="margin-top:8px">{event.description}</p>}
						<form method="post" class="form" style="margin-top:12px">
							<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="eventId" value={event.id} />
							<div class="field"><label class="lbl" for={`head-${event.id}`}>How many people?</label><select id={`head-${event.id}`} name="headCount" class="inp"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></div>
							<div class="acts"><button class="btn btn-p" name="action" value="save">{rsvp ? 'Update RSVP' : 'RSVP'}</button>{rsvp && <button class="btn btn-s" name="action" value="cancel">Cancel</button>}</div>
						</form>
					</section>
				);
			})}
			{error && <p class="alert alert-err" role="alert">{error}</p>}
		</div>
	)}
</PortalLayout>
