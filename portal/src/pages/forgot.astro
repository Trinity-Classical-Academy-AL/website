---
import AuthLayout from '../layouts/AuthLayout.astro';
import { text, validEmail } from '../lib/account.ts';
import { requestPasswordReset } from '@tca/school';

export const prerender = false;
let done = false;
let devLink = '';
let error = '';
if (Astro.request.method === 'POST') {
	const email = text(await Astro.request.formData(), 'email').toLowerCase();
	if (!validEmail(email)) error = 'Enter the email on your family account.';
	else {
		const result = await requestPasswordReset(email);
		done = true;
		if (import.meta.env.DEV && result.verifyUrl && result.email && !result.email.delivered) devLink = result.verifyUrl;
	}
}
const field = 'mt-1.5 w-full rounded-card border border-ink/15 px-3 py-2.5 text-sm outline-none focus:border-forest';
---
<AuthLayout title="Forgot password — Trinity families" heading="Reset your password" lede="If that email has an account, we will send a link that expires in one hour.">
	{done ? (
		<div>
			<p class="text-sm">If that email has an account, the reset link is on its way.</p>
			{devLink && <p class="mt-3 text-sm">Dev only: <a class="text-forest" href={devLink}>Reset password</a></p>}
		</div>
	) : (
		<form method="post">
			<label class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Email<input name="email" type="email" class={field} /></label>
			{error && <p role="alert" class="mt-3 text-sm text-[#9f2d2d]">{error}</p>}
			<button class="mt-5 w-full rounded-pill bg-forest px-5 py-3 font-mono text-[11px] uppercase tracking-eyebrow text-white">Send the link</button>
		</form>
	)}
	<p class="mt-4 text-sm"><a class="text-forest" href="/">Back to sign in</a></p>
</AuthLayout>
