---
import AuthLayout from '../layouts/AuthLayout.astro';
import { text, validEmail } from '../lib/account.ts';
import { requestPasswordReset } from '@tca/school';
export const prerender = false;
let done = false;
let error = '';
let devLink = '';
if (Astro.request.method === 'POST') {
	const email = text(await Astro.request.formData(), 'email').toLowerCase();
	if (!validEmail(email)) error = 'Enter the email on your family account.';
	else {
		const result = await requestPasswordReset(email);
		done = true;
		if (import.meta.env.DEV && result.verifyUrl && result.email && !result.email.delivered) devLink = result.verifyUrl;
	}
}
---
<AuthLayout title="Forgot password — Trinity families">
	<div class="auth-card">
		<header class="stack g8"><h1 class="h1">Reset your password</h1><p class="lead">If that email has an account, we’ll send a link that expires in one hour.</p></header>
		{done ? (
			<div class="stack g12">
				<p class="alert alert-ok">If that email has an account, the reset link is on its way.</p>
				{devLink && <p class="hint">Dev only: <a href={devLink}>Reset password</a></p>}
			</div>
		) : (
			<form class="form" method="post">
				<div class="field"><label class="lbl" for="email">Email</label><input id="email" name="email" class="inp" type="email" placeholder="name@example.com" /></div>
				{error && <p class="alert alert-err" role="alert">{error}</p>}
				<button class="btn btn-p btn-block">Send the link</button>
			</form>
		)}
		<p class="small"><a href="/">Back to sign in</a></p>
	</div>
</AuthLayout>
