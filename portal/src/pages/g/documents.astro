---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getFamily } from '@tca/school';
export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
---
<PortalLayout title="Documents — TCA Portal" current="/g/documents" roles={family.roles} name={family.name} email={family.email}>
	<header class="phead"><h1 class="h1">Documents</h1></header>
	<div class="empty"><p class="h3">No documents yet</p><p class="mute">Handbooks and policies the school shares will show here.</p></div>
</PortalLayout>
