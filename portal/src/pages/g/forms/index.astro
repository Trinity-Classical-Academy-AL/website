---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { RouteTabs } from '../../../components/RouteTabs.tsx';
import { getFamily, guardianForms } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const tab = Astro.url.searchParams.get('tab') === 'submitted' ? 'submitted' : 'todo';
const forms = await guardianForms(family.id);
const todo = forms.filter((form) => form.status !== 'submitted');
const done = forms.filter((form) => form.status === 'submitted');
const rows = tab === 'submitted' ? done : todo;
---
<PortalLayout title="Forms — TCA Portal" current="/g/forms" roles={family.roles} name={family.name} email={family.email}>
	<header class="ahead"><div><h1>Forms</h1><p class="soft">Forms the school needs from you. Your answers save as you go.</p></div></header>
	<RouteTabs client:load label="Forms" tabs={[
		{ href: '/g/forms', label: `To do · ${todo.length}`, current: tab === 'todo' },
		{ href: '/g/forms?tab=submitted', label: `Submitted · ${done.length}`, current: tab === 'submitted' },
	]} />
	{rows.length === 0 && tab === 'todo' && <div class="empty"><p class="h3">Nothing to do</p><p class="mute">You’re all caught up. New forms from the school show here, and we’ll email you.</p></div>}
	<div class="rows">{rows.map((form) => (
		<a class="r" href={form.status === 'submitted' ? `/g/forms/${form.id}?copy=1` : `/g/forms/${form.id}`}>
			<span class="stack g4"><span class="h3">{form.title}</span><span class="mute">For {form.student}{form.dueOn ? ` · Due ${form.dueOn}` : ''}</span></span>
			<span class="badge b-gray">{form.status === 'submitted' ? 'Submitted' : form.status === 'draft' ? 'Draft saved' : 'To do'}</span>
		</a>
	))}</div>
</PortalLayout>
