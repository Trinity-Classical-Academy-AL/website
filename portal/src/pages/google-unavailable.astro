---
import SignLayout from '../layouts/SignLayout.astro';
---
<SignLayout title="Google sign-in — TCA Portal">
	<div class="si">
		<div class="si-col">
			<div class="si-mark"><h1>Google sign-in isn’t available yet</h1></div>
			<p>The school hasn’t connected Google on this site. Continue with your email instead.</p>
			<p><a class="btn btn-p btn-pill" href="/">Use email</a></p>
		</div>
	</div>
</SignLayout>
