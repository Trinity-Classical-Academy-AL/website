---
import PortalLayout from '../layouts/PortalLayout.astro';
import { activeBooking, FORMALOO_APPLY_URL, formatChicago, getFamily, listRsvps, siteOrigin, upcomingEvents } from '@tca/school';
import { formatLongDate } from '../../../src/lib/admissions/dates.ts';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const booking = await activeBooking(family.id);
const [next] = await upcomingEvents();
const rsvp = next ? (await listRsvps('')).find((row) => row.eventId === next.id && row.familyId === family.id) : undefined;
const site = siteOrigin();
---
<PortalLayout title="Home">
	<h1 class="font-display text-4xl italic">Hello, {family.name.split(' ')[0]}</h1>
	<p class="mt-2 text-sm text-ink-soft">Four things you can do from here. Everything else lives on the main site.</p>
	<div class="mt-6 grid gap-4 sm:grid-cols-2">
		<a href="/tour" class="rounded-card border border-ink/10 bg-white p-5 hover:border-forest">
			<p class="font-mono text-[10px] uppercase tracking-eyebrow text-forest">Campus tour</p>
			<h2 class="mt-2 font-display text-2xl italic">{booking ? 'You’re booked' : 'Book a tour'}</h2>
			<p class="mt-2 text-sm text-ink-soft">{booking ? `${formatLongDate(booking.tourDate)} · ${booking.headCount} ${booking.headCount === 1 ? 'person' : 'people'}` : 'Pick a Wednesday and tell us how many are coming.'}</p>
		</a>
		<a href={FORMALOO_APPLY_URL} class="rounded-card border border-ink/10 bg-white p-5 hover:border-forest">
			<p class="font-mono text-[10px] uppercase tracking-eyebrow text-forest">Apply</p>
			<h2 class="mt-2 font-display text-2xl italic">Formaloo</h2>
			<p class="mt-2 text-sm text-ink-soft">The application lives on Formaloo. Updates come by email from Formaloo, not from this portal.</p>
		</a>
		<a href="/events" class="rounded-card border border-ink/10 bg-white p-5 hover:border-forest">
			<p class="font-mono text-[10px] uppercase tracking-eyebrow text-forest">Next event</p>
			<h2 class="mt-2 font-display text-2xl italic">{next ? next.title : 'Nothing scheduled'}</h2>
			<p class="mt-2 text-sm text-ink-soft">{next ? `${formatChicago(next.startsAt)}${rsvp ? ` · you RSVPed ${rsvp.headCount}` : ' · RSVP'}` : 'When the school adds an event, it will show up here.'}</p>
		</a>
		<a href="/question" class="rounded-card border border-ink/10 bg-white p-5 hover:border-forest">
			<p class="font-mono text-[10px] uppercase tracking-eyebrow text-forest">A question</p>
			<h2 class="mt-2 font-display text-2xl italic">Ask the school</h2>
			<p class="mt-2 text-sm text-ink-soft">Send a note. Staff will see it and mark it when they have replied.</p>
		</a>
	</div>
	<section class="mt-8">
		<h2 class="font-display text-2xl italic">On the main site</h2>
		<ul class="mt-3 space-y-2 text-sm">
			<li><a class="text-forest" href={site}>trinityclassical.academy</a></li>
			<li><a class="text-forest" href={`${site}/visit`}>Visit Trinity</a></li>
			<li><a class="text-forest" href={`${site}/admissions`}>Admissions</a></li>
			<li><a class="text-forest" href={`${site}/resources/tuition`}>Tuition</a></li>
			<li><a class="text-forest" href={`${site}/contact`}>Contact</a></li>
		</ul>
	</section>
</PortalLayout>
