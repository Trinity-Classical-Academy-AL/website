---
import PortalLayout from '../layouts/PortalLayout.astro';
import { FORMALOO_APPLY_URL, activeBooking, formatChicago, getFamily, upcomingEvents } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const booking = await activeBooking(family.id);
const events = await upcomingEvents();
---
<PortalLayout title="Home — TCA Portal" current="/home" roles={family.roles} name={family.name} email={family.email}>
	<header class="phead">
		<h1 class="h1">Thanks for your interest in Trinity Classical Academy</h1>
		<p class="lead">Start with a tour. Your account keeps your requests and family details in one place.</p>
	</header>
	<div class="grid2">
		<section class="card">
			<h2 class="h2">Visit the school</h2>
			<p class="soft">Tours run the second Wednesday of January, February and March. Open house dates are listed too.</p>
			<div class="acts" style="margin-top:12px"><a class="btn btn-p" href="/tour">Request a tour</a></div>
		</section>
		<section class="card">
			<h2 class="h2">Apply in Formaloo</h2>
			<p class="soft">Applications are handled in Formaloo. Updates about an application come by email from Formaloo.</p>
			<div class="acts" style="margin-top:12px"><a class="btn btn-s" href={FORMALOO_APPLY_URL} target="_blank" rel="noopener">Open the application</a></div>
		</section>
	</div>
	<section class="card" style="margin-top:16px">
		<h2 class="h2">Your tour requests</h2>
		{booking ? <p class="soft">{booking.tourDate} · {booking.headCount} {booking.headCount === 1 ? 'person' : 'people'}</p> : <p class="soft">None yet.</p>}
		<div class="acts" style="margin-top:12px"><a class="btn btn-s" href="/tour">Request a tour</a></div>
	</section>
	<section class="card" style="margin-top:16px">
		<div class="between"><h2 class="h2">Upcoming events</h2><a href="/events">All events</a></div>
		{events.length === 0 ? <p class="soft">Nothing is scheduled right now.</p> : events.slice(0, 3).map((event) => (
			<p class="r"><span><strong>{event.title}</strong><br /><span class="mute">{formatChicago(event.startsAt)}</span></span></p>
		))}
	</section>
</PortalLayout>
