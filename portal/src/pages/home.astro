---
import PortalLayout from '../layouts/PortalLayout.astro';
import { FORMALOO_APPLY_URL, formatChicago, getFamily, upcomingEvents, familyTourView, listProspectChildren } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const events = await upcomingEvents();
const tour = await familyTourView(family.id);
const booking = tour.holds.find((hold) => hold.kind === 'slot');
const kids = await listProspectChildren(family.id);
---
<PortalLayout title="Home — TCA Portal" current="/home" roles={family.roles} name={family.name} email={family.email}>
	{Astro.url.searchParams.get('welcome') && <div class="toast t-ok" role="status"><span style="flex:1">Account created. You’re signed in.</span></div>}
	<header class="ahead"><div><h1>Home</h1><p class="soft">Start with a tour. Your requests and family details live here.</p></div></header>
	<div class="two" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr)">
		<div class="stack g16">
			<section class="card">
				<div class="card-h"><h2 class="h2">{tour.holds.length ? 'Your tours' : 'Visit the school'}</h2>{tour.holds.length > 0 && <a href="/tour">Manage</a>}</div>
				{tour.holds.length === 0 ? <p class="soft">Tours run the second Wednesday of January, February and March. Open house dates are listed too.</p> : tour.holds.map((hold) => (
					<div class="r"><span class="stack g4"><span class="h3">{hold.kind === 'slot' ? 'Campus tour' : hold.status === 'proposed' ? 'School proposed a time' : 'Different time requested'}</span><span class="mute">{hold.when || hold.proposedWhen || hold.otherTime} · {hold.headCount} people</span></span>{hold.kind === 'slot' ? <span class="badge b-green">Booked</span> : hold.status === 'proposed' ? <span class="badge b-gray">Needs reply</span> : <span class="badge b-gray">Pending</span>}</div>
				))}
				<div class="acts" style="margin-top:16px">
					<a class="btn btn-p btn-sm" href="/tour">{booking ? 'Manage' : 'Request a tour'}</a>
					<a class="btn btn-s btn-sm" href={FORMALOO_APPLY_URL} target="_blank" rel="noopener">Apply in Formaloo<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
				</div>
			</section>
			<section class="card">
				<div class="card-h"><h2 class="h2">Upcoming events</h2><a href="/events">View all</a></div>
				{events.length === 0 ? <p class="soft">Nothing is scheduled right now.</p> : (
					<div class="rows">
						{events.slice(0, 3).map((event) => (
							<a class="r" href="/events" style="text-decoration:none;color:inherit"><span class="stack g4"><span class="h3">{event.title}</span><span class="mute">{formatChicago(event.startsAt)}</span></span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></a>
						))}
					</div>
				)}
			</section>
		</div>
		<div class="stack g16">
			<section class="card">
				<div class="card-h"><h2 class="h2">About the school</h2></div>
				<dl class="dl">
					<dt>Approach</dt><dd>Classical and Christian, ACCS-mentored</dd>
					<dt>Grades</dt><dd>K–8, adding a grade each year toward K–12</dd>
					<dt>Church</dt><dd>Under the care of Trinity Presbyterian Church (CREC)</dd>
					<dt>Location</dt><dd>7160 Cahaba Valley Rd., Birmingham, AL 35242</dd>
				</dl>
				<div class="rows linklist">
					<a href="https://trinityclassical.academy/our-vision" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>About Trinity</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/our-philosophy" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>Our classical approach</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/curriculum" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>Curriculum</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/resources/tuition" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>Tuition overview</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/faq" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>FAQ</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
				</div>
			</section>
			<section class="card">
				<div class="card-h"><h2 class="h2">Your family</h2><a href="/your-family">Edit</a></div>
				{kids.children.length === 0 ? <p class="soft">Optional. Children’s names, grades and the year you’re considering help us prepare for your visit.</p> : kids.children.map((child) => <p><strong>{child.firstName}</strong> <span class="mute">{child.grade}{child.schoolYear ? ` · ${child.schoolYear}` : ''}</span></p>)}
				{kids.children.length === 0 && <div style="margin-top:16px"><a class="btn btn-s btn-sm" href="/your-family">Add details</a></div>}
			</section>
		</div>
	</div>
</PortalLayout>
