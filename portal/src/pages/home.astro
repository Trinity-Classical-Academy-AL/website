---
import PortalLayout from '../layouts/PortalLayout.astro';
import { FORMALOO_APPLY_URL, formatChicago, getFamily, upcomingEvents, familyTourView } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const events = await upcomingEvents();
const tour = await familyTourView(family.id);
const booking = tour.holds.find((hold) => hold.kind === 'slot');
---
<PortalLayout title="Home — TCA Portal" current="/home" roles={family.roles} name={family.name} email={family.email}>
	<header class="ahead"><div><h1>Home</h1><p class="soft">Start with a tour. Your requests and family details live here.</p></div></header>
	<div class="two" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr)">
		<div class="stack g16">
			<section class="card">
				<div class="card-h"><h2 class="h2">Visit the school</h2></div>
				<p class="soft">Tours run the second Wednesday of January, February and March, 8:00–9:00 AM. One family is booked in each time.</p>
				{booking && <p class="mute" style="margin-top:8px">Your time: {booking.when}</p>}
				<div class="acts" style="margin-top:16px">
					<a class="btn btn-p btn-sm" href="/tour">{booking ? 'Change your time' : 'Request a tour'}</a>
					<a class="btn btn-s btn-sm" href={FORMALOO_APPLY_URL} target="_blank" rel="noopener">Apply in Formaloo</a>
				</div>
			</section>
			<section class="card">
				<div class="card-h"><h2 class="h2">Upcoming events</h2><a href="/events">View all</a></div>
				{events.length === 0 ? <p class="soft">Nothing is scheduled right now.</p> : (
					<div class="rows">
						{events.slice(0, 3).map((event) => (
							<a class="r" href="/events"><span class="stack g4"><span class="h3">{event.title}</span><span class="mute">{formatChicago(event.startsAt)}</span></span></a>
						))}
					</div>
				)}
			</section>
		</div>
		<div class="stack g16">
			<section class="card">
				<div class="card-h"><h2 class="h2">About the school</h2></div>
				<dl class="dl">
					<dt>Approach</dt><dd>Classical and Christian, ACCS-mentored</dd>
					<dt>Grades</dt><dd>K–8, adding a grade each year toward K–12</dd>
					<dt>Church</dt><dd>Under the care of Trinity Presbyterian Church</dd>
					<dt>Location</dt><dd>7160 Cahaba Valley Rd., Birmingham, AL 35242</dd>
				</dl>
			</section>
			<section class="card">
				<div class="card-h"><h2 class="h2">Tell us about your family</h2></div>
				<p class="soft">Optional. A name and phone help the school prepare for your visit.</p>
				<div style="margin-top:16px"><a class="btn btn-s btn-sm" href="/your-family">Add details</a></div>
			</section>
		</div>
	</div>
</PortalLayout>
