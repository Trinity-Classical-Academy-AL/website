---
import PortalLayout from '../layouts/PortalLayout.astro';
import { activeBooking, formatChicago, getFamily, listRsvps, siteOrigin, upcomingEvents } from '@tca/school';
import { formatLongDate } from '../../../src/lib/admissions/dates.ts';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const booking = await activeBooking(family.id);
const [next] = await upcomingEvents();
const rsvp = next ? (await listRsvps('')).find((row) => row.eventId === next.id && row.familyId === family.id) : undefined;
const site = siteOrigin();
const when = next ? formatChicago(next.startsAt) : '';
---
<PortalLayout title="Home — Trinity families" current="home" name={family.name} email={family.email}>
	<header class="phead"><h1 class="h1">Home</h1><p class="lead">{family.name} · {family.email}</p></header>
	<div class="stack g20">
		<div class="grid2">
			<section class="card">
				{booking ? (
					<>
						<div class="card-h"><div class="rowx" style="flex-wrap:nowrap"><h2 class="h2">Your tour</h2></div><span class="badge b-green">Booked</span></div>
						<p class="h3">{formatLongDate(booking.tourDate)}</p>
						<p class="soft">9:00 to 10:00 AM · {booking.headCount} {booking.headCount === 1 ? 'person' : 'people'}</p>
						<div style="margin-top:16px"><a class="btn btn-s btn-sm" href="/tour">View or cancel</a></div>
					</>
				) : (
					<>
						<div class="card-h"><div class="rowx" style="flex-wrap:nowrap"><h2 class="h2">Campus tour</h2></div></div>
						<p class="soft">Second Wednesday of January, February and March.</p>
						<div style="margin-top:16px"><a class="btn btn-p btn-sm" href="/tour">Book a tour</a></div>
					</>
				)}
			</section>
			<section class="card">
				<div class="card-h"><div class="rowx" style="flex-wrap:nowrap"><h2 class="h2">Apply</h2></div></div>
				<p class="soft">Applications are handled in Formaloo. Updates about your application come by email from Formaloo.</p>
				<div style="margin-top:16px"><a class="btn btn-p btn-sm" href="https://trinity-classicalalabama.formaloo.me/" target="_blank" rel="noopener">Open the application<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></div>
			</section>
			<section class="card">
				<div class="card-h"><div class="rowx" style="flex-wrap:nowrap"><h2 class="h2">Next event</h2></div></div>
				{next ? (
					<>
						<p class="h3">{next.title}</p>
						<p class="soft">{when}{rsvp ? ` · you’re going (${rsvp.headCount})` : ''}</p>
						<div style="margin-top:16px"><a class="btn btn-s btn-sm" href={`/events?id=${next.id}`}>{rsvp ? 'View RSVP' : 'RSVP'}</a></div>
					</>
				) : (
					<p class="soft">Nothing is scheduled right now.</p>
				)}
			</section>
			<section class="card">
				<div class="card-h"><div class="rowx" style="flex-wrap:nowrap"><h2 class="h2">Questions</h2></div></div>
				<p class="soft">Ask about tuition, curriculum or openings. We reply by email.</p>
				<div style="margin-top:16px"><a class="btn btn-s btn-sm" href="/question">Ask a question</a></div>
			</section>
		</div>
		<section class="card">
			<h2 class="h2" style="margin-bottom:8px">On the main site</h2>
			<div class="rows">
				<a href={`${site}/admissions`} class="r" style="text-decoration:none;color:inherit"><span class="h3" style="font-weight:500">Admissions</span></a>
				<a href={`${site}/faq`} class="r" style="text-decoration:none;color:inherit"><span class="h3" style="font-weight:500">FAQ</span></a>
				<a href={`${site}/TCA-Academic-Calendar-2026-2027.pdf`} class="r" style="text-decoration:none;color:inherit"><span class="h3" style="font-weight:500">School calendar (PDF)</span></a>
				<a href={`${site}/contact`} class="r" style="text-decoration:none;color:inherit"><span class="h3" style="font-weight:500">Contact the school</span></a>
			</div>
		</section>
	</div>
</PortalLayout>
