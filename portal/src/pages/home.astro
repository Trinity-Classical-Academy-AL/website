---
import Toast from '../components/ui/Toast.astro';
import PortalLayout from '../layouts/PortalLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { csrfToken } from '../lib/security.ts';
import { FORMALOO_APPLY_URL, familyEnrollments, formatChicago, formatTourWhen, listFamilyApplications, upcomingEvents, familyTourView } from '@tca/school';
import { trackApplication } from '../lib/application-tracker.ts';

export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const [events, tour, applications, enrollments] = await Promise.all([upcomingEvents(new Date(), 'prospective'), familyTourView(family.id), listFamilyApplications(family.id), familyEnrollments(family.id)]);
const tracked = applications.map((app) => ({ app, track: trackApplication(app) })).filter((item) => !item.track.closed);
const booking = tour.holds.find((hold) => hold.kind === 'slot');
const nextTour = tour.slots.find((slot) => slot.type === 'tour' && !slot.unavailable);
const csrf = csrfToken(Astro.cookies, Astro.url.protocol === 'https:');
---
<PortalLayout title="Home — TCA Portal" current="/home" roles={family.roles} name={family.name} email={family.email}>
	{Astro.url.searchParams.get('welcome') && <Toast>Account created. You’re signed in.</Toast>}
	<header class="ahead"><div><h1>Home</h1></div></header>
	{tracked.length > 0 && <section class="attention">
		<div class="attention-h"><h2 class="ev-h">Your application</h2><a href="/applications">View details</a></div>
		<ul class="doc-list">{tracked.map(({ app, track }) => <li><a class="doc-row" href="/applications"><span class="form-ic" aria-hidden="true"><Icon name="application" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></span><span class="doc-t"><strong>{app.children.map((kid) => kid.name.split(' ')[0]).join(', ') || 'Your application'} · {app.schoolYear}</strong><span class="mute">{track.todo || track.steps.find((step) => step.state === 'current')?.detail || track.headline}</span></span><span class:list={['badge', track.tone]}>{track.headline}</span></a></li>)}</ul>
	</section>}
	<div class="two" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr)">
		<div class="stack g16">
			<section class="card">
				<div class="card-h"><h2 class="h2">{tour.holds.length ? 'Your tours' : 'Visit the school'}</h2>{tour.holds.length > 0 && <a href="/tour">Manage</a>}</div>
				{tour.holds.length === 0 ? <div class="stack g8"><p class="h3">{nextTour ? `Next open tour: ${formatTourWhen(nextTour.date, nextTour.start, nextTour.end)}` : 'No tour times are open right now'}</p><p class="soft">{nextTour ? tour.summary?.note || 'Tours run during a normal school day.' : 'Request a tour and tell us what works. We’ll find a time.'}</p></div> : tour.holds.map((hold) => (
					<div class="r"><span class="stack g4"><span class="h3">{hold.kind === 'slot' ? 'Campus tour' : hold.status === 'proposed' ? 'School proposed a time' : 'Different time requested'}</span><span class="mute">{hold.when || hold.proposedWhen || hold.otherTime} · {hold.headCount} people</span></span><span class="rowx">{hold.kind === 'slot' ? <span class="badge b-green">Booked</span> : hold.status === 'proposed' ? <span class="badge b-gray">Needs reply</span> : <span class="badge b-gray">Pending</span>}{hold.status === 'proposed' && <form method="post" action="/tour" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="accept" /><input type="hidden" name="id" value={hold.id} /><button class="btn btn-p btn-sm">Accept</button></form>}{hold.status === 'proposed' && <a class="btn btn-s btn-sm" href={`/tour?cancel=${hold.id}`}>Decline</a>}</span></div>
				))}
				<div class="acts" style="margin-top:16px">
					<a class="btn btn-p btn-sm" href="/tour">{booking ? 'Manage' : 'Request a tour'}</a>
					<a class="btn btn-s btn-sm" href={FORMALOO_APPLY_URL} target="_blank" rel="noopener">Request an interview<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
				</div>
			</section>
			<section class="card">
				<div class="card-h"><h2 class="h2">Upcoming events</h2><a href="/events">View all</a></div>
				{events.length === 0 ? <p class="soft">Nothing is scheduled right now.</p> : (
					<div class="rows">
						{events.slice(0, 3).map((event) => (
							<a class="r" href="/events" style="text-decoration:none;color:inherit"><span class="stack g4"><span class="h3">{event.title}</span><span class="mute">{formatChicago(event.startsAt)}</span></span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></a>
						))}
					</div>
				)}
			</section>
		</div>
		<div class="stack g16">
			{(Date.now() - Date.parse(family.createdAt) < 30 * 86400000) && <section class="card">
				<div class="card-h"><h2 class="h2">Already have a family on the portal?</h2></div>
				<p class="soft">If a spouse or another parent signed up first, join their family so you both see the same tours and children.</p>
				<div class="acts" style="margin-top:12px"><a class="btn btn-s btn-sm" href="/account?dialog=join">Join their family</a></div>
			</section>}
			<section class="card">
				<div class="card-h"><h2 class="h2">About the school</h2></div>
				<dl class="dl">
					<dt>Approach</dt><dd>Classical and Christian, ACCS-mentored</dd>
					<dt>Grades</dt><dd>K–8, adding a grade each year toward K–12</dd>
					<dt>Church</dt><dd>Under the care of Trinity Presbyterian Church (CREC)</dd>
					<dt>Location</dt><dd>7160 Cahaba Valley Rd., Birmingham, AL 35242</dd>
				</dl>
				<div class="rows linklist">
					<a href="https://trinityclassical.academy/our-vision" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>About Trinity</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/our-philosophy" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>Our classical approach</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/curriculum" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>Curriculum</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/resources/tuition" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>Tuition overview</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
					<a href="https://trinityclassical.academy/faq" target="_blank" rel="noopener" class="r" style="text-decoration:none;color:inherit"><span>FAQ</span><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a>
				</div>
			</section>
		</div>
	</div>
</PortalLayout>
