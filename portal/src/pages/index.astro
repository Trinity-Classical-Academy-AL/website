---
import SignLayout from '../layouts/SignLayout.astro';
import { beginPortalEmail, recordAttempt, tooManyAttempts } from '@tca/school';
import { clientKey, csrfOk, csrfToken, rememberTour, wantsTour } from '../lib/security.ts';

export const prerender = false;
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
if (Astro.request.method === 'GET' && wantsTour(Astro.url.searchParams.get('next'))) rememberTour(Astro.cookies, secure);
let error = '';
let devLink = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') ?? '').trim().toLowerCase();
	const key = `${clientKey(Astro.request)}:${email}`;
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (await tooManyAttempts('email', key)) error = 'Too many tries. Wait 15 minutes and try again.';
	else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) error = 'Enter an email address like name@example.com.';
	else {
		await recordAttempt('email', key);
		const result = await beginPortalEmail(email);
		if (result.step === 'password' && result.googleOnly) {
			const google = new URL('/auth/google', Astro.url);
			google.searchParams.set('login_hint', email);
			const next = Astro.url.searchParams.get('next');
			if (next) google.searchParams.set('next', next);
			return Astro.redirect(`${google.pathname}${google.search}`, 303);
		}
		if (result.step === 'password') return Astro.redirect(`/password?email=${encodeURIComponent(email)}`);
		if (result.step === 'pending') {
			error = 'That email isn’t verified yet. Sign in with another email on the profile and enter the code in Settings.';
		} else {
		if (import.meta.env.DEV && !result.delivered) devLink = result.verifyUrl;
		const next = `/sent?email=${encodeURIComponent(email)}`;
		if (devLink) return Astro.redirect(`${next}&dev=${encodeURIComponent(devLink)}`);
		return Astro.redirect(next);
		}
	}
}
---
<SignLayout title="Sign in — TCA Portal">
	<div class="si">
		<div class="si-col">
			<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="Trinity Classical Academy" /><h1>Sign in to TCA Portal</h1></div>
			{Astro.url.searchParams.get('signedout') === '1' && <div class="alert alert-ok" role="status"><p class="at">You’re signed out.</p></div>}
			{Astro.url.searchParams.get('error') === 'google' && <div class="alert alert-err" role="alert"><p class="at">Google sign-in didn’t finish. Try again, or continue with your email.</p></div>}
			{Astro.url.searchParams.get('error') === 'server' && <div class="alert alert-err" role="alert"><p class="at">Something went wrong on our end. Try again in a minute.</p></div>}
			<a class="btn btn-google btn-pill btn-block" href="/auth/google" data-astro-reload>
				<svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
				Continue with Google
			</a>
			<div class="or">or</div>
			<form class="form" method="post" data-astro-reload>
				<input type="hidden" name="csrf" value={csrf} />
				<div class="field"><label class="lbl" for="email">Email</label><input id="email" name="email" class="inp" type="email" placeholder="name@example.com" autocomplete="email" /></div>
				{error && <p class="alert alert-err" role="alert">{error}</p>}
				<button class="btn btn-p btn-pill btn-block" data-busy="Continue">Continue</button>
			</form>
			<p class="mute" style="text-align:center">New here? Enter your email and we’ll create your account.</p>
		</div>
		<p class="si-foot">Trouble signing in? <a href="https://trinityclassical.academy/contact" target="_blank" rel="noopener">Contact the school office</a>.</p>
	</div>
</SignLayout>
