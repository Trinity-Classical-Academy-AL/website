---
import AuthLayout from '../layouts/AuthLayout.astro';
import { text, validEmail } from '../lib/account.ts';
import { FAMILY_COOKIE, FAMILY_SESSION_DAYS, issueFamilySession, signInFamily } from '@tca/school';

export const prerender = false;
let error = '';
let devLink = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = text(form, 'email').toLowerCase();
	const password = String(form.get('password') ?? '');
	if (!validEmail(email) || !password) error = 'Enter your email and password.';
	else {
		const result = await signInFamily(email, password);
		if (result.ok) {
			Astro.cookies.set(FAMILY_COOKIE, issueFamilySession(result.familyId), {
				httpOnly: true, path: '/', sameSite: 'lax', secure: Astro.url.protocol === 'https:', maxAge: FAMILY_SESSION_DAYS * 86400,
			});
			return Astro.redirect('/home');
		}
		error = result.code === 'unverified' ? 'Confirm your email first. We sent a fresh link.' : 'That email and password don’t match.';
		if (import.meta.env.DEV && result.code === 'unverified' && result.verifyUrl && !result.email?.delivered) devLink = result.verifyUrl;
	}
}
---
<AuthLayout title="Sign in — Trinity families">
	<div class="auth-card">
		<header class="stack g8"><h1 class="h1">Sign in</h1></header>
		<form class="form" method="post" novalidate>
			<div class="field"><label class="lbl" for="email">Email</label><input id="email" name="email" class:list={['inp', error && 'bad']} type="email" placeholder="name@example.com" autocomplete="email" /></div>
			<div class="field"><label class="lbl" for="password">Password</label><div class="pw"><input id="password" name="password" class:list={['inp', error && 'bad']} type="password" autocomplete="current-password" /><button type="button" class="pw-t">Show</button></div></div>
			{error && <p class="alert alert-err" role="alert">{error}</p>}
			{devLink && <p class="hint">Dev only: <a href={devLink}>Confirm this account</a></p>}
			<div class="between"><label class="chk"><input type="checkbox" checked /><span>Keep me signed in</span></label><a class="small" href="/forgot">Forgot password?</a></div>
			<button class="btn btn-p btn-block">Sign in</button>
		</form>
		<p class="small soft" style="text-align:center">New to Trinity? <a href="/signup">Create an account</a></p>
	</div>
</AuthLayout>
