---
import SignLayout from '../layouts/SignLayout.astro';
import { GRADE_OPTIONS } from '../../../src/lib/admissions/defaults.ts';
import { createInquiry, recordAttempt, tooManyAttempts } from '@tca/school';
import { clientKey, csrfOk, csrfToken } from '../lib/security.ts';

export const prerender = false;
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
let sent = false;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = String(form.get('email') ?? '');
	const key = `${clientKey(Astro.request)}:${email.trim().toLowerCase()}`;
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (await tooManyAttempts('inquiry', key)) error = 'Too many tries. Wait 15 minutes and try again.';
	else {
		await recordAttempt('inquiry', key);
		const result = await createInquiry({
			email,
			name: String(form.get('name') ?? ''),
			phone: String(form.get('phone') ?? ''),
			grades: form.getAll('grades').map(String),
			message: String(form.get('message') ?? ''),
			source: 'interested',
			notify: true,
		});
		if (!result.ok) error = result.error;
		else sent = true;
	}
}
---
<SignLayout title="Interested in Trinity? — TCA Portal">
	<div class="si">
		<div class="si-col narrow">
			<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="" /><h1>Interested in Trinity?</h1><p>No account needed. The school office will read this.</p></div>
			{sent ? (
				<p class="alert alert-ok" role="status">Received. We’ll reply by email if a reply is needed.</p>
			) : (
				<form class="form" method="post">
					<input type="hidden" name="csrf" value={csrf} />
					<div class="field"><label class="lbl" for="email">Email</label><input id="email" name="email" class="inp" type="email" placeholder="name@example.com" autocomplete="email" required /></div>
					<div class="field"><label class="lbl" for="name">Name</label><input id="name" name="name" class="inp" autocomplete="name" /></div>
					<div class="field"><label class="lbl" for="phone">Phone <span class="opt">(optional)</span></label><input id="phone" name="phone" class="inp" autocomplete="tel" /></div>
					<div class="field">
						<span class="lbl">Children’s grades <span class="opt">(optional)</span></span>
						<div class="chips" style="margin-top:8px">
							{GRADE_OPTIONS.map((grade) => (
								<label class="chip"><input type="checkbox" name="grades" value={grade.value} />{grade.label}</label>
							))}
						</div>
					</div>
					<div class="field"><label class="lbl" for="message">Message <span class="opt">(optional)</span></label><textarea id="message" name="message" class="inp" rows="4"></textarea></div>
					{error && <p class="alert alert-err" role="alert">{error}</p>}
					<button class="btn btn-p btn-pill btn-block">Send</button>
				</form>
			)}
			<p class="small" style="text-align:center"><a href="/tour">Want to book a tour time?</a></p>
		</div>
	</div>
</SignLayout>
