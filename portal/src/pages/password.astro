---
import SignLayout from '../layouts/SignLayout.astro';
import { FAMILY_COOKIE, issueFamilySession, FAMILY_SESSION_DAYS, getFamily, recordAttempt, signInFamily, tooManyAttempts } from '@tca/school';
import { clientKey, csrfOk, csrfToken, landingAfterAuth } from '../lib/security.ts';

export const prerender = false;
const email = Astro.url.searchParams.get('email') || '';
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const password = String(form.get('password') ?? '');
	const key = `${clientKey(Astro.request)}:${email}`;
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (await tooManyAttempts('password', key, 8)) error = 'This sign-in is locked for 15 minutes.';
	else {
		await recordAttempt('password', key);
		const result = await signInFamily(email, password);
		if (result.ok) {
			Astro.cookies.set(FAMILY_COOKIE, issueFamilySession(result.familyId), {
				httpOnly: true, path: '/', sameSite: 'lax', secure, maxAge: FAMILY_SESSION_DAYS * 86400,
			});
			const family = await getFamily(result.familyId);
			return Astro.redirect(landingAfterAuth(Astro.cookies, family?.roles ?? []));
		}
		error = 'That email and password don’t match.';
	}
}
---
<SignLayout title="Password — TCA Portal">
	<div class="si">
		<div class="si-col">
			<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="" /><h1>Welcome back</h1><p>{email}</p></div>
			<form class="form" method="post">
				<input type="hidden" name="csrf" value={csrf} />
				<div class="field"><label class="lbl" for="password">Password</label><div class="pw"><input id="password" name="password" class="inp" type="password" autocomplete="current-password" /><button type="button" class="pw-t">Show</button></div></div>
				{error && <p class="alert alert-err" role="alert">{error}</p>}
				<button class="btn btn-p btn-pill btn-block">Sign in</button>
			</form>
			<p class="small" style="text-align:center"><a href={`/forgot?email=${encodeURIComponent(email)}`}>Forgot password?</a></p>
			<p class="small" style="text-align:center"><a href="/">Change email</a></p>
		</div>
		<p class="si-foot">Trouble signing in? <a href="https://trinityclassical.academy/contact">Contact the school office</a>.</p>
	</div>
</SignLayout>
<script is:inline>document.querySelectorAll('.pw-t').forEach((button) => button.addEventListener('click', () => { const input = button.parentElement.querySelector('input'); input.type = input.type === 'password' ? 'text' : 'password'; button.textContent = input.type === 'password' ? 'Show' : 'Hide'; }));</script>
