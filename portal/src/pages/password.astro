---
import SignLayout from '../layouts/SignLayout.astro';
import { PasswordField } from '../components/PasswordField.tsx';
import { FAMILY_COOKIE, issueFamilySession, FAMILY_SESSION_DAYS, getFamily, recordAttempt, signInFamily, tooManyAttempts } from '@tca/school';
import { clientKey, csrfOk, csrfToken, landingAfterAuth } from '../lib/security.ts';

export const prerender = false;
const email = Astro.url.searchParams.get('email') || '';
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const password = String(form.get('password') ?? '');
	const key = `${clientKey(Astro.request)}:${email}`;
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (await tooManyAttempts('password', key, 8)) error = 'locked';
	else {
		await recordAttempt('password', key);
		const result = await signInFamily(email, password);
		if (result.ok) {
			Astro.cookies.set(FAMILY_COOKIE, issueFamilySession(result.familyId, result.email), {
				httpOnly: true, path: '/', sameSite: 'lax', secure, maxAge: FAMILY_SESSION_DAYS * 86400,
			});
			const family = await getFamily(result.familyId);
			return Astro.redirect(landingAfterAuth(Astro.cookies, family?.roles ?? [], result.email));
		}
		error = 'wrong';
	}
}
---
<SignLayout title="Password — TCA Portal">
	<div class="si">
		<div class="si-col">
			<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="Trinity Classical Academy" /><h1>Welcome back</h1></div>
			<div class="who"><span class="em">{email}</span><a href="/" style="font-size:13px">Change</a></div>
			<form class="form" method="post">
				<input type="hidden" name="csrf" value={csrf} />
				<div class="field"><label class="lbl" for="password">Password</label><PasswordField client:load id="password" name="password" autoComplete="current-password" /></div>
				{error === 'locked' && <div class="alert alert-err" role="alert"><p class="at">Too many attempts.</p><p>Wait 15 minutes, or <a href={`/forgot?email=${encodeURIComponent(email)}`}>reset your password</a>.</p></div>}
				{error === 'wrong' && <div class="alert alert-err" role="alert"><p class="at">That password doesn’t match this account.</p><p>Try again or reset your password.</p></div>}
				{error && error !== 'locked' && error !== 'wrong' && <p class="alert alert-err" role="alert">{error}</p>}
				<button class="btn btn-p btn-pill btn-block" data-busy="Sign in">Sign in</button>
			</form>
			{Astro.url.searchParams.get('google') === '1' && <p class="small" style="text-align:center">This email uses Google. <a href={`/auth/google?login_hint=${encodeURIComponent(email)}`} data-astro-reload>Continue with Google</a>.</p>}
			<p style="text-align:center;font-size:14px"><a href={`/forgot?email=${encodeURIComponent(email)}`}>Forgot password?</a></p>
		</div>
		<p class="si-foot">Trouble signing in? <a href="https://trinityclassical.academy/contact" target="_blank" rel="noopener">Contact the school office</a>.</p>
	</div>
</SignLayout>
