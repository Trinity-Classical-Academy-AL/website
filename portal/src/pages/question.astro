---
import PortalLayout from '../layouts/PortalLayout.astro';
import { text } from '../lib/account.ts';
import { askQuestion, formatChicago, getFamily, listQuestions } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
let error = '';
let sent = false;
if (Astro.request.method === 'POST') {
	const body = text(await Astro.request.formData(), 'body');
	if (body.length < 5) error = 'Write the question you want the school to see.';
	else {
		await askQuestion(family.id, family.name, family.email, body);
		sent = true;
	}
}
const questions = await listQuestions('', family.id);
---
<PortalLayout title="Ask a question — Trinity families" current="ask" name={family.name} email={family.email}>
	<header class="phead"><h1 class="h1">Ask a question</h1><p class="lead">We reply by email or phone.</p></header>
	<div class="stack g24" style="max-width:720px">
		{sent && <p class="alert alert-ok" role="status">Sent. We’ll reply by email.</p>}
		<section class="card">
			<form class="form" method="post" novalidate>
				<div class="field"><label class="lbl" for="body">Your question</label><textarea id="body" name="body" class:list={['inp', error && 'bad']} rows="4" placeholder="How can we help?"></textarea></div>
				{error && <p class="alert alert-err" role="alert">{error}</p>}
				<button class="btn btn-p">Send</button>
			</form>
		</section>
		{questions.length > 0 && (
			<section class="card">
				<h2 class="h2" style="margin-bottom:12px">Past requests</h2>
				<div class="rows">
					{questions.map((question) => (
						<div class="r"><span class="stack g4"><span class="h3">{question.body.split('\n')[0]}</span><span class="mute">Sent {formatChicago(question.createdAt, false)}</span></span><span class:list={['badge', question.status === 'replied' ? 'b-green' : 'b-gray']}>{question.status === 'replied' ? 'Replied' : 'Received'}</span></div>
					))}
				</div>
			</section>
		)}
	</div>
</PortalLayout>
