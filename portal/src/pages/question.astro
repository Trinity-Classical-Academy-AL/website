---
import PortalLayout from '../layouts/PortalLayout.astro';
import { text } from '../lib/account.ts';
import { askQuestion, formatChicago, getFamily, listQuestions } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
let error = '';
if (Astro.request.method === 'POST') {
	const body = text(await Astro.request.formData(), 'body');
	if (body.length < 5) error = 'Write the question you want the school to see.';
	else if (body.length > 2000) error = 'Keep the question under 2,000 characters.';
	else {
		await askQuestion(family.id, family.name, family.email, body);
		return Astro.redirect('/question');
	}
}
const questions = await listQuestions('', family.id);
---
<PortalLayout title="Ask a question">
	<h1 class="font-display text-4xl italic">Ask a question</h1>
	<p class="mt-2 text-sm text-ink-soft">Staff read these in the admin. They mark a question replied when they have answered you, usually by email or phone.</p>
	<form method="post" class="mt-6 rounded-card border border-ink/10 bg-white p-5">
		<label class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute" for="body">Your question</label>
		<textarea id="body" name="body" rows="5" class="mt-1.5 w-full rounded-card border border-ink/15 px-3 py-2.5 text-sm outline-none focus:border-forest"></textarea>
		{error && <p role="alert" class="mt-3 text-sm text-[#9f2d2d]">{error}</p>}
		<button class="mt-4 rounded-pill bg-forest px-5 py-3 font-mono text-[11px] uppercase tracking-eyebrow text-white">Send</button>
	</form>
	<ul class="mt-6 space-y-3">
		{questions.map((question) => (
			<li class="rounded-card border border-ink/10 bg-white p-4">
				<p class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">{formatChicago(question.createdAt)} · {question.status === 'replied' ? 'Replied' : 'New'}</p>
				<p class="mt-2 whitespace-pre-wrap text-sm">{question.body}</p>
			</li>
		))}
	</ul>
</PortalLayout>
