---
import PortalLayout from '../layouts/PortalLayout.astro';
import { text } from '../lib/account.ts';
import { askQuestion, formatChicago, getFamily, listQuestions } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
const topics = ['General question', 'Tuition', 'Curriculum and school day', 'Openings and enrollment', 'Something else'];
let error = '';
let sent = false;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const topic = text(form, 'topic');
	const reply = text(form, 'reply') === 'phone' ? 'Phone call' : 'Email';
	const body = text(form, 'body');
	if (!topics.includes(topic)) error = 'Choose a topic.';
	else if (body.length < 5) error = 'Write the question you want the school to see.';
	else {
		await askQuestion(family.id, family.name, family.email, `Topic: ${topic}\nReply by: ${reply}\n\n${body}`);
		sent = true;
	}
}
const questions = await listQuestions('', family.id);
---
<PortalLayout title="Ask a question — Trinity families" current="ask" name={family.name} email={family.email}>
	<header class="phead"><h1 class="h1">Ask a question</h1><p class="lead">We reply by email or phone.</p></header>
	<div class="stack g24" style="max-width:720px">
		{sent && <p class="alert alert-ok" role="status">Sent. We’ll reply by email.</p>}
		<section class="card">
			<form class="form" method="post" novalidate>
				<div class="field">
					<label class="lbl" for="topic">Topic</label>
					<select id="topic" name="topic" class="inp">
						<option value="">Choose one</option>
						{topics.map((topic) => <option value={topic}>{topic}</option>)}
					</select>
				</div>
				<div class="field"><label class="lbl" for="body">Your question</label><textarea id="body" name="body" class:list={['inp', error && 'bad']} rows="4" placeholder="How can we help?"></textarea></div>
				<fieldset class="field" style="border:0;margin:0;padding:0">
					<legend class="lbl" style="padding:0;margin-bottom:8px">Reply by</legend>
					<div class="chips">
						<label class="chip"><input type="radio" name="reply" value="email" checked /> Email</label>
						<label class="chip"><input type="radio" name="reply" value="phone" /> Phone call</label>
					</div>
				</fieldset>
				{error && <p class="alert alert-err" role="alert">{error}</p>}
				<button class="btn btn-p">Send</button>
			</form>
		</section>
		{questions.length > 0 && (
			<section class="card">
				<h2 class="h2" style="margin-bottom:12px">Past requests</h2>
				<div class="rows">
					{questions.map((question) => (
						<div class="r"><span class="stack g4"><span class="h3">{question.body.match(/^Topic: (.+)$/m)?.[1] ?? 'Question'}</span><span class="mute">Sent {formatChicago(question.createdAt, false)}</span></span><span class:list={['badge', question.status === 'replied' ? 'b-green' : 'b-gray']}>{question.status === 'replied' ? 'Replied' : 'Received'}</span></div>
					))}
				</div>
			</section>
		)}
	</div>
</PortalLayout>
