---
import FontHead from '../../components/FontHead.astro';
import { cssHref } from '../../lib/assets';
import { db, dbReady, transcript } from '@tca/school';

/**
 * A student's transcript, ready to print or save as PDF: each year's subjects
 * with quarter and final grades, GPA and attendance. Open to the student's
 * family and to staff and admins.
 */
export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const id = Astro.params.id || '';
await dbReady();
const [child] = await db()`select family_id from children where id = ${id}`;
const roles = Astro.locals.roles as string[];
const allowed = !!child && ((String(child.family_id) === family.id && roles.includes('guardian')) || roles.includes('staff') || roles.includes('admin'));
if (!allowed) return Astro.redirect('/no-access');
const record = await transcript(id);
const back = String(child.family_id) === family.id && roles.includes('guardian') ? `/g/students/${id}?tab=report` : '/staff/report-cards';
const issued = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'America/Chicago' }).format(new Date());
const born = record.child.birthdate ? new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${record.child.birthdate}T12:00:00Z`)) : '';
const gradeName = (grade: string) => grade === 'K' ? 'Kindergarten' : grade ? `Grade ${grade}` : '';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{record.child.name} transcript — Trinity Classical Academy</title>
		<FontHead />
		<link rel="stylesheet" href={cssHref('portal.css')} />
	</head>
	<body class="root tr-body">
		<div class="tr-bar"><a class="btn btn-s btn-sm" href={back}>Back</a><button class="btn btn-p btn-sm" type="button" onclick="window.print()">Print or save PDF</button></div>
		<article class="tr">
			<header class="tr-head">
				<img src="/assets/img/emblem-green.svg" alt="" width="44" height="44" />
				<div><p class="tr-school">Trinity Classical Academy</p><p class="tr-kind">Official transcript</p></div>
				<p class="tr-issued">Issued {issued}</p>
			</header>
			<dl class="tr-who">
				<div><dt>Student</dt><dd>{record.child.name}</dd></div>
				{born && <div><dt>Born</dt><dd>{born}</dd></div>}
				<div><dt>Cumulative GPA</dt><dd>{record.gpa != null ? record.gpa.toFixed(2) : '—'}</dd></div>
			</dl>
			{record.years.length === 0 ? <p class="tr-empty">No released report cards yet.</p> : record.years.map((year) => (
				<section class="tr-year">
					<h2>{year.schoolYear}{gradeName(year.grade) && <span> · {gradeName(year.grade)}</span>}</h2>
					<table>
						<thead><tr><th>Subject</th>{year.terms.map((term) => <th class="tr-c">{term.replace('Quarter ', 'Q')}</th>)}<th class="tr-c">Final</th></tr></thead>
						<tbody>{year.subjects.map((item) => <tr><td>{item.subject}</td>{item.quarters.map((grade) => <td class="tr-c">{grade || '—'}</td>)}<td class="tr-c tr-final">{item.final || '—'}</td></tr>)}</tbody>
					</table>
					<p class="tr-sum">{[year.gpa != null ? `GPA ${year.gpa.toFixed(2)}` : '', `${year.absences} ${year.absences === 1 ? 'absence' : 'absences'}`, `${year.tardies} ${year.tardies === 1 ? 'tardy' : 'tardies'}`].filter(Boolean).join(' · ')}</p>
				</section>
			))}
			<footer class="tr-foot">
				<p>Grades: A 93–100, A- 90, B+ 87, B 83, B- 80, C+ 77, C 73, C- 70, D+ 67, D 63, D- 60, F below 60. GPA on a 4.0 scale; a final grade averages the quarters. Kindergarten through 2nd grade: E Excellent, S Satisfactory, N Needs improvement, U Unsatisfactory.</p>
				<div class="tr-sign"><span></span><p>Head of School</p></div>
			</footer>
		</article>
	</body>
</html>
