---
import SignLayout from '../layouts/SignLayout.astro';
---
<SignLayout title="Link expired — TCA Portal">
	<div class="si">
		<div class="si-col">
			<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="Trinity Classical Academy" /><h1>That reset link has expired</h1><p>Reset links work for 1 hour and only once.</p></div>
			<a class="btn btn-p btn-pill btn-block" href="/forgot">Send a new link</a>
			<p style="text-align:center;font-size:14px"><a href="/">Back to sign in</a></p>
		</div>
		<p class="si-foot">Trouble signing in? <a href="https://trinityclassical.academy/contact" target="_blank" rel="noopener">Contact the school office</a>.</p>
	</div>
</SignLayout>
