---
import SignLayout from '../layouts/SignLayout.astro';
---
<SignLayout title="Link expired — TCA Portal">
	<div class="si">
		<div class="si-col">
			<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="" /><h1>That link has expired</h1></div>
			<p class="soft">These links work for a limited time and only once.</p>
			<p><a class="btn btn-p btn-pill btn-block" href="/forgot">Send a new link</a></p>
			<p class="small" style="text-align:center"><a href="/">Back to sign in</a></p>
		</div>
		<p class="si-foot">Trouble signing in? <a href="https://trinityclassical.academy/contact">Contact the school office</a>.</p>
	</div>
</SignLayout>
