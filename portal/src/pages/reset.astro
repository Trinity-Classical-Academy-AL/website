---
import SignLayout from '../layouts/SignLayout.astro';
import { PasswordField } from '../components/PasswordField.tsx';
import { resetPassword, recordAttempt, tooManyAttempts } from '@tca/school';
import { clientKey, csrfOk, csrfToken } from '../lib/security.ts';

export const prerender = false;
const token = Astro.url.searchParams.get('token') || '';
if (!token) return Astro.redirect('/reset-expired');
const secure = Astro.url.protocol === 'https:';
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
let done = false;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const password = String(form.get('password') ?? '');
	const key = clientKey(Astro.request);
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (await tooManyAttempts('reset-save', key)) error = 'Too many tries. Wait 15 minutes and try again.';
	else if (password.length < 10) error = 'Use at least 10 characters.';
	else {
		await recordAttempt('reset-save', key);
		if (!(await resetPassword(String(form.get('token') ?? ''), password))) return Astro.redirect('/reset-expired');
		done = true;
	}
}
---
<SignLayout title="New password — TCA Portal">
	<div class="si">
		<div class="si-col">
			{done ? (
				<>
					<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="Trinity Classical Academy" /><h1>Password updated</h1><p>Other devices were signed out.</p></div>
					<a class="btn btn-p btn-pill btn-block" href="/">Continue to TCA Portal</a>
				</>
			) : (
				<>
					<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="Trinity Classical Academy" /><h1>Choose a new password</h1></div>
					<form class="form" method="post">
						<input type="hidden" name="csrf" value={csrf} />
						<input type="hidden" name="token" value={token} />
						<div class="field">
							<label class="lbl" for="password">New password</label>
							<p class="hint">At least 10 characters</p>
							<PasswordField client:load id="password" name="password" autoComplete="new-password" />
						</div>
						{error && <p class="alert alert-err" role="alert">{error}</p>}
						<button class="btn btn-p btn-pill btn-block">Save password</button>
					</form>
				</>
			)}
		</div>
		<p class="si-foot">Trouble signing in? <a href="https://trinityclassical.academy/contact" target="_blank" rel="noopener">Contact the school office</a>.</p>
	</div>
</SignLayout>
