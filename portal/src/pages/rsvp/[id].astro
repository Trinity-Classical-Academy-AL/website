---
import { runActions } from '../../lib/actions.ts';
import SignLayout from '../../layouts/SignLayout.astro';
import { eventWhen, guestRsvpEvent, accountRsvp, saveAccountRsvp, recordAttempt, tooManyAttempts } from '@tca/school';
import { clientKey, csrfToken, rememberNext } from '../../lib/security.ts';

export const prerender = false;
const event = await guestRsvpEvent(Astro.params.id || '');
if (!event) Astro.response.status = 404;
const family = Astro.locals.family;
const email = Astro.locals.sessionEmail || family?.email || '';
const path = event ? `/rsvp/${event.id}` : '';
if (Astro.request.method === 'GET' && event?.open && !family) {
	rememberNext(Astro.cookies, Astro.url.protocol === 'https:', path);
	const target = new URL('/', Astro.url.origin);
	target.searchParams.set('next', path);
	return Astro.redirect(target.href, 303);
}
const csrf = csrfToken(Astro.cookies, Astro.url.protocol === 'https:');
const existing = family && event ? await accountRsvp(event.id, family.id) : null;
let error = '';
let sent = false;
let values = { headCount: String(existing?.headCount ?? 1), note: String(existing?.note ?? '') };
if (event?.open && family) {
	const actionResult = await runActions(Astro, {}, {
		draftFrom: (form) => {
			values = { headCount: String(form.get('headCount') ?? ''), note: String(form.get('note') ?? '') };
			return values;
		},
		csrfFailure: (error) => ({ error, status: 403 }),
		fallback: async (form) => {
			const key = `${clientKey(Astro.request)}:${family.id}`;
			if (String(form.get('website') ?? '')) sent = true;
			else if (await tooManyAttempts('account-rsvp', key, 20)) return { error: 'Too many tries. Wait 15 minutes and try again.' };
			else {
				await recordAttempt('account-rsvp', key);
				const result = await saveAccountRsvp({ eventId: event.id, familyId: family.id, ...values, headCount: Number(values.headCount) });
				if (!result.ok) return { error: result.error };
				sent = true;
			}
			return {};
		},
	});
	if ('redirect' in actionResult) return Astro.redirect(actionResult.redirect, actionResult.status);
	error = actionResult.error;
	if (actionResult.status) Astro.response.status = actionResult.status;
} else if (Astro.request.method === 'POST') {
	error = !family ? 'Sign in to RSVP.' : 'RSVPs are closed for this event.';
	Astro.response.status = !family ? 401 : event ? 409 : 404;
}
if (Astro.request.method === 'POST') {
	if (Astro.request.headers.get('accept') === 'application/json') {
		return Response.json(sent ? { ok: true, headCount: Number(values.headCount), note: values.note.trim() } : { ok: false, error }, { status: sent ? 200 : Astro.response.status >= 400 ? Astro.response.status : 422 });
	}
	if (sent) return Astro.redirect(new URL(path, Astro.url.origin).href, 303);
}
const confirmed = Boolean(existing);
const summary = { headCount: String(existing?.headCount ?? ''), note: String(existing?.note ?? '') };
---
<SignLayout title={`${event?.title || 'Event not found'} — TCA Portal`}>
	<div class="si si-rsvp"><div class="si-col narrow">
		<header class="rsvp-header">
			<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="" /><h1>{event?.title || 'Event not found'}</h1></div>
			{event && <><p><strong>{eventWhen(event.startsAt)}</strong> (Central Time)</p><p>{event.location}</p><p>{event.description}</p></>}
		</header>
		{event ? <>
			{!event.open ? <p class="alert" role="status">RSVPs are closed for this event. Please contact the school office with any questions.</p> : family && <section class="rsvp-response" data-rsvp-response data-confirmed={String(confirmed)}>
				<div class="rsvp-confirmation" data-rsvp-confirmation hidden={!confirmed} role="status">
					<h2 class="h2">You're on the list.</h2>
					<p data-rsvp-count>{summary.headCount} attending</p>
					<p class="rsvp-note" data-rsvp-note hidden={!summary.note}>{summary.note}</p>
				</div>
				<form class="rsvp-identity" method="post" action="/sign-out" data-astro-reload>
					<input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="next" value={path} />
					<p>RSVPing as <strong>{email}</strong> · <button class="rsvp-switch">Not you?</button></p>
				</form>
				<button class="rsvp-switch rsvp-edit" type="button" data-rsvp-edit aria-expanded="true" aria-controls="rsvp-form-region" hidden>Need to change something?</button>
				<div id="rsvp-form-region" class="rsvp-form-region">
					<form class="form" method="post" data-enhance data-optimistic="rsvp">
						<input type="hidden" name="csrf" value={csrf} />
						<div hidden aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
						<div class="field"><label class="lbl" for="headCount">Number attending</label><input class="inp" id="headCount" name="headCount" type="number" min="1" step="1" value={values.headCount} required /></div>
						<div class="field"><label class="lbl" for="note">Note <span class="opt">(optional)</span></label><textarea class="inp" id="note" name="note" rows="3" maxlength="1000">{values.note}</textarea></div>
						<p class="alert alert-err" role="alert" data-rsvp-error hidden={!error}>{error}</p>
						<button class="btn btn-p btn-pill btn-block" data-rsvp-submit>{confirmed ? 'Update RSVP' : 'RSVP'}</button>
					</form>
				</div>
			</section>}

		</> : <p>We couldn’t find that event. Please check the link or contact the school office.</p>}
	</div></div>
	<script>import '../../scripts/rsvp';</script>
</SignLayout>
<style>
	.si-rsvp .si-mark { align-items: flex-start; text-align: left; }
	.rsvp-header { display: flex; flex-direction: column; gap: 14px; text-align: left; }
	.rsvp-identity { overflow-wrap: anywhere; font-size: 14px; }
	.rsvp-switch { padding: 0; border: 0; background: none; color: var(--forest); text-decoration: underline; cursor: pointer; font: inherit; white-space: nowrap; }
	.rsvp-response { display: flex; flex-direction: column; gap: 14px; }
	.rsvp-confirmation { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border: 1px solid #c4d8c0; border-radius: 12px; background: var(--forest-tint); color: #173f1d; }
	.rsvp-confirmation .h2 { font-size: 18px; margin: 0; }
	.rsvp-confirmation p { margin: 0; }
	.rsvp-note { white-space: pre-wrap; overflow-wrap: anywhere; }
	.rsvp-edit { align-self: flex-start; text-align: left; }
	.rsvp-form-region { transition: height 200ms ease, opacity 200ms ease; }
	.rsvp-form-region[hidden], .rsvp-confirmation[hidden], .rsvp-edit[hidden], [data-rsvp-error][hidden] { display: none; }
	@media (prefers-reduced-motion: reduce) { .rsvp-form-region { transition: none; } }
	.si-rsvp .btn { white-space: nowrap; }
	.si-rsvp textarea.inp { height: auto; min-height: 100px; padding: 12px 14px; }
</style>
