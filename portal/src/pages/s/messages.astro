---
import PageHeader from '../../components/ui/PageHeader.astro';
import Inbox from '../../components/pages/messages/Inbox.astro';
import Toast from '../../components/ui/Toast.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { loadMessages } from '../../lib/pages/messages.ts';

/** A 7th or 8th grader's messages: their own conversation with their teachers (their family sees it too). */
export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const page = await loadMessages(Astro, 'student');
if (page instanceof Response) return page;
---
<PortalLayout title="Messages — TCA Portal" current="/s/messages" roles={family.roles} name={page.open?.childName ?? family.name} email={Astro.locals.sessionEmail || family.email}>
	<PageHeader><h1>Messages</h1></PageHeader>
	{page.toast && <Toast>{page.toast}</Toast>}
	{page.error && <p class="alert alert-err" role="alert">{page.error}</p>}
	<Inbox base={page.base} csrf={page.csrf} threads={page.threads} open={page.open} startable={page.startable} me={page.me} mode={page.mode} classes={page.classes} />
</PortalLayout>
