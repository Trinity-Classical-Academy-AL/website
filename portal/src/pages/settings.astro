---
import PortalLayout from '../layouts/PortalLayout.astro';
import { digits, text } from '../lib/account.ts';
import { getFamily, updateFamilyProfile } from '@tca/school';

export const prerender = false;
const family = await getFamily(Astro.locals.familyId);
if (!family) return Astro.redirect('/');
let error = '';
let saved = false;
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const name = text(form, 'name');
	const phone = digits(text(form, 'phone'));
	const password = String(form.get('password') ?? '');
	const currentPassword = String(form.get('currentPassword') ?? '');
	if (name.length < 2) error = 'Enter your name.';
	else if (phone.length !== 10) error = 'Enter a 10-digit phone number.';
	else if (password && password.length < 10) error = 'Use a password of at least 10 characters.';
	else {
		const result = await updateFamilyProfile(family.id, {
			name,
			phone,
			password: password || undefined,
			currentPassword: currentPassword || undefined,
		});
		if (!result.ok) error = result.error;
		else saved = true;
	}
}
const fresh = saved ? await getFamily(family.id) : family;
const field = 'mt-1.5 w-full rounded-card border border-ink/15 px-3 py-2.5 text-sm outline-none focus:border-forest';
---
<PortalLayout title="Settings">
	<h1 class="font-display text-4xl italic">Settings</h1>
	<p class="mt-2 text-sm text-ink-soft">Email stays {fresh?.email}. To change it, ask the school.</p>
	<form method="post" class="mt-6 rounded-card border border-ink/10 bg-white p-5">
		<label class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Name<input name="name" value={fresh?.name} class={field} /></label>
		<label class="mt-4 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Phone<input name="phone" value={fresh?.phone} class={field} /></label>
		<label class="mt-4 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">Current password<input name="currentPassword" type="password" autocomplete="current-password" class={field} /></label>
		<label class="mt-4 block font-mono text-[10px] uppercase tracking-eyebrow text-ink-mute">New password<input name="password" type="password" autocomplete="new-password" class={field} /></label>
		<p class="mt-2 text-xs text-ink-mute">Leave the password fields blank to keep the current one.</p>
		{error && <p role="alert" class="mt-3 text-sm text-[#9f2d2d]">{error}</p>}
		{saved && <p class="mt-3 text-sm text-forest">Saved.</p>}
		<button class="mt-4 rounded-pill bg-forest px-5 py-3 font-mono text-[11px] uppercase tracking-eyebrow text-white">Save settings</button>
	</form>
</PortalLayout>
