---
import AuthLayout from '../layouts/AuthLayout.astro';
import { digits, text, validEmail } from '../lib/account.ts';
import { signUpFamily } from '@tca/school';

export const prerender = false;
let error = '';
let done = false;
let devLink = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const name = text(form, 'name');
	const email = text(form, 'email').toLowerCase();
	const phone = digits(text(form, 'phone'));
	const password = String(form.get('password') ?? '');
	if (name.length < 2) error = 'Enter your name.';
	else if (!validEmail(email)) error = 'Enter a valid email address.';
	else if (phone && phone.length !== 10) error = 'Enter a 10-digit phone number, or leave it blank.';
	else if (password.length < 10) error = 'Use at least 10 characters.';
	else {
		const result = await signUpFamily({ name, email, phone, password });
		if (!result.ok) error = 'That email already has an account. Sign in instead.';
		else {
			done = true;
			if (import.meta.env.DEV && !result.email.delivered) devLink = result.verifyUrl;
		}
	}
}
---
<AuthLayout title="Create an account — Trinity families">
	<div class="auth-card">
		{done ? (
			<header class="stack g8">
				<h1 class="h1">Check your email</h1>
				<p class="lead">We sent a link to confirm your address. Then come back and sign in.</p>
				{devLink && <p class="hint">Dev only: <a href={devLink}>Confirm this account</a></p>}
				<p class="small"><a href="/">Back to sign in</a></p>
			</header>
		) : (
			<>
				<header class="stack g8"><h1 class="h1">Create an account</h1><p class="lead">It takes about a minute.</p></header>
				<form class="form" method="post" novalidate>
					<div class="field"><label class="lbl" for="name">Your name</label><p class="hint">Parent or guardian</p><input id="name" name="name" class="inp" type="text" placeholder="First and last name" autocomplete="name" /></div>
					<div class="field"><label class="lbl" for="email">Email</label><input id="email" name="email" class="inp" type="email" placeholder="name@example.com" autocomplete="email" /></div>
					<div class="field"><label class="lbl" for="password">Password</label><p class="hint">At least 10 characters</p><div class="pw"><input id="password" name="password" class="inp" type="password" autocomplete="new-password" /><button type="button" class="pw-t">Show</button></div></div>
					<div class="field"><label class="lbl" for="phone">Mobile phone <span class="opt">(optional)</span></label><p class="hint">Only used for tour and event reminders.</p><input id="phone" name="phone" class="inp" type="tel" placeholder="(205) 555-0100" autocomplete="tel" /></div>
					{error && <p class="alert alert-err" role="alert">{error}</p>}
					<button class="btn btn-p btn-block">Create account</button>
				</form>
				<p class="small soft" style="text-align:center">Already have an account? <a href="/">Sign in</a></p>
				<p class="mute" style="text-align:center">We’ll email you a link to confirm your address.</p>
			</>
		)}
	</div>
</AuthLayout>
