---
import PageHeader from '../../components/ui/PageHeader.astro';
import DataTable from '../../components/ui/DataTable.astro';
import Row from '../../components/ui/Row.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import { staffViewer } from '../../lib/classroom.ts';
import { staffRoster, teachingFor } from '@tca/school';

/** Staff section: every enrolled student by grade, with the teacher's own students first. Each opens the student's page. */
export const prerender = false;
const family = Astro.locals.family;
if (!family) return Astro.redirect('/');
const viewer = staffViewer(Astro);
const [{ students }, { classes }] = await Promise.all([staffRoster(viewer.email), teachingFor(viewer.email, false)]);
const taught = new Set(classes.flatMap((row) => row.students.map((kid) => kid.id)));
const mine = students.filter((student) => taught.has(student.id));
const tab = Astro.url.searchParams.get('view') === 'all' || mine.length === 0 ? 'all' : 'mine';
const shown = tab === 'mine' ? mine : students;
---
<PortalLayout title="Students — Staff — TCA Portal" current="/staff" roles={family.roles} name={family.name} email={family.email}>
	<PageHeader><h1>Students</h1></PageHeader>
	{mine.length > 0 && <nav class="ft-tabs" aria-label="View"><a class:list={['seg', tab === 'mine' && 'on']} href="/staff">My students <span class="mute">{mine.length}</span></a><a class:list={['seg', tab === 'all' && 'on']} href="/staff?view=all">Whole school <span class="mute">{students.length}</span></a></nav>}
	{shown.length === 0 ? <EmptyState><p class="h3">No students are enrolled yet</p></EmptyState> : (
		<DataTable columns={['Student', 'Grade', 'Homeroom', 'Family', 'Email']}>
			{shown.map((student) => <Row href={viewer.admin || taught.has(student.id) ? `/staff/students/${student.id}` : undefined}><td><strong>{student.name}</strong></td><td>{student.grade || '—'}</td><td>{student.teacher || '—'}</td><td>{student.family}</td><td class="mute">{student.email}</td></Row>)}
		</DataTable>
	)}
</PortalLayout>
