---
import ConfirmDialog from '../components/ui/ConfirmDialog.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Toast from '../components/ui/Toast.astro';
import TourBooking from '../components/pages/tour/TourBooking.astro';
import OtherTimeSheet from '../components/pages/tour/OtherTimeSheet.astro';
import PortalLayout from '../layouts/PortalLayout.astro';
import SignLayout from '../layouts/SignLayout.astro';

import { loadTour } from '../lib/pages/tour.ts';

export const prerender = false;
const page = await loadTour(Astro);
if (page instanceof Response) return page;
const { family, csrf, error, view, cancelling, requestedToast, cancelledToast } = page;
---
{family ? (
	<PortalLayout title="Request a tour — TCA Portal" current="/tour" roles={family.roles} name={family.name} email={family.email}>
		<PageHeader><div><h1>Request a tour</h1></div></PageHeader>
		{requestedToast && <Toast>{requestedToast}</Toast>}
		{cancelledToast && <Toast>{cancelledToast}</Toast>}
		{error && <div class="alert alert-err" role="alert"><p class="at">{error}</p>{error.startsWith('Your request') && <p>Your choices are still here.</p>}</div>}
		<TourBooking view={page} />
		<OtherTimeSheet slot="overlay" view={page} />

		{cancelling && (
			<div slot="overlay"><ConfirmDialog overlay={{ "class": "ov", "hidden": false }} dialog={{ "class": "dlg", "role": "alertdialog", "aria-modal": "true", "aria-label": "Cancel your tour?" }} openUrl={Astro.url.pathname + Astro.url.search} closeUrl={"/tour"}><h2 class="h2">Cancel your tour?</h2><p class="soft">Your spot{cancelling.when ? ` on ${cancelling.when}` : ''} opens for another family.</p><div class="acts" style="justify-content:flex-end"><a class="btn btn-s" href="/tour">Keep it</a><form method="post" data-enhance data-optimistic="close-sheet"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="cancel" /><input type="hidden" name="id" value={cancelling.id} /><button class="btn btn-d">Cancel tour</button></form></div></ConfirmDialog></div>
		)}
	</PortalLayout>
) : (
	<SignLayout title="Request a tour — TCA Portal">
		<div class="si">
			<div class="si-col">
				<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="" /><h1>Book a tour</h1><p>Use your TCA account to pick a time that works for your family. New here? Creating one takes a minute.</p></div>
				<a class="btn btn-p btn-pill btn-block" href="/?next=/tour">Sign in or create an account</a>
			</div>
			<p class="si-foot">Just have a question? <a href="/interested">Send us a message</a>.</p>
		</div>
	</SignLayout>
)}
