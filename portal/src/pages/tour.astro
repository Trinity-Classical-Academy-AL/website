---
import PortalLayout from '../layouts/PortalLayout.astro';
import SignLayout from '../layouts/SignLayout.astro';
import { GRADE_OPTIONS } from '../../../src/lib/admissions/defaults.ts';
import { csrfOk, csrfToken, rememberTour } from '../lib/security.ts';
import { cancelTourHold, familyTourView, formatTourWhen, getFamily, requestOtherTourTime, saveSlotBooking } from '@tca/school';

export const prerender = false;
const secure = Astro.url.protocol === 'https:';
const family = Astro.locals.familyId ? await getFamily(Astro.locals.familyId) : null;
if (!family) rememberTour(Astro.cookies, secure);
const csrf = csrfToken(Astro.cookies, secure);
let error = '';
let saved = Astro.url.searchParams.get('saved') === '1';
let view = family ? await familyTourView(family.id) : { slots: [], holds: [] };
if (family && Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const grades = form.getAll('grades').map(String);
	const phone = String(form.get('phone') ?? family.phone);
	const note = String(form.get('note') ?? '');
	if (!csrfOk(Astro.cookies, form)) error = 'That request expired. Try again.';
	else if (String(form.get('action') ?? '') === 'cancel') {
		await cancelTourHold(String(form.get('id') ?? ''), family.id);
		return Astro.redirect('/tour?saved=1');
	} else if (String(form.get('action') ?? '') === 'other') {
		const result = await requestOtherTourTime({
			familyId: family.id,
			familyName: family.name || family.email,
			email: family.email,
			phone,
			otherTime: String(form.get('otherTime') ?? ''),
			grades,
			note,
		});
		if (!result.ok) error = result.error;
		else return Astro.redirect('/tour?saved=1');
	} else {
		const result = await saveSlotBooking({
			familyId: family.id,
			familyName: family.name || family.email,
			email: family.email,
			phone,
			slotId: String(form.get('slotId') ?? ''),
			grades,
			note,
		});
		if (!result.ok) error = result.error;
		else return Astro.redirect('/tour?saved=1');
	}
	saved = false;
	view = await familyTourView(family.id);
}
const slotHold = view.holds.find((hold) => hold.kind === 'slot');
const selectedGrades = new Set(slotHold?.grades ?? []);
---
{family ? (
	<PortalLayout title="Request a tour — TCA Portal" current="/tour" roles={family.roles} name={family.name} email={family.email}>
		<header class="phead"><h1 class="h1">Request a tour</h1><p class="lead">One family is booked in each time. A full time shows as unavailable.</p></header>
		{saved && <p class="alert alert-ok" role="status">Saved. A confirmation was sent to {family.email}.</p>}
		{error && <p class="alert alert-err" role="alert">{error}</p>}
		{view.holds.length > 0 && (
			<section class="card" style="margin-bottom:16px">
				<h2 class="h2">Your request</h2>
				{view.holds.map((hold) => (
					<div class="r">
						<span><strong>{hold.kind === 'slot' ? hold.when : 'Another time'}</strong><br /><span class="mute">{hold.kind === 'other' ? hold.otherTime : hold.status}</span></span>
						<form method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="cancel" /><input type="hidden" name="id" value={hold.id} /><button class="btn btn-s btn-sm">Cancel</button></form>
					</div>
				))}
			</section>
		)}
		<section class="card">
			<h2 class="h2">{slotHold ? 'Change your time' : 'Choose a time'}</h2>
			{view.slots.length === 0 ? <p class="soft">No tour times are posted yet.</p> : (
				<form class="form" method="post">
					<input type="hidden" name="csrf" value={csrf} />
					<input type="hidden" name="action" value="book" />
					<div class="opts">
						{view.slots.map((slot) => (
							<label class:list={['optc', slot.unavailable && 'off']}>
								<input type="radio" name="slotId" value={slot.id} checked={slot.mine} disabled={slot.unavailable} />
								<span class="grow stack"><span class="t">{formatTourWhen(slot.date, slot.start, slot.end)}</span><span class="s">{slot.unavailable ? 'Unavailable' : slot.mine ? 'Your time' : 'Available'}</span></span>
							</label>
						))}
					</div>
					<div class="field"><label class="lbl" for="phone">Phone <span class="opt">(optional)</span></label><input id="phone" name="phone" class="inp" value={slotHold?.phone || family.phone} /></div>
					<div class="field">
						<span class="lbl">Children’s grades <span class="opt">(optional)</span></span>
						<div class="chips" style="margin-top:8px">
							{GRADE_OPTIONS.map((grade) => (
								<label class="chip"><input type="checkbox" name="grades" value={grade.value} checked={selectedGrades.has(grade.value)} />{grade.label}</label>
							))}
						</div>
					</div>
					<div class="field"><label class="lbl" for="note">Note <span class="opt">(optional)</span></label><textarea id="note" name="note" class="inp" rows="3">{slotHold?.note}</textarea></div>
					{error && <p class="alert alert-err" role="alert">{error}</p>}
					<button class="btn btn-p">{slotHold ? 'Save this time' : 'Book this time'}</button>
				</form>
			)}
		</section>
		<section class="card" style="margin-top:16px">
			<h2 class="h2">None of these work?</h2>
			<form class="form" method="post">
				<input type="hidden" name="csrf" value={csrf} />
				<input type="hidden" name="action" value="other" />
				<div class="field"><label class="lbl" for="other">What time would work?</label><textarea id="other" name="otherTime" class="inp" rows="3"></textarea></div>
				<button class="btn btn-s">Ask for another time</button>
			</form>
		</section>
	</PortalLayout>
) : (
	<SignLayout title="Request a tour — TCA Portal">
		<div class="si">
			<div class="si-col">
				<div class="si-mark"><img src="/assets/img/emblem-green.svg" alt="" /><h1>Book a tour</h1><p>Create a TCA account, then pick a time. It takes a minute.</p></div>
				<a class="btn btn-p btn-pill btn-block" href="/?next=/tour">Create your TCA account</a>
				<p class="small" style="text-align:center">Already have one? <a href="/?next=/tour">Sign in</a></p>
			</div>
			<p class="si-foot">No account yet and just want to write to us? <a href="/interested">Tell us you’re interested</a>.</p>
		</div>
	</SignLayout>
)}
