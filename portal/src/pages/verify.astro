---
import AuthLayout from '../layouts/AuthLayout.astro';
import { FAMILY_COOKIE, FAMILY_SESSION_DAYS, issueFamilySession, verifyEmailToken } from '@tca/school';

export const prerender = false;

const token = Astro.url.searchParams.get('token') || '';
const familyId = token ? await verifyEmailToken(token) : null;
if (familyId) {
	Astro.cookies.set(FAMILY_COOKIE, issueFamilySession(familyId), {
		httpOnly: true,
		path: '/',
		sameSite: 'lax',
		secure: Astro.url.protocol === 'https:',
		maxAge: FAMILY_SESSION_DAYS * 24 * 60 * 60,
	});
	return Astro.redirect('/home');
}
---
<AuthLayout title="Confirm email — Trinity families" heading="That link did not work" lede="It may have expired. Sign in and we will send a new one.">
	<p class="text-sm"><a class="text-forest" href="/">Back to sign in</a></p>
</AuthLayout>
