	.tca-banner-trigger span:first-child { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.tca-banner-cue { flex: 0 0 auto; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #dea06d; text-decoration: underline; text-underline-offset: 3px; }
	.tca-banner-dismiss { flex: 0 0 auto; width: 40px; height: 40px; display: grid; place-items: center; background: none; border: 0; color: #f0e9d0; cursor: pointer; }
	.tca-modal { position: fixed; inset: 0; z-index: 90; background: #fafaf7; overflow: auto; }
