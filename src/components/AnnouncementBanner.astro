<div data-announcement>
	<div data-banner-bar hidden role="region" aria-label="Announcement" class="tca-banner">
		<div class="tca-banner-row">
			<a data-banner-trigger id="event-details" href="#event-details" class="tca-banner-trigger">
				<span data-banner-text></span>
				<span data-banner-cue hidden class="tca-banner-cue">View flyer</span>
			</a>
			<button type="button" data-banner-dismiss aria-label="Dismiss announcement" class="tca-banner-dismiss">
				<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
					<path d="M2 2 L12 12 M12 2 L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</div>

	<div data-banner-modal hidden class="tca-modal">
		<div class="tca-dialog" role="dialog" aria-modal="true" aria-labelledby="banner-modal-title" aria-hidden="true">
			<div class="tca-sheetbar">
				<span>Announcement</span>
				<button type="button" data-banner-close aria-label="Close">
					<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
						<path d="M2 2 L12 12 M12 2 L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
			<button type="button" data-banner-close class="tca-x" aria-label="Close">
				<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
					<path d="M2 2 L12 12 M12 2 L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
				</svg>
			</button>
			<div data-modal-media class="tca-media"></div>
			<div class="tca-copy">
				<p class="tca-kicker">Upcoming event</p>
				<h2 id="banner-modal-title" data-modal-title></h2>
				<dl class="tca-facts">
					<dt>When</dt>
					<dd data-modal-when></dd>
					<dt>Where</dt>
					<dd data-modal-where></dd>
				</dl>
				<p data-modal-description class="tca-desc"></p>
				<div class="tca-actions">
					<a data-modal-primary hidden class="tca-pill tca-pill-gold"></a>
					<a data-modal-secondary hidden class="tca-pill tca-pill-line"></a>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.tca-banner { position: relative; z-index: 60; background: #002a1a; color: #f0e9d0; font-size: 14px; line-height: 1.4; }
