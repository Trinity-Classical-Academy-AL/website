	.tca-pill { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border-radius: 999px; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; }
	.tca-pill-gold { background: #dea06d; color: #1a1a18; }
	.tca-pill-line { color: #1a1a18; border: 1px solid rgba(26, 26, 24, 0.16); }
	@media (min-width: 1024px) {
		.tca-banner-row { padding-left: 48px; }
		.tca-modal { background: rgba(0, 42, 26, .62); }
