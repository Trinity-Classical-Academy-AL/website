<div data-announcement>
	<div data-banner-bar hidden class="relative z-30 border-b border-gold/20 bg-racing text-white">
		<div class="mx-auto flex w-full max-w-canvas items-start gap-3 px-4 py-2.5 sm:items-center sm:px-10 lg:px-12">
			<a
				data-banner-trigger
				id="event-details"
				href="#event-details"
				class="min-w-0 flex-1 text-center font-sans text-sm leading-snug text-white/95 underline-offset-4 hover:underline sm:text-left"
			></a>
			<button
				type="button"
				data-banner-dismiss
				aria-label="Dismiss announcement"
				class="flex h-8 w-8 shrink-0 items-center justify-center rounded-card text-white/80 transition hover:bg-white/10 hover:text-white"
			>
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
					<line x1="3" y1="3" x2="13" y2="13"></line>
					<line x1="13" y1="3" x2="3" y2="13"></line>
				</svg>
			</button>
		</div>
	</div>

	<div
		data-banner-modal
		hidden
		class="fixed inset-0 z-[80] hidden items-center justify-center overflow-y-auto bg-ink/75 p-3 sm:p-6"
		role="dialog"
		aria-modal="true"
		aria-labelledby="banner-modal-title"
		aria-hidden="true"
	>
		<div class="flex w-full max-w-5xl flex-col items-center gap-4 md:flex-row md:items-stretch md:justify-center">
			<div data-modal-media class="flex w-full items-center justify-center md:w-auto"></div>
			<div class="relative w-full max-w-md rounded-card bg-white p-6 shadow-2xl sm:p-8">
				<button
					type="button"
					data-banner-close
					aria-label="Close event details"
					class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-card text-ink-mute transition hover:text-ink"
				>
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
						<line x1="3" y1="3" x2="13" y2="13"></line>
						<line x1="13" y1="3" x2="3" y2="13"></line>
					</svg>
				</button>
				<p class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest">Upcoming event</p>
				<h2 id="banner-modal-title" data-modal-title class="mt-3 font-display text-3xl italic leading-tight text-ink sm:text-4xl"></h2>
				<p data-modal-when class="mt-4 font-sans text-sm font-medium text-ink"></p>
				<p data-modal-where class="mt-1 font-sans text-sm text-ink-soft"></p>
				<p data-modal-description class="mt-4 font-sans text-sm leading-relaxed text-ink-soft"></p>
				<div class="mt-6 flex flex-col items-start gap-3">
					<a data-modal-primary hidden class="rounded-pill bg-gold px-5 py-2.5 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink"></a>
					<a data-modal-secondary hidden class="font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink-soft hover:text-forest"></a>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import { initAnnouncementBanner } from '../scripts/banner';
	initAnnouncementBanner();
</script>
