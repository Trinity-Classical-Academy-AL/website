---
import { Image } from 'astro:assets';
import emblemInk from '../assets/images/emblem-ink.svg';
import assemblyImg from '../assets/images/assembly.webp';
import { navCategories } from '../lib/nav';
import { PORTAL_URL } from '../lib/links';

const chevron = `<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<header class="v5h" data-v5-header>
	<div class="v5h-in">
		<a href="/" class="v5h-brand" aria-label="Trinity Classical Academy, home">
			<Image src={emblemInk} alt="" width={34} height={33} />
			<span>Trinity Classical Academy</span>
		</a>
		<nav class="v5h-nav" aria-label="Primary">
			<ul class="v5h-list">
				{navCategories.map((cat) => (
					<li>
						<button type="button" class="v5h-trigger" aria-expanded="false" aria-controls="v5-mega" data-nav-trigger={cat.id}>
							{cat.label}
							<Fragment set:html={chevron} />
						</button>
					</li>
				))}
			</ul>
			<div class="v5h-mega" id="v5-mega" role="region" aria-label="Site menu">
				<div class="v5h-mega-in">
					<div class="v5h-cols">
						{navCategories.map((cat) => (
							<div class="v5h-col">
								<p class="v5-eyebrow">{cat.label}</p>
								<ul>
									{cat.items.map((item) => (
										<li>
											<a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} data-ph-event={item.phEvent} data-ph-location={item.phLocation}>
												{item.label}
												{item.external && <span class="v5-ext" aria-hidden="true">↗</span>}
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
					<a class="v5h-feature" href="/visit">
						<Image src={assemblyImg} alt="" width={300} height={120} />
						<span class="v5h-ft">Visit Trinity</span>
						<span class="v5h-fd">See a classroom in session and meet our teachers.</span>
						<span class="v5h-fl">Request a tour →</span>
					</a>
				</div>
			</div>
		</nav>
		<div class="v5h-cta">
			<a class="v5h-signin" href={PORTAL_URL}>Sign in</a>
			<a class="v5-btn v5-btn-gold v5-btn-sm" href="/visit">Request a tour</a>
		</div>
		<button type="button" class="v5h-menu" aria-expanded="false" aria-controls="v5-mnav">
			Menu
			<Fragment set:html={chevron} />
		</button>
	</div>
	<div class="v5h-mpanel" id="v5-mnav">
		{navCategories.map((cat) => (
			<div class="v5h-mg">
				<p class="v5-eyebrow">{cat.label}</p>
				<ul>
					{cat.items.map((item) => (
						<li>
							<a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
								{item.label}
								{item.external && <span class="v5-ext" aria-hidden="true">↗</span>}
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
		<div class="v5h-mcta">
			<a class="v5-btn v5-btn-gold" href="/visit">Request a tour</a>
			<a class="v5-btn v5-btn-line" href={PORTAL_URL}>Sign in</a>
		</div>
	</div>
</header>
<script is:inline>
	(function () {
		const header = document.querySelector('[data-v5-header]');
		if (!header) return;
		const nav = header.querySelector('.v5h-nav');
		const triggers = Array.from(header.querySelectorAll('[data-nav-trigger]'));
		const menu = header.querySelector('.v5h-menu');
		const panel = header.querySelector('.v5h-mpanel');
		const setExpanded = (open) => triggers.forEach((button) => button.setAttribute('aria-expanded', open ? 'true' : 'false'));
		triggers.forEach((button) => {
			button.addEventListener('click', () => {
				const open = nav.classList.toggle('is-open');
				nav.classList.remove('is-dismissed');
				setExpanded(open);
			});
		});
		nav.addEventListener('pointerleave', () => nav.classList.remove('is-dismissed'));
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			if (panel.classList.contains('is-open')) {
				panel.classList.remove('is-open');
				menu.setAttribute('aria-expanded', 'false');
				menu.focus();
				return;
			}
			if (nav.classList.contains('is-open') || nav.matches(':hover') || nav.matches(':focus-within')) {
				nav.classList.remove('is-open');
				nav.classList.add('is-dismissed');
				setExpanded(false);
				(document.activeElement && nav.contains(document.activeElement) ? document.activeElement : triggers[0]).focus();
			}
		});
		document.addEventListener('click', (event) => {
			if (header.contains(event.target)) return;
			nav.classList.remove('is-open');
			setExpanded(false);
			panel.classList.remove('is-open');
			menu.setAttribute('aria-expanded', 'false');
		});
		menu.addEventListener('click', () => {
			const open = panel.classList.toggle('is-open');
			menu.setAttribute('aria-expanded', open ? 'true' : 'false');
		});
	})();
</script>
