---
import { INTERVIEW_URL } from '../lib/links';
---

<!-- Video hero.
     A rounded card inset from the canvas edges (lg:px-12 matches the rest of
     the page) holding a silent classroom loop. A racing-green gradient keeps
     the white headline and intro copy legible over the footage.

     Autoplay is driven by the script below rather than the `autoplay`
     attribute so visitors with `prefers-reduced-motion: reduce` see only the
     poster frame. -->
<section aria-label="Welcome" class="relative z-10 px-6 pt-2 sm:px-10 lg:px-12">
	<div class="relative h-[640px] overflow-hidden rounded-card bg-racing lg:h-[800px]">
		<video
			id="hero-video"
			muted
			loop
			playsinline
			preload="auto"
			poster="/videos/hero-poster.jpg"
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
		>
			<source src="/videos/hero.webm" type="video/webm" />
			<source src="/videos/hero.mp4" type="video/mp4" />
		</video>

		<div
			class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(0,42,26,0)_0%,rgba(0,42,26,0.15)_20%,rgba(0,42,26,0.82)_100%)]"
		></div>

		<div
			class="absolute inset-x-6 bottom-6 flex flex-col items-start gap-8 lg:inset-x-12 lg:bottom-12 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
		>
			<h1
				class="font-display text-[56px] font-light uppercase leading-[0.95] tracking-[-0.01em] text-white lg:text-[clamp(80px,8.6vw,124px)]"
			>
				<span class="block">Truth.</span>
				<span class="block">Goodness.</span>
				<span class="block">Beauty.</span>
			</h1>

			<div class="flex max-w-[340px] flex-col gap-5 lg:pb-2">
				<p class="font-sans text-[15px] font-medium leading-[1.3] text-white lg:text-[17px]">
					<strong class="font-semibold">Trinity Classical Academy</strong>
					is an ACCS-mentored classical Christian school in Birmingham, Alabama, under the care of Trinity Presbyterian Church (CREC). Serving grades K–8, adding a grade each year to become a full K–12 school.
				</p>
				<div class="flex flex-wrap items-center gap-5">
					<a
						href={INTERVIEW_URL}
						target="_blank"
						rel="noopener noreferrer"
						data-ph-event="interview_requested_click"
						data-ph-location="hero"
						class="whitespace-nowrap rounded-pill bg-gold px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink transition hover:bg-gold-hover"
					>
						Request an Interview
					</a>
					<button
						type="button"
						data-newsletter-trigger
						data-ph-event="newsletter_click"
						data-ph-location="hero"
						aria-haspopup="dialog"
						class="whitespace-nowrap font-mono text-[11px] font-medium uppercase tracking-eyebrow text-cream transition hover:text-gold"
					>
						Join the Newsletter
					</button>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const video = document.getElementById('hero-video') as HTMLVideoElement | null;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (video) {
		const tryPlay = () => {
			if (reduceMotion.matches) return;
			video.play().catch(() => {
				// Autoplay blocked; the poster image stays visible.
			});
		};

		tryPlay();

		reduceMotion.addEventListener?.('change', () => {
			if (reduceMotion.matches) video.pause();
			else tryPlay();
		});
	}
</script>
