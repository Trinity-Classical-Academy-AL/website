---
const flyerSrc = '/events/tca-info-meeting-june-4.png';
---

<!-- Hidden duplicate lets Netlify detect the form at static build time. -->
<form name="info-meeting-rsvp" data-netlify="true" netlify-honeypot="bot-field" hidden>
	<input type="text" name="name" />
	<input type="email" name="email" />
	<select name="party_size">
		<option value="1">1</option>
	</select>
	<input type="text" name="bot-field" />
</form>

<section
	aria-label="Upcoming informational meeting"
	class="relative z-50 border-b border-gold/25 bg-racing px-6 py-3 text-white sm:px-10 lg:px-12"
>
	<div class="mx-auto flex w-full max-w-canvas flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
		<button
			type="button"
			data-info-meeting-trigger
			aria-haspopup="dialog"
			class="group flex min-w-0 flex-col items-start gap-1 text-left sm:flex-row sm:items-center sm:gap-3"
		>
			<span class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-gold">
				Upcoming informational meeting night
			</span>
			<span class="hidden h-3 w-px bg-gold/35 sm:block" aria-hidden="true"></span>
			<span class="font-sans text-sm font-medium leading-tight text-white/90 transition-colors group-hover:text-white">
				Thursday, June 4, 2026 at 6:30 PM · Trinity Presbyterian Church
			</span>
		</button>

		<button
			type="button"
			data-info-meeting-trigger
			aria-haspopup="dialog"
			class="inline-flex w-fit items-center rounded-card border border-gold/60 px-3 py-2 font-mono text-[10px] font-medium uppercase tracking-eyebrow text-white transition hover:border-gold hover:bg-gold hover:text-ink"
		>
			View flyer &amp; RSVP
		</button>
	</div>
</section>

<div
	data-info-meeting-modal
	class="fixed inset-0 z-[60] hidden items-start justify-center overflow-y-auto bg-ink/65 px-0 py-0 sm:items-center sm:px-4 sm:py-8"
	role="dialog"
	aria-modal="true"
	aria-labelledby="info-meeting-heading"
	aria-hidden="true"
>
	<div
		data-info-meeting-card
		class="relative flex min-h-screen w-full max-w-5xl flex-col overflow-hidden border border-ink/10 bg-white shadow-2xl sm:min-h-0 sm:max-h-[calc(100vh-4rem)] sm:rounded-card lg:grid lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.95fr)]"
	>
		<button
			type="button"
			data-info-meeting-close
			aria-label="Close informational meeting details"
			class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-card bg-white/90 text-ink-mute shadow-sm transition hover:text-ink"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
				<line x1="3" y1="3" x2="13" y2="13" />
				<line x1="13" y1="3" x2="3" y2="13" />
			</svg>
		</button>

		<div class="max-h-[70vh] overflow-y-auto bg-racing p-3 sm:max-h-[calc(100vh-4rem)] sm:p-5 lg:max-h-[calc(100vh-4rem)]">
			<img
				src={flyerSrc}
				alt="Trinity Classical Academy informational meeting flyer for Thursday, June 4, 2026 at 6:30 PM at Trinity Presbyterian Church."
				class="mx-auto h-auto w-full max-w-[520px] rounded-card border border-white/15 bg-white shadow-xl"
				loading="eager"
			/>
		</div>

		<div class="overflow-y-auto p-6 sm:p-8 lg:max-h-[calc(100vh-4rem)] lg:p-10">
			<p class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest">
				Informational Meeting
			</p>
			<h2
				id="info-meeting-heading"
				class="mt-4 font-display text-[clamp(34px,5vw,56px)] leading-[1.03] text-ink"
			>
				Learn more about Trinity Classical Academy.
			</h2>
			<div class="mt-6 space-y-3 border-y border-ink/10 py-5 font-sans text-sm leading-snug text-ink-soft">
				<p>
					<strong class="font-semibold text-ink">Thursday, June 4, 2026</strong><br />
					6:30 PM
				</p>
				<p>
					<strong class="font-semibold text-ink">Trinity Presbyterian Church</strong><br />
					7160 Cahaba Valley Road<br />
					Birmingham, AL 35242
				</p>
			</div>

			<a
				href={flyerSrc}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-5 inline-flex font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest transition hover:text-ink"
			>
				Open flyer in new tab →
			</a>

			<div class="mt-8" data-info-meeting-state="form">
				<h3 class="font-sans text-base font-semibold text-ink">
					Let us know if you're coming.
				</h3>
				<p class="mt-2 font-sans text-sm leading-snug text-ink-soft">
					This is not required, but it helps us plan.
				</p>

				<form
					method="POST"
					data-netlify="true"
					netlify-honeypot="bot-field"
					data-info-meeting-form
					class="mt-5 flex flex-col gap-4"
				>
					<input type="hidden" name="form-name" value="info-meeting-rsvp" />
					<p class="hidden">
						<label>
							Don't fill this out if you're human: <input name="bot-field" />
						</label>
					</p>

					<label class="flex flex-col gap-1.5">
						<span class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Name</span>
						<input
							type="text"
							name="name"
							required
							autocomplete="name"
							class="rounded-md border border-ink/15 bg-white px-3 py-2.5 font-sans text-sm text-ink outline-none transition focus:border-forest focus:ring-1 focus:ring-forest/30"
						/>
					</label>

					<label class="flex flex-col gap-1.5">
						<span class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Email</span>
						<input
							type="email"
							name="email"
							required
							autocomplete="email"
							class="rounded-md border border-ink/15 bg-white px-3 py-2.5 font-sans text-sm text-ink outline-none transition focus:border-forest focus:ring-1 focus:ring-forest/30"
						/>
					</label>

					<label class="flex flex-col gap-1.5">
						<span class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">How many are coming?</span>
						<select
							name="party_size"
							required
							class="rounded-md border border-ink/15 bg-white px-3 py-2.5 font-sans text-sm text-ink outline-none transition focus:border-forest focus:ring-1 focus:ring-forest/30"
						>
							<option value="1">1</option>
							<option value="2">2</option>
							<option value="3">3</option>
							<option value="4">4</option>
							<option value="5">5</option>
							<option value="6+">6+</option>
						</select>
					</label>

					<button
						type="submit"
						data-info-meeting-submit
						class="mt-2 rounded-pill bg-gold px-7 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink transition hover:bg-gold-hover disabled:cursor-not-allowed disabled:opacity-60"
					>
						Send RSVP
					</button>

					<p data-info-meeting-error class="hidden font-mono text-xs text-[#b91c1c]"></p>
				</form>
			</div>

			<div data-info-meeting-state="success" hidden class="mt-8 border-t border-ink/10 pt-6">
				<h3 class="font-sans text-base font-semibold text-ink">
					Thanks, we'll look forward to seeing you.
				</h3>
				<p class="mt-2 font-sans text-sm leading-snug text-ink-soft">
					You can close this window or keep the flyer open for the details.
				</p>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	(() => {
		const modal = document.querySelector('[data-info-meeting-modal]');
		if (!modal) return;

		const form = modal.querySelector('[data-info-meeting-form]');
		const submitBtn = modal.querySelector('[data-info-meeting-submit]');
		const errorEl = modal.querySelector('[data-info-meeting-error]');
		const formState = modal.querySelector('[data-info-meeting-state="form"]');
		const successState = modal.querySelector('[data-info-meeting-state="success"]');
		let lastFocusedElement = null;

		const encode = (data) =>
			Object.keys(data)
				.map((k) => encodeURIComponent(k) + '=' + encodeURIComponent(data[k]))
				.join('&');

		const setError = (msg) => {
			if (!errorEl) return;
			if (!msg) {
				errorEl.classList.add('hidden');
				errorEl.textContent = '';
			} else {
				errorEl.classList.remove('hidden');
				errorEl.textContent = msg;
			}
		};

		const open = (trigger) => {
			lastFocusedElement = trigger || document.activeElement;
			modal.classList.remove('hidden');
			modal.classList.add('flex');
			modal.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			modal.querySelector('[data-info-meeting-close]')?.focus();
		};

		const close = () => {
			modal.classList.add('hidden');
			modal.classList.remove('flex');
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			lastFocusedElement?.focus();
			lastFocusedElement = null;
		};

		document.addEventListener('click', (event) => {
			const trigger = event.target.closest?.('[data-info-meeting-trigger]');
			if (trigger) {
				event.preventDefault();
				open(trigger);
				return;
			}

			if (event.target.closest?.('[data-info-meeting-close]') && !modal.classList.contains('hidden')) {
				close();
			}
		});

		modal.addEventListener('click', (event) => {
			if (event.target === modal) close();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !modal.classList.contains('hidden')) close();
		});

		form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			setError('');

			const formData = new FormData(form);
			const payload = {};
			for (const [key, value] of formData.entries()) payload[key] = value.toString();

			const controls = form.querySelectorAll('input:not([type="hidden"]), select, button');
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = 'Sending...';
			}
			controls.forEach((el) => { el.disabled = true; });

			try {
				const response = await fetch('/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: encode(payload),
				});
				if (!response.ok) throw new Error('Netlify returned ' + response.status);
				form.reset();
				formState.setAttribute('hidden', '');
				successState.removeAttribute('hidden');
			} catch (err) {
				setError('Something went wrong. Please try again, or email info@trinityclassical.academy if it persists.');
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = 'Send RSVP';
				}
				controls.forEach((el) => { el.disabled = false; });
			}
		});
	})();
</script>
