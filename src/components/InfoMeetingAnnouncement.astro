---
const flyerSrc = '/events/tca-info-meeting-june-4.png';
---

<section
	aria-label="Upcoming informational meeting"
	class="relative z-50 border-b border-gold/25 bg-racing px-6 py-3 text-white sm:px-10 lg:px-12"
>
	<div class="mx-auto flex w-full max-w-canvas flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
		<button
			type="button"
			data-info-meeting-trigger
			aria-haspopup="dialog"
			class="group flex min-w-0 flex-col items-start gap-1 text-left sm:flex-row sm:items-center sm:gap-3"
		>
			<span class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-gold">
				Upcoming informational meeting night
			</span>
			<span class="hidden h-3 w-px bg-gold/35 sm:block" aria-hidden="true"></span>
			<span class="font-sans text-sm font-medium leading-tight text-white/90 transition-colors group-hover:text-white">
				Thursday, June 4, 2026 at 6:30 PM · Trinity Presbyterian Church
			</span>
		</button>

		<button
			type="button"
			data-info-meeting-trigger
			aria-haspopup="dialog"
			class="inline-flex w-fit items-center rounded-card border border-gold/60 px-3 py-2 font-mono text-[10px] font-medium uppercase tracking-eyebrow text-white transition hover:border-gold hover:bg-gold hover:text-ink"
		>
			View flyer
		</button>
	</div>
</section>

<div
	data-info-meeting-modal
	class="fixed inset-0 z-[60] hidden items-center justify-center overflow-y-auto bg-ink/80 px-3 py-3 sm:px-6 sm:py-6"
	role="dialog"
	aria-modal="true"
	aria-labelledby="info-meeting-heading"
	aria-hidden="true"
>
	<div
		data-info-meeting-card
		class="relative flex min-h-[calc(100vh-1.5rem)] w-full items-center justify-center sm:min-h-0"
	>
		<h2 id="info-meeting-heading" class="sr-only">
			Trinity Classical Academy informational meeting flyer
		</h2>
		<button
			type="button"
			data-info-meeting-close
			aria-label="Close informational meeting flyer"
			class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-card bg-white/95 text-ink-mute shadow-sm transition hover:text-ink"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
				<line x1="3" y1="3" x2="13" y2="13" />
				<line x1="13" y1="3" x2="3" y2="13" />
			</svg>
		</button>

		<img
			src={flyerSrc}
			alt="Trinity Classical Academy informational meeting flyer for Thursday, June 4, 2026 at 6:30 PM at Trinity Presbyterian Church."
			class="h-auto max-h-[calc(100vh-1.5rem)] w-auto max-w-full object-contain shadow-2xl sm:max-h-[calc(100vh-3rem)]"
			loading="eager"
		/>
	</div>
</div>

<script is:inline>
	(() => {
		const modal = document.querySelector('[data-info-meeting-modal]');
		if (!modal) return;

		let lastFocusedElement = null;

		const open = (trigger) => {
			lastFocusedElement = trigger || document.activeElement;
			modal.classList.remove('hidden');
			modal.classList.add('flex');
			modal.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			modal.querySelector('[data-info-meeting-close]')?.focus();
		};

		const close = () => {
			modal.classList.add('hidden');
			modal.classList.remove('flex');
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			lastFocusedElement?.focus();
			lastFocusedElement = null;
		};

		document.addEventListener('click', (event) => {
			const trigger = event.target.closest?.('[data-info-meeting-trigger]');
			if (trigger) {
				event.preventDefault();
				open(trigger);
				return;
			}

			if (event.target.closest?.('[data-info-meeting-close]') && !modal.classList.contains('hidden')) {
				close();
			}
		});

		modal.addEventListener('click', (event) => {
			if (event.target === modal) close();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !modal.classList.contains('hidden')) close();
		});
	})();
</script>
