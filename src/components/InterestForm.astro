---
interface Props {
	id?: string;
}

const { id = 'interest' } = Astro.props;
const pagePath = Astro.url.pathname;
const field = (name: string) => `${id}-${name}`;
---

<section class="relative z-10 px-6 py-16 sm:px-10 lg:px-12" aria-labelledby={field('heading')} data-interest data-page-path={pagePath}>
	<div class="mx-auto grid w-full max-w-canvas gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-start">
		<div>
			<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest">Admissions</p>
			<h2 id={field('heading')} class="mt-4 font-display text-[clamp(40px,5vw,64px)] italic leading-[1.05] text-ink">
				Interested in Trinity?
			</h2>
			<p class="mt-5 max-w-md font-sans text-base leading-snug text-ink-soft">
				Not ready to tour? Send your name and email. We'll answer what families usually ask about admissions, the cohort, and tuition.
			</p>
		</div>

		<div class="rounded-card border border-ink/10 bg-cream/30 p-5 sm:p-8">
			<div data-interest-view="success" hidden>
				<h3 tabindex="-1" data-success-heading class="font-display text-3xl italic text-ink outline-none">
					Thanks, <span data-success-name></span>.
				</h3>
				<p class="mt-3 font-sans text-base leading-snug text-ink-soft">We have your note and will be in touch.</p>
			</div>

			<form data-interest-view="form" novalidate class="flex flex-col gap-4">
				<p class="hidden">
					<label>Company <input name="company" tabindex="-1" autocomplete="off" /></label>
				</p>
				<div data-error-summary role="alert" hidden class="rounded-card border border-[#e7b2a8] bg-[#fdecea] px-4 py-3 font-sans text-sm text-[#9f2d2d]"></div>
				<div data-server-error tabindex="-1" role="alert" hidden class="rounded-card border border-[#e7b2a8] bg-[#fdecea] px-4 py-3 font-sans text-sm text-[#9f2d2d]"></div>
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						<label for={field('name')} class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Name</label>
						<input id={field('name')} name="name" type="text" autocomplete="name" data-field="name" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none focus:border-forest aria-[invalid=true]:border-[#b42318]" />
						<p data-error-for="name" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
					</div>
					<div>
						<label for={field('email')} class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Email</label>
						<input id={field('email')} name="email" type="email" autocomplete="email" inputmode="email" data-field="email" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none focus:border-forest aria-[invalid=true]:border-[#b42318]" />
						<p data-error-for="email" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
					</div>
				</div>
				<div>
					<label for={field('phone')} class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Phone <span class="normal-case tracking-normal">(optional)</span></label>
					<input id={field('phone')} name="phone" type="tel" autocomplete="tel" data-field="phone" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none focus:border-forest aria-[invalid=true]:border-[#b42318]" />
					<p data-error-for="phone" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
				</div>
				<div>
					<label for={field('message')} class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">What would you like to know? <span class="normal-case tracking-normal">(optional)</span></label>
					<textarea id={field('message')} name="message" rows="3" data-field="message" class="mt-1.5 w-full resize-y rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none focus:border-forest"></textarea>
					<p data-error-for="message" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
				</div>
				<button type="submit" data-submit class="self-start rounded-pill bg-gold px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink transition hover:bg-gold-hover disabled:cursor-wait disabled:opacity-70">
					Send
				</button>
			</form>
		</div>
	</div>
</section>

<script>
	import { initInterestForms } from '../scripts/interest-form';
	initInterestForms();
</script>
