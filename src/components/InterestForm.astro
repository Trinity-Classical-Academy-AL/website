---
import { PORTAL_URL } from '../lib/links';

interface Props {
	id?: string;
}
const { id = 'interest' } = Astro.props;
const emailId = `${id}-email`;
const errId = `${id}-err`;
---

<section class="v5c v5c-a" aria-label="Get updates">
	<div class="v5-wrap">
		<div>
			<h2 class="v5c-h">Stay in the loop</h2>
			<p class="v5c-sub">Tour dates, info nights and school news. No account needed.</p>
		</div>
		<div>
			<div class="v5-alert" data-slim-alert hidden role="alert" style="margin-bottom:8px">
				<p class="v5-strong">We couldn’t add you.</p>
				<p>Check your connection and try again.</p>
			</div>
			<form class="v5c-form" novalidate aria-label="Email updates" data-slim-updates data-source={Astro.url.pathname}>
				<label class="sr-only" for={emailId}>Email</label>
				<input id={emailId} class="v5-input" type="email" name="email" placeholder="Your email" autocomplete="email" aria-describedby={errId} />
				<button type="submit" class="v5-btn v5-btn-gold">Get updates</button>
			</form>
			<p id={errId} class="v5-err" data-slim-error hidden role="alert">
				<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.5v4.2M8 11v.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
				<span>Enter an email address like name@example.com.</span>
			</p>
			<div class="v5-done" data-slim-done hidden role="status" aria-live="polite" style="margin-top:0">
				<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
				<div>
					<p class="v5-strong">You’re on the list.</p>
					<p>We’ll email <span data-slim-address></span> with tour dates and school news.</p>
				</div>
			</div>
			<p class="v5c-links">or <a href={PORTAL_URL}>create your TCA account</a> · <a href={PORTAL_URL}>Sign in</a></p>
		</div>
	</div>
</section>
<script>
	document.querySelectorAll('[data-slim-updates]').forEach((node) => {
		const form = node instanceof HTMLFormElement ? node : null;
		if (!form || form.dataset.bound === 'true') return;
		form.dataset.bound = 'true';
		const panel = form.parentElement;
		const input = form.querySelector('input[name="email"]');
		const button = form.querySelector('button');
		const error = panel?.querySelector('[data-slim-error]');
		const alert = panel?.querySelector('[data-slim-alert]');
		const done = panel?.querySelector('[data-slim-done]');
		const address = done?.querySelector('[data-slim-address]');
		const showError = (invalid: boolean) => {
			if (input instanceof HTMLInputElement) {
				input.classList.toggle('is-bad', invalid);
				input.setAttribute('aria-invalid', invalid ? 'true' : 'false');
			}
			if (error instanceof HTMLElement) error.hidden = !invalid;
		};
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const email = input instanceof HTMLInputElement ? input.value.trim() : '';
			const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
			showError(!valid);
			if (alert instanceof HTMLElement) alert.hidden = true;
			if (!valid) return;
			if (input instanceof HTMLInputElement) input.disabled = true;
			if (button instanceof HTMLButtonElement) {
				button.disabled = true;
				button.setAttribute('aria-busy', 'true');
				button.textContent = 'Sending…';
			}
			try {
				const response = await fetch('/api/updates', {
					method: 'POST',
					headers: { 'content-type': 'application/json', accept: 'application/json' },
					body: JSON.stringify({ email, source: form.dataset.source || 'website' }),
				});
				if (!response.ok) throw new Error('save failed');
				form.hidden = true;
				if (error instanceof HTMLElement) error.hidden = true;
				if (address) address.textContent = email;
				if (done instanceof HTMLElement) done.hidden = false;
			} catch {
				if (alert instanceof HTMLElement) alert.hidden = false;
				if (input instanceof HTMLInputElement) {
					input.disabled = false;
					input.value = email;
				}
				if (button instanceof HTMLButtonElement) {
					button.disabled = false;
					button.removeAttribute('aria-busy');
					button.textContent = 'Get updates';
				}
			}
		});
	});
</script>
