---
import { Image } from 'astro:assets';
import emblemGreen from '../assets/images/emblem-green.svg';
import assemblyImg from '../assets/images/assembly.webp';
import { INTERVIEW_URL } from '../lib/links';
---

<!-- Mission statement card. Sits directly under the video hero: statement
     and CTAs on the left, morning-assembly photo on the right. Stacks on
     mobile. -->
<section aria-label="Our Mission" class="relative z-10 px-6 pt-16 sm:px-10 lg:px-12 lg:pt-20">
	<div
		class="grid grid-cols-1 items-center gap-10 rounded-card bg-cream p-8 lg:grid-cols-2 lg:gap-14 lg:p-14"
	>
		<div class="flex flex-col items-start gap-8">
			<Image src={emblemGreen} alt="" class="h-12 w-auto" />

			<p class="font-display text-[30px] font-light leading-[1.08] text-ink lg:text-[38px]">
				<em class="italic">We believe education is an act of worship.</em>
				Every subject from mathematics and literature, to Latin and music
				is an opportunity to know the Triune God more clearly and love
				Him more fully.
			</p>

			<p class="max-w-[420px] font-display text-lg font-light leading-[1.25] text-ink">
				We are a classical Christian school in Birmingham, under the care of
				Trinity Presbyterian Church. We'd love to meet your family.
			</p>

			<div class="flex flex-wrap items-center gap-5">
				<a
					href={INTERVIEW_URL}
					target="_blank"
					rel="noopener noreferrer"
					data-ph-event="interview_requested_click"
					data-ph-location="mission-band"
					class="whitespace-nowrap rounded-pill bg-gold px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink transition hover:bg-gold-hover"
				>
					Request an Interview
				</a>
				<a
					href="/contact"
					class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute transition hover:text-forest"
				>
					or contact us →
				</a>
			</div>
		</div>

		<Image
			src={assemblyImg}
			alt="Students gathered for morning assembly"
			widths={[640, 960, 1280]}
			sizes="(min-width: 1024px) 640px, 100vw"
			class="block h-[360px] w-full rounded-card object-cover lg:h-[520px]"
		/>
	</div>
</section>
