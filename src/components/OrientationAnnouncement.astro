---
import { getFlyerExpirationTime, isFlyerExpired } from '../lib/flyerExpiration';

interface Props {
	eyebrow: string;
	details: string;
	flyerSrc: string;
	flyerAlt: string;
	storageKey: string;
	ariaLabel?: string;
	modalHeading?: string;
	ctaLabel?: string;
	autoOpenPath?: string | null;
	expirationDate?: string;
	expirationTimeZone?: string;
}

const {
	eyebrow,
	details,
	flyerSrc,
	flyerAlt,
	storageKey,
	ariaLabel = eyebrow,
	modalHeading = flyerAlt,
	ctaLabel = 'View flyer',
	autoOpenPath = '/',
	expirationDate,
	expirationTimeZone = 'America/Chicago',
} = Astro.props;

const expirationTime = getFlyerExpirationTime(expirationDate, expirationTimeZone);
const shouldRender = !isFlyerExpired(expirationDate, new Date(), expirationTimeZone);
---

{shouldRender && (
	<div
		data-flyer-announcement
		data-storage-key={storageKey}
		data-auto-open-enabled={autoOpenPath !== null ? 'true' : 'false'}
		data-auto-open-path={autoOpenPath ?? ''}
		data-expiration-time={expirationTime}
	>
		<section
			aria-label={ariaLabel}
			class="relative z-50 border-b border-gold/25 bg-racing px-6 py-3 text-white sm:px-10 lg:px-12"
		>
			<div class="mx-auto flex w-full max-w-canvas flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
				<button
					type="button"
					data-flyer-trigger
					aria-haspopup="dialog"
					class="group flex min-w-0 flex-col items-start gap-1 text-left sm:flex-row sm:items-center sm:gap-3"
				>
					<span class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-gold">
						{eyebrow}
					</span>
					<span class="hidden h-3 w-px bg-gold/35 sm:block" aria-hidden="true"></span>
					<span class="font-sans text-sm font-medium leading-tight text-white/90 transition-colors group-hover:text-white">
						{details}
					</span>
				</button>

				<button
					type="button"
					data-flyer-trigger
					aria-haspopup="dialog"
					class="inline-flex w-fit items-center rounded-card border border-gold/60 px-3 py-2 font-mono text-[10px] font-medium uppercase tracking-eyebrow text-white transition hover:border-gold hover:bg-gold hover:text-ink"
				>
					{ctaLabel}
				</button>
			</div>
		</section>

		<div
			data-flyer-modal
			class="fixed inset-0 z-[60] hidden items-center justify-center overflow-y-auto bg-ink/80 px-3 py-3 sm:px-6 sm:py-6"
			role="dialog"
			aria-modal="true"
			aria-label={modalHeading}
			aria-hidden="true"
		>
			<div class="relative flex min-h-[calc(100vh-1.5rem)] w-full items-center justify-center sm:min-h-0">
				<button
					type="button"
					data-flyer-close
					aria-label={`Close ${modalHeading}`}
					class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-card bg-white/95 text-ink-mute shadow-sm transition hover:text-ink"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
						<line x1="3" y1="3" x2="13" y2="13" />
						<line x1="13" y1="3" x2="3" y2="13" />
					</svg>
				</button>

				<img
					src={flyerSrc}
					alt={flyerAlt}
					class="h-auto max-h-[calc(100vh-1.5rem)] w-auto max-w-full object-contain shadow-2xl sm:max-h-[calc(100vh-3rem)]"
					loading="eager"
				/>
			</div>
		</div>

		<script is:inline>
			(() => {
				const AUTO_OPEN_DELAY_MS = 800;
				const root = document.currentScript?.closest('[data-flyer-announcement]');
				const modal = root?.querySelector('[data-flyer-modal]');
				if (!root || !modal) return;
				const storageKey = root.getAttribute('data-storage-key') || '';
				const autoOpenEnabled = root.getAttribute('data-auto-open-enabled') === 'true';
				const autoOpenPath = root.getAttribute('data-auto-open-path');
				const expirationValue = root.getAttribute('data-expiration-time');
				const expirationTime = expirationValue === null ? null : Number(expirationValue);

				let lastFocusedElement = null;
				let closeMarksSeen = false;
				let autoOpenTimer = null;
				let expirationTimer = null;
				let expirationInterval = null;

				const clearAutoOpen = () => {
					if (autoOpenTimer !== null) {
						window.clearTimeout(autoOpenTimer);
						autoOpenTimer = null;
					}
				};

				const open = (trigger, options = {}) => {
					lastFocusedElement = trigger || document.activeElement;
					closeMarksSeen = options.markSeenOnClose === true;
					modal.classList.remove('hidden');
					modal.classList.add('flex');
					modal.setAttribute('aria-hidden', 'false');
					document.body.style.overflow = 'hidden';
					modal.querySelector('[data-flyer-close]')?.focus();
				};

				const close = () => {
					modal.classList.add('hidden');
					modal.classList.remove('flex');
					modal.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
					lastFocusedElement?.focus();
					lastFocusedElement = null;
					if (closeMarksSeen) {
						try {
							localStorage.setItem(storageKey, 'dismissed');
						} catch (err) {}
					}
					closeMarksSeen = false;
				};

				const expireIfNeeded = () => {
					if (expirationTime == null || Date.now() < expirationTime) return false;
					clearAutoOpen();
					if (!modal.classList.contains('hidden')) close();
					if (expirationTimer !== null) window.clearTimeout(expirationTimer);
					if (expirationInterval !== null) window.clearInterval(expirationInterval);
					root.remove();
					return true;
				};

				root.addEventListener('click', (event) => {
					const trigger = event.target.closest?.('[data-flyer-trigger]');
					if (trigger) {
						event.preventDefault();
						clearAutoOpen();
						open(trigger, { markSeenOnClose: true });
						return;
					}

					if (event.target.closest?.('[data-flyer-close]') && !modal.classList.contains('hidden')) {
						close();
					}
				});

				modal.addEventListener('click', (event) => {
					if (event.target === modal) close();
				});

				document.addEventListener('keydown', (event) => {
					if (modal.classList.contains('hidden')) return;
					if (event.key === 'Escape') {
						close();
						return;
					}

					if (event.key === 'Tab') {
						const focusableElements = [...modal.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])')];
						if (focusableElements.length === 0) {
							event.preventDefault();
							return;
						}

						const firstFocusable = focusableElements[0];
						const lastFocusable = focusableElements[focusableElements.length - 1];
						if (event.shiftKey && document.activeElement === firstFocusable) {
							event.preventDefault();
							lastFocusable.focus();
						} else if (!event.shiftKey && document.activeElement === lastFocusable) {
							event.preventDefault();
							firstFocusable.focus();
						}
					}
				});

				if (expirationTime != null) {
					if (expireIfNeeded()) return;
					const MAX_TIMEOUT_MS = 2_147_000_000;
					expirationTimer = window.setTimeout(expireIfNeeded, Math.min(expirationTime - Date.now(), MAX_TIMEOUT_MS));
					expirationInterval = window.setInterval(expireIfNeeded, 60_000);
				}

				if (autoOpenEnabled && location.pathname === autoOpenPath) {
					let hasSeen = false;
					try {
						hasSeen = localStorage.getItem(storageKey) === 'dismissed';
					} catch (err) {}
					if (!hasSeen) {
						autoOpenTimer = window.setTimeout(() => {
							autoOpenTimer = null;
							if (!expireIfNeeded() && modal.classList.contains('hidden')) {
								open(null, { markSeenOnClose: true });
							}
						}, AUTO_OPEN_DELAY_MS);
					}
				}
			})();
		</script>
	</div>
)}
