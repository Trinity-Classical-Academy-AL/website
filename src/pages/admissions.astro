---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InterestForm from '../components/InterestForm.astro';
import { INTERVIEW_URL } from '../lib/links';
import assemblyImg from '../assets/images/assembly.webp';
import storytimeImg from '../assets/images/storytime.webp';
import diggsImg from '../assets/images/diggs.webp';
import lecternImg from '../assets/images/lectern.webp';
import museumImg from '../assets/images/museum.webp';

const title = 'Admissions — Trinity Classical Academy';
const description =
	'Admissions at Trinity Classical Academy: request an interview, meet with the school, and receive an invitation to apply.';

const steps = [
	{
		image: storytimeImg,
		alt: 'Students gathered around a picture book and a map',
		position: '50% 50%',
		title: 'Request an interview',
		body: 'Tell us about your family and what you’re looking for. We reply within a day or two to set a time.',
		meta: 'Online form',
	},
	{
		image: diggsImg,
		alt: 'A teacher leading his cohort',
		position: '35% 40%',
		title: 'Meet with us',
		body: 'An unhurried, two-way conversation, in person or by video. You learn what Trinity offers; we get to know your family.',
		meta: 'In person or by video',
	},
	{
		image: lecternImg,
		alt: 'Upper-school students listening at the lectern',
		position: '50% 50%',
		title: 'Apply and enroll',
		body: 'If we both see a good fit, we invite you to complete the application and enroll your student.',
		meta: 'Invitation to apply',
	},
];
---

<Layout {title} {description}>
	<Header />
	<div class="v5-page">
		<section class="v5-hero" aria-labelledby="adm-h">
			<div class="v5-wrap v5-hero-grid">
				<div class="v5-hero-t">
					<p class="v5-eyebrow">Admissions</p>
					<h1 id="adm-h" class="v5-h1">How to join Trinity</h1>
					<p class="v5-lede">Enrollment is a process of mutual discernment. We’re inviting families into a partnership that shapes children for years, so we take the time to get to know you.</p>
					<div class="v5-actions">
						<a class="v5-btn v5-btn-gold" href={INTERVIEW_URL} target="_blank" rel="noopener noreferrer" data-ph-event="interview_requested_click" data-ph-location="admissions">Request an interview</a>
						<a class="v5-btn v5-btn-line" href="/visit">Request a tour</a>
					</div>
					<div class="v5-facts">
						<div class="v5-fact"><p class="v5-fact-k">Grades</p><p class="v5-fact-v">K–8, adding a grade each year</p></div>
						<div class="v5-fact"><p class="v5-fact-k">Schedule</p><p class="v5-fact-v">Four days a week on campus</p></div>
						<div class="v5-fact"><p class="v5-fact-k">Location</p><p class="v5-fact-v">7160 Cahaba Valley Rd., Birmingham</p></div>
					</div>
				</div>
				<div class="v5-hero-img">
					<Image src={assemblyImg} alt="Students gathered for morning assembly" style="object-position:50% 50%" />
				</div>
			</div>
		</section>
		<section class="v5-sec" aria-labelledby="steps-h">
			<div class="v5-wrap">
				<div class="v5-sec-head">
					<p class="v5-eyebrow">The process</p>
					<h2 id="steps-h" class="v5-h2">Three steps</h2>
					<p class="v5-lede">A conversation first, then an application.</p>
				</div>
				<ol class="v5-steps">
					{steps.map((step, index) => (
						<li class="v5-step">
							<div class="v5-step-img">
								<Image src={step.image} alt={step.alt} style={`object-position:${step.position}`} />
							</div>
							<div class="v5-step-b">
								<span class="v5-num" aria-hidden="true">{index + 1}</span>
								<h3 class="v5-h3">{step.title}</h3>
								<p class="v5-body">{step.body}</p>
								<p class="v5-meta">{step.meta}</p>
							</div>
						</li>
					))}
				</ol>
			</div>
		</section>
		<section class="v5-sec v5-sec-tint" aria-labelledby="good-h">
			<div class="v5-wrap v5-good-grid">
				<div class="v5-good-img">
					<Image src={museumImg} alt="A field trip at the natural history museum" style="object-position:40% 60%" />
				</div>
				<div>
					<p class="v5-eyebrow">Before you apply</p>
					<h2 id="good-h" class="v5-h2">Good to know</h2>
					<ul class="v5-links">
						<li><a href="/resources/tuition"><span class="v5-gt">Tuition policy</span><span class="v5-gd">Tuition, fees and payment schedule</span><span class="v5-arr" aria-hidden="true">→</span></a></li>
						<li><a href="/curriculum"><span class="v5-gt">Curriculum</span><span class="v5-gd">What your child will study, subject by subject</span><span class="v5-arr" aria-hidden="true">→</span></a></li>
						<li><a href="/resources/uniform"><span class="v5-gt">Uniform policy</span><span class="v5-gd">What students wear</span><span class="v5-arr" aria-hidden="true">→</span></a></li>
						<li><a href="/faq"><span class="v5-gt">FAQ</span><span class="v5-gd">Common questions from families</span><span class="v5-arr" aria-hidden="true">→</span></a></li>
					</ul>
					<p class="v5-small" style="margin-top:20px">Still have questions? <a href="/contact">Contact the school office</a>.</p>
				</div>
			</div>
		</section>
		<InterestForm id="admissions-interest" />
	</div>
	<Footer />
</Layout>
