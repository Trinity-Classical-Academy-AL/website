---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { INTERVIEW_URL } from '../lib/links';
import { curriculumSubjects } from '../lib/curriculumSubjects';

// Subject copy, images and programs live in src/lib/curriculumSubjects.ts.
const title = 'Curriculum — Trinity Classical Academy';
const description =
	'Curriculum at Trinity Classical Academy: integrated humanities, Latin, music, art, logic, grammar, writing, phonics, geography, science, and mathematics.';
---

<Layout {title} {description} canonicalPath="/curriculum/">
	<Header />

	<main class="mx-auto w-full max-w-canvas bg-white">
		<section
			aria-labelledby="curriculum-heading"
			class="border-b border-forest/15 px-6 pb-[72px] pt-20 sm:px-10 lg:px-12 lg:pt-28"
		>
			<div class="max-w-[880px]">
				<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest">
					Curriculum Overview
				</p>
				<h1
					id="curriculum-heading"
					class="mt-7 font-display text-[52px] font-light leading-none tracking-[-0.01em] text-ink lg:text-[88px]"
				>
					Learning you <em class="italic">can see.</em>
				</h1>
				<p class="mt-8 max-w-[720px] font-display text-[22px] font-light leading-[1.35] text-ink lg:text-[26px]">
					A walk through the subjects as they look in our classrooms: what each one builds, the program we teach it with, and why.
				</p>
			</div>
		</section>

		<section aria-label="Subjects" class="px-6 pt-8 sm:px-10 lg:px-12">
			{curriculumSubjects.map((subject, index) => {
				const imageFirst = index % 2 === 0;
				const number = String(index + 1).padStart(2, '0');
				return (
					<article class="grid grid-cols-1 items-center gap-4 py-12 lg:grid-cols-2 lg:gap-16">
						<div class={imageFirst ? '' : 'lg:order-2'}>
							{subject.contain ? (
								<Image
									src={subject.image}
									alt={subject.imageAlt}
									widths={[480, 720, 960]}
									sizes="(min-width: 1024px) 640px, 100vw"
									class="block h-[440px] w-full rounded-card bg-[#fdf8ef] object-contain lg:h-[560px]"
								/>
							) : (
								<Image
									src={subject.image}
									alt={subject.imageAlt}
									widths={[480, 720, 960, 1280]}
									sizes="(min-width: 1024px) 640px, 100vw"
									class="block h-[280px] w-full rounded-card object-cover lg:h-[440px]"
									style={subject.imagePosition ? `object-position: ${subject.imagePosition}` : undefined}
								/>
							)}
						</div>

						<div class={`flex flex-col gap-[18px] ${imageFirst ? '' : 'lg:order-1'}`}>
							<p class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">
								{number} · {subject.levels}
							</p>
							<h2 class="font-display text-[40px] font-light leading-none text-ink lg:text-5xl">
								{subject.name}
							</h2>
							<p class="font-display text-[22px] font-light italic leading-[1.25] text-ink">
								{subject.summary}
							</p>
							<p class="font-sans text-base leading-[1.55] text-ink">
								{subject.body}
							</p>
							<div class="pt-2">
								{subject.logo ? (
									<Image
										src={subject.logo}
										alt={subject.program}
										class="block h-7 w-auto max-w-[180px] object-contain object-left"
									/>
								) : (
									<span class="font-display text-[17px] italic text-ink">{subject.program}</span>
								)}
							</div>
						</div>
					</article>
				);
			})}
		</section>

		<section aria-labelledby="next-step-heading" class="px-6 py-24 text-center sm:px-10 lg:px-12">
			<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest">Next step</p>
			<h2
				id="next-step-heading"
				class="mx-auto mt-5 max-w-[760px] font-display text-[36px] font-light leading-[1.05] text-ink lg:text-5xl"
			>
				See it in a classroom. Families and prospective teachers are welcome to visit.
			</h2>
			<div class="mt-9 flex flex-wrap items-center justify-center gap-6">
				<a
					href={INTERVIEW_URL}
					target="_blank"
					rel="noopener noreferrer"
					data-ph-event="interview_requested_click"
					data-ph-location="curriculum"
					class="inline-block rounded-pill bg-gold px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink transition hover:bg-gold-hover"
				>
					Request an Interview
				</a>
				<a
					href="/careers"
					class="font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink-mute transition hover:text-forest"
				>
					Teaching at Trinity →
				</a>
				<a
					href="/our-vision"
					class="font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink-mute transition hover:text-forest"
				>
					Our Vision →
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
