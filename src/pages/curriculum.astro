---
import { Image } from 'astro:assets';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import emblemGreen from '../assets/images/emblem-green.svg';
import concordisLogo from '../assets/images/curriculum/concordis.png';
import swrLogo from '../assets/images/curriculum/swr.png';
import iewLogo from '../assets/images/curriculum/iew.png';
import pictaDictaLogo from '../assets/images/curriculum/picta-dicta.png';
import singaporeMathLogo from '../assets/images/curriculum/singapore-math.png';
import bereanBuildersLogo from '../assets/images/curriculum/berean-builders.png';
import { INTERVIEW_URL } from '../lib/links';

const title = 'Our Curriculum — Trinity Classical Academy';
const description =
	'The curriculum choices at Trinity Classical Academy, from integrated humanities to reading, writing, mathematics, science, music, logic, and rhetoric.';

const featured = {
	label: 'The Heart of the Curriculum',
	title: 'Integrated Humanities',
	program: 'Concordis',
	sourceLinks: [{ label: 'Concordis Education Partners', href: 'https://concordispartners.com' }],
	logo: concordisLogo,
	logoAlt: 'Concordis Education Partners',
	copy: "All truth is God's truth, so we teach history, literature, and theology as one subject, in the order it happened. A student reading about Rome reads Rome's writers and sees where the church stood in those same years. It is one story, God's story, and we teach it as one.",
};

const sections = [
	{
		id: 'reading-spelling',
		label: 'Reading & Spelling',
		title: 'Spell to Write and Read',
		sourceLinks: [{ label: 'Spell to Write and Read', href: 'https://www.swrhome.com' }],
		logo: swrLogo,
		logoAlt: 'Spell to Write and Read',
		copy: 'Spell to Write and Read teaches the phonograms and spelling rules that govern English. Students sound out and write words by hand from the start, so reading and spelling are learned together. A child trained this way can read and spell a word he has never seen, because he understands how the language is put together.',
	},
	{
		id: 'grammar',
		label: 'Grammar',
		title: 'First Language Lessons, then Grammar for the Well-Trained Mind',
		sourceLinks: [{ label: 'Well-Trained Mind Press', href: 'https://welltrainedmind.com' }],
		logoText: 'Well-Trained Mind Press',
		logoSubtext: 'First Language Lessons / Grammar',
		copy: 'Grammar begins in the early grades with short oral lessons and builds, year by year, into the careful analysis of how a sentence is made. Students learn to name each part and see how the parts work together. A child who understands how a sentence is built can write one that says exactly what he means.',
	},
	{
		id: 'writing',
		label: 'Writing',
		title: 'Institute for Excellence in Writing',
		sourceLinks: [{ label: 'Institute for Excellence in Writing', href: 'https://iew.com' }],
		logo: iewLogo,
		logoAlt: 'Institute for Excellence in Writing',
		copy: 'The Institute for Excellence in Writing treats writing as a set of skills that can be taught and practiced. Students begin by outlining and imitating strong models, then add one technique at a time until good structure becomes habit. They learn to write clearly before they are asked to write at length.',
	},
	{
		id: 'classical-language',
		label: 'Classical Language',
		title: 'Picta Dicta Latin',
		sourceLinks: [
			{ label: 'Picta Dicta', href: 'https://pictadicta.com' },
			{ label: 'Roman Roads Press', href: 'https://romanroadspress.com' },
		],
		logo: pictaDictaLogo,
		logoAlt: 'Picta Dicta',
		copy: 'Picta Dicta teaches Latin with images instead of translation lists, so a student connects each word directly to its meaning. New vocabulary and grammar come a little at a time, through pictures and short exercises, and are reviewed often enough that they stick.',
	},
	{
		id: 'mathematics',
		label: 'Mathematics',
		title: 'Singapore Dimensions, then Phillips Exeter',
		sourceLinks: [
			{ label: 'Singapore Math', href: 'https://www.singaporemath.com' },
			{ label: 'Phillips Exeter Academy', href: 'https://www.exeter.edu' },
		],
		logo: singaporeMathLogo,
		logoAlt: 'Singapore Math',
		copy: 'In the younger grades, Singapore math has students work with real objects and draw a problem before writing an equation, and they master each concept before moving on. In the upper grades they take up the Exeter method, working through real problems and reasoning toward solutions together. The aim throughout is that students understand why the mathematics works.',
	},
	{
		id: 'science',
		label: 'Science',
		title: 'Berean Builders',
		sourceLinks: [{ label: 'Berean Builders', href: 'https://bereanbuilders.com' }],
		logo: bereanBuildersLogo,
		logoAlt: 'Berean Builders',
		copy: 'Berean Builders teaches science in the order it was discovered, so students follow the questions and experiments that produced what we know. The curriculum is rigorous and openly Christian, treating Scripture and careful science as parts of the same created order.',
	},
	{
		id: 'music',
		label: 'Music',
		title: 'The Kodály Method',
		sourceLinks: [{ label: 'Organization of American Kodály Educators', href: 'https://oake.org' }],
		logoText: 'The Kodály Method',
		logoSubtext: 'Music literacy through singing',
		copy: 'In the Kodály method, children sing before they read a note, learning melody and rhythm by ear through folk songs and hand signs. Notation comes later, putting names to what they already know. By the time a student reads music, he already understands what it sounds like.',
	},
	{
		id: 'logic-rhetoric',
		label: 'Logic & Rhetoric',
		title: 'The Classical Arts of Reasoning',
		sourceLinks: [],
		logoText: 'Logic & Rhetoric',
		logoSubtext: 'The classical arts of reasoning',
		copy: 'In the upper grades, students learn to construct a sound argument and to find the flaw in a weak one. They study the ways reasoning fails, practice making their case aloud, and learn to hold a position with both conviction and charity toward those who disagree.',
	},
];
---

<Layout {title} {description} canonicalPath="/curriculum">
	<Header />

	<main class="curriculum-page mx-auto w-full max-w-canvas bg-white">
		<section
			id="curriculum-hero"
			aria-labelledby="curriculum-heading"
			class="border-b border-forest/10 bg-cream"
		>
			<div class="grid gap-10 px-6 py-14 sm:px-10 sm:py-16 lg:grid-cols-[8rem_minmax(0,1fr)_18rem] lg:px-12 lg:py-20">
				<div class="flex items-start lg:pt-2">
					<Image
						src={emblemGreen}
						alt=""
						class="h-20 w-auto"
					/>
				</div>

				<div class="flex flex-col gap-5">
					<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest">
						Curriculum
					</p>
					<h1
						id="curriculum-heading"
						class="curriculum-display max-w-[12ch] text-balance text-[4.5rem] font-normal italic tracking-tight text-ink sm:text-[5.75rem] lg:text-[6.75rem]"
					>
						Our Curriculum
					</h1>
					<p class="curriculum-display max-w-[16ch] text-balance text-[2.25rem] font-normal italic tracking-tight text-forest sm:text-[2.75rem]">
						& Why We Chose It
					</p>
				</div>

				<div class="grid grid-cols-2 gap-4 border-t border-forest/20 pt-6 lg:grid-cols-1 lg:self-end lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
					<div>
						<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-ink-soft">
							Grades
						</p>
						<p class="curriculum-display mt-2 text-[2.25rem] font-normal italic tracking-tight text-forest">
							K-8
						</p>
					</div>
					<div>
						<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-ink-soft">
							Choices
						</p>
						<p class="curriculum-display mt-2 text-[2.25rem] font-normal italic tracking-tight text-forest">
							9
						</p>
					</div>
				</div>
			</div>
		</section>

		<section
			id="integrated-humanities"
			aria-labelledby="integrated-humanities-heading"
			class="px-6 py-8 sm:px-10 sm:py-10 lg:px-12 lg:py-12"
		>
			<article class="grid overflow-hidden rounded-card bg-racing-mid text-white lg:grid-cols-[minmax(0,1fr)_24rem]">
				<div class="flex flex-col gap-8 p-7 sm:p-10 lg:p-12">
					<div class="flex flex-col gap-3">
						<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-gold">
							{featured.label}
						</p>
						<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-white/60">
							{featured.program}
						</p>
					</div>
					<h2
						id="integrated-humanities-heading"
						class="curriculum-display max-w-[14ch] text-balance text-[3.75rem] font-normal italic tracking-tight text-white sm:text-[5rem] lg:text-[5.75rem]"
					>
						{featured.title}
					</h2>
					<p class="max-w-[62ch] font-sans text-base leading-7 text-white/85 sm:text-[1.0625rem]">
						{featured.copy}
					</p>
					<ul role="list" class="flex flex-wrap gap-4 font-mono text-[0.6875rem] font-medium uppercase tracking-eyebrow">
						{featured.sourceLinks.map((source) => (
							<li>
								<a
									href={source.href}
									target="_blank"
									rel="noopener noreferrer"
									class="text-gold transition hover:text-gold-hover"
								>
									{source.label} ↗
								</a>
							</li>
						))}
					</ul>
				</div>

				<a
					href={featured.sourceLinks[0].href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`${featured.logoAlt} source site`}
					class="flex min-h-64 items-center justify-center bg-cream p-10 transition hover:bg-white lg:min-h-full"
				>
					<Image
						src={featured.logo}
						alt=""
						loading="eager"
						class="curriculum-logo-mark h-auto max-h-36 w-auto max-w-full object-contain"
					/>
				</a>
			</article>
		</section>

		<section
			id="curriculum-subjects"
			aria-labelledby="curriculum-subjects-heading"
			class="px-6 py-8 sm:px-10 sm:py-10 lg:px-12 lg:pb-24 lg:pt-12"
		>
			<div class="mb-8 flex flex-col gap-4 border-y border-forest/15 py-6 lg:flex-row lg:items-end lg:justify-between">
				<div>
					<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest">
						Kindergarten through Eighth Grade
					</p>
					<h2
						id="curriculum-subjects-heading"
						class="curriculum-display mt-3 max-w-[14ch] text-balance text-[3rem] font-normal italic tracking-tight text-ink sm:text-[4rem]"
					>
						Curriculum Choices
					</h2>
				</div>
				<p class="max-w-[34ch] font-mono text-xs font-medium uppercase tracking-eyebrow text-ink-soft lg:text-right">
					Reading, language, mathematics, science, music, logic
				</p>
			</div>

			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 xl:items-start">
				{sections.map((section, index) => (
					<article
						id={section.id}
						class={`flex min-h-[34rem] flex-col justify-between rounded-card border border-forest/15 p-5 ${
							index % 2 === 0 ? 'bg-white' : 'bg-cream'
						} ${index % 2 === 1 ? 'xl:mt-10' : ''}`}
					>
						<div class="flex flex-col gap-6">
							<div class="flex min-h-24 items-center justify-center border-b border-forest/15 pb-6">
								{section.sourceLinks.length > 0 ? (
									<a
										href={section.sourceLinks[0].href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${section.title} source site`}
										class="flex min-h-20 w-full items-center justify-center transition hover:opacity-70"
									>
										{section.logo ? (
											<Image
												src={section.logo}
												alt=""
												loading="eager"
												class={`curriculum-logo-mark h-auto w-auto max-w-[12rem] object-contain ${
													section.id === 'mathematics' ? 'max-h-20' : 'max-h-14'
												}`}
											/>
										) : (
											<div class="text-center text-forest">
												<p class="curriculum-display text-[2rem] font-normal italic tracking-tight">
													{section.logoText}
												</p>
												<p class="mt-2 font-mono text-[0.625rem] font-medium uppercase tracking-eyebrow">
													{section.logoSubtext}
												</p>
											</div>
										)}
									</a>
								) : (
									<div class="text-center text-forest">
										<p class="curriculum-display text-[2rem] font-normal italic tracking-tight">
											{section.logoText}
										</p>
										<p class="mt-2 font-mono text-[0.625rem] font-medium uppercase tracking-eyebrow">
											{section.logoSubtext}
										</p>
									</div>
								)}
							</div>

							<div class="flex flex-col gap-4">
								<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest">
									{section.label}
								</p>
								<h3 class="curriculum-display max-w-[17ch] text-balance text-[2.25rem] font-normal italic tracking-tight text-ink">
									{section.title}
								</h3>
								<p class="font-sans text-base leading-7 text-ink-soft">
									{section.copy}
								</p>
							</div>
						</div>

						{section.sourceLinks.length > 0 && (
							<ul role="list" class="mt-8 flex flex-col gap-2 border-t border-forest/15 pt-4 font-mono text-[0.6875rem] font-medium uppercase tracking-eyebrow">
								{section.sourceLinks.map((source) => (
									<li>
										<a
											href={source.href}
											target="_blank"
											rel="noopener noreferrer"
											class="text-forest transition hover:text-ink"
										>
											{source.label} ↗
										</a>
									</li>
								))}
							</ul>
						)}
					</article>
				))}
			</div>
		</section>

		<section
			id="curriculum-note"
			aria-labelledby="curriculum-note-heading"
			class="px-6 pb-28 pt-4 sm:px-10 sm:pb-36 lg:px-12 lg:pb-44"
		>
			<div class="grid gap-8 border-t border-forest/15 pt-8 lg:grid-cols-[18rem_minmax(0,1fr)]">
				<p
					id="curriculum-note-heading"
					class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest"
				>
					A Note on Sources
				</p>

				<div class="flex flex-col items-start gap-6">
					<p class="max-w-[62ch] font-sans text-base leading-7 text-ink-soft">
						Third-party marks are shown only to identify curriculum sources. Each mark or source label links to the official site, and inclusion here does not imply endorsement by the publisher.
					</p>
					<a
						href={INTERVIEW_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex rounded-pill bg-gold px-8 py-3.5 font-mono text-[0.6875rem] font-medium uppercase tracking-eyebrow text-ink transition hover:opacity-90"
					>
						Request an Interview
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.curriculum-display {
		font-family: "Cormorant Garamond", ui-serif, Georgia, serif;
	}

	.curriculum-logo-mark {
		filter: brightness(0) saturate(100%) invert(32%) sepia(21%) saturate(1280%) hue-rotate(78deg) brightness(91%) contrast(91%);
	}
</style>
