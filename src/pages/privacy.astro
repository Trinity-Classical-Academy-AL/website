---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Privacy — Trinity Classical Academy';
const description =
	'How Trinity Classical Academy handles information on the website and in the TCA Portal.';
---

<Layout {title} {description}>
	<Header />
	<div class="relative mx-auto w-full max-w-canvas flow-root">
		<div
			class="pointer-events-none absolute -top-[192px] bottom-0 left-0 right-0 z-0 hidden lg:block lg:px-12"
			aria-hidden="true"
		>
			<div class="relative h-full">
				<div class="absolute inset-y-0 left-1/4 w-px bg-ink/[0.04]"></div>
				<div class="absolute inset-y-0 left-1/2 w-px bg-ink/[0.04]"></div>
				<div class="absolute inset-y-0 left-3/4 w-px bg-ink/[0.04]"></div>
			</div>
		</div>

		<article class="relative z-10 px-6 pb-32 pt-20 sm:px-10 sm:pt-28 lg:px-12 lg:pb-40 lg:pt-36">
			<p class="font-mono text-xs font-medium uppercase tracking-eyebrow text-forest">Privacy</p>
			<h1 class="mt-6 max-w-[16ch] font-display text-[clamp(48px,7vw,84px)] italic leading-[0.95] tracking-tight text-ink">
				How we handle information.
			</h1>
			<p class="mt-8 max-w-[40rem] font-sans text-lg leading-snug text-ink-soft">
				This notice covers the Trinity Classical Academy website and the TCA Portal at
				<a class="text-forest" href="https://portal.trinityclassical.academy">portal.trinityclassical.academy</a>.
				The school is in Hoover/Birmingham, Alabama.
			</p>

			<div class="mt-14 flex max-w-[40rem] flex-col gap-10 font-sans text-base leading-relaxed text-ink-soft">
				<section>
					<h2 class="font-display text-[28px] leading-tight text-ink">The website</h2>
					<p class="mt-3">
						We use trusted service providers for hosting and analytics so the site can run and so we can see which pages people open. We do not sell that information.
					</p>
				</section>
				<section>
					<h2 class="font-display text-[28px] leading-tight text-ink">Signing in</h2>
					<p class="mt-3">
						You can sign in with an email and password, or with Google. Google is only a sign-in option. We use it to recognize your account.
					</p>
				</section>
				<section>
					<h2 class="font-display text-[28px] leading-tight text-ink">What we store</h2>
					<p class="mt-3">
						For a portal account we store your name, email addresses, and the kind of access you have. When a family uses the portal, we also store the family and student information that family provides.
					</p>
				</section>
				<section>
					<h2 class="font-display text-[28px] leading-tight text-ink">Who helps us run this</h2>
					<p class="mt-3">
						We use trusted service providers for hosting, email, and analytics. They send account messages, such as verification and password resets, host the website and the portal, and store the records those need.
					</p>
				</section>
				<section>
					<h2 class="font-display text-[28px] leading-tight text-ink">We do not sell personal information</h2>
					<p class="mt-3">
						We do not sell the information described on this page.
					</p>
				</section>
				<section>
					<h2 class="font-display text-[28px] leading-tight text-ink">Asking us to delete it</h2>
					<p class="mt-3">
						Email the school office at <a class="text-forest" href="mailto:info@trinityclassical.academy">info@trinityclassical.academy</a>, or use the <a class="text-forest" href="/contact">contact page</a>, and ask us to delete your portal account. We will delete the account information we hold. We may keep records the school is required to keep.
					</p>
				</section>
				<section>
					<h2 class="font-display text-[28px] leading-tight text-ink">The school office</h2>
					<p class="mt-3">
						Trinity Classical Academy<br />
						7160 Cahaba Valley Rd.<br />
						Birmingham, AL 35242<br />
						<a class="text-forest" href="mailto:info@trinityclassical.academy">info@trinityclassical.academy</a>
					</p>
					<p class="mt-6 font-mono text-xs uppercase tracking-eyebrow text-ink-mute">Updated November 4, 2026</p>
				</section>
			</div>
		</article>
	</div>
	<Footer />
</Layout>
