---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InterestForm from '../components/InterestForm.astro';
import { INTERVIEW_URL } from '../lib/links';
import { GRADE_OPTIONS, HEAR_ABOUT_OPTIONS, TOUR_DEFAULTS } from '../lib/admissions/defaults';
import { chicagoToday, formatTimeRange, schoolYearLabel, seasonYear } from '../lib/admissions/dates';

const title = 'Visit Trinity — Trinity Classical Academy';
const description =
	'Tour Trinity Classical Academy on the second Wednesday of January, February, and March. See the classrooms, meet the faculty, and ask your questions.';
const schoolYear = schoolYearLabel(seasonYear(chicagoToday()));
const timeLabel = formatTimeRange(TOUR_DEFAULTS.startTime, TOUR_DEFAULTS.endTime);
---

<Layout {title} {description}>
	<Header />
	<div class="relative mx-auto w-full max-w-canvas flow-root">
		<div
			class="pointer-events-none absolute -top-[192px] bottom-0 left-0 right-0 z-0 hidden lg:block lg:px-12"
			aria-hidden="true"
		>
			<div class="relative h-full">
				<div class="absolute inset-y-0 left-1/4 w-px bg-ink/[0.04]"></div>
				<div class="absolute inset-y-0 left-1/2 w-px bg-ink/[0.04]"></div>
				<div class="absolute inset-y-0 left-3/4 w-px bg-ink/[0.04]"></div>
			</div>
		</div>

		<section class="tour-stage relative z-10" data-visit-page>
			<div class="tour-grid">
				<div id="tour-heading">
					<p class="font-mono" style="margin:0;font-size:12px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#276d33">Admissions · Tours</p>
					<h1 class="font-display" style="margin:20px 0 0;font-style:italic;font-weight:300;line-height:.95;letter-spacing:-0.01em;color:#1a1a18">
						Visit Trinity.
					</h1>
					<p class="font-display" style="margin:28px 0 0;line-height:1.35;font-weight:300;color:#1a1a18;max-width:520px">
						Tours are held the second Wednesday of each month, January through March. See the classrooms, meet the faculty, and ask your questions.
					</p>
					<dl class="tour-facts">
						<div class="contents">
							<dt>When</dt>
							<dd>Second Wednesday · January, February, March</dd>
						</div>
						<div class="contents">
							<dt>Where</dt>
							<dd>{TOUR_DEFAULTS.location}</dd>
						</div>
						<div class="contents">
							<dt>Time</dt>
							<dd>{timeLabel}. Sent with your confirmation.</dd>
						</div>
					</dl>
					<p style="margin:32px 0 0;font-size:15px;color:#4a4b47">
						Prefer to talk first?
						<a href={INTERVIEW_URL} target="_blank" rel="noopener noreferrer" data-ph-event="interview_requested_click" data-ph-location="visit" style="color:#276d33">Request an interview</a>
					</p>
				</div>

				<div>
					<div data-visit-view="loading" class="rounded-card border border-ink/10 bg-cream/40 p-6 sm:p-8">
						<p class="font-sans text-base text-ink-soft">Loading tour dates…</p>
					</div>

					<div data-visit-view="load-error" hidden class="rounded-card border border-ink/10 bg-white p-6 sm:p-8">
						<p class="font-sans text-base text-ink" role="alert">
							We couldn't load tour dates. Please try again, or email
							<a class="text-forest underline" href={`mailto:${TOUR_DEFAULTS.schoolEmail}`}>{TOUR_DEFAULTS.schoolEmail}</a>.
						</p>
						<button type="button" data-retry class="mt-6 rounded-pill bg-gold px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink">
							Try again
						</button>
					</div>

					<div data-visit-view="empty" hidden class="rounded-card border border-ink/10 bg-white p-6 sm:p-8">
						<h2 class="font-display text-3xl italic text-ink">No dates are open.</h2>
						<p class="mt-4 font-sans text-base leading-snug text-ink-soft">
							Tours run on the second Wednesday of January, February, and March. Leave your name below and we'll write when the next dates are posted.
						</p>
					</div>

					<div data-visit-view="full" hidden class="rounded-card border border-ink/10 bg-white p-6 sm:p-8">
						<h2 class="font-display text-3xl italic text-ink">These tours are full.</h2>
						<p class="mt-4 font-sans text-base leading-snug text-ink-soft">
							Every open tour this season has reached its limit. Leave your name below and we'll write if a seat opens.
						</p>
						<div class="mt-6 space-y-2" data-full-list></div>
					</div>

					<div data-visit-view="form" hidden>
						<form data-visit-form novalidate class="rounded-card border border-ink/10 bg-cream/30 p-5 sm:p-8">
							<p class="hidden">
								<label>Company <input name="company" tabindex="-1" autocomplete="off" /></label>
							</p>
							<div data-error-summary role="alert" hidden class="mb-5 rounded-card border border-[#e7b2a8] bg-[#fdecea] px-4 py-3 font-sans text-sm text-[#9f2d2d]"></div>
							<div data-server-error tabindex="-1" role="alert" hidden class="mb-5 rounded-card border border-[#e7b2a8] bg-[#fdecea] px-4 py-3 font-sans text-sm text-[#9f2d2d]"></div>
							<p data-status class="sr-only" aria-live="polite"></p>

							<div class="flex flex-col gap-5">
								<div>
									<label for="tour-name" class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Parent or guardian name</label>
									<input id="tour-name" name="parentName" type="text" autocomplete="name" data-field="parentName" aria-describedby="tour-name-error" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none transition focus:border-forest aria-[invalid=true]:border-[#b42318] aria-[invalid=true]:bg-[#fff6f4]" />
									<p id="tour-name-error" data-error-for="parentName" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
								</div>
								<div class="grid gap-5 sm:grid-cols-2">
									<div>
										<label for="tour-email" class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Email</label>
										<input id="tour-email" name="email" type="email" autocomplete="email" inputmode="email" data-field="email" aria-describedby="tour-email-error" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none transition focus:border-forest aria-[invalid=true]:border-[#b42318] aria-[invalid=true]:bg-[#fff6f4]" />
										<p id="tour-email-error" data-error-for="email" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
									</div>
									<div>
										<label for="tour-phone" class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Phone</label>
										<input id="tour-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(205) 555-0100" data-field="phone" aria-describedby="tour-phone-error" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none transition placeholder:text-ink-mute/60 focus:border-forest aria-[invalid=true]:border-[#b42318] aria-[invalid=true]:bg-[#fff6f4]" />
										<p id="tour-phone-error" data-error-for="phone" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
									</div>
								</div>
								<div>
									<label for="tour-children" class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Number of children</label>
									<select id="tour-children" name="children" data-field="children" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none focus:border-forest">
										<option value="">Select…</option>
										<option value="1">1</option>
										<option value="2">2</option>
										<option value="3">3</option>
										<option value="4">4</option>
										<option value="5">5</option>
										<option value="6">6</option>
										<option value="7">7</option>
										<option value="8">8</option>
									</select>
									<p data-error-for="children" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
								</div>
								<fieldset>
									<legend class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Grades of interest</legend>
									<p class="mt-1 font-sans text-sm text-ink-soft">For the <span data-school-year>{schoolYear}</span> school year. Choose all that apply.</p>
									<div class="mt-3 flex flex-wrap gap-2">
										{GRADE_OPTIONS.map((grade) => (
											<button type="button" data-grade={grade.value} data-field="grades" aria-pressed="false" class="rounded-full border border-ink/15 bg-white px-3 py-1.5 font-sans text-sm text-ink transition hover:border-forest aria-pressed:border-forest aria-pressed:bg-forest aria-pressed:text-white aria-[invalid=true]:border-[#b42318]">
												{grade.label}
											</button>
										))}
									</div>
									<p data-error-for="grades" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
								</fieldset>
								<fieldset>
									<legend class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Preferred tour date</legend>
									<div class="mt-3 space-y-2" data-date-list></div>
									<p data-error-for="tourDateId" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
								</fieldset>
								<div>
									<label for="tour-heard" class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">How did you hear about us?</label>
									<select id="tour-heard" name="hearAbout" data-field="hearAbout" class="mt-1.5 w-full rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none focus:border-forest">
										<option value="">Select…</option>
										{HEAR_ABOUT_OPTIONS.map((option) => (
											<option value={option.value}>{option.label}</option>
										))}
									</select>
								</div>
								<div>
									<label for="tour-message" class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-ink-mute">Message <span class="normal-case tracking-normal">(optional)</span></label>
									<textarea id="tour-message" name="message" rows="4" data-field="message" placeholder="Anything we should know before the tour?" class="mt-1.5 w-full resize-y rounded-card border border-ink/15 bg-white px-3 py-2.5 font-sans text-base text-ink outline-none placeholder:text-ink-mute/60 focus:border-forest"></textarea>
									<p data-error-for="message" hidden class="mt-1.5 font-sans text-sm text-[#9f2d2d]"></p>
								</div>
								<button type="submit" data-submit class="rounded-pill bg-gold px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink transition hover:bg-gold-hover disabled:cursor-wait disabled:opacity-70">
									Request this tour
								</button>
							</div>
						</form>
					</div>

					<div data-visit-view="success" hidden class="rounded-card border border-ink/10 bg-white p-6 sm:p-8">
						<div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#e7f2e4] text-forest" aria-hidden="true">
							<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9.2 7.2 12.5 14 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						</div>
						<h2 tabindex="-1" data-success-heading class="mt-5 font-display text-4xl italic leading-tight text-ink outline-none">
							You're on the list, <span data-success-name></span>.
						</h2>
						<p data-success-lead class="mt-4 font-sans text-base leading-snug text-ink-soft"></p>
						<dl class="mt-8 space-y-4">
							<div>
								<dt class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest">When</dt>
								<dd data-success-when class="mt-1 font-sans text-base text-ink"></dd>
								<dd data-success-time class="font-sans text-sm text-ink-soft"></dd>
							</div>
							<div>
								<dt class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest">Where</dt>
								<dd class="mt-1 font-sans text-base text-ink">{TOUR_DEFAULTS.location}</dd>
							</div>
							<div>
								<dt class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest">What to expect</dt>
								<dd class="mt-1 font-sans text-base leading-snug text-ink-soft">{TOUR_DEFAULTS.whatToExpect}</dd>
							</div>
							<div>
								<dt class="font-mono text-[10px] font-medium uppercase tracking-eyebrow text-forest">Need to change it?</dt>
								<dd class="mt-1 font-sans text-base leading-snug text-ink-soft">
									Email <a class="text-forest underline" href={`mailto:${TOUR_DEFAULTS.schoolEmail}`}>{TOUR_DEFAULTS.schoolEmail}</a> and we'll move you to another date.
								</dd>
							</div>
						</dl>
						<div class="mt-8 flex flex-col gap-3 sm:flex-row">
							<button type="button" data-another class="rounded-pill border border-ink/15 px-5 py-3 font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink transition hover:border-forest">
								Back to dates
							</button>
							<a href="/admissions" class="rounded-pill bg-gold px-5 py-3 text-center font-mono text-[11px] font-medium uppercase tracking-eyebrow text-ink">
								Back to admissions
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>
	<div data-visit-followup hidden>
		<InterestForm id="visit-followup" />
	</div>
	<Footer />
	<noscript>
		<p class="mx-auto max-w-canvas px-6 pb-16 font-sans text-base text-ink">
			Tour requests on this page need JavaScript. Email {TOUR_DEFAULTS.schoolEmail} and we'll find a Wednesday for you.
		</p>
	</noscript>
</Layout>

<style>
	.tour-stage { padding: 56px 20px 72px; }
	.tour-stage h1 { font-size: 64px; }
	.tour-stage .font-display + .font-display,
	.tour-stage h1 + p { font-size: 22px; }
	.tour-grid { display: flex; flex-direction: column; gap: 40px; }
	.tour-facts { margin: 36px 0 0; display: grid; grid-template-columns: auto 1fr; gap: 14px 20px; font-size: 16px; line-height: 1.45; max-width: 520px; }
	.tour-facts dt { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #6b6c68; padding-top: 3px; }
	.tour-facts dd { margin: 0; }
	@media (min-width: 1024px) {
		.tour-stage { padding: 96px 48px 120px; }
		.tour-stage h1 { font-size: 120px; }
		.tour-stage h1 + p { font-size: 26px; }
		.tour-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; align-items: start; }
	}
</style>

<script>
	import { initVisitPage } from '../scripts/visit-page';
	initVisitPage();
</script>
