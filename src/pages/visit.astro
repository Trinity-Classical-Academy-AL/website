---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { INTERVIEW_URL, PORTAL_TOUR_SIGNUP, PORTAL_URL } from '../lib/links';
import { TOUR_DEFAULTS } from '../lib/admissions/defaults';
import storytimeImg from '../assets/images/storytime.webp';

const title = 'Visit Trinity — Trinity Classical Academy';
const description = 'See the classrooms, meet the faculty, and ask your questions.';
---

<Layout {title} {description}>
	<Header />
	<div class="v5-page">
		<section class="v5-hero" aria-labelledby="visit-h">
			<div class="v5-wrap v5-hero-grid">
				<div class="v5-hero-t">
					<p class="v5-eyebrow">Admissions</p>
					<h1 id="visit-h" class="v5-h1">Visit Trinity</h1>
					<p class="v5-lede" data-visit-lede>Spring tour dates aren’t posted yet. Request a tour now and we’ll offer you a time as soon as they are.</p>
					<div class="v5-actions">
						<a class="v5-btn v5-btn-gold" href={PORTAL_TOUR_SIGNUP}>Request a tour</a>
						<p class="v5-small">Already have an account? <a href={PORTAL_URL}>Sign in</a></p>
					</div>
					<p class="v5-small" style="margin-top:12px;color:var(--v5-mute)">You’ll create a free TCA account with Google or your email, then pick a time.</p>
					<div class="v5-facts">
						<div class="v5-fact">
							<p class="v5-fact-k">When</p>
							<p class="v5-fact-v" data-visit-when>New dates coming soon</p>
						</div>
						<div class="v5-fact">
							<p class="v5-fact-k">Time</p>
							<p class="v5-fact-v" data-visit-time>To be announced</p>
						</div>
						<div class="v5-fact">
							<p class="v5-fact-k">Where</p>
							<p class="v5-fact-v">{TOUR_DEFAULTS.location}</p>
						</div>
					</div>
					<p class="v5-small" style="margin-top:32px">Prefer to talk first? <a href={INTERVIEW_URL} target="_blank" rel="noopener noreferrer">Request an interview</a></p>
				</div>
				<div class="v5-hero-img">
					<Image src={storytimeImg} alt="Students gathered around a picture book and a map" style="object-position:50% 50%" />
				</div>
			</div>
		</section>
	</div>
	<Footer />
</Layout>
<script>
	const lede = document.querySelector('[data-visit-lede]');
	const when = document.querySelector('[data-visit-when]');
	const time = document.querySelector('[data-visit-time]');
	if (lede && when && time) {
		fetch('/api/tour-slots', { headers: { accept: 'application/json' } })
			.then((response) => (response.ok ? response.json() : null))
			.then((body: { slots?: { when?: string; open?: boolean }[] } | null) => {
				const slots = (body?.slots ?? []).filter((slot) => slot.open !== false && slot.when);
				if (!slots.length) return;
				const dates = slots.map((slot) => String(slot.when).replace(/, \d{1,2}:\d{2}.*$/, ''));
				const clocks = String(slots[0].when).match(/(\d{1,2}:\d{2})(?: ([AP]M))?–(\d{1,2}:\d{2}) ([AP]M)/);
				lede.textContent = 'See the classrooms, meet the faculty, and ask your questions.';
				when.textContent = dates.join(' · ');
				if (clocks) {
					const startSuffix = clocks[2];
					time.textContent = startSuffix && startSuffix !== clocks[4]
						? `${clocks[1]} ${startSuffix} to ${clocks[3]} ${clocks[4]}`
						: `${clocks[1]} to ${clocks[3]} ${clocks[4]}`;
				}
			})
			.catch(() => {});
	}
</script>
