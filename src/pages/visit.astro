---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { INTERVIEW_URL, PORTAL_TOUR_SIGNIN, PORTAL_TOUR_SIGNUP } from '../lib/links';
import { TOUR_DEFAULTS } from '../lib/admissions/defaults';

const title = 'Visit Trinity — Trinity Classical Academy';
const description =
	'Tour Trinity Classical Academy. Create a free account, then pick a time to see the classrooms and meet the faculty.';
---

<Layout {title} {description}>
	<Header />
	<main class="v5-page">
		<section class="v5-hero" aria-labelledby="visit-heading">
			<div class="v5-wrap" style="max-width:720px">
				<p class="v5-eyebrow">Admissions</p>
				<h1 id="visit-heading" class="v5-h1">Visit Trinity</h1>
				<p class="v5-lede">See the classrooms, meet the faculty, and ask your questions.</p>
				<div class="v5-actions">
					<a class="v5-btn v5-btn-gold" href={PORTAL_TOUR_SIGNUP}>Request a tour</a>
					<p class="v5-small">Already have an account? <a href={PORTAL_TOUR_SIGNIN}>Sign in</a></p>
				</div>
				<p class="v5-fine">Create a free account, then pick a time.</p>
				<dl class="v5-facts" style="max-width:520px">
					<div class="v5-fact">
						<p class="v5-fact-k">When</p>
						<p class="v5-fact-v" data-visit-when>Dates coming soon</p>
					</div>
					<div class="v5-fact">
						<p class="v5-fact-k">Time</p>
						<p class="v5-fact-v" data-visit-time>Dates coming soon</p>
					</div>
					<div class="v5-fact">
						<p class="v5-fact-k">Where</p>
						<p class="v5-fact-v">{TOUR_DEFAULTS.location}</p>
					</div>
				</dl>
				<p class="v5-small" style="margin-top:24px">
					Prefer to talk first? <a href={INTERVIEW_URL} target="_blank" rel="noopener noreferrer" data-ph-event="interview_requested_click" data-ph-location="visit">Request an interview</a>
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
<script>
	const when = document.querySelector('[data-visit-when]');
	const time = document.querySelector('[data-visit-time]');
	if (when instanceof HTMLElement && time instanceof HTMLElement) {
		fetch('/api/tour-slots', { headers: { accept: 'application/json' } })
			.then((response) => (response.ok ? response.json() : null))
			.then((body: { slots?: { when: string }[] } | null) => {
				const slots = body?.slots ?? [];
				if (slots.length === 0) return;
				when.textContent = slots.map((slot) => slot.when.replace(/, \d{1,2}:\d{2}.*$/, '')).join(' · ');
				const clock = slots[0].when.match(/\d{1,2}:\d{2}.*$/);
				if (clock) time.textContent = clock[0];
			})
			.catch(() => undefined);
	}
</script>
